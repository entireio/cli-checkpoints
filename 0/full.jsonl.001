gent/copilotcli/copilotcli_test.go:108:\t\tt.Errorf(\"ResolveSessionFile() = %q, want %q\", result, expected)\ncmd/entire/cli/agent/copilotcli/copilotcli_test.go:116:\tt.Setenv(\"ENTIRE_TEST_COPILOT_SESSION_DIR\", \"/test/override\")\ncmd/entire/cli/agent/copilotcli/copilotcli_test.go:129:\tt.Setenv(\"ENTIRE_TEST_COPILOT_SESSION_DIR\", \"\")\ncmd/entire/cli/agent/copilotcli/copilotcli_test.go:144:\tt.Setenv(\"ENTIRE_TEST_COPILOT_SESSION_DIR\", \"\")\nsed: cmd/entire/cli/agent/copilotcli/agent.go: No such file or directory\ncmd/entire/cli/strategy/manual_commit_condensation.go:273:// resolveTaskTranscriptPath falls back to the agent-layout convention when a\ncmd/entire/cli/strategy/manual_commit_condensation.go:282:func resolveTaskTranscriptPath(state *SessionState, agentID string) string {\ncmd/entire/cli/strategy/manual_commit_condensation.go:313:// materializeTaskRecords resolves and redacts each of state.TaskRecords'\ncmd/entire/cli/strategy/manual_commit_condensation.go:341:func (s *ManualCommitStrategy) materializeTaskRecords(\ncmd/entire/cli/strategy/manual_commit_condensation.go:378:\t\tif record.DeclaredTranscriptPath != \"\" {\ncmd/entire/cli/strategy/manual_commit_condensation.go:379:\t\t\tcandidates = append(candidates, record.DeclaredTranscriptPath)\ncmd/entire/cli/strategy/manual_commit_condensation.go:381:\t\tif fallback := resolveTaskTranscriptPath(state, record.AgentID); fallback != \"\" && fallback != record.DeclaredTranscriptPath {\ncmd/entire/cli/strategy/manual_commit_condensation.go:617:\ttaskPayloads, extractedAssets := s.materializeTaskRecords(ctx, logCtx, ag, state, extractedAssets)\ncmd/entire/cli/strategy/manual_commit_condensation.go:273:// resolveTaskTranscriptPath falls back to the agent-layout convention when a\ncmd/entire/cli/strategy/manual_commit_condensation.go:282:func resolveTaskTranscriptPath(state *SessionState, agentID string) string {\ncmd/entire/cli/strategy/manual_commit_condensation.go:313:// materializeTaskRecords resolves