erything in between can still stop delivery, and the election is\n95-\t// permanent, so intent is not enough to move it. The hint below then speaks\n96-\t// only for what capture left gated — see hintGatedCheckpointSync.\n97-\tvar pendingCapture string\n98-\tif !ps.hasCheckpointURL() {\n99-\t\tif pendingCaptureCheckpointSyncRemote(ctx, ps.remote) {\n100-\t\t\tpendingCapture = ps.remote\n101-\t\t}\n102-\t\tif !checkpointSyncAllowedForRemote(ctx, ps.remote, pendingCapture) {\n103-\t\t\thintGatedCheckpointSync(ctx, ps.remote)\n104-\t\t\treturn nil\n105-\t\t}\n106-\t}\n107-\n108-\t// Egress trust gate, above both backend branches: a globally enrolled repo\n109-\t// syncs only after the user trusts it once. A hold pairs with exactly one\n110-\t// stderr explanation and never fails the user's own push.\n111:\tif !settings.CheckpointEgressAllowed(ctx) {\n112:\t\tdecision, decisionErr := resolveTrustDecisionFn(ctx, stderrWriter)\n113-\t\tif decisionErr != nil {\n114-\t\t\tlogging.Warn(ctx, \"trust pre-push prompt failed; holding checkpoint sync\",\n115-\t\t\t\tslog.String(\"error\", decisionErr.Error()),\n116-\t\t\t)\n117-\t\t}\n118-\t\tif decisionErr != nil || decision != TrustGranted {\n119-\t\t\tfmt.Fprintln(stderrWriter, \"Entire: checkpoint sync held — this repo isn't trusted yet.\\nSessions are captured locally. Run `entire trust` to sync them to your checkpoint sync remote.\")\n120-\t\t\treturn nil\n121-\t\t}\n122-\t\t// Granted at the prompt: re-evaluate the gate, never reuse a boolean.\n123:\t\tif !settings.CheckpointEgressAllowed(ctx) {\n124-\t\t\tfmt.Fprintln(stderrWriter, \"Warning: trust was saved but the gate still holds; checkpoint sync skipped for this push.\")\n125-\t\t\treturn nil\n126-\t\t}\n127-\t}\n128-\n129-\t// git-refs primary: push the per-checkpoint refs recorded in the push queue\n130-\t// instead of the single v1 branch. Those refs live under refs/entire/, not\n131-\t// refs/heads/, so a forge can never pick them as a repository's default\n132-\t// branch — the empty-remote guard below is unnecessary for this backend.\n133-\t// (A configured git-branch mirror's v1 ref is not pushed here yet — mirror\n134-\t// push for downgrade safety is a later step.)\n135-\tif ps.primaryIsRefs {\n136-\t\treturn s.prePushCheckpointRefs(ctx, ps, pendingCapture)\n137-\t}\n138-\n139-\t// git-branch primary: entire/checkpoints/v1 is a real refs/heads branch, so\n140-\t// on an otherwise-empty remote a forge like GitHub would select it as the\n141-\t// default. Defer publication until the user's own branch exists there.\n--\n442-\treturn nil\n443-}\n444-\n445-// PushQueuedCheckpointRefs pushes any queued checkpoint refs to the configured\n446-// checkpoint remote, surfacing errors (unlike the fail-soft pre-push path); the\n447-// caller owns the repo. It returns the number of refs pushed and whether\n448-// pushing is disabled in settings — a distinct signal from pushed==0 with\n449-// pushing enabled (an empty queue), so callers can report the two accurately.\n450-// Like the pre-push paths, a checkpoint policy that blocks pushing errors with\n451-// the refs left queued. Currently used by the checkpoint migration command's\n452-// opt-in \"push now\".\n453-func PushQueuedCheckpointRefs(ctx context.Context, repo *git.Repository, remote string) (pushed int, pushDisabled bool, err error) {\n454-\tps := resolvePushSettings(ctx, remote)\n455-\tif ps.pushDisabled {\n456-\t\treturn 0, true, nil\n457-\t}\n458-\t// Second egress entry point (bypasses prePush): same trust gate, no\n459-\t// prompt; refs stay queued for after `entire trust`.\n460:\tif !settings.CheckpointEgressAllowed(ctx) {\n461-\t\treturn 0, false, errors.New(\"checkpoint sync is held — this repo isn't trusted yet; refs stay queued — run `entire trust` first\")\n462-\t}\n463-\tsyncCheckpointPolicyForPrePush(ctx, repo, ps)\n464-\tif !checkpointPolicyAllowsGitHook(ctx, repo) {\n465-\t\treturn 0, false, errors.New(\"checkpoint policy does not allow pushing checkpoint ref