i/agent/external/discovery_test.go:428:\\terr := DiscoverAndRegisterNamedAlways(context.Background(), name)\\ncmd/entire/cli/agent/external/discovery_test.go:430:\\t\\tt.Fatal(\\\"DiscoverAndRegisterNamedAlways() error = nil, want helper-disappeared error\\\")\\ncmd/entire/cli/agent/external/discovery_test.go:433:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %q, want agent and binary context\\\", err)\\ncmd/entire/cli/agent/external/discovery_test.go:436:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %q, want actionable registration context\\\", err)\\ncmd/entire/cli/agent/external/discovery_test.go:440:func TestDiscoverAndRegisterNamedAlways_StatError(t *testing.T) {\\ncmd/entire/cli/agent/external/discovery_test.go:454:\\terr := DiscoverAndRegisterNamedAlways(context.Background(), name)\\ncmd/entire/cli/agent/external/discovery_test.go:456:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %v, want stat error\\\", err)\\ncmd/entire/cli/agent/external/discovery_test.go:459:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %q, want agent name %q\\\", err, name)\\ncmd/entire/cli/agent/external/discovery_test.go:463:func TestDiscoverAndRegisterNamedAlways_LookPathError(t *testing.T) {\\ncmd/entire/cli/agent/external/discovery_test.go:471:\\terr := DiscoverAndRegisterNamedAlways(context.Background(), name)\\ncmd/entire/cli/agent/external/discovery_test.go:473:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %v, want lookup error\\\", err)\\ncmd/entire/cli/agent/external/discovery_test.go:476:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %q, want agent name %q\\\", err, name)\\ncmd/entire/cli/agent/external/discovery_test.go:491:\\tDiscoverAndRegisterAlways(context.Background())\\ncmd/entire/cli/agent/external/discovery_test.go:623:// TestDiscoverAndRegisterNamedAlways_RegistersBatOnWindows covers the explicit\\ncmd/entire/cli/agent/external/discovery_test.go:626:func TestDiscoverAndRegisterNamedAlways_RegistersBatOnWindows(t *testing.T) {\\ncmd/entire/cli/agent/external/discovery_test.go:643:\\tif err := DiscoverAndRegisterNamedAlways(context.Background(), name); err != nil {\\ncmd/entire/cli/agent/external/discovery_test.go:644:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %v\\\", err)\\ncmd/entire/cli/agent/external/discovery_test.go:680:// TestDiscoverAndRegisterNamedAlways_ReportsCallerDeadlineExpiredDuringLookup pins the\\ncmd/entire/cli/agent/external/discovery_test.go:687:// TestDiscoverAndRegisterNamedAlways_DeadlineWhileLookingUpMissingHelper flaky under\\ncmd/entire/cli/agent/external/discovery_test.go:689:func TestDiscoverAndRegisterNamedAlways_ReportsCallerDeadlineExpiredDuringLookup(t *testing.T) {\\ncmd/entire/cli/agent/external/discovery_test.go:703:\\terr := DiscoverAndRegisterNamedAlways(caller, name)\\ncmd/entire/cli/agent/external/discovery_test.go:705:\\t\\tt.Fatalf(\\\"DiscoverAndRegisterNamedAlways() error = %v, want context deadline exceeded\\\", err)\\ncmd/entire/cli/versioncheck/versioncheck.go:72:\\t// Always update cache to avoid retrying on every CLI invocation\\ncmd/entire/cli/agent/external/discovery.go:47:// DiscoverAndRegisterAlways is like DiscoverAndRegister but bypasses the\\ncmd/entire/cli/agent/external/discovery.go:50:func DiscoverAndRegisterAlways(ctx context.Context) {\\ncmd/entire/cli/agent/external/discovery.go:54:// DiscoverAndRegisterNamedAlways discovers and registers only the external\\ncmd/entire/cli/agent/external/discovery.go:57:func DiscoverAndRegisterNamedAlways(ctx context.Context, name types.AgentName) error {\\ncmd/entire/cli/dispatch_test.go:594:\\toldDiscover := discoverSummaryProvidersAlways\\ncmd/entire/cli/dispatch_test.go:609:\\t\\tdiscoverSummaryProvidersAlways = oldDiscover\\ncmd/entire/cli/dispatch_test.go:632:\\tdiscoverSummaryProvidersAlways = func(context.Context) {}\\ncmd/entire/cli/settings/trust.go:117:// CurrentTrustSource names what grants egress consent in the global trust\\ncmd/entire/cli/settings/trust.go:120:func CurrentTrustSource(ctx context.Context) TrustSource {\\ncmd/entire/cli/settings/trust.go:133:// CheckpointEgressAllowed and CurrentTrustSource. Every error path resolves\\ncmd/entire/cli/settings/trust.go:153:// TrustCurrentRepo records egress consent for the current repository's\\ncmd/entire/cli/settings/trust.go:157:func TrustCurrentRepo(ctx context.Context) (TrustIdentity, error) {\\ncmd/entire/cli/settings/opf_command_trust_test.go:195:\\tassert.Equal(t, OPFPromptAlways, opf.PromptDefault, \\\"prompt_default must still load\\\")\\ncmd/entire/cli/settings/trust_test.go:150:\\t\\tif _, err := TrustCurrentRepo(t.Context()); err != nil {\\ncmd/entire/cli/agent/skilldiscovery/registry_test.go:55:func REDACTED(t *testing.T) {\\ncmd/entire/cli/settings/settings.go:63:\\t// CommitLinkingAlways auto-links commits to sessions without prompting.\\ncmd/entire/cli/settings/settings.go:64:\\tCommitLinkingAlways = \\\"always\\\"\\ncmd/entire/cli/settings/settings.go:377:\\tOPFPromptAlways = \\\"always\\\"\\ncmd/entire/cli/settings/settings.go:493:\\t// AlwaysPrompt is appended to every turn's composed prompt, parallel\\ncmd/entire/cli/settings/settings.go:495:\\tAlwaysPrompt string `json:\\\"always_prompt,omitempty\\\"`\\ncmd/entire/cli/settings/settings.go:503:\\treturn len(c.Agents) == 0 && c.MaxTurns == 0 && c.Quorum == 0 && c.AlwaysPrompt == \\\"\\\"\\ncmd/entire/cli/settings/settings.go:891:\\tif settings.CommitLinking != \\\"\\\" && settings.CommitLinking != CommitLinkingAlways && settings.CommitLinking != CommitLinkingPrompt {\\ncmd/entire/cli/settings/settings.go:892:\\t\\treturn nil, fmt.Errorf(\\\"invalid commit_linking value %q: must be %q or %q\\\", settings.CommitLinking, CommitLinkingAlways, CommitLinkingPrompt)\\ncmd/entire/cli/settings/settings.go:1273:\\tcase CommitLinkingAlways, CommitLinkingPrompt:\\ncmd/entire/cli/settings/settings.go:1276:\\t\\treturn fmt.Errorf(\\\"invalid commit_linking value %q: must be %q or %q\\\", cl, CommitLinkingAlways, CommitLinkingPrompt)\\ncmd/entire/cli/settings/settings.go:1345:\\tcase \\\"\\\", OPFPromptAsk, OPFPromptNever, OPFPromptAlways:\\ncmd/entire/cli/settings/settings.go:1349:\\t\\t\\tOPFPromptAsk, OPFPromptNever, OPFPromptAlways, opf.PromptDefault)\\ncmd/entire/cli/settings/settings_test.go:523:\\ts := &EntireSettings{Enabled: true, CommitLinking: CommitLinkingAlways}\\ncmd/entire/cli/settings/settings_test.go:524:\\tif got := s.GetCommitLinking(); got != CommitLinkingAlways {\\ncmd/entire/cli/settings/settings_test.go:525:\\t\\tt.Errorf(\\\"GetCommitLinking() = %q, want %q\\\", got, CommitLinkingAlways)\\ncmd/entire/cli/settings/settings_test.go:557:\\tif s.CommitLinking != CommitLinkingAlways {\\ncmd/entire/cli/settings/settings_test.go:558:\\t\\tt.Errorf(\\\"CommitLinking = %q, want %q\\\", s.CommitLinking, CommitLinkingAlways)\\ncmd/entire/cli/settings/settings_test.go:560:\\tif got := s.GetCommitLinking(); got != CommitLinkingAlways {\\ncmd/entire/cli/settings/settings_test.go:561:\\t\\tt.Errorf(\\\"GetCommitLinking() = %q, want %q\\\", got, CommitLinkingAlways)\\ncmd/entire/cli/settings/settings_test.go:595:\\tif s.CommitLinking != CommitLinkingAlways {\\ncmd/entire/cli/settings/settings_test.go:596:\\t\\tt.Errorf(\\\"CommitLinking = %q, want %q (expected local override)\\\", s.CommitLinking, CommitLinkingAlways)\\ncmd/entire/cli/settings/settings_test.go:1313:\\tif s.Investigate.AlwaysPrompt != \\\"Be terse.\\\" {\\ncmd/entire/cli/settings/settings_test.go:1314:\\t\\tt.Errorf(\\\"AlwaysPrompt = %q\\\", s.Investigate.AlwaysPrompt)\\ncmd/entire/cli/settings/settings_test.go:1333:\\t\\t{\\\"always_prompt\\\", &InvestigateConfig{AlwaysPrompt: \\\"hello\\\"}, false},\\ncmd/entire/cli/settings/settings_test.go:1415:\\tif cfg.AlwaysPrompt != \\\"Be brief.\\\" {\\ncmd/entire/cli/settings/settings_test.go:1416:\\t\\tt.Errorf(\\\"AlwaysPrompt = %q, want %q\\\", cfg.AlwaysPrompt, \\\"Be brief.\\\")\\ncmd/entire/cli/agent/geminicli/hooks_user.go:39:// Always the plain production `entire` command form; preserves every\\ncmd/entire/cli/agent/codex/reviewer_test.go:47:\\t\\tAlwaysPrompt: \\\"Always check error handling.\\\",\\ncmd/entire/cli/agent/codex/reviewer_test.go:107:\\t\\tAlwaysPrompt:      \\\"Focus on auth regressions.\\\",\\ncmd/entire/cli/agent/geminicli/reviewer_test.go:46:\\t\\tAlwaysPrompt: \\\"Always check for security vulnerabilities.\\\",\\ncmd/entire/cli/agent/pi/reviewer_test.go:27:\\t\\tAlwaysPrompt: \\\"Focus on API regressions.\\\",\\ncmd/entire/cli/agent/claudecode/hooks_user.go:30:// Always the plain production `entire` command form — byte-identical to the\\ncmd/entire/cli/agent/claudecode/reviewer_test.go:47:\\t\\tAlwaysPrompt: \\\"Always check for security issues.\\\",\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a035bb-e411-7b32-a380-13e06970de42","create_time":1787607925.067149}}}
