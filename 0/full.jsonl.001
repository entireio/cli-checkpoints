d/entire/cli/strategy/trust_prompt.go:33:// resolveTrustDecision holds without prompting when there is no user to ask,\ncmd/entire/cli/strategy/trust_prompt.go:35:func resolveTrustDecision(ctx context.Context, hasTTY bool, ask func() (trustChoice, error), errOut io.Writer) (TrustDecision, error) {\ncmd/entire/cli/strategy/trust_prompt.go:37:\t\treturn TrustHeld, nil\ncmd/entire/cli/strategy/trust_prompt.go:41:\t\treturn TrustHeld, err\ncmd/entire/cli/strategy/trust_prompt.go:43:\treturn applyTrustChoice(ctx, choice, errOut), nil\ncmd/entire/cli/strategy/trust_prompt.go:46:// resolveTrustDecisionForPrePush is the production wiring: TTY detection plus\ncmd/entire/cli/strategy/trust_prompt.go:48:func resolveTrustDecisionForPrePush(ctx context.Context, errOut io.Writer) (TrustDecision, error) {\ncmd/entire/cli/strategy/trust_prompt.go:49:\treturn resolveTrustDecision(ctx, interactive.CanPromptInteractively(),\ncmd/entire/cli/strategy/trust_prompt.go:50:\t\tfunc() (trustChoice, error) { return askTrustPrompt(ctx) }, errOut)\ncmd/entire/cli/strategy/trust_prompt.go:53:// applyTrustChoice persists the user's answer. A write failure warns and\ncmd/entire/cli/strategy/trust_prompt.go:56:func applyTrustChoice(ctx context.Context, choice trustChoice, errOut io.Writer) TrustDecision {\ncmd/entire/cli/strategy/trust_prompt.go:58:\tcase trustChoiceYes:\ncmd/entire/cli/strategy/trust_prompt.go:59:\t\t// The same writer bare `entire trust` uses (one consent key shape).\ncmd/entire/cli/strategy/trust_prompt.go:60:\t\tif _, err := settings.TrustCurrentRepo(ctx); err != nil {\ncmd/entire/cli/strategy/trust_prompt.go:61:\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust for this repo: %v\\n\", err)\ncmd/entire/cli/strategy/trust_prompt.go:62:\t\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:64:\t\treturn TrustGranted\ncmd/entire/cli/strategy/trust_prompt.go:65:\tcase trustChoiceAlways:\ncmd/entire/cli/strategy/trust_prompt.go:66:\t\tif err := settings.TrustAllRepos(