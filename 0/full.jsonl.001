{"timestamp":"2026-08-24T21:45:31.406Z","ordinal":9637,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a025ce-e754-7631-8467-eaa6035ba0f8","turn_id":"01a035bb-e411-7b32-a380-13e06970de42","item":{"type":"CommandExecution","id":"exec-3552cad0-fe9e-4a6b-a21d-5352003f3b98","process_id":"67500","command":["/bin/zsh","-lc","sed -n '1,180p' cmd/entire/cli/strategy/trust_prompt.go && sed -n '420,490p' cmd/entire/cli/strategy/manual_commit_push.go && sed -n '1,180p' cmd/entire/cli/strategy/trust_prompt_test.go && sed -n '1,180p' cmd/entire/cli/agent/geminicli/hooks_user.go && sed -n '1,160p' cmd/entire/cli/agent/claudecode/hooks_user.go"],"cwd":"file:///Users/peytonmontei/Documents/Documents%20-%20Peyton%E2%80%99s%20MacBook%20Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier","parsed_cmd":[{"type":"read","cmd":"sed -n '1,180p' cmd/entire/cli/strategy/trust_prompt.go","name":"trust_prompt.go","path":"cmd/entire/cli/strategy/trust_prompt.go"},{"type":"read","cmd":"sed -n '420,490p' cmd/entire/cli/strategy/manual_commit_push.go","name":"manual_commit_push.go","path":"cmd/entire/cli/strategy/manual_commit_push.go"},{"type":"read","cmd":"sed -n '1,180p' cmd/entire/cli/strategy/trust_prompt_test.go","name":"trust_prompt_test.go","path":"cmd/entire/cli/strategy/trust_prompt_test.go"},{"type":"read","cmd":"sed -n '1,180p' cmd/entire/cli/agent/geminicli/hooks_user.go","name":"hooks_user.go","path":"cmd/entire/cli/agent/geminicli/hooks_user.go"},{"type":"read","cmd":"sed -n '1,160p' cmd/entire/cli/agent/claudecode/hooks_user.go","name":"hooks_user.go","path":"cmd/entire/cli/agent/claudecode/hooks_user.go"}],"source":"unified_exec_startup","status":"completed","stdout":"package strategy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\n\t\"charm.land/huh/v2\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/uiform\"\n)\n\n// TrustDecision is the resolved egress-trust outcome for a single pre-push in\n// a globally enrolled repo.\ntype TrustDecision int\n\nconst (\n\tTrustHeld    TrustDecision = iota // checkpoints stay local this push; re-ask next push\n\tTrustGranted                      // consent recorded — the caller re-evaluates the gate, never reuses this as a boolean\n)\n\ntype trustChoice string\n\nconst (\n\ttrustChoiceYes    trustChoice = \"yes\"\n\ttrustChoiceNotNow trustChoice = \"not_now\"\n\ttrustChoiceAlways trustChoice = \"always\"\n)\n\n// resolveTrustDecision holds without prompting when there is no user to ask,\n// otherwise asks and persists the answer. ask is injected for tests.\nfunc resolveTrustDecision(ctx context.Context, hasTTY bool, ask func() (trustChoice, error), errOut io.Writer) (TrustDecision, error) {\n\tif !hasTTY {\n\t\treturn TrustHeld, nil\n\t}\n\tchoice, err := ask()\n\tif err != nil {\n\t\treturn TrustHeld, err\n\t}\n\treturn applyTrustChoice(ctx, choice, errOut), nil\n}\n\n// resolveTrustDecisionForPrePush is the production wiring: TTY detection plus\n// the real uiform prompt. errOut receives persistence-failure warnings.\nfunc resolveTrustDecisionForPrePush(ctx context.Context, errOut io.Writer) (TrustDecision, error) {\n\treturn resolveTrustDecision(ctx, interactive.CanPromptInteractively(),\n\t\tfunc() (trustChoice, error) { return askTrustPrompt(ctx) }, errOut)\n}\n\n// applyTrustChoice persists the user's answer. A write failure warns and\n// holds — never an error, which the pre-push hook would turn into a failed\n// user push.\nfunc applyTrustChoice(ctx context.Context, choice trustChoice, errOut io.Writer) TrustDecision {\n\tswitch choice {\n\tcase trustChoiceYes:\n\t\t// The same writer bare `entire trust` uses (one consent key shape).\n\t\tif _, err := settings.TrustCurrentRepo(ctx); err != nil {\n\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust for this repo: %v\\n\", err)\n\t\t\treturn TrustHeld\n\t\t}\n\t\treturn TrustGranted\n\tcase trustChoiceAlways:\n\t\tif err := settings.TrustAllRepos(ctx); err != nil {\n\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust_all: %v\\n\", err)\n\t\t\treturn TrustHeld\n\t\t}\n\t\treturn TrustGranted\n\tcase trustChoiceNotNow:\n\t\treturn TrustHeld\n\tdefault:\n\t\treturn TrustHeld\n\t}\n}\n\n// askTrustPrompt shows the three-option trust select. Pre-push stdin carries\n// git ref lines — the form reads the terminal, never stdin. Ctrl-C / abort\n// means \"not now\"; the user's push proceeds either way.\nfunc askTrustPrompt(ctx context.Context) (trustChoice, error) {\n\t// An identity error needs no handling here: TrustCurrentRepo re-derives\n\t// it and its failure is warned-and-held by applyTrustChoice.\n\tyesLabel := \"Yes — trust this repo (this folder only)\"\n\tif id, err := settings.RepoTrustIdentity(ctx); err == nil && id.OriginKeyed() {\n\t\tyesLabel = fmt.Sprintf(\"Yes — trust this repo (all clones of %s)\", id.DisplayScope())\n\t}\n\tchoice := trustChoiceYes\n\tform := uiform.New(\n\t\thuh.NewGroup(\n\t\t\thuh.NewSelect[trustChoice]().\n\t\t\t\tTitle(\"Entire captured agent sessions in this repo via global mode.\").\n\t\t\t\tDescription(\"Trust this folder and sync its checkpoints to your checkpoint sync remote?\").\n\t\t\t\tOptions(\n\t\t\t\t\thuh.NewOption(yesLabel, trustChoiceYes),\n\t\t\t\t\thuh.NewOption(\"Not now — keep capturing locally, ask again next push\", trustChoiceNotNow),\n\t\t\t\t\thuh.NewOption(\"Always — trust every repo on this machine\", trustChoiceAlways),\n\t\t\t\t).\n\t\t\t\tValue(&choice),\n\t\t),\n\t)\n\tif err := form.RunWithContext(ctx); err != nil {\n\t\tif errors.Is(err, huh.ErrUserAborted) {\n\t\t\treturn trustChoiceNotNow, nil\n\t\t}\n\t\treturn trustChoiceNotNow, fmt.Errorf(\"trust prompt: %w\", err)\n\t}\n\treturn choice, nil\n}\n\t// without blocking the user. The v1 path aborts the user's git push; here a\n\t// checkpoint-ref failure must never do that (see this function's doc), so\n\t// failing closed means withholding the flush — nothing un-OPF'd ships, the\n\t// refs stay queued, and the user's push proceeds.\n\tif redact.OPFEnabled() && !runOPFForCheckpointRefs(ctx, repo) {\n\t\treturn nil\n\t}\n\n\tif flushed, err := flushCheckpointRefsQueue(ctx, repo, ps); err == nil {\n\t\t// Delivered, and only if something actually was: an empty queue pushed\n\t\t// nothing, so it must not move the election or announce that it had.\n\t\tif pendingCapture != \"\" && flushed > 0 {\n\t\t\tcommitCapturedSyncRemote(ctx, pendingCapture)\n\t\t}\n\t} else {\n\t\t// Fail-soft: a checkpoint-ref push failure must never block the user's\n\t\t// git push. The refs stay queued for the next pre-push.\n\t\tlogging.Warn(ctx, \"git-refs pre-push: checkpoint ref push failed; refs left queued\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\tcleanupPushedShadowBranches(ctx)\n\treturn nil\n}\n\n// PushQueuedCheckpointRefs pushes any queued checkpoint refs to the configured\n// checkpoint remote, surfacing errors (unlike the fail-soft pre-push path); the\n// caller owns the repo. It returns the number of refs pushed and whether\n// pushing is disabled in settings — a distinct signal from pushed==0 with\n// pushing enabled (an empty queue), so callers can report the two accurately.\n// Like the pre-push paths, a checkpoint policy that blocks pushing errors with\n// the refs left queued. Currently used by the checkpoint migration command's\n// opt-in \"push now\".\nfunc PushQueuedCheckpointRefs(ctx context.Context, repo *git.Repository, remote string) (pushed int, pushDisabled bool, err error) {\n\tps := resolvePushSettings(ctx, remote)\n\tif ps.pushDisabled {\n\t\treturn 0, true, nil\n\t}\n\t// Second egress entry point (bypasses prePush): same trust gate, no\n\t// prompt; refs stay queued for after `entire trust`.\n\tif !settings.CheckpointEgressAllowed(ctx) {\n\t\treturn 0, false, errors.New(\"checkpoint sync is held — this repo isn't trusted yet; refs stay queued — run `entire trust` first\")\n\t}\n\tsyncCheckpointPolicyForPrePush(ctx, repo, ps)\n\tif !checkpointPolicyAllowsGitHook(ctx, repo) {\n\t\treturn 0, false, errors.New(\"checkpoint policy does not allow pushing checkpoint refs; refs stay queued\")\n\t}\n\tpushed, err = flushCheckpointRefsQueue(ctx, repo, ps)\n\t// Clean up even on a partial/failed flush: a diverged batch can push some\n\t// refs and still return an error, and the shadow branches for the refs that\n\t// *did* land must still be cleaned up — parity with the pre-push path, which\n\t// always runs cleanup after flush regardless of its error.\n\tcleanupPushedShadowBranches(ctx)\n\treturn pushed, false, err\n}\n\n// flushCheckpointRefsQueue drains the push-discovery queue and batch-pushes the\n// recorded refs fast-forward-only, recovering a diverged ref by fetch+replay and\n// removing from the queue only the refs that land. It returns the number pushed.\n//\n// Shared by the git-refs pre-push path (which logs and ignores the error to\n// never block the user's push) and the migration command's opt-in push (which\n// surfaces it). Stale entries — refs no longer present locally — are pruned so\n// they don't block the queue forever.\nfunc flushCheckpointRefsQueue(ctx context.Context, repo *git.Repository, ps pushSettings) (int, error) {\n\tqueue, err := checkpoint.PushQueueForRepo(ctx, repo)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"resolve push queue: %w\", err)\n\t}\n\tqueued, err := queue.Drain()\n\tif err != nil {\npackage strategy\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/require\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/testutil\"\n)\n\n// newGloballyEnrolledPromptRepo creates a globally enrolled repo (no\n// repo-level setup) and chdirs into it. Not parallel-safe: t.Chdir + t.Setenv.\nfunc newGloballyEnrolledPromptRepo(t *testing.T, userSettingsJSON string) {\n\tt.Helper()\n\ttestutil.IsolateGitConfigEnv(t)\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\ttestutil.AddRemote(t, dir, \"origin\", \"https://github.com/acme/widgets.git\")\n\tt.Chdir(dir)\n\tenrollRepoGlobally(t, userSettingsJSON)\n}\n\n// TestResolveTrustDecision: a non-interactive pre-push holds WITHOUT\n// prompting (stdin carries git ref lines); answers persist through the same\n// writers `entire trust` uses; a failed prompt or trust write holds.\nfunc TestResolveTrustDecision(t *testing.T) {\n\taskErr := errors.New(\"trust prompt: terminal gone\")\n\tfor _, tc := range []struct {\n\t\tname           string\n\t\tunconfigured   bool // no global block: the trust write fails\n\t\tnonInteractive bool\n\t\tchoice         trustChoice\n\t\taskErr         error\n\t\twantErr        error\n\t\twant           TrustDecision\n\t\twantSource     settings.TrustSource\n\t\twantWarn       bool\n\t}{\n\t\t{name: \"non-interactive holds without prompting\", nonInteractive: true, want: TrustHeld},\n\t\t{name: \"yes persists repo trust\", choice: trustChoiceYes, want: TrustGranted, wantSource: settings.TrustSourceRepo},\n\t\t{name: \"always sets trust_all\", choice: trustChoiceAlways, want: TrustGranted, wantSource: settings.TrustSourceAll},\n\t\t{name: \"not now holds and writes nothing\", choice: trustChoiceNotNow, want: TrustHeld},\n\t\t{name: \"ask error holds and propagates\", choice: trustChoiceYes, askErr: askErr, wantErr: askErr, want: TrustHeld},\n\t\t{name: \"trust write failure warns and holds\", unconfigured: true, choice: trustChoiceYes, want: TrustHeld, wantWarn: true},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tuserSettings := `{\"global\":{\"enabled\":true}}`\n\t\t\tif tc.unconfigured {\n\t\t\t\tuserSettings = `{}`\n\t\t\t}\n\t\t\tnewGloballyEnrolledPromptRepo(t, userSettings)\n\t\t\tctx := context.Background()\n\t\t\task := func() (trustChoice, error) {\n\t\t\t\tif tc.nonInteractive {\n\t\t\t\t\tt.Fatal(\"prompt must not open in a non-interactive pre-push\")\n\t\t\t\t}\n\t\t\t\treturn tc.choice, tc.askErr\n\t\t\t}\n\n\t\t\tvar warnings bytes.Buffer\n\t\t\td, err := resolveTrustDecision(ctx, !tc.nonInteractive, ask, &warnings)\n\t\t\tif tc.wantErr != nil {\n\t\t\t\trequire.ErrorIs(t, err, tc.wantErr)\n\t\t\t} else {\n\t\t\t\trequire.NoError(t, err)\n\t\t\t}\n\t\t\trequire.Equal(t, tc.want, d)\n\t\t\tif tc.wantSource == \"\" {\n\t\t\t\ttc.wantSource = settings.TrustSourceNone\n\t\t\t}\n\t\t\trequire.Equal(t, tc.wantSource, settings.CurrentTrustSource(ctx))\n\t\t\tif tc.wantWarn {\n\t\t\t\trequire.Contains(t, warnings.String(), \"Warning\")\n\t\t\t}\n\t\t})\n\t}\n}\npackage geminicli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure GeminiCLIAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\n\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\n// Gemini concatenates hook event arrays across user and workspace scopes,\n// and the no-double-fire guarantee comes from its execution layer, which\n// deduplicates entries keyed by `name:command`\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\n// repo-level production installs write byte-identical name+command pairs, so\n// each hook executes once — but the dedup is command-sensitive: a repo-level\n// dev-mode install (localDev=true, entire-dev command form) alongside these\n// entries has same names with different commands and double-fires every\n// hook, including SessionEnd condensation.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".gemini\", GeminiSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form; preserves every\n// unrelated key in the user settings file.\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.gemini/settings.json. A missing file is not an error.\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn uninstallHooksFromFile(ctx, settingsPath)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.gemini/settings.json — the full expected entry set in\n// current production form, so a partial install reads as not-installed,\n// doctor prompts repair, and the idempotent installer repairs it. A missing\n// file is (false, nil); an unreadable or unparseable one returns the error\n// rather than posing as \"not installed\".\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\treturn current, nil\n}\npackage claudecode\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure ClaudeCodeAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\n\n// UserSettingsPath returns the path of Claude Code's user-level settings file\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\n// .claude/settings.json.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".claude\", ClaudeSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form — byte-identical to the\n// repo-level production entries, so Claude Code's cross-scope dedup of\n// identical hook commands keeps a repo with both installs firing each hook\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\n// go-run install has different command strings at repo scope, so its hooks\n// double-fire alongside these user-level entries. It self-heals within the\n// user file: existing Entire entries in any other command form are removed\n// and re-added in the current form, so a pre-existing alternate-form entry\n// can never double-fire alongside the one this install writes. Never touches\n// user-level permissions and preserves unrelated keys.\nfunc (c *ClaudeCodeAgent) InstallUserHooks(_ context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.claude/settings.json. A missing file is not an error.\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(_ context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn uninstallHooksFromFile(settingsPath, false)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.claude/settings.json — the same completeness spec as the\n// install contract (all lifecycle hooks plus the current tool-use matchers),\n// so a partial install reads as not-installed, doctor prompts\n// repair, and the idempotent installer repairs it. A missing file is\n// (false, nil); an unreadable or unparseable one returns the error rather\n// than posing as \"not installed\".\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tsettings, err := loadClaudeSettingsFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tif !hasEntireHook(settings.Hooks.SessionStart) ||\n\t\t!hasEntireHook(settings.Hooks.SessionEnd) ||\n\t\t!hasEntireHook(settings.Hooks.UserPromptSubmit) ||\n\t\t!hasEntireHook(settings.Hooks.Stop) ||\n\t\t!hasEntireHook(settings.Hooks.SubagentStop) {\n\t\treturn false, nil\n\t}\n\tsubagentTools := splitMatcherTools(subagentToolMatcher)\n\ttaskTools := splitMatcherTools(taskToolMatcher)\n\treturn hasEntireHookCoveringTools(settings.Hooks.PreToolUse, subagentTools) &&\n\t\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, subagentTools) &&\n\t\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, taskTools), nil\n}\n","stderr":"","aggregated_output":"package strategy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\n\t\"charm.land/huh/v2\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/uiform\"\n)\n\n// TrustDecision is the resolved egress-trust outcome for a single pre-push in\n// a globally enrolled repo.\ntype TrustDecision int\n\nconst (\n\tTrustHeld    TrustDecision = iota // checkpoints stay local this push; re-ask next push\n\tTrustGranted                      // consent recorded — the caller re-evaluates the gate, never reuses this as a boolean\n)\n\ntype trustChoice string\n\nconst (\n\ttrustChoiceYes    trustChoice = \"yes\"\n\ttrustChoiceNotNow trustChoice = \"not_now\"\n\ttrustChoiceAlways trustChoice = \"always\"\n)\n\n// resolveTrustDecision holds without prompting when there is no user to ask,\n// otherwise asks and persists the answer. ask is injected for tests.\nfunc resolveTrustDecision(ctx context.Context, hasTTY bool, ask func() (trustChoice, error), errOut io.Writer) (TrustDecision, error) {\n\tif !hasTTY {\n\t\treturn TrustHeld, nil\n\t}\n\tchoice, err := ask()\n\tif err != nil {\n\t\treturn TrustHeld, err\n\t}\n\treturn applyTrustChoice(ctx, choice, errOut), nil\n}\n\n// resolveTrustDecisionForPrePush is the production wiring: TTY detection plus\n// the real uiform prompt. errOut receives persistence-failure warnings.\nfunc resolveTrustDecisionForPrePush(ctx context.Context, errOut io.Writer) (TrustDecision, error) {\n\treturn resolveTrustDecision(ctx, interactive.CanPromptInteractively(),\n\t\tfunc() (trustChoice, error) { return askTrustPrompt(ctx) }, errOut)\n}\n\n// applyTrustChoice persists the user's answer. A write failure warns and\n// holds — never an error, which the pre-push hook would turn into a failed\n// user push.\nfunc applyTrustChoice(ctx context.Context, choice trustChoice, errOut io.Writer) TrustDecision {\n\tswitch choice {\n\tcase trustChoiceYes:\n\t\t// The same writer bare `entire trust` uses (one consent key shape).\n\t\tif _, err := settings.TrustCurrentRepo(ctx); err != nil {\n\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust for this repo: %v\\n\", err)\n\t\t\treturn TrustHeld\n\t\t}\n\t\treturn TrustGranted\n\tcase trustChoiceAlways:\n\t\tif err := settings.TrustAllRepos(ctx); err != nil {\n\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust_all: %v\\n\", err)\n\t\t\treturn TrustHeld\n\t\t}\n\t\treturn TrustGranted\n\tcase trustChoiceNotNow:\n\t\treturn TrustHeld\n\tdefault:\n\t\treturn TrustHeld\n\t}\n}\n\n// askTrustPrompt shows the three-option trust select. Pre-push stdin carries\n// git ref lines — the form reads the terminal, never stdin. Ctrl-C / abort\n// means \"not now\"; the user's push proceeds either way.\nfunc askTrustPrompt(ctx context.Context) (trustChoice, error) {\n\t// An identity error needs no handling here: TrustCurrentRepo re-derives\n\t// it and its failure is warned-and-held by applyTrustChoice.\n\tyesLabel := \"Yes — trust this repo (this folder only)\"\n\tif id, err := settings.RepoTrustIdentity(ctx); err == nil && id.OriginKeyed() {\n\t\tyesLabel = fmt.Sprintf(\"Yes — trust this repo (all clones of %s)\", id.DisplayScope())\n\t}\n\tchoice := trustChoiceYes\n\tform := uiform.New(\n\t\thuh.NewGroup(\n\t\t\thuh.NewSelect[trustChoice]().\n\t\t\t\tTitle(\"Entire captured agent sessions in this repo via global mode.\").\n\t\t\t\tDescription(\"Trust this folder and sync its checkpoints to your checkpoint sync remote?\").\n\t\t\t\tOptions(\n\t\t\t\t\thuh.NewOption(yesLabel, trustChoiceYes),\n\t\t\t\t\thuh.NewOption(\"Not now — keep capturing locally, ask again next push\", trustChoiceNotNow),\n\t\t\t\t\thuh.NewOption(\"Always — trust every repo on this machine\", trustChoiceAlways),\n\t\t\t\t).\n\t\t\t\tValue(&choice),\n\t\t),\n\t)\n\tif err := form.RunWithContext(ctx); err != nil {\n\t\tif errors.Is(err, huh.ErrUserAborted) {\n\t\t\treturn trustChoiceNotNow, nil\n\t\t}\n\t\treturn trustChoiceNotNow, fmt.Errorf(\"trust prompt: %w\", err)\n\t}\n\treturn choice, nil\n}\n\t// without blocking the user. The v1 path aborts the user's git push; here a\n\t// checkpoint-ref failure must never do that (see this function's doc), so\n\t// failing closed means withholding the flush — nothing un-OPF'd ships, the\n\t// refs stay queued, and the user's push proceeds.\n\tif redact.OPFEnabled() && !runOPFForCheckpointRefs(ctx, repo) {\n\t\treturn nil\n\t}\n\n\tif flushed, err := flushCheckpointRefsQueue(ctx, repo, ps); err == nil {\n\t\t// Delivered, and only if something actually was: an empty queue pushed\n\t\t// nothing, so it must not move the election or announce that it had.\n\t\tif pendingCapture != \"\" && flushed > 0 {\n\t\t\tcommitCapturedSyncRemote(ctx, pendingCapture)\n\t\t}\n\t} else {\n\t\t// Fail-soft: a checkpoint-ref push failure must never block the user's\n\t\t// git push. The refs stay queued for the next pre-push.\n\t\tlogging.Warn(ctx, \"git-refs pre-push: checkpoint ref push failed; refs left queued\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\tcleanupPushedShadowBranches(ctx)\n\treturn nil\n}\n\n// PushQueuedCheckpointRefs pushes any queued checkpoint refs to the configured\n// checkpoint remote, surfacing errors (unlike the fail-soft pre-push path); the\n// caller owns the repo. It returns the number of refs pushed and whether\n// pushing is disabled in settings — a distinct signal from pushed==0 with\n// pushing enabled (an empty queue), so callers can report the two accurately.\n// Like the pre-push paths, a checkpoint policy that blocks pushing errors with\n// the refs left queued. Currently used by the checkpoint migration command's\n// opt-in \"push now\".\nfunc PushQueuedCheckpointRefs(ctx context.Context, repo *git.Repository, remote string) (pushed int, pushDisabled bool, err error) {\n\tps := resolvePushSettings(ctx, remote)\n\tif ps.pushDisabled {\n\t\treturn 0, true, nil\n\t}\n\t// Second egress entry point (bypasses prePush): same trust gate, no\n\t// prompt; refs stay queued for after `entire trust`.\n\tif !settings.CheckpointEgressAllowed(ctx) {\n\t\treturn 0, false, errors.New(\"checkpoint sync is held — this repo isn't trusted yet; refs stay queued — run `entire trust` first\")\n\t}\n\tsyncCheckpointPolicyForPrePush(ctx, repo, ps)\n\tif !checkpointPolicyAllowsGitHook(ctx, repo) {\n\t\treturn 0, false, errors.New(\"checkpoint policy does not allow pushing checkpoint refs; refs stay queued\")\n\t}\n\tpushed, err = flushCheckpointRefsQueue(ctx, repo, ps)\n\t// Clean up even on a partial/failed flush: a diverged batch can push some\n\t// refs and still return an error, and the shadow branches for the refs that\n\t// *did* land must still be cleaned up — parity with the pre-push path, which\n\t// always runs cleanup after flush regardless of its error.\n\tcleanupPushedShadowBranches(ctx)\n\treturn pushed, false, err\n}\n\n// flushCheckpointRefsQueue drains the push-discovery queue and batch-pushes the\n// recorded refs fast-forward-only, recovering a diverged ref by fetch+replay and\n// removing from the queue only the refs that land. It returns the number pushed.\n//\n// Shared by the git-refs pre-push path (which logs and ignores the error to\n// never block the user's push) and the migration command's opt-in push (which\n// surfaces it). Stale entries — refs no longer present locally — are pruned so\n// they don't block the queue forever.\nfunc flushCheckpointRefsQueue(ctx context.Context, repo *git.Repository, ps pushSettings) (int, error) {\n\tqueue, err := checkpoint.PushQueueForRepo(ctx, repo)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"resolve push queue: %w\", err)\n\t}\n\tqueued, err := queue.Drain()\n\tif err != nil {\npackage strategy\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/require\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/testutil\"\n)\n\n// newGloballyEnrolledPromptRepo creates a globally enrolled repo (no\n// repo-level setup) and chdirs into it. Not parallel-safe: t.Chdir + t.Setenv.\nfunc newGloballyEnrolledPromptRepo(t *testing.T, userSettingsJSON string) {\n\tt.Helper()\n\ttestutil.IsolateGitConfigEnv(t)\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\ttestutil.AddRemote(t, dir, \"origin\", \"https://github.com/acme/widgets.git\")\n\tt.Chdir(dir)\n\tenrollRepoGlobally(t, userSettingsJSON)\n}\n\n// TestResolveTrustDecision: a non-interactive pre-push holds WITHOUT\n// prompting (stdin carries git ref lines); answers persist through the same\n// writers `entire trust` uses; a failed prompt or trust write holds.\nfunc TestResolveTrustDecision(t *testing.T) {\n\taskErr := errors.New(\"trust prompt: terminal gone\")\n\tfor _, tc := range []struct {\n\t\tname           string\n\t\tunconfigured   bool // no global block: the trust write fails\n\t\tnonInteractive bool\n\t\tchoice         trustChoice\n\t\taskErr         error\n\t\twantErr        error\n\t\twant           TrustDecision\n\t\twantSource     settings.TrustSource\n\t\twantWarn       bool\n\t}{\n\t\t{name: \"non-interactive holds without prompting\", nonInteractive: true, want: TrustHeld},\n\t\t{name: \"yes persists repo trust\", choice: trustChoiceYes, want: TrustGranted, wantSource: settings.TrustSourceRepo},\n\t\t{name: \"always sets trust_all\", choice: trustChoiceAlways, want: TrustGranted, wantSource: settings.TrustSourceAll},\n\t\t{name: \"not now holds and writes nothing\", choice: trustChoiceNotNow, want: TrustHeld},\n\t\t{name: \"ask error holds and propagates\", choice: trustChoiceYes, askErr: askErr, wantErr: askErr, want: TrustHeld},\n\t\t{name: \"trust write failure warns and holds\", unconfigured: true, choice: trustChoiceYes, want: TrustHeld, wantWarn: true},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tuserSettings := `{\"global\":{\"enabled\":true}}`\n\t\t\tif tc.unconfigured {\n\t\t\t\tuserSettings = `{}`\n\t\t\t}\n\t\t\tnewGloballyEnrolledPromptRepo(t, userSettings)\n\t\t\tctx := context.Background()\n\t\t\task := func() (trustChoice, error) {\n\t\t\t\tif tc.nonInteractive {\n\t\t\t\t\tt.Fatal(\"prompt must not open in a non-interactive pre-push\")\n\t\t\t\t}\n\t\t\t\treturn tc.choice, tc.askErr\n\t\t\t}\n\n\t\t\tvar warnings bytes.Buffer\n\t\t\td, err := resolveTrustDecision(ctx, !tc.nonInteractive, ask, &warnings)\n\t\t\tif tc.wantErr != nil {\n\t\t\t\trequire.ErrorIs(t, err, tc.wantErr)\n\t\t\t} else {\n\t\t\t\trequire.NoError(t, err)\n\t\t\t}\n\t\t\trequire.Equal(t, tc.want, d)\n\t\t\tif tc.wantSource == \"\" {\n\t\t\t\ttc.wantSource = settings.TrustSourceNone\n\t\t\t}\n\t\t\trequire.Equal(t, tc.wantSource, settings.CurrentTrustSource(ctx))\n\t\t\tif tc.wantWarn {\n\t\t\t\trequire.Contains(t, warnings.String(), \"Warning\")\n\t\t\t}\n\t\t})\n\t}\n}\npackage geminicli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure GeminiCLIAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\n\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\n// Gemini concatenates hook event arrays across user and workspace scopes,\n// and the no-double-fire guarantee comes from its execution layer, which\n// deduplicates entries keyed by `name:command`\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\n// repo-level production installs write byte-identical name+command pairs, so\n// each hook executes once — but the dedup is command-sensitive: a repo-level\n// dev-mode install (localDev=true, entire-dev command form) alongside these\n// entries has same names with different commands and double-fires every\n// hook, including SessionEnd condensation.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".gemini\", GeminiSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form; preserves every\n// unrelated key in the user settings file.\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.gemini/settings.json. A missing file is not an error.\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn uninstallHooksFromFile(ctx, settingsPath)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.gemini/settings.json — the full expected entry set in\n// current production form, so a partial install reads as not-installed,\n// doctor prompts repair, and the idempotent installer repairs it. A missing\n// file is (false, nil); an unreadable or unparseable one returns the error\n// rather than posing as \"not installed\".\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\treturn current, nil\n}\npackage claudecode\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure ClaudeCodeAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\n\n// UserSettingsPath returns the path of Claude Code's user-level settings file\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\n// .claude/settings.json.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".claude\", ClaudeSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form — byte-identical to the\n// repo-level production entries, so Claude Code's cross-scope dedup of\n// identical hook commands keeps a repo with both installs firing each hook\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\n// go-run install has different command strings at repo scope, so its hooks\n// double-fire alongside these user-level entries. It self-heals within the\n// user file: existing Entire entries in any other command form are removed\n// and re-added in the current form, so a pre-existing alternate-form entry\n// can never double-fire alongside the one this install writes. Never touches\n// user-level permissions and preserves unrelated keys.\nfunc (c *ClaudeCodeAgent) InstallUserHooks(_ context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.claude/settings.json. A missing file is not an error.\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(_ context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn uninstallHooksFromFile(settingsPath, false)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.claude/settings.json — the same completeness spec as the\n// install contract (all lifecycle hooks plus the current tool-use matchers),\n// so a partial install reads as not-installed, doctor prompts\n// repair, and the idempotent installer repairs it. A missing file is\n// (false, nil); an unreadable or unparseable one returns the error rather\n// than posing as \"not installed\".\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tsettings, err := loadClaudeSettingsFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tif !hasEntireHook(settings.Hooks.SessionStart) ||\n\t\t!hasEntireHook(settings.Hooks.SessionEnd) ||\n\t\t!hasEntireHook(settings.Hooks.UserPromptSubmit) ||\n\t\t!hasEntireHook(settings.Hooks.Stop) ||\n\t\t!hasEntireHook(settings.Hooks.SubagentStop) {\n\t\treturn false, nil\n\t}\n\tsubagentTools := splitMatcherTools(subagentToolMatcher)\n\ttaskTools := splitMatcherTools(taskToolMatcher)\n\treturn hasEntireHookCoveringTools(settings.Hooks.PreToolUse, subagentTools) &&\n\t\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, subagentTools) &&\n\t\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, taskTools), nil\n}\n","exit_code":0,"duration":{"secs":0,"nanos":9625},"formatted_output":"package strategy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\n\t\"charm.land/huh/v2\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/uiform\"\n)\n\n// TrustDecision is the resolved egress-trust outcome for a single pre-push in\n// a globally enrolled repo.\ntype TrustDecision int\n\nconst (\n\tTrustHeld    TrustDecision = iota // checkpoints stay local this push; re-ask next push\n\tTrustGranted                      // consent recorded — the caller re-evaluates the gate, never reuses this as a boolean\n)\n\ntype trustChoice string\n\nconst (\n\ttrustChoiceYes    trustChoice = \"yes\"\n\ttrustChoiceNotNow trustChoice = \"not_now\"\n\ttrustChoiceAlways trustChoice = \"always\"\n)\n\n// resolveTrustDecision holds without prompting when there is no user to ask,\n// otherwise asks and persists the answer. ask is injected for tests.\nfunc resolveTrustDecision(ctx context.Context, hasTTY bool, ask func() (trustChoice, error), errOut io.Writer) (TrustDecision, error) {\n\tif !hasTTY {\n\t\treturn TrustHeld, nil\n\t}\n\tchoice, err := ask()\n\tif err != nil {\n\t\treturn TrustHeld, err\n\t}\n\treturn applyTrustChoice(ctx, choice, errOut), nil\n}\n\n// resolveTrustDecisionForPrePush is the production wiring: TTY detection plus\n// the real uiform prompt. errOut receives persistence-failure warnings.\nfunc resolveTrustDecisionForPrePush(ctx context.Context, errOut io.Writer) (TrustDecision, error) {\n\treturn resolveTrustDecision(ctx, interactive.CanPromptInteractively(),\n\t\tfunc() (trustChoice, error) { return askTrustPrompt(ctx) }, errOut)\n}\n\n// applyTrustChoice persists the user's answer. A write failure warns and\n// holds — never an error, which the pre-push hook would turn into a failed\n// user push.\nfunc applyTrustChoice(ctx context.Context, choice trustChoice, errOut io.Writer) TrustDecision {\n\tswitch choice {\n\tcase trustChoiceYes:\n\t\t// The same writer bare `entire trust` uses (one consent key shape).\n\t\tif _, err := settings.TrustCurrentRepo(ctx); err != nil {\n\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust for this repo: %v\\n\", err)\n\t\t\treturn TrustHeld\n\t\t}\n\t\treturn TrustGranted\n\tcase trustChoiceAlways:\n\t\tif err := settings.TrustAllRepos(ctx); err != nil {\n\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust_all: %v\\n\", err)\n\t\t\treturn TrustHeld\n\t\t}\n\t\treturn TrustGranted\n\tcase trustChoiceNotNow:\n\t\treturn TrustHeld\n\tdefault:\n\t\treturn TrustHeld\n\t}\n}\n\n// askTrustPrompt shows the three-option trust select. Pre-push stdin carries\n// git ref lines — the form reads the terminal, never stdin. Ctrl-C / abort\n// means \"not now\"; the user's push proceeds either way.\nfunc askTrustPrompt(ctx context.Context) (trustChoice, error) {\n\t// An identity error needs no handling here: TrustCurrentRepo re-derives\n\t// it and its failure is warned-and-held by applyTrustChoice.\n\tyesLabel := \"Yes — trust this repo (this folder only)\"\n\tif id, err := settings.RepoTrustIdentity(ctx); err == nil && id.OriginKeyed() {\n\t\tyesLabel = fmt.Sprintf(\"Yes — trust this repo (all clones of %s)\", id.DisplayScope())\n\t}\n\tchoice := trustChoiceYes\n\tform := uiform.New(\n\t\thuh.NewGroup(\n\t\t\thuh.NewSelect[trustChoice]().\n\t\t\t\tTitle(\"Entire captured agent sessions in this repo via global mode.\").\n\t\t\t\tDescription(\"Trust this folder and sync its checkpoints to your checkpoint sync remote?\").\n\t\t\t\tOptions(\n\t\t\t\t\thuh.NewOption(yesLabel, trustChoiceYes),\n\t\t\t\t\thuh.NewOption(\"Not now — keep capturing locally, ask again next push\", trustChoiceNotNow),\n\t\t\t\t\thuh.NewOption(\"Always — trust every repo on this machine\", trustChoiceAlways),\n\t\t\t\t).\n\t\t\t\tValue(&choice),\n\t\t),\n\t)\n\tif err := form.RunWithContext(ctx); err != nil {\n\t\tif errors.Is(err, huh.ErrUserAborted) {\n\t\t\treturn trustChoiceNotNow, nil\n\t\t}\n\t\treturn trustChoiceNotNow, fmt.Errorf(\"trust prompt: %w\", err)\n\t}\n\treturn choice, nil\n}\n\t// without blocking the user. The v1 path aborts the user's git push; here a\n\t// checkpoint-ref failure must never do that (see this function's doc), so\n\t// failing closed means withholding the flush — nothing un-OPF'd ships, the\n\t// refs stay queued, and the user's push proceeds.\n\tif redact.OPFEnabled() && !runOPFForCheckpointRefs(ctx, repo) {\n\t\treturn nil\n\t}\n\n\tif flushed, err := flushCheckpointRefsQueue(ctx, repo, ps); err == nil {\n\t\t// Delivered, and only if something actually was: an empty queue pushed\n\t\t// nothing, so it must not move the election or announce that it had.\n\t\tif pendingCapture != \"\" && flushed > 0 {\n\t\t\tcommitCapturedSyncRemote(ctx, pendingCapture)\n\t\t}\n\t} else {\n\t\t// Fail-soft: a checkpoint-ref push failure must never block the user's\n\t\t// git push. The refs stay queued for the next pre-push.\n\t\tlogging.Warn(ctx, \"git-refs pre-push: checkpoint ref push failed; refs left queued\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\tcleanupPushedShadowBranches(ctx)\n\treturn nil\n}\n\n// PushQueuedCheckpointRefs pushes any queued checkpoint refs to the configured\n// checkpoint remote, surfacing errors (unlike the fail-soft pre-push path); the\n// caller owns the repo. It returns the number of refs pushed and whether\n// pushing is disabled in settings — a distinct signal from pushed==0 with\n// pushing enabled (an empty queue), so callers can report the two accurately.\n// Like the pre-push paths, a checkpoint policy that blocks pushing errors with\n// the refs left queued. Currently used by the checkpoint migration command's\n// opt-in \"push now\".\nfunc PushQueuedCheckpointRefs(ctx context.Context, repo *git.Repository, remote string) (pushed int, pushDisabled bool, err error) {\n\tps := resolvePushSettings(ctx, remote)\n\tif ps.pushDisabled {\n\t\treturn 0, true, nil\n\t}\n\t// Second egress entry point (bypasses prePush): same trust gate, no\n\t// prompt; refs stay queued for after `entire trust`.\n\tif !settings.CheckpointEgressAllowed(ctx) {\n\t\treturn 0, false, errors.New(\"checkpoint sync is held — this repo isn't trusted yet; refs stay queued — run `entire trust` first\")\n\t}\n\tsyncCheckpointPolicyForPrePush(ctx, repo, ps)\n\tif !checkpointPolicyAllowsGitHook(ctx, repo) {\n\t\treturn 0, false, errors.New(\"checkpoint policy does not allow pushing checkpoint refs; refs stay queued\")\n\t}\n\tpushed, err = flushCheckpointRefsQueue(ctx, repo, ps)\n\t// Clean up even on a partial/failed flush: a diverged batch can push some\n\t// refs and still return an error, and the shadow branches for the refs that\n\t// *did* land must still be cleaned up — parity with the pre-push path, which\n\t// always runs cleanup after flush regardless of its error.\n\tcleanupPushedShadowBranches(ctx)\n\treturn pushed, false, err\n}\n\n// flushCheckpointRefsQueue drains the push-discovery queue and batch-pushes the\n// recorded refs fast-forward-only, recovering a diverged ref by fetch+replay and\n// removing from the queue only the refs that land. It returns the number pushed.\n//\n// Shared by the git-refs pre-push path (which logs and ignores the error to\n// never block the user's push) and the migration command's opt-in push (which\n// surfaces it). Stale entries — refs no longer present locally — are pruned so\n// they don't block the queue forever.\nfunc flushCheckpointRefsQueue(ctx context.Context, repo *git.Repository, ps pushSettings) (int, error) {\n\tqueue, err := checkpoint.PushQueueForRepo(ctx, repo)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"resolve push queue: %w\", err)\n\t}\n\tqueued, err := queue.Drain()\n\tif err != nil {\npackage strategy\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"testing\"\n\n\t\"github.com/stretchr/testify/require\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/testutil\"\n)\n\n// newGloballyEnrolledPromptRepo creates a globally enrolled repo (no\n// repo-level setup) and chdirs into it. Not parallel-safe: t.Chdir + t.Setenv.\nfunc newGloballyEnrolledPromptRepo(t *testing.T, userSettingsJSON string) {\n\tt.Helper()\n\ttestutil.IsolateGitConfigEnv(t)\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\ttestutil.AddRemote(t, dir, \"origin\", \"https://github.com/acme/widgets.git\")\n\tt.Chdir(dir)\n\tenrollRepoGlobally(t, userSettingsJSON)\n}\n\n// TestResolveTrustDecision: a non-interactive pre-push holds WITHOUT\n// prompting (stdin carries git ref lines); answers persist through the same\n// writers `entire trust` uses; a failed prompt or trust write holds.\nfunc TestResolveTrustDecision(t *testing.T) {\n\taskErr := errors.New(\"trust prompt: terminal gone\")\n\tfor _, tc := range []struct {\n\t\tname           string\n\t\tunconfigured   bool // no global block: the trust write fails\n\t\tnonInteractive bool\n\t\tchoice         trustChoice\n\t\taskErr         error\n\t\twantErr        error\n\t\twant           TrustDecision\n\t\twantSource     settings.TrustSource\n\t\twantWarn       bool\n\t}{\n\t\t{name: \"non-interactive holds without prompting\", nonInteractive: true, want: TrustHeld},\n\t\t{name: \"yes persists repo trust\", choice: trustChoiceYes, want: TrustGranted, wantSource: settings.TrustSourceRepo},\n\t\t{name: \"always sets trust_all\", choice: trustChoiceAlways, want: TrustGranted, wantSource: settings.TrustSourceAll},\n\t\t{name: \"not now holds and writes nothing\", choice: trustChoiceNotNow, want: TrustHeld},\n\t\t{name: \"ask error holds and propagates\", choice: trustChoiceYes, askErr: askErr, wantErr: askErr, want: TrustHeld},\n\t\t{name: \"trust write failure warns and holds\", unconfigured: true, choice: trustChoiceYes, want: TrustHeld, wantWarn: true},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tuserSettings := `{\"global\":{\"enabled\":true}}`\n\t\t\tif tc.unconfigured {\n\t\t\t\tuserSettings = `{}`\n\t\t\t}\n\t\t\tnewGloballyEnrolledPromptRepo(t, userSettings)\n\t\t\tctx := context.Background()\n\t\t\task := func() (trustChoice, error) {\n\t\t\t\tif tc.nonInteractive {\n\t\t\t\t\tt.Fatal(\"prompt must not open in a non-interactive pre-push\")\n\t\t\t\t}\n\t\t\t\treturn tc.choice, tc.askErr\n\t\t\t}\n\n\t\t\tvar warnings bytes.Buffer\n\t\t\td, err := resolveTrustDecision(ctx, !tc.nonInteractive, ask, &warnings)\n\t\t\tif tc.wantErr != nil {\n\t\t\t\trequire.ErrorIs(t, err, tc.wantErr)\n\t\t\t} else {\n\t\t\t\trequire.NoError(t, err)\n\t\t\t}\n\t\t\trequire.Equal(t, tc.want, d)\n\t\t\tif tc.wantSource == \"\" {\n\t\t\t\ttc.wantSource = settings.TrustSourceNone\n\t\t\t}\n\t\t\trequire.Equal(t, tc.wantSource, settings.CurrentTrustSource(ctx))\n\t\t\tif tc.wantWarn {\n\t\t\t\trequire.Contains(t, warnings.String(), \"Warning\")\n\t\t\t}\n\t\t})\n\t}\n}\npackage geminicli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure GeminiCLIAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\n\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\n// Gemini concatenates hook event arrays across user and workspace scopes,\n// and the no-double-fire guarantee comes from its execution layer, which\n// deduplicates entries keyed by `name:command`\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\n// repo-level production installs write byte-identical name+command pairs, so\n// each hook executes once — but the dedup is command-sensitive: a repo-level\n// dev-mode install (localDev=true, entire-dev command form) alongside these\n// entries has same names with different commands and double-fires every\n// hook, including SessionEnd condensation.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".gemini\", GeminiSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form; preserves every\n// unrelated key in the user settings file.\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.gemini/settings.json. A missing file is not an error.\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn uninstallHooksFromFile(ctx, settingsPath)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.gemini/settings.json — the full expected entry set in\n// current production form, so a partial install reads as not-installed,\n// doctor prompts repair, and the idempotent installer repairs it. A missing\n// file is (false, nil); an unreadable or unparseable one returns the error\n// rather than posing as \"not installed\".\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\treturn current, nil\n}\npackage claudecode\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure ClaudeCodeAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\n\n// UserSettingsPath returns the path of Claude Code's user-level settings file\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\n// .claude/settings.json.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".claude\", ClaudeSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form — byte-identical to the\n// repo-level production entries, so Claude Code's cross-scope dedup of\n// identical hook commands keeps a repo with both installs firing each hook\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\n// go-run install has different command strings at repo scope, so its hooks\n// double-fire alongside these user-level entries. It self-heals within the\n// user file: existing Entire entries in any other command form are removed\n// and re-added in the current form, so a pre-existing alternate-form entry\n// can never double-fire alongside the one this install writes. Never touches\n// user-level permissions and preserves unrelated keys.\nfunc (c *ClaudeCodeAgent) InstallUserHooks(_ context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.claude/settings.json. A missing file is not an error.\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(_ context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn uninstallHooksFromFile(settingsPath, false)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.claude/settings.json — the same completeness spec as the\n// install contract (all lifecycle hooks plus the current tool-use matchers),\n// so a partial install reads as not-installed, doctor prompts\n// repair, and the idempotent installer repairs it. A missing file is\n// (false, nil); an unreadable or unparseable one returns the error rather\n// than posing as \"not installed\".\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tsettings, err := loadClaudeSettingsFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tif !hasEntireHook(settings.Hooks.SessionStart) ||\n\t\t!hasEntireHook(settings.Hooks.SessionEnd) ||\n\t\t!hasEntireHook(settings.Hooks.UserPromptSubmit) ||\n\t\t!hasEntireHook(settings.Hooks.Stop) ||\n\t\t!hasEntireHook(settings.Hooks.SubagentStop) {\n\t\treturn false, nil\n\t}\n\tsubagentTools := splitMatcherTools(subagentToolMatcher)\n\ttaskTools := splitMatcherTools(taskToolMatcher)\n\treturn hasEntireHookCoveringTools(settings.Hooks.PreToolUse, subagentTools) &&\n\t\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, subagentTools) &&\n\t\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, taskTools), nil\n}\n"},"started_at_ms":1787607931405,"completed_at_ms":1787607931406}}
{"timestamp":"2026-08-24T21:45:31.468Z","ordinal":9638,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a035bc-5a4c-7543-8f6e-0a064b89d8c3","call_id":"call_IY8jrGe63DAAx91j7CdmAqCA","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"749ca1\",\"wall_time_seconds\":0.000009625,\"exit_code\":0,\"original_token_count\":4248,\"output\":\"package strategy\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io\\\"\\n\\n\\t\\\"charm.land/huh/v2\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/interactive\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/settings\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/uiform\\\"\\n)\\n\\n// TrustDecision is the resolved egress-trust outcome for a single pre-push in\\n// a globally enrolled repo.\\ntype TrustDecision int\\n\\nconst (\\n\\tTrustHeld    TrustDecision = iota // checkpoints stay local this push; re-ask next push\\n\\tTrustGranted                      // consent recorded — the caller re-evaluates the gate, never reuses this as a boolean\\n)\\n\\ntype trustChoice string\\n\\nconst (\\n\\ttrustChoiceYes    trustChoice = \\\"yes\\\"\\n\\ttrustChoiceNotNow trustChoice = \\\"not_now\\\"\\n\\ttrustChoiceAlways trustChoice = \\\"always\\\"\\n)\\n\\n// resolveTrustDecision holds without prompting when there is no user to ask,\\n// otherwise asks and persists the answer. ask is injected for tests.\\nfunc resolveTrustDecision(ctx context.Context, hasTTY bool, ask func() (trustChoice, error), errOut io.Writer) (TrustDecision, error) {\\n\\tif !hasTTY {\\n\\t\\treturn TrustHeld, nil\\n\\t}\\n\\tchoice, err := ask()\\n\\tif err != nil {\\n\\t\\treturn TrustHeld, err\\n\\t}\\n\\treturn applyTrustChoice(ctx, choice, errOut), nil\\n}\\n\\n// resolveTrustDecisionForPrePush is the production wiring: TTY detection plus\\n// the real uiform prompt. errOut receives persistence-failure warnings.\\nfunc resolveTrustDecisionForPrePush(ctx context.Context, errOut io.Writer) (TrustDecision, error) {\\n\\treturn resolveTrustDecision(ctx, interactive.CanPromptInteractively(),\\n\\t\\tfunc() (trustChoice, error) { return askTrustPrompt(ctx) }, errOut)\\n}\\n\\n// applyTrustChoice persists the user's answer. A write failure warns and\\n// holds — never an error, which the pre-push hook would turn into a failed\\n// user push.\\nfunc applyTrustChoice(ctx context.Context, choice trustChoice, errOut io.Writer) TrustDecision {\\n\\tswitch choice {\\n\\tcase trustChoiceYes:\\n\\t\\t// The same writer bare `entire trust` uses (one consent key shape).\\n\\t\\tif _, err := settings.TrustCurrentRepo(ctx); err != nil {\\n\\t\\t\\tfmt.Fprintf(errOut, \\\"Warning: couldn't save trust for this repo: %v\\\\n\\\", err)\\n\\t\\t\\treturn TrustHeld\\n\\t\\t}\\n\\t\\treturn TrustGranted\\n\\tcase trustChoiceAlways:\\n\\t\\tif err := settings.TrustAllRepos(ctx); err != nil {\\n\\t\\t\\tfmt.Fprintf(errOut, \\\"Warning: couldn't save trust_all: %v\\\\n\\\", err)\\n\\t\\t\\treturn TrustHeld\\n\\t\\t}\\n\\t\\treturn TrustGranted\\n\\tcase trustChoiceNotNow:\\n\\t\\treturn TrustHeld\\n\\tdefault:\\n\\t\\treturn TrustHeld\\n\\t}\\n}\\n\\n// askTrustPrompt shows the three-option trust select. Pre-push stdin carries\\n// git ref lines — the form reads the terminal, never stdin. Ctrl-C / abort\\n// means \\\"not now\\\"; the user's push proceeds either way.\\nfunc askTrustPrompt(ctx context.Context) (trustChoice, error) {\\n\\t// An identity error needs no handling here: TrustCurrentRepo re-derives\\n\\t// it and its failure is warned-and-held by applyTrustChoice.\\n\\tyesLabel := \\\"Yes — trust this repo (this folder only)\\\"\\n\\tif id, err := settings.RepoTrustIdentity(ctx); err == nil && id.OriginKeyed() {\\n\\t\\tyesLabel = fmt.Sprintf(\\\"Yes — trust this repo (all clones of %s)\\\", id.DisplayScope())\\n\\t}\\n\\tchoice := trustChoiceYes\\n\\tform := uiform.New(\\n\\t\\thuh.NewGroup(\\n\\t\\t\\thuh.NewSelect[trustChoice]().\\n\\t\\t\\t\\tTitle(\\\"Entire captured agent sessions in this repo via global mode.\\\").\\n\\t\\t\\t\\tDescription(\\\"Trust this folder and sync its checkpoints to your checkpoint sync remote?\\\").\\n\\t\\t\\t\\tOptions(\\n\\t\\t\\t\\t\\thuh.NewOption(yesLabel, trustChoiceYes),\\n\\t\\t\\t\\t\\thuh.NewOption(\\\"Not now — keep capturing locally, ask again next push\\\", trustChoiceNotNow),\\n\\t\\t\\t\\t\\thuh.NewOption(\\\"Always — trust every repo on this machine\\\", trustChoiceAlways),\\n\\t\\t\\t\\t).\\n\\t\\t\\t\\tValue(&choice),\\n\\t\\t),\\n\\t)\\n\\tif err := form.RunWithContext(ctx); err != nil {\\n\\t\\tif errors.Is(err, huh.ErrUserAborted) {\\n\\t\\t\\treturn trustChoiceNotNow, nil\\n\\t\\t}\\n\\t\\treturn trustChoiceNotNow, fmt.Errorf(\\\"trust prompt: %w\\\", err)\\n\\t}\\n\\treturn choice, nil\\n}\\n\\t// without blocking the user. The v1 path aborts the user's git push; here a\\n\\t// checkpoint-ref failure must never do that (see this function's doc), so\\n\\t// failing closed means withholding the flush — nothing un-OPF'd ships, the\\n\\t// refs stay queued, and the user's push proceeds.\\n\\tif redact.OPFEnabled() && !runOPFForCheckpointRefs(ctx, repo) {\\n\\t\\treturn nil\\n\\t}\\n\\n\\tif flushed, err := flushCheckpointRefsQueue(ctx, repo, ps); err == nil {\\n\\t\\t// Delivered, and only if something actually was: an empty queue pushed\\n\\t\\t// nothing, so it must not move the election or announce that it had.\\n\\t\\tif pendingCapture != \\\"\\\" && flushed > 0 {\\n\\t\\t\\tcommitCapturedSyncRemote(ctx, pendingCapture)\\n\\t\\t}\\n\\t} else {\\n\\t\\t// Fail-soft: a checkpoint-ref push failure must never block the user's\\n\\t\\t// git push. The refs stay queued for the next pre-push.\\n\\t\\tlogging.Warn(ctx, \\\"git-refs pre-push: checkpoint ref push failed; refs left queued\\\",\\n\\t\\t\\tslog.String(\\\"error\\\", err.Error()))\\n\\t}\\n\\n\\tcleanupPushedShadowBranches(ctx)\\n\\treturn nil\\n}\\n\\n// PushQueuedCheckpointRefs pushes any queued checkpoint refs to the configured\\n// checkpoint remote, surfacing errors (unlike the fail-soft pre-push path); the\\n// caller owns the repo. It returns the number of refs pushed and whether\\n// pushing is disabled in settings — a distinct signal from pushed==0 with\\n// pushing enabled (an empty queue), so callers can report the two accurately.\\n// Like the pre-push paths, a checkpoint policy that blocks pushing errors with\\n// the refs left queued. Currently used by the checkpoint migration command's\\n// opt-in \\\"push now\\\".\\nfunc PushQueuedCheckpointRefs(ctx context.Context, repo *git.Repository, remote string) (pushed int, pushDisabled bool, err error) {\\n\\tps := resolvePushSettings(ctx, remote)\\n\\tif ps.pushDisabled {\\n\\t\\treturn 0, true, nil\\n\\t}\\n\\t// Second egress entry point (bypasses prePush): same trust gate, no\\n\\t// prompt; refs stay queued for after `entire trust`.\\n\\tif !settings.CheckpointEgressAllowed(ctx) {\\n\\t\\treturn 0, false, errors.New(\\\"checkpoint sync is held — this repo isn't trusted yet; refs stay queued — run `entire trust` first\\\")\\n\\t}\\n\\tsyncCheckpointPolicyForPrePush(ctx, repo, ps)\\n\\tif !checkpointPolicyAllowsGitHook(ctx, repo) {\\n\\t\\treturn 0, false, errors.New(\\\"checkpoint policy does not allow pushing checkpoint refs; refs stay queued\\\")\\n\\t}\\n\\tpushed, err = flushCheckpointRefsQueue(ctx, repo, ps)\\n\\t// Clean up even on a partial/failed flush: a diverged batch can push some\\n\\t// refs and still return an error, and the shadow branches for the refs that\\n\\t// *did* land must still be cleaned up — parity with the pre-push path, which\\n\\t// always runs cleanup after flush regardless of its error.\\n\\tcleanupPushedShadowBranches(ctx)\\n\\treturn pushed, false, err\\n}\\n\\n// flushCheckpointRefsQueue drains the push-discovery queue and batch-pushes the\\n// recorded refs fast-forward-only, recovering a diverged ref by fetch+replay and\\n// removing from the queue only the refs that land. It returns the number pushed.\\n//\\n// Shared by the git-refs pre-push path (which logs and ignores the error to\\n// never block the user's push) and the migration command's opt-in push (which\\n// surfaces it). Stale entries — refs no longer present locally — are pruned so\\n// they don't block the queue forever.\\nfunc flushCheckpointRefsQueue(ctx context.Context, repo *git.Repository, ps pushSettings) (int, error) {\\n\\tqueue, err := checkpoint.PushQueueForRepo(ctx, repo)\\n\\tif err != nil {\\n\\t\\treturn 0, fmt.Errorf(\\\"resolve push queue: %w\\\", err)\\n\\t}\\n\\tqueued, err := queue.Drain()\\n\\tif err != nil {\\npackage strategy\\n\\nimport (\\n\\t\\\"bytes\\\"\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/stretchr/testify/require\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/settings\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/testutil\\\"\\n)\\n\\n// newGloballyEnrolledPromptRepo creates a globally enrolled repo (no\\n// repo-level setup) and chdirs into it. Not parallel-safe: t.Chdir + t.Setenv.\\nfunc newGloballyEnrolledPromptRepo(t *testing.T, userSettingsJSON string) {\\n\\tt.Helper()\\n\\ttestutil.IsolateGitConfigEnv(t)\\n\\tdir := t.TempDir()\\n\\ttestutil.InitRepo(t, dir)\\n\\ttestutil.AddRemote(t, dir, \\\"origin\\\", \\\"https://github.com/acme/widgets.git\\\")\\n\\tt.Chdir(dir)\\n\\tenrollRepoGlobally(t, userSettingsJSON)\\n}\\n\\n// TestResolveTrustDecision: a non-interactive pre-push holds WITHOUT\\n// prompting (stdin carries git ref lines); answers persist through the same\\n// writers `entire trust` uses; a failed prompt or trust write holds.\\nfunc TestResolveTrustDecision(t *testing.T) {\\n\\taskErr := errors.New(\\\"trust prompt: terminal gone\\\")\\n\\tfor _, tc := range []struct {\\n\\t\\tname           string\\n\\t\\tunconfigured   bool // no global block: the trust write fails\\n\\t\\tnonInteractive bool\\n\\t\\tchoice         trustChoice\\n\\t\\taskErr         error\\n\\t\\twantErr        error\\n\\t\\twant           TrustDecision\\n\\t\\twantSource     settings.TrustSource\\n\\t\\twantWarn       bool\\n\\t}{\\n\\t\\t{name: \\\"non-interactive holds without prompting\\\", nonInteractive: true, want: TrustHeld},\\n\\t\\t{name: \\\"yes persists repo trust\\\", choice: trustChoiceYes, want: TrustGranted, wantSource: settings.TrustSourceRepo},\\n\\t\\t{name: \\\"always sets trust_all\\\", choice: trustChoiceAlways, want: TrustGranted, wantSource: settings.TrustSourceAll},\\n\\t\\t{name: \\\"not now holds and writes nothing\\\", choice: trustChoiceNotNow, want: TrustHeld},\\n\\t\\t{name: \\\"ask error holds and propagates\\\", choice: trustChoiceYes, askErr: askErr, wantErr: askErr, want: TrustHeld},\\n\\t\\t{name: \\\"trust write failure warns and holds\\\", unconfigured: true, choice: trustChoiceYes, want: TrustHeld, wantWarn: true},\\n\\t} {\\n\\t\\tt.Run(tc.name, func(t *testing.T) {\\n\\t\\t\\tuserSettings := `{\\\"global\\\":{\\\"enabled\\\":true}}`\\n\\t\\t\\tif tc.unconfigured {\\n\\t\\t\\t\\tuserSettings = `{}`\\n\\t\\t\\t}\\n\\t\\t\\tnewGloballyEnrolledPromptRepo(t, userSettings)\\n\\t\\t\\tctx := context.Background()\\n\\t\\t\\task := func() (trustChoice, error) {\\n\\t\\t\\t\\tif tc.nonInteractive {\\n\\t\\t\\t\\t\\tt.Fatal(\\\"prompt must not open in a non-interactive pre-push\\\")\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\treturn tc.choice, tc.askErr\\n\\t\\t\\t}\\n\\n\\t\\t\\tvar warnings bytes.Buffer\\n\\t\\t\\td, err := resolveTrustDecision(ctx, !tc.nonInteractive, ask, &warnings)\\n\\t\\t\\tif tc.wantErr != nil {\\n\\t\\t\\t\\trequire.ErrorIs(t, err, tc.wantErr)\\n\\t\\t\\t} else {\\n\\t\\t\\t\\trequire.NoError(t, err)\\n\\t\\t\\t}\\n\\t\\t\\trequire.Equal(t, tc.want, d)\\n\\t\\t\\tif tc.wantSource == \\\"\\\" {\\n\\t\\t\\t\\ttc.wantSource = settings.TrustSourceNone\\n\\t\\t\\t}\\n\\t\\t\\trequire.Equal(t, tc.wantSource, settings.CurrentTrustSource(ctx))\\n\\t\\t\\tif tc.wantWarn {\\n\\t\\t\\t\\trequire.Contains(t, warnings.String(), \\\"Warning\\\")\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\npackage geminicli\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/agent\\\"\\n)\\n\\n// Ensure GeminiCLIAgent implements UserHookSupport.\\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\\n\\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\\n// Gemini concatenates hook event arrays across user and workspace scopes,\\n// and the no-double-fire guarantee comes from its execution layer, which\\n// deduplicates entries keyed by `name:command`\\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\\n// repo-level production installs write byte-identical name+command pairs, so\\n// each hook executes once — but the dedup is command-sensitive: a repo-level\\n// dev-mode install (localDev=true, entire-dev command form) alongside these\\n// entries has same names with different commands and double-fires every\\n// hook, including SessionEnd condensation.\\nfunc UserSettingsPath() (string, error) {\\n\\thome, err := os.UserHomeDir()\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"resolve user home directory: %w\\\", err)\\n\\t}\\n\\treturn filepath.Join(home, \\\".gemini\\\", GeminiSettingsFileName), nil\\n}\\n\\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\\n// fire in every repository (the user-level surface behind global tracking).\\n// Always the plain production `entire` command form; preserves every\\n// unrelated key in the user settings file.\\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn agent.UserHookInstallResult{}, err\\n\\t}\\n\\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\\n\\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\\n}\\n\\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\\n// ~/.gemini/settings.json. A missing file is not an error.\\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\treturn uninstallHooksFromFile(ctx, settingsPath)\\n}\\n\\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\\n// installed in ~/.gemini/settings.json — the full expected entry set in\\n// current production form, so a partial install reads as not-installed,\\n// doctor prompts repair, and the idempotent installer repairs it. A missing\\n// file is (false, nil); an unreadable or unparseable one returns the error\\n// rather than posing as \\\"not installed\\\".\\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn false, err\\n\\t}\\n\\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn false, nil\\n\\t\\t}\\n\\t\\treturn false, err\\n\\t}\\n\\treturn current, nil\\n}\\npackage claudecode\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/agent\\\"\\n)\\n\\n// Ensure ClaudeCodeAgent implements UserHookSupport.\\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\\n\\n// UserSettingsPath returns the path of Claude Code's user-level settings file\\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\\n// .claude/settings.json.\\nfunc UserSettingsPath() (string, error) {\\n\\thome, err := os.UserHomeDir()\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"resolve user home directory: %w\\\", err)\\n\\t}\\n\\treturn filepath.Join(home, \\\".claude\\\", ClaudeSettingsFileName), nil\\n}\\n\\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\\n// fire in every repository (the user-level surface behind global tracking).\\n// Always the plain production `entire` command form — byte-identical to the\\n// repo-level production entries, so Claude Code's cross-scope dedup of\\n// identical hook commands keeps a repo with both installs firing each hook\\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\\n// go-run install has different command strings at repo scope, so its hooks\\n// double-fire alongside these user-level entries. It self-heals within the\\n// user file: existing Entire entries in any other command form are removed\\n// and re-added in the current form, so a pre-existing alternate-form entry\\n// can never double-fire alongside the one this install writes. Never touches\\n// user-level permissions and preserves unrelated keys.\\nfunc (c *ClaudeCodeAgent) InstallUserHooks(_ context.Context) (agent.UserHookInstallResult, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn agent.UserHookInstallResult{}, err\\n\\t}\\n\\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\\n\\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\\n}\\n\\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\\n// ~/.claude/settings.json. A missing file is not an error.\\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(_ context.Context) error {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\treturn uninstallHooksFromFile(settingsPath, false)\\n}\\n\\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\\n// installed in ~/.claude/settings.json — the same completeness spec as the\\n// install contract (all lifecycle hooks plus the current tool-use matchers),\\n// so a partial install reads as not-installed, doctor prompts\\n// repair, and the idempotent installer repairs it. A missing file is\\n// (false, nil); an unreadable or unparseable one returns the error rather\\n// than posing as \\\"not installed\\\".\\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn false, err\\n\\t}\\n\\tsettings, err := loadClaudeSettingsFile(settingsPath)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn false, nil\\n\\t\\t}\\n\\t\\treturn false, err\\n\\t}\\n\\tif !hasEntireHook(settings.Hooks.SessionStart) ||\\n\\t\\t!hasEntireHook(settings.Hooks.SessionEnd) ||\\n\\t\\t!hasEntireHook(settings.Hooks.UserPromptSubmit) ||\\n\\t\\t!hasEntireHook(settings.Hooks.Stop) ||\\n\\t\\t!hasEntireHook(settings.Hooks.SubagentStop) {\\n\\t\\treturn false, nil\\n\\t}\\n\\tsubagentTools := splitMatcherTools(subagentToolMatcher)\\n\\ttaskTools := splitMatcherTools(taskToolMatcher)\\n\\treturn hasEntireHookCoveringTools(settings.Hooks.PreToolUse, subagentTools) &&\\n\\t\\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, subagentTools) &&\\n\\t\\thasEntireHookCoveringTools(settings.Hooks.PostToolUse, taskTools), nil\\n}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a035bb-e411-7b32-a380-13e06970de42","create_time":1787607931.468082}}}
