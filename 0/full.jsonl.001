serHooks_NeverWritesRepoFiles(t *testing.T) {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:275:\tif _, err := agent.InstallUserHooks(context.Background()); err != nil {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:276:\t\tt.Fatalf(\"InstallUserHooks() error = %v\", err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:289:func TestInstallUserHooks_CommandsMatchRepoProductionForms(t *testing.T) {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:295:\tif _, err := agent.InstallUserHooks(context.Background()); err != nil {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:296:\t\tt.Fatalf(\"InstallUserHooks() error = %v\", err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:321:// UninstallUserHooks deleted it).\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:333:\tif _, err := agent.InstallUserHooks(context.Background()); err != nil {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:334:\t\tt.Fatalf(\"InstallUserHooks() error = %v\", err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:339:\tif err := agent.UninstallUserHooks(context.Background()); err != nil {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:340:\t\tt.Fatalf(\"UninstallUserHooks() error = %v\", err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:356:func TestInstallUserHooks_RepairsIncompleteInstalls(t *testing.T) {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:365:\t\tres, err := agent.InstallUserHooks(context.Background())\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:367:\t\t\tt.Fatalf(\"InstallUserHooks() error = %v\", err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:384:\t\tif _, err := agent.InstallUserHooks(context.Background()); err != nil {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:385:\t\t\tt.Fatalf(\"initial InstallUserHooks() error = %v\", err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:408:\t\tif ok, err := agent.AreUserHooksInstalled(context.Background()); err != nil || ok {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:409:\t\t\tt.Fatalf(\"AreUserHooksInstalled() = (%v, %v), want (false, nil)\", ok, err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:411:\t\tres, err := agent.InstallUserHooks(context.Background())\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:413:\t\t\tt.Fatalf(\"repair InstallUserHooks() error = %v\", err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:418:\t\tif ok, err := agent.AreUserHooksInstalled(context.Background()); err != nil || !ok {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:419:\t\t\tt.Fatalf(\"AreUserHooksInstalled() after repair = (%v, %v), want (true, nil)\", ok, err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:424:func TestAreUserHooksInstalled_RequiresEveryLifecycleHook(t *testing.T) {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:429:\t\t\tif _, err := agent.InstallUserHooks(context.Background()); err != nil {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:453:\t\t\tif ok, err := agent.AreUserHooksInstalled(context.Background()); err != nil || ok {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:454:\t\t\t\tt.Fatalf(\"AreUserHooksInstalled() with %s missing = (%v, %v), want (false, nil)\", missing, ok, err)\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:462:func TestInstallUserHooks_UnparseableHookSectionErrorsCleanly(t *testing.T) {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:472:\t_, err := agent.InstallUserHooks(context.Background())\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:474:\t\tt.Fatal(\"InstallUserHooks() must error on an unparseable hook section\")\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:479:\tif err := agent.UninstallUserHooks(context.Background()); err == nil {\ncmd/entire/cli/agent/claudecode/hooks_user_test.go:480:\t\tt.Fatal(\"UninstallUserHooks() must error on an unparseable hook section\")\ncmd/entire/cli/agent/claudecode/hooks_user.go:14:// Ensure ClaudeCodeAgent implements UserHookSupport.\ncmd/entire/cli/agent/claudecode