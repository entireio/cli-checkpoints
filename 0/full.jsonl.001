{"timestamp":"2026-08-25T17:55:45.975Z","ordinal":14903,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_068dffc2438c6825016a8dd7203bb087d0b8b86b28f9c1fee6","status":"completed","call_id":"call_6njkF1GL3b7GMIDtHd2gyoOp","name":"exec","input":"const r = await tools.exec_command({\"cmd\":\"sed -n '1,380p' cmd/entire/cli/settings/repopolicy/trust.go; sed -n '1,260p' cmd/entire/cli/agent/user_hooks.go; sed -n '1,190p' cmd/entire/cli/hook_policy.go; sed -n '1,150p' cmd/entire/cli/agent/claudecode/hooks_user.go; sed -n '1,135p' cmd/entire/cli/agent/geminicli/hooks_user.go\",\"workdir\":\"/Users/peytonmontei/Documents/Documents - Peyton’s MacBook Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier\",\"yield_time_ms\":30000,\"max_output_tokens\":30000,\"login\":false});\ntext(JSON.stringify(r));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a039b7-b242-7af0-80e0-d29bf9afbbac","create_time":1787680536.288995}}}
{"timestamp":"2026-08-25T17:55:46.064Z","ordinal":14904,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a025ce-e754-7631-8467-eaa6035ba0f8","turn_id":"01a039b7-b242-7af0-80e0-d29bf9afbbac","item":{"type":"CommandExecution","id":"exec-429e54ac-30b7-4f8b-bfc0-22da25d6a451","process_id":"92868","command":["/bin/zsh","-c","sed -n '1,380p' cmd/entire/cli/settings/repopolicy/trust.go; sed -n '1,260p' cmd/entire/cli/agent/user_hooks.go; sed -n '1,190p' cmd/entire/cli/hook_policy.go; sed -n '1,150p' cmd/entire/cli/agent/claudecode/hooks_user.go; sed -n '1,135p' cmd/entire/cli/agent/geminicli/hooks_user.go"],"cwd":"file:///Users/peytonmontei/Documents/Documents%20-%20Peyton%E2%80%99s%20MacBook%20Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier","parsed_cmd":[{"type":"read","cmd":"sed -n '1,380p' cmd/entire/cli/settings/repopolicy/trust.go","name":"trust.go","path":"cmd/entire/cli/settings/repopolicy/trust.go"},{"type":"read","cmd":"sed -n '1,260p' cmd/entire/cli/agent/user_hooks.go","name":"user_hooks.go","path":"cmd/entire/cli/agent/user_hooks.go"},{"type":"read","cmd":"sed -n '1,190p' cmd/entire/cli/hook_policy.go","name":"hook_policy.go","path":"cmd/entire/cli/hook_policy.go"},{"type":"read","cmd":"sed -n '1,150p' cmd/entire/cli/agent/claudecode/hooks_user.go","name":"hooks_user.go","path":"cmd/entire/cli/agent/claudecode/hooks_user.go"},{"type":"read","cmd":"sed -n '1,135p' cmd/entire/cli/agent/geminicli/hooks_user.go","name":"hooks_user.go","path":"cmd/entire/cli/agent/geminicli/hooks_user.go"}],"source":"unified_exec_startup","status":"completed","stdout":"package repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst trustLedgerFileName = \"trust.json\"\n\n// TrustGrantLedger tracks only consent keys written by Entire for this\n// worktree. It intentionally does not mirror hand-authored user settings.\ntype TrustGrantLedger struct {\n\tVersion            int      `json:\"version\"`\n\tCanonicalWorktree  string   `json:\"canonical_worktree\"`\n\tCanonicalGitCommon string   `json:\"canonical_git_common\"`\n\tOriginKeys         []string `json:\"origin_keys,omitempty\"`\n\tPaths              []string `json:\"paths,omitempty\"`\n}\n\nfunc trustLedgerPath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), trustLedgerFileName)\n}\n\n// ResolveTrustIdentity derives an exclusive origin or path identity. A\n// configured but unparseable origin is an error; path identity is allowed only\n// when origin is absent.\nfunc ResolveTrustIdentity(ctx context.Context, repository Repository) (TrustIdentity, error) {\n\turls, fetchFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"reading origin remote: %w\", err)\n\t}\n\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"reading origin pushurl: %w\", err)\n\t}\n\turls = append(urls, pushURLs...)\n\tif fetchFound || pushFound {\n\t\tkeys := make([]string, 0, len(urls))\n\t\tfor _, raw := range urls {\n\t\t\tkey := NormalizeOrigin(raw)\n\t\t\tif key == \"\" {\n\t\t\t\treturn TrustIdentity{}, errors.New(\"configured origin cannot be normalized\")\n\t\t\t}\n\t\t\tif !slices.Contains(keys, key) {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t}\n\t\tif len(keys) == 0 {\n\t\t\treturn TrustIdentity{}, errors.New(\"configured origin has no usable URLs\")\n\t\t}\n\t\treturn TrustIdentity{OriginKeys: keys}, nil\n\t}\n\treturn TrustIdentity{Path: repository.WorktreeRoot}, nil\n}\n\n// DecideEgress computes the single trust decision stored in RepoPolicy.\nfunc DecideEgress(ctx context.Context, policy RepoPolicy, global *GlobalConfig, repository Repository) TrustDecision {\n\tif !policy.Active {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\n\t}\n\tif policy.ActivationSource == ActivationLocal {\n\t\treturn TrustDecision{Allowed: true, Source: TrustSourceLocal}\n\t}\n\tif global == nil || !global.Enabled {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\n\t}\n\tidentity, err := ResolveTrustIdentity(ctx, repository)\n\tif err != nil {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInvalidOrigin}\n\t}\n\tdecision := TrustDecision{Source: TrustSourceNone, Reason: TrustReasonUntrusted, Identity: identity}\n\tif global.TrustAll {\n\t\tdecision.Allowed = true\n\t\tdecision.Source = TrustSourceAll\n\t\tdecision.Reason = TrustReasonNone\n\t\treturn decision\n\t}\n\tif identityTrusted(ctx, global, identity) {\n\t\tdecision.Allowed = true\n\t\tdecision.Source = TrustSourceRepo\n\t\tdecision.Reason = TrustReasonNone\n\t}\n\treturn decision\n}\n\nfunc identityTrusted(ctx context.Context, global *GlobalConfig, identity TrustIdentity) bool {\n\tif identity.OriginKeyed() {\n\t\tfor _, key := range identity.OriginKeys {\n\t\t\tif !containsOrigin(global.TrustedOrigins, key) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\n\treturn err == nil && matched\n}\n\nfunc containsOrigin(entries []string, key string) bool {\n\tfor _, entry := range entries {\n\t\tif CanonicalTrustOrigin(entry) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\nfunc CanonicalTrustOrigin(value string) string {\n\treturn strings.ToLower(strings.TrimSpace(value))\n}\n\n// ReadTrustGrantLedger returns the verified machine-local grant history.\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn TrustGrantLedger{}, false, err\n\t}\n\tdata, err := os.ReadFile(trustLedgerPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn TrustGrantLedger{}, false, nil\n\t\t}\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"reading trust ledger: %w\", err)\n\t}\n\tvar ledger TrustGrantLedger\n\tif err := decodeStrict(data, &ledger); err != nil {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"parsing trust ledger: %w\", err)\n\t}\n\tif ledger.Version != recordVersion {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"unsupported trust ledger version %d\", ledger.Version)\n\t}\n\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn TrustGrantLedger{}, false, errors.New(\"trust ledger repository identity mismatch\")\n\t}\n\treturn ledger, true, nil\n}\n\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\tledger.Version = recordVersion\n\tledger.CanonicalWorktree = repository.WorktreeRoot\n\tledger.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding trust ledger: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing trust ledger: %w\", err)\n\t}\n\treturn nil\n}\npackage agent\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/flock\"\n)\n\nconst userHookLockTimeout = 5 * time.Second\n\n// AcquireUserHookConfigLock serializes a complete user-config read/modify/write\n// transaction. The bounded wait keeps foreground setup responsive while still\n// preserving unrelated concurrent agent-config edits.\nfunc AcquireUserHookConfigLock(ctx context.Context, settingsPath string) (func(), error) {\n\tif err := os.MkdirAll(filepath.Dir(settingsPath), 0o750); err != nil {\n\t\treturn nil, fmt.Errorf(\"create user hook config directory: %w\", err)\n\t}\n\tlockCtx, cancel := context.WithTimeout(ctx, userHookLockTimeout)\n\trelease, err := flock.AcquireContext(lockCtx, settingsPath+\".entire.lock\")\n\tif err != nil {\n\t\tcancel()\n\t\treturn nil, fmt.Errorf(\"lock user hook config: %w\", err)\n\t}\n\treturn func() {\n\t\trelease()\n\t\tcancel()\n\t}, nil\n}\n\n// UserHookSupport is an optional extension of HookSupport for agents whose\n// hooks can also be installed at the USER level (home-directory config) — the\n// infrastructure used by settings-driven global tracking.\n// Implement it only for agents with a verified user/repo dedup story (both\n// scopes installed must never double-fire hooks); never fake it for agents\n// without a real user-level surface. The full contract and the per-agent\n// audit live in docs/architecture/agent-integration-checklist.md under\n// \"User-Level Hook Support (Global Tracking)\".\ntype UserHookSupport interface {\n\tHookSupport\n\n\t// InstallUserHooks installs Entire's hooks in the agent's user-level\n\t// config. Idempotent: a fully current install is left untouched and\n\t// reported as the zero result.\n\tInstallUserHooks(ctx context.Context) (UserHookInstallResult, error)\n\n\t// UninstallUserHooks removes Entire's hooks (and only Entire's) from the\n\t// agent's user-level config. A missing config file is not an error.\n\tUninstallUserHooks(ctx context.Context) error\n\n\t// AreUserHooksInstalled reports whether Entire's hooks are present in the\n\t// agent's user-level config. A missing config file is (false, nil); a\n\t// config that cannot be read or parsed returns a non-nil error — callers\n\t// must not fold that into \"not installed\", which is how an EACCES-broken\n\t// config once read as a repo the installer should overwrite.\n\tAreUserHooksInstalled(ctx context.Context) (bool, error)\n}\n\n// UserHookInstallResult reports what a user-level hook install actually did,\n// so callers can tell an untouched file from a rewritten one. The zero value\n// means \"already installed, nothing written\".\ntype UserHookInstallResult struct {\n\t// Installed is the number of hook entries the install added that were not\n\t// already present in current form.\n\tInstalled int\n\t// Repaired reports that pre-existing Entire entries were rewritten\n\t// (duplicates, alternate command forms, a partial install, or legacy\n\t// config fields normalized) — the file changed even when Installed is 0,\n\t// so \"already installed\" would be dishonest.\n\tRepaired bool\n}\n\n// AsUserHookSupport returns the agent as UserHookSupport if it implements the\n// interface. Built-in-only capability: external plugin agents have no\n// user-level install protocol, so this resolves by type assertion alone.\nfunc AsUserHookSupport(ag Agent) (UserHookSupport, bool) {\n\treturn builtinCapability[UserHookSupport](ag)\n}\n\n// UserHookAgent pairs a registered agent's name with its user-level hook\n// support.\ntype UserHookAgent struct {\n\tName    types.AgentName\n\tSupport UserHookSupport\n}\n\n// UserHookSupports enumerates the registered, non-test agents by user-level\n// hook capability, in sorted name order: supports are the agents implementing\n// UserHookSupport, unsupported the remaining agent names. The single home for\n// the List→Get→skip-test-only→AsUserHookSupport walk that enable/disable,\n// status, and doctor all need.\nfunc UserHookSupports() (supports []UserHookAgent, unsupported []types.AgentName) {\n\tfor _, name := range List() {\n\t\tag, err := Get(name)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif to, ok := ag.(TestOnly); ok && to.IsTestOnly() {\n\t\t\tcontinue\n\t\t}\n\t\tif uhs, ok := AsUserHookSupport(ag); ok {\n\t\t\tsupports = append(supports, UserHookAgent{Name: name, Support: uhs})\n\t\t} else {\n\t\t\tunsupported = append(unsupported, name)\n\t\t}\n\t}\n\treturn supports, unsupported\n}\npackage cli\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings/repopolicy\"\n)\n\n// prepareHookPolicy classifies once at a hook boundary and establishes the\n// sticky runtime route only for active repositories. Every downstream policy,\n// settings, path, trust, and checkpoint-backend read consumes this snapshot.\nfunc prepareHookPolicy(ctx context.Context) (context.Context, repopolicy.RepoPolicy, error) {\n\tif policy, ok := repopolicy.RepoPolicyFromContext(ctx); ok {\n\t\treturn ctx, policy, nil\n\t}\n\tpolicy, err := repopolicy.ClassifyRepoPolicy(ctx)\n\tif err != nil {\n\t\trepository, repoErr := repopolicy.ResolveRepository(ctx)\n\t\tif repoErr == nil {\n\t\t\trebound, rebindErr := repopolicy.RebindMovedRepository(ctx, repository)\n\t\t\tif rebindErr != nil {\n\t\t\t\treturn ctx, policy, fmt.Errorf(\"recovering moved repository policy: %w\", rebindErr)\n\t\t\t}\n\t\t\tif rebound {\n\t\t\t\tpolicy, err = repopolicy.ClassifyRepoPolicy(ctx)\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ctx, policy, fmt.Errorf(\"classifying repository policy: %w\", err)\n\t\t}\n\t}\n\tif policy.Active {\n\t\tpolicy, err = repopolicy.EnsureRuntimeRoute(ctx, policy)\n\t\tif err != nil {\n\t\t\treturn ctx, policy, fmt.Errorf(\"establishing runtime route: %w\", err)\n\t\t}\n\t}\n\treturn repopolicy.WithRepoPolicy(ctx, policy), policy, nil\n}\npackage claudecode\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure ClaudeCodeAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\n\n// UserSettingsPath returns the path of Claude Code's user-level settings file\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\n// .claude/settings.json.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".claude\", ClaudeSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form — byte-identical to the\n// repo-level production entries, so Claude Code's cross-scope dedup of\n// identical hook commands keeps a repo with both installs firing each hook\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\n// go-run install has different command strings at repo scope, so its hooks\n// double-fire alongside these user-level entries. It self-heals within the\n// user file: existing Entire entries in any other command form are removed\n// and re-added in the current form, so a pre-existing alternate-form entry\n// can never double-fire alongside the one this install writes. Never touches\n// user-level permissions and preserves unrelated keys.\nfunc (c *ClaudeCodeAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, fmt.Errorf(\"lock Claude Code user hook settings: %w\", err)\n\t}\n\tdefer release()\n\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.claude/settings.json. A missing file is not an error.\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"lock Claude Code user hook settings: %w\", err)\n\t}\n\tdefer release()\n\treturn uninstallHooksFromFile(settingsPath, false)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.claude/settings.json — the same completeness spec as the\n// install contract (all lifecycle hooks plus the current tool-use matchers),\n// so a partial install reads as not-installed, doctor prompts\n// repair, and the idempotent installer repairs it. A missing file is\n// (false, nil); an unreadable or unparseable one returns the error rather\n// than posing as \"not installed\".\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tsettings, err := loadClaudeSettingsFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tsections := map[string][]ClaudeHookMatcher{\n\t\t\"SessionStart\":     settings.Hooks.SessionStart,\n\t\t\"SessionEnd\":       settings.Hooks.SessionEnd,\n\t\t\"Stop\":             settings.Hooks.Stop,\n\t\t\"SubagentStop\":     settings.Hooks.SubagentStop,\n\t\t\"UserPromptSubmit\": settings.Hooks.UserPromptSubmit,\n\t\t\"PreToolUse\":       settings.Hooks.PreToolUse,\n\t\t\"PostToolUse\":      settings.Hooks.PostToolUse,\n\t}\n\tfor _, spec := range claudeHookSpecs {\n\t\tvar present bool\n\t\tif spec.matcher == \"\" {\n\t\t\tpresent = hookCommandExists(sections[spec.section], spec.productionCommand())\n\t\t} else {\n\t\t\tpresent = hookCommandExistsWithMatcher(sections[spec.section], spec.matcher, spec.productionCommand())\n\t\t}\n\t\tif !present {\n\t\t\treturn false, nil\n\t\t}\n\t}\n\treturn true, nil\n}\npackage geminicli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure GeminiCLIAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\n\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\n// Gemini concatenates hook event arrays across user and workspace scopes,\n// and the no-double-fire guarantee comes from its execution layer, which\n// deduplicates entries keyed by `name:command`\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\n// repo-level production installs write byte-identical name+command pairs, so\n// each hook executes once — but the dedup is command-sensitive: a repo-level\n// dev-mode install (localDev=true, entire-dev command form) alongside these\n// entries has same names with different commands and double-fires every\n// hook, including SessionEnd condensation.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".gemini\", GeminiSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form; preserves every\n// unrelated key in the user settings file.\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, fmt.Errorf(\"lock Gemini CLI user hook settings: %w\", err)\n\t}\n\tdefer release()\n\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.gemini/settings.json. A missing file is not an error.\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"lock Gemini CLI user hook settings: %w\", err)\n\t}\n\tdefer release()\n\treturn uninstallHooksFromFile(ctx, settingsPath)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.gemini/settings.json — the full expected entry set in\n// current production form, so a partial install reads as not-installed,\n// doctor prompts repair, and the idempotent installer repairs it. A missing\n// file is (false, nil); an unreadable or unparseable one returns the error\n// rather than posing as \"not installed\".\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\treturn current, nil\n}\n","stderr":"","aggregated_output":"package repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst trustLedgerFileName = \"trust.json\"\n\n// TrustGrantLedger tracks only consent keys written by Entire for this\n// worktree. It intentionally does not mirror hand-authored user settings.\ntype TrustGrantLedger struct {\n\tVersion            int      `json:\"version\"`\n\tCanonicalWorktree  string   `json:\"canonical_worktree\"`\n\tCanonicalGitCommon string   `json:\"canonical_git_common\"`\n\tOriginKeys         []string `json:\"origin_keys,omitempty\"`\n\tPaths              []string `json:\"paths,omitempty\"`\n}\n\nfunc trustLedgerPath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), trustLedgerFileName)\n}\n\n// ResolveTrustIdentity derives an exclusive origin or path identity. A\n// configured but unparseable origin is an error; path identity is allowed only\n// when origin is absent.\nfunc ResolveTrustIdentity(ctx context.Context, repository Repository) (TrustIdentity, error) {\n\turls, fetchFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"reading origin remote: %w\", err)\n\t}\n\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"reading origin pushurl: %w\", err)\n\t}\n\turls = append(urls, pushURLs...)\n\tif fetchFound || pushFound {\n\t\tkeys := make([]string, 0, len(urls))\n\t\tfor _, raw := range urls {\n\t\t\tkey := NormalizeOrigin(raw)\n\t\t\tif key == \"\" {\n\t\t\t\treturn TrustIdentity{}, errors.New(\"configured origin cannot be normalized\")\n\t\t\t}\n\t\t\tif !slices.Contains(keys, key) {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t}\n\t\tif len(keys) == 0 {\n\t\t\treturn TrustIdentity{}, errors.New(\"configured origin has no usable URLs\")\n\t\t}\n\t\treturn TrustIdentity{OriginKeys: keys}, nil\n\t}\n\treturn TrustIdentity{Path: repository.WorktreeRoot}, nil\n}\n\n// DecideEgress computes the single trust decision stored in RepoPolicy.\nfunc DecideEgress(ctx context.Context, policy RepoPolicy, global *GlobalConfig, repository Repository) TrustDecision {\n\tif !policy.Active {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\n\t}\n\tif policy.ActivationSource == ActivationLocal {\n\t\treturn TrustDecision{Allowed: true, Source: TrustSourceLocal}\n\t}\n\tif global == nil || !global.Enabled {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\n\t}\n\tidentity, err := ResolveTrustIdentity(ctx, repository)\n\tif err != nil {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInvalidOrigin}\n\t}\n\tdecision := TrustDecision{Source: TrustSourceNone, Reason: TrustReasonUntrusted, Identity: identity}\n\tif global.TrustAll {\n\t\tdecision.Allowed = true\n\t\tdecision.Source = TrustSourceAll\n\t\tdecision.Reason = TrustReasonNone\n\t\treturn decision\n\t}\n\tif identityTrusted(ctx, global, identity) {\n\t\tdecision.Allowed = true\n\t\tdecision.Source = TrustSourceRepo\n\t\tdecision.Reason = TrustReasonNone\n\t}\n\treturn decision\n}\n\nfunc identityTrusted(ctx context.Context, global *GlobalConfig, identity TrustIdentity) bool {\n\tif identity.OriginKeyed() {\n\t\tfor _, key := range identity.OriginKeys {\n\t\t\tif !containsOrigin(global.TrustedOrigins, key) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\n\treturn err == nil && matched\n}\n\nfunc containsOrigin(entries []string, key string) bool {\n\tfor _, entry := range entries {\n\t\tif CanonicalTrustOrigin(entry) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\nfunc CanonicalTrustOrigin(value string) string {\n\treturn strings.ToLower(strings.TrimSpace(value))\n}\n\n// ReadTrustGrantLedger returns the verified machine-local grant history.\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn TrustGrantLedger{}, false, err\n\t}\n\tdata, err := os.ReadFile(trustLedgerPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn TrustGrantLedger{}, false, nil\n\t\t}\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"reading trust ledger: %w\", err)\n\t}\n\tvar ledger TrustGrantLedger\n\tif err := decodeStrict(data, &ledger); err != nil {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"parsing trust ledger: %w\", err)\n\t}\n\tif ledger.Version != recordVersion {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"unsupported trust ledger version %d\", ledger.Version)\n\t}\n\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn TrustGrantLedger{}, false, errors.New(\"trust ledger repository identity mismatch\")\n\t}\n\treturn ledger, true, nil\n}\n\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\tledger.Version = recordVersion\n\tledger.CanonicalWorktree = repository.WorktreeRoot\n\tledger.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding trust ledger: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing trust ledger: %w\", err)\n\t}\n\treturn nil\n}\npackage agent\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/flock\"\n)\n\nconst userHookLockTimeout = 5 * time.Second\n\n// AcquireUserHookConfigLock serializes a complete user-config read/modify/write\n// transaction. The bounded wait keeps foreground setup responsive while still\n// preserving unrelated concurrent agent-config edits.\nfunc AcquireUserHookConfigLock(ctx context.Context, settingsPath string) (func(), error) {\n\tif err := os.MkdirAll(filepath.Dir(settingsPath), 0o750); err != nil {\n\t\treturn nil, fmt.Errorf(\"create user hook config directory: %w\", err)\n\t}\n\tlockCtx, cancel := context.WithTimeout(ctx, userHookLockTimeout)\n\trelease, err := flock.AcquireContext(lockCtx, settingsPath+\".entire.lock\")\n\tif err != nil {\n\t\tcancel()\n\t\treturn nil, fmt.Errorf(\"lock user hook config: %w\", err)\n\t}\n\treturn func() {\n\t\trelease()\n\t\tcancel()\n\t}, nil\n}\n\n// UserHookSupport is an optional extension of HookSupport for agents whose\n// hooks can also be installed at the USER level (home-directory config) — the\n// infrastructure used by settings-driven global tracking.\n// Implement it only for agents with a verified user/repo dedup story (both\n// scopes installed must never double-fire hooks); never fake it for agents\n// without a real user-level surface. The full contract and the per-agent\n// audit live in docs/architecture/agent-integration-checklist.md under\n// \"User-Level Hook Support (Global Tracking)\".\ntype UserHookSupport interface {\n\tHookSupport\n\n\t// InstallUserHooks installs Entire's hooks in the agent's user-level\n\t// config. Idempotent: a fully current install is left untouched and\n\t// reported as the zero result.\n\tInstallUserHooks(ctx context.Context) (UserHookInstallResult, error)\n\n\t// UninstallUserHooks removes Entire's hooks (and only Entire's) from the\n\t// agent's user-level config. A missing config file is not an error.\n\tUninstallUserHooks(ctx context.Context) error\n\n\t// AreUserHooksInstalled reports whether Entire's hooks are present in the\n\t// agent's user-level config. A missing config file is (false, nil); a\n\t// config that cannot be read or parsed returns a non-nil error — callers\n\t// must not fold that into \"not installed\", which is how an EACCES-broken\n\t// config once read as a repo the installer should overwrite.\n\tAreUserHooksInstalled(ctx context.Context) (bool, error)\n}\n\n// UserHookInstallResult reports what a user-level hook install actually did,\n// so callers can tell an untouched file from a rewritten one. The zero value\n// means \"already installed, nothing written\".\ntype UserHookInstallResult struct {\n\t// Installed is the number of hook entries the install added that were not\n\t// already present in current form.\n\tInstalled int\n\t// Repaired reports that pre-existing Entire entries were rewritten\n\t// (duplicates, alternate command forms, a partial install, or legacy\n\t// config fields normalized) — the file changed even when Installed is 0,\n\t// so \"already installed\" would be dishonest.\n\tRepaired bool\n}\n\n// AsUserHookSupport returns the agent as UserHookSupport if it implements the\n// interface. Built-in-only capability: external plugin agents have no\n// user-level install protocol, so this resolves by type assertion alone.\nfunc AsUserHookSupport(ag Agent) (UserHookSupport, bool) {\n\treturn builtinCapability[UserHookSupport](ag)\n}\n\n// UserHookAgent pairs a registered agent's name with its user-level hook\n// support.\ntype UserHookAgent struct {\n\tName    types.AgentName\n\tSupport UserHookSupport\n}\n\n// UserHookSupports enumerates the registered, non-test agents by user-level\n// hook capability, in sorted name order: supports are the agents implementing\n// UserHookSupport, unsupported the remaining agent names. The single home for\n// the List→Get→skip-test-only→AsUserHookSupport walk that enable/disable,\n// status, and doctor all need.\nfunc UserHookSupports() (supports []UserHookAgent, unsupported []types.AgentName) {\n\tfor _, name := range List() {\n\t\tag, err := Get(name)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif to, ok := ag.(TestOnly); ok && to.IsTestOnly() {\n\t\t\tcontinue\n\t\t}\n\t\tif uhs, ok := AsUserHookSupport(ag); ok {\n\t\t\tsupports = append(supports, UserHookAgent{Name: name, Support: uhs})\n\t\t} else {\n\t\t\tunsupported = append(unsupported, name)\n\t\t}\n\t}\n\treturn supports, unsupported\n}\npackage cli\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings/repopolicy\"\n)\n\n// prepareHookPolicy classifies once at a hook boundary and establishes the\n// sticky runtime route only for active repositories. Every downstream policy,\n// settings, path, trust, and checkpoint-backend read consumes this snapshot.\nfunc prepareHookPolicy(ctx context.Context) (context.Context, repopolicy.RepoPolicy, error) {\n\tif policy, ok := repopolicy.RepoPolicyFromContext(ctx); ok {\n\t\treturn ctx, policy, nil\n\t}\n\tpolicy, err := repopolicy.ClassifyRepoPolicy(ctx)\n\tif err != nil {\n\t\trepository, repoErr := repopolicy.ResolveRepository(ctx)\n\t\tif repoErr == nil {\n\t\t\trebound, rebindErr := repopolicy.RebindMovedRepository(ctx, repository)\n\t\t\tif rebindErr != nil {\n\t\t\t\treturn ctx, policy, fmt.Errorf(\"recovering moved repository policy: %w\", rebindErr)\n\t\t\t}\n\t\t\tif rebound {\n\t\t\t\tpolicy, err = repopolicy.ClassifyRepoPolicy(ctx)\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ctx, policy, fmt.Errorf(\"classifying repository policy: %w\", err)\n\t\t}\n\t}\n\tif policy.Active {\n\t\tpolicy, err = repopolicy.EnsureRuntimeRoute(ctx, policy)\n\t\tif err != nil {\n\t\t\treturn ctx, policy, fmt.Errorf(\"establishing runtime route: %w\", err)\n\t\t}\n\t}\n\treturn repopolicy.WithRepoPolicy(ctx, policy), policy, nil\n}\npackage claudecode\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure ClaudeCodeAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\n\n// UserSettingsPath returns the path of Claude Code's user-level settings file\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\n// .claude/settings.json.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".claude\", ClaudeSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form — byte-identical to the\n// repo-level production entries, so Claude Code's cross-scope dedup of\n// identical hook commands keeps a repo with both installs firing each hook\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\n// go-run install has different command strings at repo scope, so its hooks\n// double-fire alongside these user-level entries. It self-heals within the\n// user file: existing Entire entries in any other command form are removed\n// and re-added in the current form, so a pre-existing alternate-form entry\n// can never double-fire alongside the one this install writes. Never touches\n// user-level permissions and preserves unrelated keys.\nfunc (c *ClaudeCodeAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, fmt.Errorf(\"lock Claude Code user hook settings: %w\", err)\n\t}\n\tdefer release()\n\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.claude/settings.json. A missing file is not an error.\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"lock Claude Code user hook settings: %w\", err)\n\t}\n\tdefer release()\n\treturn uninstallHooksFromFile(settingsPath, false)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.claude/settings.json — the same completeness spec as the\n// install contract (all lifecycle hooks plus the current tool-use matchers),\n// so a partial install reads as not-installed, doctor prompts\n// repair, and the idempotent installer repairs it. A missing file is\n// (false, nil); an unreadable or unparseable one returns the error rather\n// than posing as \"not installed\".\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tsettings, err := loadClaudeSettingsFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tsections := map[string][]ClaudeHookMatcher{\n\t\t\"SessionStart\":     settings.Hooks.SessionStart,\n\t\t\"SessionEnd\":       settings.Hooks.SessionEnd,\n\t\t\"Stop\":             settings.Hooks.Stop,\n\t\t\"SubagentStop\":     settings.Hooks.SubagentStop,\n\t\t\"UserPromptSubmit\": settings.Hooks.UserPromptSubmit,\n\t\t\"PreToolUse\":       settings.Hooks.PreToolUse,\n\t\t\"PostToolUse\":      settings.Hooks.PostToolUse,\n\t}\n\tfor _, spec := range claudeHookSpecs {\n\t\tvar present bool\n\t\tif spec.matcher == \"\" {\n\t\t\tpresent = hookCommandExists(sections[spec.section], spec.productionCommand())\n\t\t} else {\n\t\t\tpresent = hookCommandExistsWithMatcher(sections[spec.section], spec.matcher, spec.productionCommand())\n\t\t}\n\t\tif !present {\n\t\t\treturn false, nil\n\t\t}\n\t}\n\treturn true, nil\n}\npackage geminicli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure GeminiCLIAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\n\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\n// Gemini concatenates hook event arrays across user and workspace scopes,\n// and the no-double-fire guarantee comes from its execution layer, which\n// deduplicates entries keyed by `name:command`\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\n// repo-level production installs write byte-identical name+command pairs, so\n// each hook executes once — but the dedup is command-sensitive: a repo-level\n// dev-mode install (localDev=true, entire-dev command form) alongside these\n// entries has same names with different commands and double-fires every\n// hook, including SessionEnd condensation.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".gemini\", GeminiSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form; preserves every\n// unrelated key in the user settings file.\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, fmt.Errorf(\"lock Gemini CLI user hook settings: %w\", err)\n\t}\n\tdefer release()\n\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.gemini/settings.json. A missing file is not an error.\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"lock Gemini CLI user hook settings: %w\", err)\n\t}\n\tdefer release()\n\treturn uninstallHooksFromFile(ctx, settingsPath)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.gemini/settings.json — the full expected entry set in\n// current production form, so a partial install reads as not-installed,\n// doctor prompts repair, and the idempotent installer repairs it. A missing\n// file is (false, nil); an unreadable or unparseable one returns the error\n// rather than posing as \"not installed\".\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\treturn current, nil\n}\n","exit_code":0,"duration":{"secs":0,"nanos":7708},"formatted_output":"package repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst trustLedgerFileName = \"trust.json\"\n\n// TrustGrantLedger tracks only consent keys written by Entire for this\n// worktree. It intentionally does not mirror hand-authored user settings.\ntype TrustGrantLedger struct {\n\tVersion            int      `json:\"version\"`\n\tCanonicalWorktree  string   `json:\"canonical_worktree\"`\n\tCanonicalGitCommon string   `json:\"canonical_git_common\"`\n\tOriginKeys         []string `json:\"origin_keys,omitempty\"`\n\tPaths              []string `json:\"paths,omitempty\"`\n}\n\nfunc trustLedgerPath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), trustLedgerFileName)\n}\n\n// ResolveTrustIdentity derives an exclusive origin or path identity. A\n// configured but unparseable origin is an error; path identity is allowed only\n// when origin is absent.\nfunc ResolveTrustIdentity(ctx context.Context, repository Repository) (TrustIdentity, error) {\n\turls, fetchFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"reading origin remote: %w\", err)\n\t}\n\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"reading origin pushurl: %w\", err)\n\t}\n\turls = append(urls, pushURLs...)\n\tif fetchFound || pushFound {\n\t\tkeys := make([]string, 0, len(urls))\n\t\tfor _, raw := range urls {\n\t\t\tkey := NormalizeOrigin(raw)\n\t\t\tif key == \"\" {\n\t\t\t\treturn TrustIdentity{}, errors.New(\"configured origin cannot be normalized\")\n\t\t\t}\n\t\t\tif !slices.Contains(keys, key) {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t}\n\t\tif len(keys) == 0 {\n\t\t\treturn TrustIdentity{}, errors.New(\"configured origin has no usable URLs\")\n\t\t}\n\t\treturn TrustIdentity{OriginKeys: keys}, nil\n\t}\n\treturn TrustIdentity{Path: repository.WorktreeRoot}, nil\n}\n\n// DecideEgress computes the single trust decision stored in RepoPolicy.\nfunc DecideEgress(ctx context.Context, policy RepoPolicy, global *GlobalConfig, repository Repository) TrustDecision {\n\tif !policy.Active {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\n\t}\n\tif policy.ActivationSource == ActivationLocal {\n\t\treturn TrustDecision{Allowed: true, Source: TrustSourceLocal}\n\t}\n\tif global == nil || !global.Enabled {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\n\t}\n\tidentity, err := ResolveTrustIdentity(ctx, repository)\n\tif err != nil {\n\t\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInvalidOrigin}\n\t}\n\tdecision := TrustDecision{Source: TrustSourceNone, Reason: TrustReasonUntrusted, Identity: identity}\n\tif global.TrustAll {\n\t\tdecision.Allowed = true\n\t\tdecision.Source = TrustSourceAll\n\t\tdecision.Reason = TrustReasonNone\n\t\treturn decision\n\t}\n\tif identityTrusted(ctx, global, identity) {\n\t\tdecision.Allowed = true\n\t\tdecision.Source = TrustSourceRepo\n\t\tdecision.Reason = TrustReasonNone\n\t}\n\treturn decision\n}\n\nfunc identityTrusted(ctx context.Context, global *GlobalConfig, identity TrustIdentity) bool {\n\tif identity.OriginKeyed() {\n\t\tfor _, key := range identity.OriginKeys {\n\t\t\tif !containsOrigin(global.TrustedOrigins, key) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\n\treturn err == nil && matched\n}\n\nfunc containsOrigin(entries []string, key string) bool {\n\tfor _, entry := range entries {\n\t\tif CanonicalTrustOrigin(entry) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\nfunc CanonicalTrustOrigin(value string) string {\n\treturn strings.ToLower(strings.TrimSpace(value))\n}\n\n// ReadTrustGrantLedger returns the verified machine-local grant history.\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn TrustGrantLedger{}, false, err\n\t}\n\tdata, err := os.ReadFile(trustLedgerPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn TrustGrantLedger{}, false, nil\n\t\t}\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"reading trust ledger: %w\", err)\n\t}\n\tvar ledger TrustGrantLedger\n\tif err := decodeStrict(data, &ledger); err != nil {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"parsing trust ledger: %w\", err)\n\t}\n\tif ledger.Version != recordVersion {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"unsupported trust ledger version %d\", ledger.Version)\n\t}\n\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn TrustGrantLedger{}, false, errors.New(\"trust ledger repository identity mismatch\")\n\t}\n\treturn ledger, true, nil\n}\n\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\tledger.Version = recordVersion\n\tledger.CanonicalWorktree = repository.WorktreeRoot\n\tledger.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding trust ledger: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing trust ledger: %w\", err)\n\t}\n\treturn nil\n}\npackage agent\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/flock\"\n)\n\nconst userHookLockTimeout = 5 * time.Second\n\n// AcquireUserHookConfigLock serializes a complete user-config read/modify/write\n// transaction. The bounded wait keeps foreground setup responsive while still\n// preserving unrelated concurrent agent-config edits.\nfunc AcquireUserHookConfigLock(ctx context.Context, settingsPath string) (func(), error) {\n\tif err := os.MkdirAll(filepath.Dir(settingsPath), 0o750); err != nil {\n\t\treturn nil, fmt.Errorf(\"create user hook config directory: %w\", err)\n\t}\n\tlockCtx, cancel := context.WithTimeout(ctx, userHookLockTimeout)\n\trelease, err := flock.AcquireContext(lockCtx, settingsPath+\".entire.lock\")\n\tif err != nil {\n\t\tcancel()\n\t\treturn nil, fmt.Errorf(\"lock user hook config: %w\", err)\n\t}\n\treturn func() {\n\t\trelease()\n\t\tcancel()\n\t}, nil\n}\n\n// UserHookSupport is an optional extension of HookSupport for agents whose\n// hooks can also be installed at the USER level (home-directory config) — the\n// infrastructure used by settings-driven global tracking.\n// Implement it only for agents with a verified user/repo dedup story (both\n// scopes installed must never double-fire hooks); never fake it for agents\n// without a real user-level surface. The full contract and the per-agent\n// audit live in docs/architecture/agent-integration-checklist.md under\n// \"User-Level Hook Support (Global Tracking)\".\ntype UserHookSupport interface {\n\tHookSupport\n\n\t// InstallUserHooks installs Entire's hooks in the agent's user-level\n\t// config. Idempotent: a fully current install is left untouched and\n\t// reported as the zero result.\n\tInstallUserHooks(ctx context.Context) (UserHookInstallResult, error)\n\n\t// UninstallUserHooks removes Entire's hooks (and only Entire's) from the\n\t// agent's user-level config. A missing config file is not an error.\n\tUninstallUserHooks(ctx context.Context) error\n\n\t// AreUserHooksInstalled reports whether Entire's hooks are present in the\n\t// agent's user-level config. A missing config file is (false, nil); a\n\t// config that cannot be read or parsed returns a non-nil error — callers\n\t// must not fold that into \"not installed\", which is how an EACCES-broken\n\t// config once read as a repo the installer should overwrite.\n\tAreUserHooksInstalled(ctx context.Context) (bool, error)\n}\n\n// UserHookInstallResult reports what a user-level hook install actually did,\n// so callers can tell an untouched file from a rewritten one. The zero value\n// means \"already installed, nothing written\".\ntype UserHookInstallResult struct {\n\t// Installed is the number of hook entries the install added that were not\n\t// already present in current form.\n\tInstalled int\n\t// Repaired reports that pre-existing Entire entries were rewritten\n\t// (duplicates, alternate command forms, a partial install, or legacy\n\t// config fields normalized) — the file changed even when Installed is 0,\n\t// so \"already installed\" would be dishonest.\n\tRepaired bool\n}\n\n// AsUserHookSupport returns the agent as UserHookSupport if it implements the\n// interface. Built-in-only capability: external plugin agents have no\n// user-level install protocol, so this resolves by type assertion alone.\nfunc AsUserHookSupport(ag Agent) (UserHookSupport, bool) {\n\treturn builtinCapability[UserHookSupport](ag)\n}\n\n// UserHookAgent pairs a registered agent's name with its user-level hook\n// support.\ntype UserHookAgent struct {\n\tName    types.AgentName\n\tSupport UserHookSupport\n}\n\n// UserHookSupports enumerates the registered, non-test agents by user-level\n// hook capability, in sorted name order: supports are the agents implementing\n// UserHookSupport, unsupported the remaining agent names. The single home for\n// the List→Get→skip-test-only→AsUserHookSupport walk that enable/disable,\n// status, and doctor all need.\nfunc UserHookSupports() (supports []UserHookAgent, unsupported []types.AgentName) {\n\tfor _, name := range List() {\n\t\tag, err := Get(name)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif to, ok := ag.(TestOnly); ok && to.IsTestOnly() {\n\t\t\tcontinue\n\t\t}\n\t\tif uhs, ok := AsUserHookSupport(ag); ok {\n\t\t\tsupports = append(supports, UserHookAgent{Name: name, Support: uhs})\n\t\t} else {\n\t\t\tunsupported = append(unsupported, name)\n\t\t}\n\t}\n\treturn supports, unsupported\n}\npackage cli\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings/repopolicy\"\n)\n\n// prepareHookPolicy classifies once at a hook boundary and establishes the\n// sticky runtime route only for active repositories. Every downstream policy,\n// settings, path, trust, and checkpoint-backend read consumes this snapshot.\nfunc prepareHookPolicy(ctx context.Context) (context.Context, repopolicy.RepoPolicy, error) {\n\tif policy, ok := repopolicy.RepoPolicyFromContext(ctx); ok {\n\t\treturn ctx, policy, nil\n\t}\n\tpolicy, err := repopolicy.ClassifyRepoPolicy(ctx)\n\tif err != nil {\n\t\trepository, repoErr := repopolicy.ResolveRepository(ctx)\n\t\tif repoErr == nil {\n\t\t\trebound, rebindErr := repopolicy.RebindMovedRepository(ctx, repository)\n\t\t\tif rebindErr != nil {\n\t\t\t\treturn ctx, policy, fmt.Errorf(\"recovering moved repository policy: %w\", rebindErr)\n\t\t\t}\n\t\t\tif rebound {\n\t\t\t\tpolicy, err = repopolicy.ClassifyRepoPolicy(ctx)\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ctx, policy, fmt.Errorf(\"classifying repository policy: %w\", err)\n\t\t}\n\t}\n\tif policy.Active {\n\t\tpolicy, err = repopolicy.EnsureRuntimeRoute(ctx, policy)\n\t\tif err != nil {\n\t\t\treturn ctx, policy, fmt.Errorf(\"establishing runtime route: %w\", err)\n\t\t}\n\t}\n\treturn repopolicy.WithRepoPolicy(ctx, policy), policy, nil\n}\npackage claudecode\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure ClaudeCodeAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\n\n// UserSettingsPath returns the path of Claude Code's user-level settings file\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\n// .claude/settings.json.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".claude\", ClaudeSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form — byte-identical to the\n// repo-level production entries, so Claude Code's cross-scope dedup of\n// identical hook commands keeps a repo with both installs firing each hook\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\n// go-run install has different command strings at repo scope, so its hooks\n// double-fire alongside these user-level entries. It self-heals within the\n// user file: existing Entire entries in any other command form are removed\n// and re-added in the current form, so a pre-existing alternate-form entry\n// can never double-fire alongside the one this install writes. Never touches\n// user-level permissions and preserves unrelated keys.\nfunc (c *ClaudeCodeAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, fmt.Errorf(\"lock Claude Code user hook settings: %w\", err)\n\t}\n\tdefer release()\n\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.claude/settings.json. A missing file is not an error.\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"lock Claude Code user hook settings: %w\", err)\n\t}\n\tdefer release()\n\treturn uninstallHooksFromFile(settingsPath, false)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.claude/settings.json — the same completeness spec as the\n// install contract (all lifecycle hooks plus the current tool-use matchers),\n// so a partial install reads as not-installed, doctor prompts\n// repair, and the idempotent installer repairs it. A missing file is\n// (false, nil); an unreadable or unparseable one returns the error rather\n// than posing as \"not installed\".\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tsettings, err := loadClaudeSettingsFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tsections := map[string][]ClaudeHookMatcher{\n\t\t\"SessionStart\":     settings.Hooks.SessionStart,\n\t\t\"SessionEnd\":       settings.Hooks.SessionEnd,\n\t\t\"Stop\":             settings.Hooks.Stop,\n\t\t\"SubagentStop\":     settings.Hooks.SubagentStop,\n\t\t\"UserPromptSubmit\": settings.Hooks.UserPromptSubmit,\n\t\t\"PreToolUse\":       settings.Hooks.PreToolUse,\n\t\t\"PostToolUse\":      settings.Hooks.PostToolUse,\n\t}\n\tfor _, spec := range claudeHookSpecs {\n\t\tvar present bool\n\t\tif spec.matcher == \"\" {\n\t\t\tpresent = hookCommandExists(sections[spec.section], spec.productionCommand())\n\t\t} else {\n\t\t\tpresent = hookCommandExistsWithMatcher(sections[spec.section], spec.matcher, spec.productionCommand())\n\t\t}\n\t\tif !present {\n\t\t\treturn false, nil\n\t\t}\n\t}\n\treturn true, nil\n}\npackage geminicli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n)\n\n// Ensure GeminiCLIAgent implements UserHookSupport.\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\n\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\n// Gemini concatenates hook event arrays across user and workspace scopes,\n// and the no-double-fire guarantee comes from its execution layer, which\n// deduplicates entries keyed by `name:command`\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\n// repo-level production installs write byte-identical name+command pairs, so\n// each hook executes once — but the dedup is command-sensitive: a repo-level\n// dev-mode install (localDev=true, entire-dev command form) alongside these\n// entries has same names with different commands and double-fires every\n// hook, including SessionEnd condensation.\nfunc UserSettingsPath() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home directory: %w\", err)\n\t}\n\treturn filepath.Join(home, \".gemini\", GeminiSettingsFileName), nil\n}\n\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\n// fire in every repository (the user-level surface behind global tracking).\n// Always the plain production `entire` command form; preserves every\n// unrelated key in the user settings file.\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn agent.UserHookInstallResult{}, fmt.Errorf(\"lock Gemini CLI user hook settings: %w\", err)\n\t}\n\tdefer release()\n\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\n\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\n}\n\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\n// ~/.gemini/settings.json. A missing file is not an error.\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn err\n\t}\n\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"lock Gemini CLI user hook settings: %w\", err)\n\t}\n\tdefer release()\n\treturn uninstallHooksFromFile(ctx, settingsPath)\n}\n\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\n// installed in ~/.gemini/settings.json — the full expected entry set in\n// current production form, so a partial install reads as not-installed,\n// doctor prompts repair, and the idempotent installer repairs it. A missing\n// file is (false, nil); an unreadable or unparseable one returns the error\n// rather than posing as \"not installed\".\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\n\tsettingsPath, err := UserSettingsPath()\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\treturn current, nil\n}\n"},"started_at_ms":1787680546064,"completed_at_ms":1787680546064}}
{"timestamp":"2026-08-25T17:56:03.951Z","ordinal":14905,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03a10-a2ef-7fa0-84e9-03e379335ed4","call_id":"call_6njkF1GL3b7GMIDtHd2gyoOp","output":[{"type":"input_text","text":"Script completed\nWall time 18.0 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"5ea710\",\"wall_time_seconds\":0.000007708,\"exit_code\":0,\"original_token_count\":4748,\"output\":\"package repopolicy\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"slices\\\"\\n\\t\\\"strings\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/gitremote\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/jsonutil\\\"\\n)\\n\\nconst trustLedgerFileName = \\\"trust.json\\\"\\n\\n// TrustGrantLedger tracks only consent keys written by Entire for this\\n// worktree. It intentionally does not mirror hand-authored user settings.\\ntype TrustGrantLedger struct {\\n\\tVersion            int      `json:\\\"version\\\"`\\n\\tCanonicalWorktree  string   `json:\\\"canonical_worktree\\\"`\\n\\tCanonicalGitCommon string   `json:\\\"canonical_git_common\\\"`\\n\\tOriginKeys         []string `json:\\\"origin_keys,omitempty\\\"`\\n\\tPaths              []string `json:\\\"paths,omitempty\\\"`\\n}\\n\\nfunc trustLedgerPath(repository Repository) string {\\n\\treturn filepath.Join(registryDir(repository), trustLedgerFileName)\\n}\\n\\n// ResolveTrustIdentity derives an exclusive origin or path identity. A\\n// configured but unparseable origin is an error; path identity is allowed only\\n// when origin is absent.\\nfunc ResolveTrustIdentity(ctx context.Context, repository Repository) (TrustIdentity, error) {\\n\\turls, fetchFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \\\"origin\\\")\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, fmt.Errorf(\\\"reading origin remote: %w\\\", err)\\n\\t}\\n\\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, repository.WorktreeRoot, \\\"origin\\\")\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, fmt.Errorf(\\\"reading origin pushurl: %w\\\", err)\\n\\t}\\n\\turls = append(urls, pushURLs...)\\n\\tif fetchFound || pushFound {\\n\\t\\tkeys := make([]string, 0, len(urls))\\n\\t\\tfor _, raw := range urls {\\n\\t\\t\\tkey := NormalizeOrigin(raw)\\n\\t\\t\\tif key == \\\"\\\" {\\n\\t\\t\\t\\treturn TrustIdentity{}, errors.New(\\\"configured origin cannot be normalized\\\")\\n\\t\\t\\t}\\n\\t\\t\\tif !slices.Contains(keys, key) {\\n\\t\\t\\t\\tkeys = append(keys, key)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif len(keys) == 0 {\\n\\t\\t\\treturn TrustIdentity{}, errors.New(\\\"configured origin has no usable URLs\\\")\\n\\t\\t}\\n\\t\\treturn TrustIdentity{OriginKeys: keys}, nil\\n\\t}\\n\\treturn TrustIdentity{Path: repository.WorktreeRoot}, nil\\n}\\n\\n// DecideEgress computes the single trust decision stored in RepoPolicy.\\nfunc DecideEgress(ctx context.Context, policy RepoPolicy, global *GlobalConfig, repository Repository) TrustDecision {\\n\\tif !policy.Active {\\n\\t\\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\\n\\t}\\n\\tif policy.ActivationSource == ActivationLocal {\\n\\t\\treturn TrustDecision{Allowed: true, Source: TrustSourceLocal}\\n\\t}\\n\\tif global == nil || !global.Enabled {\\n\\t\\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInactive}\\n\\t}\\n\\tidentity, err := ResolveTrustIdentity(ctx, repository)\\n\\tif err != nil {\\n\\t\\treturn TrustDecision{Source: TrustSourceNone, Reason: TrustReasonInvalidOrigin}\\n\\t}\\n\\tdecision := TrustDecision{Source: TrustSourceNone, Reason: TrustReasonUntrusted, Identity: identity}\\n\\tif global.TrustAll {\\n\\t\\tdecision.Allowed = true\\n\\t\\tdecision.Source = TrustSourceAll\\n\\t\\tdecision.Reason = TrustReasonNone\\n\\t\\treturn decision\\n\\t}\\n\\tif identityTrusted(ctx, global, identity) {\\n\\t\\tdecision.Allowed = true\\n\\t\\tdecision.Source = TrustSourceRepo\\n\\t\\tdecision.Reason = TrustReasonNone\\n\\t}\\n\\treturn decision\\n}\\n\\nfunc identityTrusted(ctx context.Context, global *GlobalConfig, identity TrustIdentity) bool {\\n\\tif identity.OriginKeyed() {\\n\\t\\tfor _, key := range identity.OriginKeys {\\n\\t\\t\\tif !containsOrigin(global.TrustedOrigins, key) {\\n\\t\\t\\t\\treturn false\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn true\\n\\t}\\n\\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\\n\\treturn err == nil && matched\\n}\\n\\nfunc containsOrigin(entries []string, key string) bool {\\n\\tfor _, entry := range entries {\\n\\t\\tif CanonicalTrustOrigin(entry) == key {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\\nfunc CanonicalTrustOrigin(value string) string {\\n\\treturn strings.ToLower(strings.TrimSpace(value))\\n}\\n\\n// ReadTrustGrantLedger returns the verified machine-local grant history.\\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn TrustGrantLedger{}, false, err\\n\\t}\\n\\tdata, err := os.ReadFile(trustLedgerPath(repository))\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn TrustGrantLedger{}, false, nil\\n\\t\\t}\\n\\t\\treturn TrustGrantLedger{}, false, fmt.Errorf(\\\"reading trust ledger: %w\\\", err)\\n\\t}\\n\\tvar ledger TrustGrantLedger\\n\\tif err := decodeStrict(data, &ledger); err != nil {\\n\\t\\treturn TrustGrantLedger{}, false, fmt.Errorf(\\\"parsing trust ledger: %w\\\", err)\\n\\t}\\n\\tif ledger.Version != recordVersion {\\n\\t\\treturn TrustGrantLedger{}, false, fmt.Errorf(\\\"unsupported trust ledger version %d\\\", ledger.Version)\\n\\t}\\n\\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\\n\\t\\treturn TrustGrantLedger{}, false, errors.New(\\\"trust ledger repository identity mismatch\\\")\\n\\t}\\n\\treturn ledger, true, nil\\n}\\n\\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif err := ensureRegistryDir(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tledger.Version = recordVersion\\n\\tledger.CanonicalWorktree = repository.WorktreeRoot\\n\\tledger.CanonicalGitCommon = repository.GitCommonDir\\n\\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \\\"\\\", \\\"  \\\")\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"encoding trust ledger: %w\\\", err)\\n\\t}\\n\\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"writing trust ledger: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\npackage agent\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"time\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/agent/types\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/internal/flock\\\"\\n)\\n\\nconst userHookLockTimeout = 5 * time.Second\\n\\n// AcquireUserHookConfigLock serializes a complete user-config read/modify/write\\n// transaction. The bounded wait keeps foreground setup responsive while still\\n// preserving unrelated concurrent agent-config edits.\\nfunc AcquireUserHookConfigLock(ctx context.Context, settingsPath string) (func(), error) {\\n\\tif err := os.MkdirAll(filepath.Dir(settingsPath), 0o750); err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"create user hook config directory: %w\\\", err)\\n\\t}\\n\\tlockCtx, cancel := context.WithTimeout(ctx, userHookLockTimeout)\\n\\trelease, err := flock.AcquireContext(lockCtx, settingsPath+\\\".entire.lock\\\")\\n\\tif err != nil {\\n\\t\\tcancel()\\n\\t\\treturn nil, fmt.Errorf(\\\"lock user hook config: %w\\\", err)\\n\\t}\\n\\treturn func() {\\n\\t\\trelease()\\n\\t\\tcancel()\\n\\t}, nil\\n}\\n\\n// UserHookSupport is an optional extension of HookSupport for agents whose\\n// hooks can also be installed at the USER level (home-directory config) — the\\n// infrastructure used by settings-driven global tracking.\\n// Implement it only for agents with a verified user/repo dedup story (both\\n// scopes installed must never double-fire hooks); never fake it for agents\\n// without a real user-level surface. The full contract and the per-agent\\n// audit live in docs/architecture/agent-integration-checklist.md under\\n// \\\"User-Level Hook Support (Global Tracking)\\\".\\ntype UserHookSupport interface {\\n\\tHookSupport\\n\\n\\t// InstallUserHooks installs Entire's hooks in the agent's user-level\\n\\t// config. Idempotent: a fully current install is left untouched and\\n\\t// reported as the zero result.\\n\\tInstallUserHooks(ctx context.Context) (UserHookInstallResult, error)\\n\\n\\t// UninstallUserHooks removes Entire's hooks (and only Entire's) from the\\n\\t// agent's user-level config. A missing config file is not an error.\\n\\tUninstallUserHooks(ctx context.Context) error\\n\\n\\t// AreUserHooksInstalled reports whether Entire's hooks are present in the\\n\\t// agent's user-level config. A missing config file is (false, nil); a\\n\\t// config that cannot be read or parsed returns a non-nil error — callers\\n\\t// must not fold that into \\\"not installed\\\", which is how an EACCES-broken\\n\\t// config once read as a repo the installer should overwrite.\\n\\tAreUserHooksInstalled(ctx context.Context) (bool, error)\\n}\\n\\n// UserHookInstallResult reports what a user-level hook install actually did,\\n// so callers can tell an untouched file from a rewritten one. The zero value\\n// means \\\"already installed, nothing written\\\".\\ntype UserHookInstallResult struct {\\n\\t// Installed is the number of hook entries the install added that were not\\n\\t// already present in current form.\\n\\tInstalled int\\n\\t// Repaired reports that pre-existing Entire entries were rewritten\\n\\t// (duplicates, alternate command forms, a partial install, or legacy\\n\\t// config fields normalized) — the file changed even when Installed is 0,\\n\\t// so \\\"already installed\\\" would be dishonest.\\n\\tRepaired bool\\n}\\n\\n// AsUserHookSupport returns the agent as UserHookSupport if it implements the\\n// interface. Built-in-only capability: external plugin agents have no\\n// user-level install protocol, so this resolves by type assertion alone.\\nfunc AsUserHookSupport(ag Agent) (UserHookSupport, bool) {\\n\\treturn builtinCapability[UserHookSupport](ag)\\n}\\n\\n// UserHookAgent pairs a registered agent's name with its user-level hook\\n// support.\\ntype UserHookAgent struct {\\n\\tName    types.AgentName\\n\\tSupport UserHookSupport\\n}\\n\\n// UserHookSupports enumerates the registered, non-test agents by user-level\\n// hook capability, in sorted name order: supports are the agents implementing\\n// UserHookSupport, unsupported the remaining agent names. The single home for\\n// the List→Get→skip-test-only→AsUserHookSupport walk that enable/disable,\\n// status, and doctor all need.\\nfunc UserHookSupports() (supports []UserHookAgent, unsupported []types.AgentName) {\\n\\tfor _, name := range List() {\\n\\t\\tag, err := Get(name)\\n\\t\\tif err != nil {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif to, ok := ag.(TestOnly); ok && to.IsTestOnly() {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif uhs, ok := AsUserHookSupport(ag); ok {\\n\\t\\t\\tsupports = append(supports, UserHookAgent{Name: name, Support: uhs})\\n\\t\\t} else {\\n\\t\\t\\tunsupported = append(unsupported, name)\\n\\t\\t}\\n\\t}\\n\\treturn supports, unsupported\\n}\\npackage cli\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"fmt\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/settings/repopolicy\\\"\\n)\\n\\n// prepareHookPolicy classifies once at a hook boundary and establishes the\\n// sticky runtime route only for active repositories. Every downstream policy,\\n// settings, path, trust, and checkpoint-backend read consumes this snapshot.\\nfunc prepareHookPolicy(ctx context.Context) (context.Context, repopolicy.RepoPolicy, error) {\\n\\tif policy, ok := repopolicy.RepoPolicyFromContext(ctx); ok {\\n\\t\\treturn ctx, policy, nil\\n\\t}\\n\\tpolicy, err := repopolicy.ClassifyRepoPolicy(ctx)\\n\\tif err != nil {\\n\\t\\trepository, repoErr := repopolicy.ResolveRepository(ctx)\\n\\t\\tif repoErr == nil {\\n\\t\\t\\trebound, rebindErr := repopolicy.RebindMovedRepository(ctx, repository)\\n\\t\\t\\tif rebindErr != nil {\\n\\t\\t\\t\\treturn ctx, policy, fmt.Errorf(\\\"recovering moved repository policy: %w\\\", rebindErr)\\n\\t\\t\\t}\\n\\t\\t\\tif rebound {\\n\\t\\t\\t\\tpolicy, err = repopolicy.ClassifyRepoPolicy(ctx)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif err != nil {\\n\\t\\t\\treturn ctx, policy, fmt.Errorf(\\\"classifying repository policy: %w\\\", err)\\n\\t\\t}\\n\\t}\\n\\tif policy.Active {\\n\\t\\tpolicy, err = repopolicy.EnsureRuntimeRoute(ctx, policy)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn ctx, policy, fmt.Errorf(\\\"establishing runtime route: %w\\\", err)\\n\\t\\t}\\n\\t}\\n\\treturn repopolicy.WithRepoPolicy(ctx, policy), policy, nil\\n}\\npackage claudecode\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/agent\\\"\\n)\\n\\n// Ensure ClaudeCodeAgent implements UserHookSupport.\\nvar _ agent.UserHookSupport = (*ClaudeCodeAgent)(nil)\\n\\n// UserSettingsPath returns the path of Claude Code's user-level settings file\\n// (~/.claude/settings.json). It accepts the same hooks schema as the repo's\\n// .claude/settings.json.\\nfunc UserSettingsPath() (string, error) {\\n\\thome, err := os.UserHomeDir()\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"resolve user home directory: %w\\\", err)\\n\\t}\\n\\treturn filepath.Join(home, \\\".claude\\\", ClaudeSettingsFileName), nil\\n}\\n\\n// InstallUserHooks installs Entire's hooks in ~/.claude/settings.json so they\\n// fire in every repository (the user-level surface behind global tracking).\\n// Always the plain production `entire` command form — byte-identical to the\\n// repo-level production entries, so Claude Code's cross-scope dedup of\\n// identical hook commands keeps a repo with both installs firing each hook\\n// once. That dedup covers byte-identical commands ONLY: a repo whose hooks\\n// were installed with --local-dev (scripts/entire-dev form) or by a legacy\\n// go-run install has different command strings at repo scope, so its hooks\\n// double-fire alongside these user-level entries. It self-heals within the\\n// user file: existing Entire entries in any other command form are removed\\n// and re-added in the current form, so a pre-existing alternate-form entry\\n// can never double-fire alongside the one this install writes. Never touches\\n// user-level permissions and preserves unrelated keys.\\nfunc (c *ClaudeCodeAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn agent.UserHookInstallResult{}, err\\n\\t}\\n\\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\\n\\tif err != nil {\\n\\t\\treturn agent.UserHookInstallResult{}, fmt.Errorf(\\\"lock Claude Code user hook settings: %w\\\", err)\\n\\t}\\n\\tdefer release()\\n\\tcount, repaired, err := installHooksToFile(settingsPath, false, false)\\n\\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\\n}\\n\\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\\n// ~/.claude/settings.json. A missing file is not an error.\\nfunc (c *ClaudeCodeAgent) UninstallUserHooks(ctx context.Context) error {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"lock Claude Code user hook settings: %w\\\", err)\\n\\t}\\n\\tdefer release()\\n\\treturn uninstallHooksFromFile(settingsPath, false)\\n}\\n\\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\\n// installed in ~/.claude/settings.json — the same completeness spec as the\\n// install contract (all lifecycle hooks plus the current tool-use matchers),\\n// so a partial install reads as not-installed, doctor prompts\\n// repair, and the idempotent installer repairs it. A missing file is\\n// (false, nil); an unreadable or unparseable one returns the error rather\\n// than posing as \\\"not installed\\\".\\nfunc (c *ClaudeCodeAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn false, err\\n\\t}\\n\\tsettings, err := loadClaudeSettingsFile(settingsPath)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn false, nil\\n\\t\\t}\\n\\t\\treturn false, err\\n\\t}\\n\\tsections := map[string][]ClaudeHookMatcher{\\n\\t\\t\\\"SessionStart\\\":     settings.Hooks.SessionStart,\\n\\t\\t\\\"SessionEnd\\\":       settings.Hooks.SessionEnd,\\n\\t\\t\\\"Stop\\\":             settings.Hooks.Stop,\\n\\t\\t\\\"SubagentStop\\\":     settings.Hooks.SubagentStop,\\n\\t\\t\\\"UserPromptSubmit\\\": settings.Hooks.UserPromptSubmit,\\n\\t\\t\\\"PreToolUse\\\":       settings.Hooks.PreToolUse,\\n\\t\\t\\\"PostToolUse\\\":      settings.Hooks.PostToolUse,\\n\\t}\\n\\tfor _, spec := range claudeHookSpecs {\\n\\t\\tvar present bool\\n\\t\\tif spec.matcher == \\\"\\\" {\\n\\t\\t\\tpresent = hookCommandExists(sections[spec.section], spec.productionCommand())\\n\\t\\t} else {\\n\\t\\t\\tpresent = hookCommandExistsWithMatcher(sections[spec.section], spec.matcher, spec.productionCommand())\\n\\t\\t}\\n\\t\\tif !present {\\n\\t\\t\\treturn false, nil\\n\\t\\t}\\n\\t}\\n\\treturn true, nil\\n}\\npackage geminicli\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/agent\\\"\\n)\\n\\n// Ensure GeminiCLIAgent implements UserHookSupport.\\nvar _ agent.UserHookSupport = (*GeminiCLIAgent)(nil)\\n\\n// UserSettingsPath returns the path of Gemini CLI's user-level settings file\\n// (~/.gemini/settings.json). It accepts the same hooks schema as the repo's\\n// .gemini/settings.json. There is NO per-key settings precedence for hooks:\\n// Gemini concatenates hook event arrays across user and workspace scopes,\\n// and the no-double-fire guarantee comes from its execution layer, which\\n// deduplicates entries keyed by `name:command`\\n// (hookPlanner.deduplicateHooks / getHookKey in gemini-cli). Our user- and\\n// repo-level production installs write byte-identical name+command pairs, so\\n// each hook executes once — but the dedup is command-sensitive: a repo-level\\n// dev-mode install (localDev=true, entire-dev command form) alongside these\\n// entries has same names with different commands and double-fires every\\n// hook, including SessionEnd condensation.\\nfunc UserSettingsPath() (string, error) {\\n\\thome, err := os.UserHomeDir()\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"resolve user home directory: %w\\\", err)\\n\\t}\\n\\treturn filepath.Join(home, \\\".gemini\\\", GeminiSettingsFileName), nil\\n}\\n\\n// InstallUserHooks installs Entire's hooks in ~/.gemini/settings.json so they\\n// fire in every repository (the user-level surface behind global tracking).\\n// Always the plain production `entire` command form; preserves every\\n// unrelated key in the user settings file.\\nfunc (g *GeminiCLIAgent) InstallUserHooks(ctx context.Context) (agent.UserHookInstallResult, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn agent.UserHookInstallResult{}, err\\n\\t}\\n\\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\\n\\tif err != nil {\\n\\t\\treturn agent.UserHookInstallResult{}, fmt.Errorf(\\\"lock Gemini CLI user hook settings: %w\\\", err)\\n\\t}\\n\\tdefer release()\\n\\tcount, repaired, err := installHooksToFile(ctx, settingsPath, false, true)\\n\\treturn agent.UserHookInstallResult{Installed: count, Repaired: repaired}, err\\n}\\n\\n// UninstallUserHooks removes Entire's hooks (and only Entire's) from\\n// ~/.gemini/settings.json. A missing file is not an error.\\nfunc (g *GeminiCLIAgent) UninstallUserHooks(ctx context.Context) error {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\trelease, err := agent.AcquireUserHookConfigLock(ctx, settingsPath)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"lock Gemini CLI user hook settings: %w\\\", err)\\n\\t}\\n\\tdefer release()\\n\\treturn uninstallHooksFromFile(ctx, settingsPath)\\n}\\n\\n// AreUserHooksInstalled reports whether Entire's hooks are COMPLETELY\\n// installed in ~/.gemini/settings.json — the full expected entry set in\\n// current production form, so a partial install reads as not-installed,\\n// doctor prompts repair, and the idempotent installer repairs it. A missing\\n// file is (false, nil); an unreadable or unparseable one returns the error\\n// rather than posing as \\\"not installed\\\".\\nfunc (g *GeminiCLIAgent) AreUserHooksInstalled(_ context.Context) (bool, error) {\\n\\tsettingsPath, err := UserSettingsPath()\\n\\tif err != nil {\\n\\t\\treturn false, err\\n\\t}\\n\\tcurrent, err := areUserHooksCurrentInFile(settingsPath)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn false, nil\\n\\t\\t}\\n\\t\\treturn false, err\\n\\t}\\n\\treturn current, nil\\n}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a039b7-b242-7af0-80e0-d29bf9afbbac","create_time":1787680563.951324}}}
