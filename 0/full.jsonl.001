li/strategy/trust_prompt.go:68:\t\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:70:\t\treturn TrustGranted\ncmd/entire/cli/strategy/trust_prompt.go:72:\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:74:\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:78:// askTrustPrompt shows the three-option trust select. Pre-push stdin carries\ncmd/entire/cli/strategy/trust_prompt.go:81:func askTrustPrompt(ctx context.Context) (trustChoice, error) {\ncmd/entire/cli/strategy/trust_prompt.go:82:\t// An identity error needs no handling here: TrustCurrentRepo re-derives\ncmd/entire/cli/strategy/trust_prompt.go:83:\t// it and its failure is warned-and-held by applyTrustChoice.\ncmd/entire/cli/strategy/trust_prompt.go:85:\tif id, err := settings.RepoTrustIdentity(ctx); err == nil && id.OriginKeyed() {\ncmd/entire/cli/strategy/trust_prompt.go:93:\t\t\t\tDescription(\"Trust this folder and sync its checkpoints to your checkpoint sync remote?\").\ncmd/entire/cli/strategy/trust_prompt.go:96:\t\t\t\t\thuh.NewOption(\"Not now — keep capturing locally, ask again next push\", trustChoiceNotNow),\ncmd/entire/cli/strategy/trust_prompt.go:97:\t\t\t\t\thuh.NewOption(\"Always — trust every repo on this machine\", trustChoiceAlways),\ncmd/entire/cli/strategy/manual_commit_hooks.go:51:\tttyResultLinkAlways                  // Link and remember: add trailer + save \"always\" preference\ncmd/entire/cli/strategy/manual_commit_hooks.go:109:\t\treturn ttyResultLinkAlways\ncmd/entire/cli/strategy/manual_commit_hooks.go:116:// saveCommitLinkingAlways persists commit_linking = \"always\" to settings.local.json.\ncmd/entire/cli/strategy/manual_commit_hooks.go:120:func saveCommitLinkingAlways(ctx context.Context) error {\ncmd/entire/cli/strategy/manual_commit_hooks.go:141:\traw[\"commit_linking\"] = json.RawMessage(`\"` + settings.CommitLinkingAlways + `\"`)\ncmd/entire/cli/strategy/manual_commit_hooks.go:510:\t\tcase commitLinking == settings.CommitLinkingAlways:\ncmd