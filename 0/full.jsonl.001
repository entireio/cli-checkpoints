{"timestamp":"2026-09-04T05:58:27.020Z","ordinal":10637,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a06465-c2da-73f2-a18c-e3568bc720c2","turn_id":"01a06aeb-fba1-7c73-b9bd-e6c66f69b450","item":{"type":"CommandExecution","id":"exec-abe83f1f-bf60-4168-9b37-fcaf4ed1089a","process_id":"76649","command":["/bin/zsh","-lc","sed -n '45,105p' cmd/entire/cli/agent/copilotcli/copilotcli.go; sed -n '250,430p' cmd/entire/cli/strategy/manual_commit_condensation.go; sed -n '1700,1745p' cmd/entire/cli/lifecycle.go; sed -n '1,220p' docs/superpowers/specs/2026-09-03-copilot-native-subagent-tracking-design.md"],"cwd":"file:///Users/peytonmontei/Documents/Documents%20-%20Peyton%E2%80%99s%20MacBook%20Pro/entire/devenv/entireio/cli/.worktrees/subagents","parsed_cmd":[{"type":"read","cmd":"sed -n '45,105p' cmd/entire/cli/agent/copilotcli/copilotcli.go","name":"copilotcli.go","path":"cmd/entire/cli/agent/copilotcli/copilotcli.go"},{"type":"read","cmd":"sed -n '250,430p' cmd/entire/cli/strategy/manual_commit_condensation.go","name":"manual_commit_condensation.go","path":"cmd/entire/cli/strategy/manual_commit_condensation.go"},{"type":"read","cmd":"sed -n '1700,1745p' cmd/entire/cli/lifecycle.go","name":"lifecycle.go","path":"cmd/entire/cli/lifecycle.go"},{"type":"read","cmd":"sed -n '1,220p' docs/superpowers/specs/2026-09-03-copilot-native-subagent-tracking-design.md","name":"2026-09-03-copilot-native-subagent-tracking-design.md","path":"docs/superpowers/specs/2026-09-03-copilot-native-subagent-tracking-design.md"}],"source":"unified_exec_startup","status":"completed","stdout":"\treturn \"Copilot CLI - GitHub's AI-powered coding agent\"\n}\n\n// IsPreview returns true because this is a new integration.\nfunc (c *CopilotCLIAgent) IsPreview() bool { return true }\n\n// DetectPresence checks if Entire hooks are installed in the Copilot CLI config.\n// Delegates to AreHooksInstalled which checks .github/hooks/entire.json for Entire hook entries.\nfunc (c *CopilotCLIAgent) DetectPresence(ctx context.Context) (bool, error) {\n\treturn c.AreHooksInstalled(ctx)\n}\n\n// GetSessionID extracts the session ID from hook input.\nfunc (c *CopilotCLIAgent) GetSessionID(input *agent.HookInput) string {\n\treturn input.SessionID\n}\n\n// GetSessionDir returns the directory where Copilot CLI stores session transcripts.\nfunc (c *CopilotCLIAgent) GetSessionDir(_ string) (string, error) {\n\tif override := os.Getenv(\"ENTIRE_TEST_COPILOT_SESSION_DIR\"); override != \"\" {\n\t\treturn override, nil\n\t}\n\n\t// Copilot stores its config and state under COPILOT_HOME when that is set,\n\t// falling back to ~/.copilot. Honouring it points transcript resolution at\n\t// wherever the agent actually wrote, rather than at a directory it never\n\t// used — which is what a user with COPILOT_HOME set, or a harness that\n\t// isolates Copilot state per session, would otherwise get.\n\tif copilotHome := os.Getenv(\"COPILOT_HOME\"); copilotHome != \"\" {\n\t\treturn filepath.Join(copilotHome, \"session-state\"), nil\n\t}\n\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to get home directory: %w\", err)\n\t}\n\n\treturn filepath.Join(homeDir, \".copilot\", \"session-state\"), nil\n}\n\n// ResolveSessionFile returns the path to a Copilot CLI session transcript file.\n// Copilot CLI stores transcripts at <sessionDir>/<sessionId>/events.jsonl.\nfunc (c *CopilotCLIAgent) ResolveSessionFile(sessionDir, agentSessionID string) string {\n\treturn filepath.Join(sessionDir, agentSessionID, \"events.jsonl\")\n}\n\n// ProtectedDirs returns directories that Copilot CLI uses for config/state.\nfunc (c *CopilotCLIAgent) ProtectedDirs() []string {\n\treturn []string{filepath.Join(\".github\", \"hooks\")}\n}\n\n// ReadSession reads a session from Copilot CLI's storage (JSONL transcript file).\nfunc (c *CopilotCLIAgent) ReadSession(input *agent.HookInput) (*agent.AgentSession, error) {\n\tif input.SessionRef == \"\" {\n\t\treturn nil, errors.New(\"session reference (transcript path) is required\")\n\t}\n\n\tdata, err := os.ReadFile(input.SessionRef)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\tpath string,\n\traw []byte,\n) (redacted redact.RedactedBytes, assets []cpkg.TranscriptAsset, tooLarge bool, err error) {\n\tsanitized := agent.SanitizeTranscriptForStorage(ag, raw)\n\tif len(sanitized) > agent.MaxChunkSize {\n\t\tlogging.Warn(logCtx, \"subagent transcript exceeds the blob size cap; storing task without it\",\n\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\tslog.String(\"path\", path),\n\t\t\tslog.Int(\"raw_bytes\", len(raw)),\n\t\t\tslog.Int(\"sanitized_bytes\", len(sanitized)),\n\t\t\tslog.Int(\"cap\", agent.MaxChunkSize))\n\t\treturn redact.RedactedBytes{}, nil, true, nil\n\t}\n\texternalized, assets := externalizeSessionImages(ctx, logCtx, state, sanitized)\n\t// nil repo declines prefix reuse: a subagent transcript is written once per\n\t// task, not appended across checkpoints, so there is nothing to reuse.\n\tredacted, _, err = redactSessionTranscript(logCtx, nil, \"\", externalized)\n\tif err != nil {\n\t\treturn redact.RedactedBytes{}, nil, false, err\n\t}\n\treturn redacted, assets, false, nil\n}\n\n// resolveTaskTranscriptPath falls back to the agent-layout convention when a\n// task record has no declared transcript path (e.g. an agent that reports the\n// path only on some events, or a legacy record captured before an agent\n// started reporting one at all). Mirrors cli.ResolveAgentTranscriptPath,\n// which this package cannot call directly — the cli package imports strategy,\n// so the reverse import would cycle — and the logic itself is small enough\n// that duplicating it here beats introducing a new shared package for this\n// one call site (moving the transcript resolver into paths is deliberately\n// out of scope for the durable-records plan this implements).\nfunc resolveTaskTranscriptPath(state *SessionState, agentID string) string {\n\tif agentID == \"\" || state.TranscriptPath == \"\" {\n\t\treturn \"\"\n\t}\n\ttranscriptDir := filepath.Dir(state.TranscriptPath)\n\tname := paths.AgentTranscriptFileName(agentID)\n\tif nested := filepath.Join(paths.SubagentsDir(transcriptDir, state.SessionID), name); fileExists(nested) {\n\t\treturn nested\n\t}\n\tif legacy := filepath.Join(transcriptDir, name); fileExists(legacy) {\n\t\treturn legacy\n\t}\n\treturn \"\"\n}\n\n// taskTranscriptReasonUnresolvable, taskTranscriptReasonUnreadable,\n// taskTranscriptReasonEmpty, taskTranscriptReasonRedactionFailed, and\n// taskTranscriptReasonTooLarge are the stable\n// TaskPayload.TranscriptUnavailableReason categories. They deliberately\n// carry no path or underlying-error detail: task.json is pushed to\n// entire/checkpoints/v1, so a local filesystem path (which os.ReadFile's error\n// text embeds) must never end up in it. The detailed error goes only to\n// logging.Warn at the call site.\nconst (\n\ttaskTranscriptReasonUnresolvable    = \"transcript path unresolvable\"\n\ttaskTranscriptReasonUnreadable      = \"transcript unreadable\"\n\ttaskTranscriptReasonEmpty           = \"transcript empty\"\n\ttaskTranscriptReasonRedactionFailed = \"transcript redaction failed\"\n\ttaskTranscriptReasonTooLarge        = \"transcript too large\"\n)\n\n// materializeTaskRecords resolves and redacts each of state.TaskRecords'\n// subagent transcripts for storage under this checkpoint's\n// tasks/<tool-use-id>/ subtree — the durable-records materializer for #2058:\n// subagent transcripts used to die at condensation because no producer ever\n// set the (now deleted) WriteOptions.IsTask route.\n//\n// Every record is materialized on every condensation, whether completed or\n// still in flight: a completed record's transcript is stored once here and\n// then removed from session state by the caller (see resetCheckpointWindow);\n// an in-flight record's transcript-so-far is stored and the record stays so\n// the next condensation re-materializes it. A record whose transcript cannot\n// be resolved or read still produces a payload — with TranscriptUnavailableReason\n// set instead of a Transcript — so the pointer is never silently dropped.\n//\n// A record with an unsafe or empty ToolUseID, or one whose AgentID is unsafe\n// or empty at the point a transcript would be written, is skipped entirely —\n// no payload at all, not even a reason-only one: an unsafe ToolUseID has no\n// safe tasks/<id>/ directory to put a task.json under in the first place, and\n// an empty/unsafe AgentID would corrupt the agent-<id>.jsonl filename (see\n// writeTaskRecordEntries, which re-validates as a last resort). This must\n// never wedge condensation — a poisoned record produces zero payloads, not an\n// error, and the caller's normal completed-record removal\n// (resetCheckpointWindow) still drops it once completed, since a record that\n// can never materialize would otherwise retry forever.\n//\n// Task assets are appended to the incoming assets slice and returned (rather\n// than living on TaskPayload, which has no Assets field of its own) so they\n// join the checkpoint's own Assets list — see WriteOptions.Assets.\nfunc (s *ManualCommitStrategy) materializeTaskRecords(\n\tctx, logCtx context.Context,\n\tag agent.Agent,\n\tstate *SessionState,\n\tassets []cpkg.TranscriptAsset,\n) ([]cpkg.TaskPayload, []cpkg.TranscriptAsset) {\n\tif len(state.TaskRecords) == 0 {\n\t\treturn nil, assets\n\t}\n\n\tpayloads := make([]cpkg.TaskPayload, 0, len(state.TaskRecords))\n\tfor _, record := range state.TaskRecords {\n\t\tif record.ToolUseID == \"\" || validation.ValidateToolUseID(record.ToolUseID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or empty tool_use_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\tpayload := cpkg.TaskPayload{\n\t\t\tToolUseID:       record.ToolUseID,\n\t\t\tAgentID:         record.AgentID,\n\t\t\tSubagentType:    record.SubagentType,\n\t\t\tTaskDescription: record.TaskDescription,\n\t\t\tFiles:           record.Files,\n\t\t\tTokenUsage:      record.TokenUsage,\n\t\t\tStartedAt:       record.StartedAt,\n\t\t\tCompletedAt:     record.CompletedAt,\n\t\t}\n\n\t\t// Candidate transcript paths, tried in order: the agent-declared path\n\t\t// first, then the agent-layout fallback — declared paths are\n\t\t// unreliable (agents relocate/clean up transcripts), which is why the\n\t\t// fallback resolver exists at all, so a declared-but-unreadable path\n\t\t// must not short-circuit past it.\n\t\tvar candidates []string\n\t\tif record.DeclaredTranscriptPath != \"\" {\n\t\t\tcandidates = append(candidates, record.DeclaredTranscriptPath)\n\t\t}\n\t\tif fallback := resolveTaskTranscriptPath(state, record.AgentID); fallback != \"\" && fallback != record.DeclaredTranscriptPath {\n\t\t\tcandidates = append(candidates, fallback)\n\t\t}\n\t\tif len(candidates) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnresolvable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\t// A transcript is about to be read and, if valid, stored as\n\t\t// agent-<agent-id>.jsonl — the agent ID becomes part of that path, so\n\t\t// it must be present and path-safe before going any further. Skip the\n\t\t// WHOLE record rather than merely omitting the transcript: this is\n\t\t// the same \"poisoned identifier\" shape as the ToolUseID check above.\n\t\tif record.AgentID == \"\" || validation.ValidateAgentID(record.AgentID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or missing agent_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\traw, transcriptPath, readErr := readFirstTranscript(candidates)\n\t\tif readErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to read subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", readErr.Error()),\n\t\t\t)\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnreadable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif len(raw) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonEmpty\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\tredacted, taskAssets, tooLarge, prepErr := prepareTaskTranscriptForStorage(ctx, logCtx, ag, state, transcriptPath, raw)\n\t\tif tooLarge {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonTooLarge\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif prepErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to redact subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", prepErr.Error()),\n\t\t}\n\t\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\t\treturn nil\n\t}\n\tcompleted, err := strategy.CompleteTaskRecord(logCtx, event.SessionID, rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to complete task record: %w\", err)\n\t}\n\tif !completed {\n\t\t// A racing Final event won the exactly-once completion, or the session\n\t\t// state is gone (ended and swept mid-capture) — nothing was written.\n\t\tlogging.Debug(logCtx, \"task record not completed by this capture (raced or state gone)\",\n\t\t\tslog.String(\"session_id\", event.SessionID),\n\t\t\tslog.String(\"tool_use_id\", event.ToolUseID))\n\t}\n\n\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\treturn nil\n}\n\n// loadLiveTaskRecords returns sessionID's still-in-flight task records, or nil\n// when there is no state (or it cannot be read — logged, best-effort).\nfunc loadLiveTaskRecords(logCtx context.Context, sessionID string) []session.TaskRecord {\n\tstate, err := strategy.LoadSessionState(logCtx, sessionID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for in-flight task capture\",\n\t\t\tslog.String(\"session_id\", sessionID),\n\t\t\tslog.String(\"error\", err.Error()))\n\t\treturn nil\n\t}\n\tif state == nil {\n\t\treturn nil\n\t}\n\treturn state.LiveTaskRecords()\n}\n\n// completeLiveTaskRecords is the SessionEnd sweep: the session is closing with\n// these tasks still in flight, so each gets the same completion SubagentStop\n// would have performed, via the same handleSubagentStopFinal machinery (see\n// captureInFlightTaskFinal). SessionEnd is every record's last completion\n// chance, so it processes every live marker, and MUST run before the caller\n// marks the session ended and eagerly condenses (endSessionNow), so the\n// condense materializes the just-completed records.\n// Best-effort: one task's failure does not stop the others.\nfunc completeLiveTaskRecords(ctx context.Context, ag agent.Agent, sessionID, sessionRef string) {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n# Copilot CLI Native Subagent Tracking Design\n\n## Goal\n\nGive GitHub Copilot CLI the same normalized subagent lifecycle used by Claude\nCode and Codex: one correctly correlated durable task record per native child,\nincluding child metadata, files, transcript when available, and exact token\nusage when Copilot exposes it.\n\n## Current behavior\n\nEntire's Copilot adapter reflects an older CLI contract:\n\n- it installs `subagentStop` but not `subagentStart`;\n- it discards `preToolUse` and `postToolUse` payloads;\n- it converts `subagentStop` into `SubagentEnd` with only the parent session ID;\n- shared lifecycle code therefore merges all uncorrelated Copilot children into\n  the task record keyed by the empty string; and\n- its subordinate-session guard recognizes only the historical `toolu_` prefix.\n\nThis preserves parent-level file capture but is not per-child tracking.\n\nCurrent Copilot CLI documentation exposes both `subagentStart` and\n`subagentStop` for YAML-based built-in agents and custom agents. The start\npayload contains `sessionId`, `transcriptPath`, and agent metadata but no\n`agentId`; the stop payload adds `agentId`, `agentType`, and the final response.\nThe built-in `general-purpose` agent deliberately emits neither event.\n\n## Scope\n\n### In scope\n\n- Install, detect, preserve, and remove the native `subagentStart` hook.\n- Parse current camelCase Copilot CLI payloads and compatible snake_case\n  payloads without weakening existing VS Code compatibility checks.\n- Prove and use a collision-free value shared by start and stop as Entire's\n  `ToolUseID`.\n- Map stop `agentId` to `SubagentID` and retain the native child transcript path\n  only when a real current capture proves that `transcriptPath` identifies the\n  child rather than the parent.\n- Reuse the existing `SubagentStart`/`SubagentEnd`, task-record, condensation,\n  sanitization, externalization, redaction, and `tasks/` materialization paths.\n- Preserve phantom-session prevention for historical child lifecycle IDs,\n  including both observed `toolu_` and `tooluse_` spellings.\n- Validate the behavior with simulated hooks, one focused integration test,\n  the existing E2E scenario, and an end-user real Copilot smoke test.\n- Document the `general-purpose` exception truthfully.\n\n### Out of scope\n\n- Rebuilding shared task-record or checkpoint persistence.\n- Guessing child identity from task descriptions, timestamps, directory order,\n  or \"most recent\" state.\n- Claiming exact per-child tokens when Copilot exposes only a session aggregate.\n- Treating the final response text as a canonical child transcript.\n- Solving `general-purpose` through heuristic attribution. If the evidence\n  phase finds a deterministic native signal, it may be added through the same\n  tests; otherwise it remains an explicit upstream limitation and follow-up.\n- Merging any pull request.\n\n## Design\n\n### Evidence gate\n\nBefore production changes, and only after explicit authorization for a real\nCopilot invocation, run Copilot CLI 1.0.82 or newer in an isolated repository\nwith capture-only hooks. Exercise two same-type native subagents concurrently,\none writing and one read-only, and one `general-purpose` child. Record only\npayload structure, identifiers, event order, transcript locations, and token\nfields. Parallel evidence is mandatory whenever transcript-path identity is a\ncandidate correlation source.\n\nThe native implementation proceeds only if start and stop expose a stable,\none-to-one correlation source. The preferred mapping is the native child ID if\nit is present in both events. Otherwise a canonical child transcript path may\nbe converted to a path-safe deterministic digest, but only after the capture\nproves that path is stable across start/stop and unique across parallel\nchildren. Canonical store-relative layout validation must precede digesting at\nboth boundaries: equivalent spellings of one path map to one identity, while\ndistinct concurrent canonical paths remain distinct. An outside-store,\nwrong-layout, symlinked, missing, or otherwise unvalidated path creates no\nevent or marker. If neither condition holds, stop and revise the design rather\nthan ship ambiguous attribution.\n\nThe same capture must prove the ordering of child start/stop relative to parent\n`agentStop` and `sessionEnd`, when child transcript bytes become readable, and\nwhether the child transcript survives until condensation. If parent session\ntermination can precede native child stop, stop and revise the lifecycle design:\nthe current SessionEnd sweep would otherwise complete and condense a live marker\nwithout the stop's child metadata.\n\nIf transcript path is the correlation source, the capture must additionally\nshow that the canonical non-symlink child file is present and verifiable at\nboth start and stop. If child file attribution depends on transcript bytes, the\nfile must be readable at stop; otherwise the implementation pauses for a design\nthat can safely defer attribution instead of silently producing incomplete\nrecords.\n\n### Hook adapter\n\nAdd `subagent-start` beside the existing Copilot hook verbs and include the\n`subagentStart` key in installation, uninstall, idempotency, and presence/drift\ncoverage. Copilot gains a read-only `CheckHookConfig`: absent/user-only files are\nabsent, the exact managed set is current, and any managed-but-incomplete,\nstale, malformed, or unreadable configuration is outdated. Extend the\ncompatibility envelope only with fields required by the documented subagent\npayloads.\n\n`subagentStart` maps to `agent.SubagentStart` with:\n\n- the parent Copilot session as `SessionID`;\n- the proven stable correlation value as `ToolUseID`;\n- native agent name/type and description when present; and\n- the canonical child transcript as `SubagentTranscriptPath` only after\n  store-confined, no-follow validation.\n\n`subagentStop` maps to `agent.SubagentEnd` with the same `ToolUseID`, stop\n`agentId` as `SubagentID`, the parent transcript as `SessionRef`, native labels,\nand the verified child transcript path. It remains `Final: false` because\nCopilot supplies one true-completion end signal rather than Claude Code's\nlaunch-stub-plus-final pair. A narrow normalized-event marker distinguishes\nthis native start/stop lifecycle from the existing foreground PostToolUse\ncompletion path. The same marker declares that any supplied child transcript\npath is authoritative: Copilot records never probe the generic Claude-style\nsubagent layout when that path is absent, disappears, or cannot be read.\n\n### Durable capture\n\nNo new storage model is introduced. For the marked native lifecycle, generic\nstart handling adds a live `session.TaskRecord` only to an existing parent\nsession. Generic end handling requires that live record, uses only hook- or\nchild-transcript-authoritative file evidence, bypasses the no-file skip for a\nread-only child, and completes it exactly once. An unmatched, duplicate, or\nmissing/ended-parent stop is a no-op and never creates or resurrects state.\nThis path is separate from the existing Final=false foreground PostToolUse\npath, whose whole-worktree scan is unsafe for concurrent children.\n\nThe task record persists an explicit authoritative-transcript/no-fallback bit.\nCompletion merges start and stop metadata field-by-field: stop values win when\npresent, while an omitted stop field retains the start value. This includes\n`SubagentType`, `TaskDescription`, `AgentID`, the declared transcript, and its\nprovenance. Consequently, a start that lacks a description can still retain a\ndescription supplied by stop, without erasing a name learned at start.\nThe verified start transcript path is stored on the live record immediately,\nsurvives a JSON state round trip, remains when stop omits it, and is replaced\nonly by a non-empty verified stop path.\n\nCondensation writes\n`tasks/<tool-use-id>/task.json` and, when available,\n`agent-<agent-id>.jsonl`. Missing child transcripts retain a metadata record\nwith an existing path-free unavailability reason. For an authoritative Copilot\nrecord, a missing or unreadable declared path never falls through to either\n`ResolveAgentTranscriptPath` during completion or\n`resolveTaskTranscriptPath` during condensation, even if a coincidental file\nexists at the generic layout.\n\nConfinement applies to every read, not just initial hook parsing. The Copilot\nadapter performs one `SessionStore`-anchored, no-follow read at stop and derives\nboth `Event.ModifiedFiles` and exact usage from those bytes, so shared lifecycle\ncode does not reopen the path through `ExtractModifiedFilesFromOffset`.\nCondensation independently revalidates and reopens an authoritative path\nthrough `SessionStore.ReadFile`; it never sends that path to unrestricted\n`ReadTranscriptFile`/`readFirstTranscript`. A file replaced by a symlink after\nparsing or immediately before condensation therefore yields transcript\nunavailability rather than reading outside the store.\n\nExact child token usage is stored only if a canonical child transcript or\nmachine-readable per-agent usage record supplies an exact total. The Copilot\nadapter accepts usage only when the verified child transcript already contains\nthe authoritative `session.shutdown` aggregate with non-empty `modelMetrics`.\nIt uses an exact-only extractor rather than the existing calculator's partial\nassistant-message fallback, and places the result on `Event.TokenUsage` before\ndispatch. The hook path is accepted only when it resolves to the captured\ncanonical file layout beneath Copilot's session store; outside-store paths,\nsymlinks, and layout mismatches yield neither a declared child transcript nor\nchild usage. Otherwise the record's child token usage remains unavailable;\nparent session totals continue through the existing Copilot calculator and are\nnot replaced or double-counted by partial child data.\n\n### General-purpose behavior\n\nThe probe must confirm the documented absence of native start/stop hooks. The\nexisting subordinate lifecycle filter remains in place so a child cannot open\na phantom top-level Entire session. Supporting `general-purpose` requires a\nstable parent/child/call relationship under parallel execution; descriptions\nand recency are expressly insufficient.\n\nIf current Copilot re-emits a deterministic child task ID and canonical child\nsession evidence, add a narrowly scoped adapter using that identity. Otherwise\nthe PR documents the exception and does not imply parity for that built-in.\n\n## Error handling and privacy\n\n- Malformed subagent payloads return ordinary parse errors and never create a\n  partial task record.\n- Missing optional metadata degrades field-by-field.\n- Invalid or ambiguous correlation fails closed for per-child capture while\n  preserving parent-session checkpoint behavior.\n- A native stop after parent SessionEnd is skipped unless the evidence phase\n  proves and the design explicitly handles a safe retained-state ordering.\n- Logs contain identifiers, key names, counts, and paths already permitted by\n  current operational logging; never prompts, responses, or transcript text.\n- Hook output remains empty/pass-through so Entire cannot block Copilot work.\n\n## Acceptance criteria\n\n- Fresh installation includes exactly one managed `subagentStart` and one\n  managed `subagentStop`; upgrade, reinstall, and uninstall are idempotent and\n  preserve user hooks and unknown fields.\n- Two native children with the same agent type receive different stable task\n  IDs and cannot complete each other's records.\n- A writing child contributes its file and native child transcript to its own\n  durable `tasks/` subtree after a normal user commit.\n- A read-only child still produces its own durable metadata/transcript record.\n- Duplicate stop delivery does not duplicate or overwrite another child.\n- Unmatched stops and stops after missing/ended parent state create nothing.\n- Metadata present only at stop is merged into the start-created record.\n- Missing authoritative child transcripts never fall back to a generic\n  agent-layout file.\n- Partial message-only usage, unsafe paths, and symlinks (including paths\n","stderr":"","aggregated_output":"\treturn \"Copilot CLI - GitHub's AI-powered coding agent\"\n}\n\n// IsPreview returns true because this is a new integration.\nfunc (c *CopilotCLIAgent) IsPreview() bool { return true }\n\n// DetectPresence checks if Entire hooks are installed in the Copilot CLI config.\n// Delegates to AreHooksInstalled which checks .github/hooks/entire.json for Entire hook entries.\nfunc (c *CopilotCLIAgent) DetectPresence(ctx context.Context) (bool, error) {\n\treturn c.AreHooksInstalled(ctx)\n}\n\n// GetSessionID extracts the session ID from hook input.\nfunc (c *CopilotCLIAgent) GetSessionID(input *agent.HookInput) string {\n\treturn input.SessionID\n}\n\n// GetSessionDir returns the directory where Copilot CLI stores session transcripts.\nfunc (c *CopilotCLIAgent) GetSessionDir(_ string) (string, error) {\n\tif override := os.Getenv(\"ENTIRE_TEST_COPILOT_SESSION_DIR\"); override != \"\" {\n\t\treturn override, nil\n\t}\n\n\t// Copilot stores its config and state under COPILOT_HOME when that is set,\n\t// falling back to ~/.copilot. Honouring it points transcript resolution at\n\t// wherever the agent actually wrote, rather than at a directory it never\n\t// used — which is what a user with COPILOT_HOME set, or a harness that\n\t// isolates Copilot state per session, would otherwise get.\n\tif copilotHome := os.Getenv(\"COPILOT_HOME\"); copilotHome != \"\" {\n\t\treturn filepath.Join(copilotHome, \"session-state\"), nil\n\t}\n\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to get home directory: %w\", err)\n\t}\n\n\treturn filepath.Join(homeDir, \".copilot\", \"session-state\"), nil\n}\n\n// ResolveSessionFile returns the path to a Copilot CLI session transcript file.\n// Copilot CLI stores transcripts at <sessionDir>/<sessionId>/events.jsonl.\nfunc (c *CopilotCLIAgent) ResolveSessionFile(sessionDir, agentSessionID string) string {\n\treturn filepath.Join(sessionDir, agentSessionID, \"events.jsonl\")\n}\n\n// ProtectedDirs returns directories that Copilot CLI uses for config/state.\nfunc (c *CopilotCLIAgent) ProtectedDirs() []string {\n\treturn []string{filepath.Join(\".github\", \"hooks\")}\n}\n\n// ReadSession reads a session from Copilot CLI's storage (JSONL transcript file).\nfunc (c *CopilotCLIAgent) ReadSession(input *agent.HookInput) (*agent.AgentSession, error) {\n\tif input.SessionRef == \"\" {\n\t\treturn nil, errors.New(\"session reference (transcript path) is required\")\n\t}\n\n\tdata, err := os.ReadFile(input.SessionRef)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\tpath string,\n\traw []byte,\n) (redacted redact.RedactedBytes, assets []cpkg.TranscriptAsset, tooLarge bool, err error) {\n\tsanitized := agent.SanitizeTranscriptForStorage(ag, raw)\n\tif len(sanitized) > agent.MaxChunkSize {\n\t\tlogging.Warn(logCtx, \"subagent transcript exceeds the blob size cap; storing task without it\",\n\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\tslog.String(\"path\", path),\n\t\t\tslog.Int(\"raw_bytes\", len(raw)),\n\t\t\tslog.Int(\"sanitized_bytes\", len(sanitized)),\n\t\t\tslog.Int(\"cap\", agent.MaxChunkSize))\n\t\treturn redact.RedactedBytes{}, nil, true, nil\n\t}\n\texternalized, assets := externalizeSessionImages(ctx, logCtx, state, sanitized)\n\t// nil repo declines prefix reuse: a subagent transcript is written once per\n\t// task, not appended across checkpoints, so there is nothing to reuse.\n\tredacted, _, err = redactSessionTranscript(logCtx, nil, \"\", externalized)\n\tif err != nil {\n\t\treturn redact.RedactedBytes{}, nil, false, err\n\t}\n\treturn redacted, assets, false, nil\n}\n\n// resolveTaskTranscriptPath falls back to the agent-layout convention when a\n// task record has no declared transcript path (e.g. an agent that reports the\n// path only on some events, or a legacy record captured before an agent\n// started reporting one at all). Mirrors cli.ResolveAgentTranscriptPath,\n// which this package cannot call directly — the cli package imports strategy,\n// so the reverse import would cycle — and the logic itself is small enough\n// that duplicating it here beats introducing a new shared package for this\n// one call site (moving the transcript resolver into paths is deliberately\n// out of scope for the durable-records plan this implements).\nfunc resolveTaskTranscriptPath(state *SessionState, agentID string) string {\n\tif agentID == \"\" || state.TranscriptPath == \"\" {\n\t\treturn \"\"\n\t}\n\ttranscriptDir := filepath.Dir(state.TranscriptPath)\n\tname := paths.AgentTranscriptFileName(agentID)\n\tif nested := filepath.Join(paths.SubagentsDir(transcriptDir, state.SessionID), name); fileExists(nested) {\n\t\treturn nested\n\t}\n\tif legacy := filepath.Join(transcriptDir, name); fileExists(legacy) {\n\t\treturn legacy\n\t}\n\treturn \"\"\n}\n\n// taskTranscriptReasonUnresolvable, taskTranscriptReasonUnreadable,\n// taskTranscriptReasonEmpty, taskTranscriptReasonRedactionFailed, and\n// taskTranscriptReasonTooLarge are the stable\n// TaskPayload.TranscriptUnavailableReason categories. They deliberately\n// carry no path or underlying-error detail: task.json is pushed to\n// entire/checkpoints/v1, so a local filesystem path (which os.ReadFile's error\n// text embeds) must never end up in it. The detailed error goes only to\n// logging.Warn at the call site.\nconst (\n\ttaskTranscriptReasonUnresolvable    = \"transcript path unresolvable\"\n\ttaskTranscriptReasonUnreadable      = \"transcript unreadable\"\n\ttaskTranscriptReasonEmpty           = \"transcript empty\"\n\ttaskTranscriptReasonRedactionFailed = \"transcript redaction failed\"\n\ttaskTranscriptReasonTooLarge        = \"transcript too large\"\n)\n\n// materializeTaskRecords resolves and redacts each of state.TaskRecords'\n// subagent transcripts for storage under this checkpoint's\n// tasks/<tool-use-id>/ subtree — the durable-records materializer for #2058:\n// subagent transcripts used to die at condensation because no producer ever\n// set the (now deleted) WriteOptions.IsTask route.\n//\n// Every record is materialized on every condensation, whether completed or\n// still in flight: a completed record's transcript is stored once here and\n// then removed from session state by the caller (see resetCheckpointWindow);\n// an in-flight record's transcript-so-far is stored and the record stays so\n// the next condensation re-materializes it. A record whose transcript cannot\n// be resolved or read still produces a payload — with TranscriptUnavailableReason\n// set instead of a Transcript — so the pointer is never silently dropped.\n//\n// A record with an unsafe or empty ToolUseID, or one whose AgentID is unsafe\n// or empty at the point a transcript would be written, is skipped entirely —\n// no payload at all, not even a reason-only one: an unsafe ToolUseID has no\n// safe tasks/<id>/ directory to put a task.json under in the first place, and\n// an empty/unsafe AgentID would corrupt the agent-<id>.jsonl filename (see\n// writeTaskRecordEntries, which re-validates as a last resort). This must\n// never wedge condensation — a poisoned record produces zero payloads, not an\n// error, and the caller's normal completed-record removal\n// (resetCheckpointWindow) still drops it once completed, since a record that\n// can never materialize would otherwise retry forever.\n//\n// Task assets are appended to the incoming assets slice and returned (rather\n// than living on TaskPayload, which has no Assets field of its own) so they\n// join the checkpoint's own Assets list — see WriteOptions.Assets.\nfunc (s *ManualCommitStrategy) materializeTaskRecords(\n\tctx, logCtx context.Context,\n\tag agent.Agent,\n\tstate *SessionState,\n\tassets []cpkg.TranscriptAsset,\n) ([]cpkg.TaskPayload, []cpkg.TranscriptAsset) {\n\tif len(state.TaskRecords) == 0 {\n\t\treturn nil, assets\n\t}\n\n\tpayloads := make([]cpkg.TaskPayload, 0, len(state.TaskRecords))\n\tfor _, record := range state.TaskRecords {\n\t\tif record.ToolUseID == \"\" || validation.ValidateToolUseID(record.ToolUseID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or empty tool_use_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\tpayload := cpkg.TaskPayload{\n\t\t\tToolUseID:       record.ToolUseID,\n\t\t\tAgentID:         record.AgentID,\n\t\t\tSubagentType:    record.SubagentType,\n\t\t\tTaskDescription: record.TaskDescription,\n\t\t\tFiles:           record.Files,\n\t\t\tTokenUsage:      record.TokenUsage,\n\t\t\tStartedAt:       record.StartedAt,\n\t\t\tCompletedAt:     record.CompletedAt,\n\t\t}\n\n\t\t// Candidate transcript paths, tried in order: the agent-declared path\n\t\t// first, then the agent-layout fallback — declared paths are\n\t\t// unreliable (agents relocate/clean up transcripts), which is why the\n\t\t// fallback resolver exists at all, so a declared-but-unreadable path\n\t\t// must not short-circuit past it.\n\t\tvar candidates []string\n\t\tif record.DeclaredTranscriptPath != \"\" {\n\t\t\tcandidates = append(candidates, record.DeclaredTranscriptPath)\n\t\t}\n\t\tif fallback := resolveTaskTranscriptPath(state, record.AgentID); fallback != \"\" && fallback != record.DeclaredTranscriptPath {\n\t\t\tcandidates = append(candidates, fallback)\n\t\t}\n\t\tif len(candidates) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnresolvable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\t// A transcript is about to be read and, if valid, stored as\n\t\t// agent-<agent-id>.jsonl — the agent ID becomes part of that path, so\n\t\t// it must be present and path-safe before going any further. Skip the\n\t\t// WHOLE record rather than merely omitting the transcript: this is\n\t\t// the same \"poisoned identifier\" shape as the ToolUseID check above.\n\t\tif record.AgentID == \"\" || validation.ValidateAgentID(record.AgentID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or missing agent_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\traw, transcriptPath, readErr := readFirstTranscript(candidates)\n\t\tif readErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to read subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", readErr.Error()),\n\t\t\t)\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnreadable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif len(raw) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonEmpty\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\tredacted, taskAssets, tooLarge, prepErr := prepareTaskTranscriptForStorage(ctx, logCtx, ag, state, transcriptPath, raw)\n\t\tif tooLarge {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonTooLarge\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif prepErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to redact subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", prepErr.Error()),\n\t\t}\n\t\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\t\treturn nil\n\t}\n\tcompleted, err := strategy.CompleteTaskRecord(logCtx, event.SessionID, rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to complete task record: %w\", err)\n\t}\n\tif !completed {\n\t\t// A racing Final event won the exactly-once completion, or the session\n\t\t// state is gone (ended and swept mid-capture) — nothing was written.\n\t\tlogging.Debug(logCtx, \"task record not completed by this capture (raced or state gone)\",\n\t\t\tslog.String(\"session_id\", event.SessionID),\n\t\t\tslog.String(\"tool_use_id\", event.ToolUseID))\n\t}\n\n\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\treturn nil\n}\n\n// loadLiveTaskRecords returns sessionID's still-in-flight task records, or nil\n// when there is no state (or it cannot be read — logged, best-effort).\nfunc loadLiveTaskRecords(logCtx context.Context, sessionID string) []session.TaskRecord {\n\tstate, err := strategy.LoadSessionState(logCtx, sessionID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for in-flight task capture\",\n\t\t\tslog.String(\"session_id\", sessionID),\n\t\t\tslog.String(\"error\", err.Error()))\n\t\treturn nil\n\t}\n\tif state == nil {\n\t\treturn nil\n\t}\n\treturn state.LiveTaskRecords()\n}\n\n// completeLiveTaskRecords is the SessionEnd sweep: the session is closing with\n// these tasks still in flight, so each gets the same completion SubagentStop\n// would have performed, via the same handleSubagentStopFinal machinery (see\n// captureInFlightTaskFinal). SessionEnd is every record's last completion\n// chance, so it processes every live marker, and MUST run before the caller\n// marks the session ended and eagerly condenses (endSessionNow), so the\n// condense materializes the just-completed records.\n// Best-effort: one task's failure does not stop the others.\nfunc completeLiveTaskRecords(ctx context.Context, ag agent.Agent, sessionID, sessionRef string) {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n# Copilot CLI Native Subagent Tracking Design\n\n## Goal\n\nGive GitHub Copilot CLI the same normalized subagent lifecycle used by Claude\nCode and Codex: one correctly correlated durable task record per native child,\nincluding child metadata, files, transcript when available, and exact token\nusage when Copilot exposes it.\n\n## Current behavior\n\nEntire's Copilot adapter reflects an older CLI contract:\n\n- it installs `subagentStop` but not `subagentStart`;\n- it discards `preToolUse` and `postToolUse` payloads;\n- it converts `subagentStop` into `SubagentEnd` with only the parent session ID;\n- shared lifecycle code therefore merges all uncorrelated Copilot children into\n  the task record keyed by the empty string; and\n- its subordinate-session guard recognizes only the historical `toolu_` prefix.\n\nThis preserves parent-level file capture but is not per-child tracking.\n\nCurrent Copilot CLI documentation exposes both `subagentStart` and\n`subagentStop` for YAML-based built-in agents and custom agents. The start\npayload contains `sessionId`, `transcriptPath`, and agent metadata but no\n`agentId`; the stop payload adds `agentId`, `agentType`, and the final response.\nThe built-in `general-purpose` agent deliberately emits neither event.\n\n## Scope\n\n### In scope\n\n- Install, detect, preserve, and remove the native `subagentStart` hook.\n- Parse current camelCase Copilot CLI payloads and compatible snake_case\n  payloads without weakening existing VS Code compatibility checks.\n- Prove and use a collision-free value shared by start and stop as Entire's\n  `ToolUseID`.\n- Map stop `agentId` to `SubagentID` and retain the native child transcript path\n  only when a real current capture proves that `transcriptPath` identifies the\n  child rather than the parent.\n- Reuse the existing `SubagentStart`/`SubagentEnd`, task-record, condensation,\n  sanitization, externalization, redaction, and `tasks/` materialization paths.\n- Preserve phantom-session prevention for historical child lifecycle IDs,\n  including both observed `toolu_` and `tooluse_` spellings.\n- Validate the behavior with simulated hooks, one focused integration test,\n  the existing E2E scenario, and an end-user real Copilot smoke test.\n- Document the `general-purpose` exception truthfully.\n\n### Out of scope\n\n- Rebuilding shared task-record or checkpoint persistence.\n- Guessing child identity from task descriptions, timestamps, directory order,\n  or \"most recent\" state.\n- Claiming exact per-child tokens when Copilot exposes only a session aggregate.\n- Treating the final response text as a canonical child transcript.\n- Solving `general-purpose` through heuristic attribution. If the evidence\n  phase finds a deterministic native signal, it may be added through the same\n  tests; otherwise it remains an explicit upstream limitation and follow-up.\n- Merging any pull request.\n\n## Design\n\n### Evidence gate\n\nBefore production changes, and only after explicit authorization for a real\nCopilot invocation, run Copilot CLI 1.0.82 or newer in an isolated repository\nwith capture-only hooks. Exercise two same-type native subagents concurrently,\none writing and one read-only, and one `general-purpose` child. Record only\npayload structure, identifiers, event order, transcript locations, and token\nfields. Parallel evidence is mandatory whenever transcript-path identity is a\ncandidate correlation source.\n\nThe native implementation proceeds only if start and stop expose a stable,\none-to-one correlation source. The preferred mapping is the native child ID if\nit is present in both events. Otherwise a canonical child transcript path may\nbe converted to a path-safe deterministic digest, but only after the capture\nproves that path is stable across start/stop and unique across parallel\nchildren. Canonical store-relative layout validation must precede digesting at\nboth boundaries: equivalent spellings of one path map to one identity, while\ndistinct concurrent canonical paths remain distinct. An outside-store,\nwrong-layout, symlinked, missing, or otherwise unvalidated path creates no\nevent or marker. If neither condition holds, stop and revise the design rather\nthan ship ambiguous attribution.\n\nThe same capture must prove the ordering of child start/stop relative to parent\n`agentStop` and `sessionEnd`, when child transcript bytes become readable, and\nwhether the child transcript survives until condensation. If parent session\ntermination can precede native child stop, stop and revise the lifecycle design:\nthe current SessionEnd sweep would otherwise complete and condense a live marker\nwithout the stop's child metadata.\n\nIf transcript path is the correlation source, the capture must additionally\nshow that the canonical non-symlink child file is present and verifiable at\nboth start and stop. If child file attribution depends on transcript bytes, the\nfile must be readable at stop; otherwise the implementation pauses for a design\nthat can safely defer attribution instead of silently producing incomplete\nrecords.\n\n### Hook adapter\n\nAdd `subagent-start` beside the existing Copilot hook verbs and include the\n`subagentStart` key in installation, uninstall, idempotency, and presence/drift\ncoverage. Copilot gains a read-only `CheckHookConfig`: absent/user-only files are\nabsent, the exact managed set is current, and any managed-but-incomplete,\nstale, malformed, or unreadable configuration is outdated. Extend the\ncompatibility envelope only with fields required by the documented subagent\npayloads.\n\n`subagentStart` maps to `agent.SubagentStart` with:\n\n- the parent Copilot session as `SessionID`;\n- the proven stable correlation value as `ToolUseID`;\n- native agent name/type and description when present; and\n- the canonical child transcript as `SubagentTranscriptPath` only after\n  store-confined, no-follow validation.\n\n`subagentStop` maps to `agent.SubagentEnd` with the same `ToolUseID`, stop\n`agentId` as `SubagentID`, the parent transcript as `SessionRef`, native labels,\nand the verified child transcript path. It remains `Final: false` because\nCopilot supplies one true-completion end signal rather than Claude Code's\nlaunch-stub-plus-final pair. A narrow normalized-event marker distinguishes\nthis native start/stop lifecycle from the existing foreground PostToolUse\ncompletion path. The same marker declares that any supplied child transcript\npath is authoritative: Copilot records never probe the generic Claude-style\nsubagent layout when that path is absent, disappears, or cannot be read.\n\n### Durable capture\n\nNo new storage model is introduced. For the marked native lifecycle, generic\nstart handling adds a live `session.TaskRecord` only to an existing parent\nsession. Generic end handling requires that live record, uses only hook- or\nchild-transcript-authoritative file evidence, bypasses the no-file skip for a\nread-only child, and completes it exactly once. An unmatched, duplicate, or\nmissing/ended-parent stop is a no-op and never creates or resurrects state.\nThis path is separate from the existing Final=false foreground PostToolUse\npath, whose whole-worktree scan is unsafe for concurrent children.\n\nThe task record persists an explicit authoritative-transcript/no-fallback bit.\nCompletion merges start and stop metadata field-by-field: stop values win when\npresent, while an omitted stop field retains the start value. This includes\n`SubagentType`, `TaskDescription`, `AgentID`, the declared transcript, and its\nprovenance. Consequently, a start that lacks a description can still retain a\ndescription supplied by stop, without erasing a name learned at start.\nThe verified start transcript path is stored on the live record immediately,\nsurvives a JSON state round trip, remains when stop omits it, and is replaced\nonly by a non-empty verified stop path.\n\nCondensation writes\n`tasks/<tool-use-id>/task.json` and, when available,\n`agent-<agent-id>.jsonl`. Missing child transcripts retain a metadata record\nwith an existing path-free unavailability reason. For an authoritative Copilot\nrecord, a missing or unreadable declared path never falls through to either\n`ResolveAgentTranscriptPath` during completion or\n`resolveTaskTranscriptPath` during condensation, even if a coincidental file\nexists at the generic layout.\n\nConfinement applies to every read, not just initial hook parsing. The Copilot\nadapter performs one `SessionStore`-anchored, no-follow read at stop and derives\nboth `Event.ModifiedFiles` and exact usage from those bytes, so shared lifecycle\ncode does not reopen the path through `ExtractModifiedFilesFromOffset`.\nCondensation independently revalidates and reopens an authoritative path\nthrough `SessionStore.ReadFile`; it never sends that path to unrestricted\n`ReadTranscriptFile`/`readFirstTranscript`. A file replaced by a symlink after\nparsing or immediately before condensation therefore yields transcript\nunavailability rather than reading outside the store.\n\nExact child token usage is stored only if a canonical child transcript or\nmachine-readable per-agent usage record supplies an exact total. The Copilot\nadapter accepts usage only when the verified child transcript already contains\nthe authoritative `session.shutdown` aggregate with non-empty `modelMetrics`.\nIt uses an exact-only extractor rather than the existing calculator's partial\nassistant-message fallback, and places the result on `Event.TokenUsage` before\ndispatch. The hook path is accepted only when it resolves to the captured\ncanonical file layout beneath Copilot's session store; outside-store paths,\nsymlinks, and layout mismatches yield neither a declared child transcript nor\nchild usage. Otherwise the record's child token usage remains unavailable;\nparent session totals continue through the existing Copilot calculator and are\nnot replaced or double-counted by partial child data.\n\n### General-purpose behavior\n\nThe probe must confirm the documented absence of native start/stop hooks. The\nexisting subordinate lifecycle filter remains in place so a child cannot open\na phantom top-level Entire session. Supporting `general-purpose` requires a\nstable parent/child/call relationship under parallel execution; descriptions\nand recency are expressly insufficient.\n\nIf current Copilot re-emits a deterministic child task ID and canonical child\nsession evidence, add a narrowly scoped adapter using that identity. Otherwise\nthe PR documents the exception and does not imply parity for that built-in.\n\n## Error handling and privacy\n\n- Malformed subagent payloads return ordinary parse errors and never create a\n  partial task record.\n- Missing optional metadata degrades field-by-field.\n- Invalid or ambiguous correlation fails closed for per-child capture while\n  preserving parent-session checkpoint behavior.\n- A native stop after parent SessionEnd is skipped unless the evidence phase\n  proves and the design explicitly handles a safe retained-state ordering.\n- Logs contain identifiers, key names, counts, and paths already permitted by\n  current operational logging; never prompts, responses, or transcript text.\n- Hook output remains empty/pass-through so Entire cannot block Copilot work.\n\n## Acceptance criteria\n\n- Fresh installation includes exactly one managed `subagentStart` and one\n  managed `subagentStop`; upgrade, reinstall, and uninstall are idempotent and\n  preserve user hooks and unknown fields.\n- Two native children with the same agent type receive different stable task\n  IDs and cannot complete each other's records.\n- A writing child contributes its file and native child transcript to its own\n  durable `tasks/` subtree after a normal user commit.\n- A read-only child still produces its own durable metadata/transcript record.\n- Duplicate stop delivery does not duplicate or overwrite another child.\n- Unmatched stops and stops after missing/ended parent state create nothing.\n- Metadata present only at stop is merged into the start-created record.\n- Missing authoritative child transcripts never fall back to a generic\n  agent-layout file.\n- Partial message-only usage, unsafe paths, and symlinks (including paths\n","exit_code":0,"duration":{"secs":0,"nanos":3375},"formatted_output":"\treturn \"Copilot CLI - GitHub's AI-powered coding agent\"\n}\n\n// IsPreview returns true because this is a new integration.\nfunc (c *CopilotCLIAgent) IsPreview() bool { return true }\n\n// DetectPresence checks if Entire hooks are installed in the Copilot CLI config.\n// Delegates to AreHooksInstalled which checks .github/hooks/entire.json for Entire hook entries.\nfunc (c *CopilotCLIAgent) DetectPresence(ctx context.Context) (bool, error) {\n\treturn c.AreHooksInstalled(ctx)\n}\n\n// GetSessionID extracts the session ID from hook input.\nfunc (c *CopilotCLIAgent) GetSessionID(input *agent.HookInput) string {\n\treturn input.SessionID\n}\n\n// GetSessionDir returns the directory where Copilot CLI stores session transcripts.\nfunc (c *CopilotCLIAgent) GetSessionDir(_ string) (string, error) {\n\tif override := os.Getenv(\"ENTIRE_TEST_COPILOT_SESSION_DIR\"); override != \"\" {\n\t\treturn override, nil\n\t}\n\n\t// Copilot stores its config and state under COPILOT_HOME when that is set,\n\t// falling back to ~/.copilot. Honouring it points transcript resolution at\n\t// wherever the agent actually wrote, rather than at a directory it never\n\t// used — which is what a user with COPILOT_HOME set, or a harness that\n\t// isolates Copilot state per session, would otherwise get.\n\tif copilotHome := os.Getenv(\"COPILOT_HOME\"); copilotHome != \"\" {\n\t\treturn filepath.Join(copilotHome, \"session-state\"), nil\n\t}\n\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to get home directory: %w\", err)\n\t}\n\n\treturn filepath.Join(homeDir, \".copilot\", \"session-state\"), nil\n}\n\n// ResolveSessionFile returns the path to a Copilot CLI session transcript file.\n// Copilot CLI stores transcripts at <sessionDir>/<sessionId>/events.jsonl.\nfunc (c *CopilotCLIAgent) ResolveSessionFile(sessionDir, agentSessionID string) string {\n\treturn filepath.Join(sessionDir, agentSessionID, \"events.jsonl\")\n}\n\n// ProtectedDirs returns directories that Copilot CLI uses for config/state.\nfunc (c *CopilotCLIAgent) ProtectedDirs() []string {\n\treturn []string{filepath.Join(\".github\", \"hooks\")}\n}\n\n// ReadSession reads a session from Copilot CLI's storage (JSONL transcript file).\nfunc (c *CopilotCLIAgent) ReadSession(input *agent.HookInput) (*agent.AgentSession, error) {\n\tif input.SessionRef == \"\" {\n\t\treturn nil, errors.New(\"session reference (transcript path) is required\")\n\t}\n\n\tdata, err := os.ReadFile(input.SessionRef)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\tpath string,\n\traw []byte,\n) (redacted redact.RedactedBytes, assets []cpkg.TranscriptAsset, tooLarge bool, err error) {\n\tsanitized := agent.SanitizeTranscriptForStorage(ag, raw)\n\tif len(sanitized) > agent.MaxChunkSize {\n\t\tlogging.Warn(logCtx, \"subagent transcript exceeds the blob size cap; storing task without it\",\n\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\tslog.String(\"path\", path),\n\t\t\tslog.Int(\"raw_bytes\", len(raw)),\n\t\t\tslog.Int(\"sanitized_bytes\", len(sanitized)),\n\t\t\tslog.Int(\"cap\", agent.MaxChunkSize))\n\t\treturn redact.RedactedBytes{}, nil, true, nil\n\t}\n\texternalized, assets := externalizeSessionImages(ctx, logCtx, state, sanitized)\n\t// nil repo declines prefix reuse: a subagent transcript is written once per\n\t// task, not appended across checkpoints, so there is nothing to reuse.\n\tredacted, _, err = redactSessionTranscript(logCtx, nil, \"\", externalized)\n\tif err != nil {\n\t\treturn redact.RedactedBytes{}, nil, false, err\n\t}\n\treturn redacted, assets, false, nil\n}\n\n// resolveTaskTranscriptPath falls back to the agent-layout convention when a\n// task record has no declared transcript path (e.g. an agent that reports the\n// path only on some events, or a legacy record captured before an agent\n// started reporting one at all). Mirrors cli.ResolveAgentTranscriptPath,\n// which this package cannot call directly — the cli package imports strategy,\n// so the reverse import would cycle — and the logic itself is small enough\n// that duplicating it here beats introducing a new shared package for this\n// one call site (moving the transcript resolver into paths is deliberately\n// out of scope for the durable-records plan this implements).\nfunc resolveTaskTranscriptPath(state *SessionState, agentID string) string {\n\tif agentID == \"\" || state.TranscriptPath == \"\" {\n\t\treturn \"\"\n\t}\n\ttranscriptDir := filepath.Dir(state.TranscriptPath)\n\tname := paths.AgentTranscriptFileName(agentID)\n\tif nested := filepath.Join(paths.SubagentsDir(transcriptDir, state.SessionID), name); fileExists(nested) {\n\t\treturn nested\n\t}\n\tif legacy := filepath.Join(transcriptDir, name); fileExists(legacy) {\n\t\treturn legacy\n\t}\n\treturn \"\"\n}\n\n// taskTranscriptReasonUnresolvable, taskTranscriptReasonUnreadable,\n// taskTranscriptReasonEmpty, taskTranscriptReasonRedactionFailed, and\n// taskTranscriptReasonTooLarge are the stable\n// TaskPayload.TranscriptUnavailableReason categories. They deliberately\n// carry no path or underlying-error detail: task.json is pushed to\n// entire/checkpoints/v1, so a local filesystem path (which os.ReadFile's error\n// text embeds) must never end up in it. The detailed error goes only to\n// logging.Warn at the call site.\nconst (\n\ttaskTranscriptReasonUnresolvable    = \"transcript path unresolvable\"\n\ttaskTranscriptReasonUnreadable      = \"transcript unreadable\"\n\ttaskTranscriptReasonEmpty           = \"transcript empty\"\n\ttaskTranscriptReasonRedactionFailed = \"transcript redaction failed\"\n\ttaskTranscriptReasonTooLarge        = \"transcript too large\"\n)\n\n// materializeTaskRecords resolves and redacts each of state.TaskRecords'\n// subagent transcripts for storage under this checkpoint's\n// tasks/<tool-use-id>/ subtree — the durable-records materializer for #2058:\n// subagent transcripts used to die at condensation because no producer ever\n// set the (now deleted) WriteOptions.IsTask route.\n//\n// Every record is materialized on every condensation, whether completed or\n// still in flight: a completed record's transcript is stored once here and\n// then removed from session state by the caller (see resetCheckpointWindow);\n// an in-flight record's transcript-so-far is stored and the record stays so\n// the next condensation re-materializes it. A record whose transcript cannot\n// be resolved or read still produces a payload — with TranscriptUnavailableReason\n// set instead of a Transcript — so the pointer is never silently dropped.\n//\n// A record with an unsafe or empty ToolUseID, or one whose AgentID is unsafe\n// or empty at the point a transcript would be written, is skipped entirely —\n// no payload at all, not even a reason-only one: an unsafe ToolUseID has no\n// safe tasks/<id>/ directory to put a task.json under in the first place, and\n// an empty/unsafe AgentID would corrupt the agent-<id>.jsonl filename (see\n// writeTaskRecordEntries, which re-validates as a last resort). This must\n// never wedge condensation — a poisoned record produces zero payloads, not an\n// error, and the caller's normal completed-record removal\n// (resetCheckpointWindow) still drops it once completed, since a record that\n// can never materialize would otherwise retry forever.\n//\n// Task assets are appended to the incoming assets slice and returned (rather\n// than living on TaskPayload, which has no Assets field of its own) so they\n// join the checkpoint's own Assets list — see WriteOptions.Assets.\nfunc (s *ManualCommitStrategy) materializeTaskRecords(\n\tctx, logCtx context.Context,\n\tag agent.Agent,\n\tstate *SessionState,\n\tassets []cpkg.TranscriptAsset,\n) ([]cpkg.TaskPayload, []cpkg.TranscriptAsset) {\n\tif len(state.TaskRecords) == 0 {\n\t\treturn nil, assets\n\t}\n\n\tpayloads := make([]cpkg.TaskPayload, 0, len(state.TaskRecords))\n\tfor _, record := range state.TaskRecords {\n\t\tif record.ToolUseID == \"\" || validation.ValidateToolUseID(record.ToolUseID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or empty tool_use_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\tpayload := cpkg.TaskPayload{\n\t\t\tToolUseID:       record.ToolUseID,\n\t\t\tAgentID:         record.AgentID,\n\t\t\tSubagentType:    record.SubagentType,\n\t\t\tTaskDescription: record.TaskDescription,\n\t\t\tFiles:           record.Files,\n\t\t\tTokenUsage:      record.TokenUsage,\n\t\t\tStartedAt:       record.StartedAt,\n\t\t\tCompletedAt:     record.CompletedAt,\n\t\t}\n\n\t\t// Candidate transcript paths, tried in order: the agent-declared path\n\t\t// first, then the agent-layout fallback — declared paths are\n\t\t// unreliable (agents relocate/clean up transcripts), which is why the\n\t\t// fallback resolver exists at all, so a declared-but-unreadable path\n\t\t// must not short-circuit past it.\n\t\tvar candidates []string\n\t\tif record.DeclaredTranscriptPath != \"\" {\n\t\t\tcandidates = append(candidates, record.DeclaredTranscriptPath)\n\t\t}\n\t\tif fallback := resolveTaskTranscriptPath(state, record.AgentID); fallback != \"\" && fallback != record.DeclaredTranscriptPath {\n\t\t\tcandidates = append(candidates, fallback)\n\t\t}\n\t\tif len(candidates) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnresolvable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\t// A transcript is about to be read and, if valid, stored as\n\t\t// agent-<agent-id>.jsonl — the agent ID becomes part of that path, so\n\t\t// it must be present and path-safe before going any further. Skip the\n\t\t// WHOLE record rather than merely omitting the transcript: this is\n\t\t// the same \"poisoned identifier\" shape as the ToolUseID check above.\n\t\tif record.AgentID == \"\" || validation.ValidateAgentID(record.AgentID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or missing agent_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\traw, transcriptPath, readErr := readFirstTranscript(candidates)\n\t\tif readErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to read subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", readErr.Error()),\n\t\t\t)\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnreadable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif len(raw) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonEmpty\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\tredacted, taskAssets, tooLarge, prepErr := prepareTaskTranscriptForStorage(ctx, logCtx, ag, state, transcriptPath, raw)\n\t\tif tooLarge {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonTooLarge\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif prepErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to redact subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", prepErr.Error()),\n\t\t}\n\t\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\t\treturn nil\n\t}\n\tcompleted, err := strategy.CompleteTaskRecord(logCtx, event.SessionID, rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to complete task record: %w\", err)\n\t}\n\tif !completed {\n\t\t// A racing Final event won the exactly-once completion, or the session\n\t\t// state is gone (ended and swept mid-capture) — nothing was written.\n\t\tlogging.Debug(logCtx, \"task record not completed by this capture (raced or state gone)\",\n\t\t\tslog.String(\"session_id\", event.SessionID),\n\t\t\tslog.String(\"tool_use_id\", event.ToolUseID))\n\t}\n\n\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\treturn nil\n}\n\n// loadLiveTaskRecords returns sessionID's still-in-flight task records, or nil\n// when there is no state (or it cannot be read — logged, best-effort).\nfunc loadLiveTaskRecords(logCtx context.Context, sessionID string) []session.TaskRecord {\n\tstate, err := strategy.LoadSessionState(logCtx, sessionID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for in-flight task capture\",\n\t\t\tslog.String(\"session_id\", sessionID),\n\t\t\tslog.String(\"error\", err.Error()))\n\t\treturn nil\n\t}\n\tif state == nil {\n\t\treturn nil\n\t}\n\treturn state.LiveTaskRecords()\n}\n\n// completeLiveTaskRecords is the SessionEnd sweep: the session is closing with\n// these tasks still in flight, so each gets the same completion SubagentStop\n// would have performed, via the same handleSubagentStopFinal machinery (see\n// captureInFlightTaskFinal). SessionEnd is every record's last completion\n// chance, so it processes every live marker, and MUST run before the caller\n// marks the session ended and eagerly condenses (endSessionNow), so the\n// condense materializes the just-completed records.\n// Best-effort: one task's failure does not stop the others.\nfunc completeLiveTaskRecords(ctx context.Context, ag agent.Agent, sessionID, sessionRef string) {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n# Copilot CLI Native Subagent Tracking Design\n\n## Goal\n\nGive GitHub Copilot CLI the same normalized subagent lifecycle used by Claude\nCode and Codex: one correctly correlated durable task record per native child,\nincluding child metadata, files, transcript when available, and exact token\nusage when Copilot exposes it.\n\n## Current behavior\n\nEntire's Copilot adapter reflects an older CLI contract:\n\n- it installs `subagentStop` but not `subagentStart`;\n- it discards `preToolUse` and `postToolUse` payloads;\n- it converts `subagentStop` into `SubagentEnd` with only the parent session ID;\n- shared lifecycle code therefore merges all uncorrelated Copilot children into\n  the task record keyed by the empty string; and\n- its subordinate-session guard recognizes only the historical `toolu_` prefix.\n\nThis preserves parent-level file capture but is not per-child tracking.\n\nCurrent Copilot CLI documentation exposes both `subagentStart` and\n`subagentStop` for YAML-based built-in agents and custom agents. The start\npayload contains `sessionId`, `transcriptPath`, and agent metadata but no\n`agentId`; the stop payload adds `agentId`, `agentType`, and the final response.\nThe built-in `general-purpose` agent deliberately emits neither event.\n\n## Scope\n\n### In scope\n\n- Install, detect, preserve, and remove the native `subagentStart` hook.\n- Parse current camelCase Copilot CLI payloads and compatible snake_case\n  payloads without weakening existing VS Code compatibility checks.\n- Prove and use a collision-free value shared by start and stop as Entire's\n  `ToolUseID`.\n- Map stop `agentId` to `SubagentID` and retain the native child transcript path\n  only when a real current capture proves that `transcriptPath` identifies the\n  child rather than the parent.\n- Reuse the existing `SubagentStart`/`SubagentEnd`, task-record, condensation,\n  sanitization, externalization, redaction, and `tasks/` materialization paths.\n- Preserve phantom-session prevention for historical child lifecycle IDs,\n  including both observed `toolu_` and `tooluse_` spellings.\n- Validate the behavior with simulated hooks, one focused integration test,\n  the existing E2E scenario, and an end-user real Copilot smoke test.\n- Document the `general-purpose` exception truthfully.\n\n### Out of scope\n\n- Rebuilding shared task-record or checkpoint persistence.\n- Guessing child identity from task descriptions, timestamps, directory order,\n  or \"most recent\" state.\n- Claiming exact per-child tokens when Copilot exposes only a session aggregate.\n- Treating the final response text as a canonical child transcript.\n- Solving `general-purpose` through heuristic attribution. If the evidence\n  phase finds a deterministic native signal, it may be added through the same\n  tests; otherwise it remains an explicit upstream limitation and follow-up.\n- Merging any pull request.\n\n## Design\n\n### Evidence gate\n\nBefore production changes, and only after explicit authorization for a real\nCopilot invocation, run Copilot CLI 1.0.82 or newer in an isolated repository\nwith capture-only hooks. Exercise two same-type native subagents concurrently,\none writing and one read-only, and one `general-purpose` child. Record only\npayload structure, identifiers, event order, transcript locations, and token\nfields. Parallel evidence is mandatory whenever transcript-path identity is a\ncandidate correlation source.\n\nThe native implementation proceeds only if start and stop expose a stable,\none-to-one correlation source. The preferred mapping is the native child ID if\nit is present in both events. Otherwise a canonical child transcript path may\nbe converted to a path-safe deterministic digest, but only after the capture\nproves that path is stable across start/stop and unique across parallel\nchildren. Canonical store-relative layout validation must precede digesting at\nboth boundaries: equivalent spellings of one path map to one identity, while\ndistinct concurrent canonical paths remain distinct. An outside-store,\nwrong-layout, symlinked, missing, or otherwise unvalidated path creates no\nevent or marker. If neither condition holds, stop and revise the design rather\nthan ship ambiguous attribution.\n\nThe same capture must prove the ordering of child start/stop relative to parent\n`agentStop` and `sessionEnd`, when child transcript bytes become readable, and\nwhether the child transcript survives until condensation. If parent session\ntermination can precede native child stop, stop and revise the lifecycle design:\nthe current SessionEnd sweep would otherwise complete and condense a live marker\nwithout the stop's child metadata.\n\nIf transcript path is the correlation source, the capture must additionally\nshow that the canonical non-symlink child file is present and verifiable at\nboth start and stop. If child file attribution depends on transcript bytes, the\nfile must be readable at stop; otherwise the implementation pauses for a design\nthat can safely defer attribution instead of silently producing incomplete\nrecords.\n\n### Hook adapter\n\nAdd `subagent-start` beside the existing Copilot hook verbs and include the\n`subagentStart` key in installation, uninstall, idempotency, and presence/drift\ncoverage. Copilot gains a read-only `CheckHookConfig`: absent/user-only files are\nabsent, the exact managed set is current, and any managed-but-incomplete,\nstale, malformed, or unreadable configuration is outdated. Extend the\ncompatibility envelope only with fields required by the documented subagent\npayloads.\n\n`subagentStart` maps to `agent.SubagentStart` with:\n\n- the parent Copilot session as `SessionID`;\n- the proven stable correlation value as `ToolUseID`;\n- native agent name/type and description when present; and\n- the canonical child transcript as `SubagentTranscriptPath` only after\n  store-confined, no-follow validation.\n\n`subagentStop` maps to `agent.SubagentEnd` with the same `ToolUseID`, stop\n`agentId` as `SubagentID`, the parent transcript as `SessionRef`, native labels,\nand the verified child transcript path. It remains `Final: false` because\nCopilot supplies one true-completion end signal rather than Claude Code's\nlaunch-stub-plus-final pair. A narrow normalized-event marker distinguishes\nthis native start/stop lifecycle from the existing foreground PostToolUse\ncompletion path. The same marker declares that any supplied child transcript\npath is authoritative: Copilot records never probe the generic Claude-style\nsubagent layout when that path is absent, disappears, or cannot be read.\n\n### Durable capture\n\nNo new storage model is introduced. For the marked native lifecycle, generic\nstart handling adds a live `session.TaskRecord` only to an existing parent\nsession. Generic end handling requires that live record, uses only hook- or\nchild-transcript-authoritative file evidence, bypasses the no-file skip for a\nread-only child, and completes it exactly once. An unmatched, duplicate, or\nmissing/ended-parent stop is a no-op and never creates or resurrects state.\nThis path is separate from the existing Final=false foreground PostToolUse\npath, whose whole-worktree scan is unsafe for concurrent children.\n\nThe task record persists an explicit authoritative-transcript/no-fallback bit.\nCompletion merges start and stop metadata field-by-field: stop values win when\npresent, while an omitted stop field retains the start value. This includes\n`SubagentType`, `TaskDescription`, `AgentID`, the declared transcript, and its\nprovenance. Consequently, a start that lacks a description can still retain a\ndescription supplied by stop, without erasing a name learned at start.\nThe verified start transcript path is stored on the live record immediately,\nsurvives a JSON state round trip, remains when stop omits it, and is replaced\nonly by a non-empty verified stop path.\n\nCondensation writes\n`tasks/<tool-use-id>/task.json` and, when available,\n`agent-<agent-id>.jsonl`. Missing child transcripts retain a metadata record\nwith an existing path-free unavailability reason. For an authoritative Copilot\nrecord, a missing or unreadable declared path never falls through to either\n`ResolveAgentTranscriptPath` during completion or\n`resolveTaskTranscriptPath` during condensation, even if a coincidental file\nexists at the generic layout.\n\nConfinement applies to every read, not just initial hook parsing. The Copilot\nadapter performs one `SessionStore`-anchored, no-follow read at stop and derives\nboth `Event.ModifiedFiles` and exact usage from those bytes, so shared lifecycle\ncode does not reopen the path through `ExtractModifiedFilesFromOffset`.\nCondensation independently revalidates and reopens an authoritative path\nthrough `SessionStore.ReadFile`; it never sends that path to unrestricted\n`ReadTranscriptFile`/`readFirstTranscript`. A file replaced by a symlink after\nparsing or immediately before condensation therefore yields transcript\nunavailability rather than reading outside the store.\n\nExact child token usage is stored only if a canonical child transcript or\nmachine-readable per-agent usage record supplies an exact total. The Copilot\nadapter accepts usage only when the verified child transcript already contains\nthe authoritative `session.shutdown` aggregate with non-empty `modelMetrics`.\nIt uses an exact-only extractor rather than the existing calculator's partial\nassistant-message fallback, and places the result on `Event.TokenUsage` before\ndispatch. The hook path is accepted only when it resolves to the captured\ncanonical file layout beneath Copilot's session store; outside-store paths,\nsymlinks, and layout mismatches yield neither a declared child transcript nor\nchild usage. Otherwise the record's child token usage remains unavailable;\nparent session totals continue through the existing Copilot calculator and are\nnot replaced or double-counted by partial child data.\n\n### General-purpose behavior\n\nThe probe must confirm the documented absence of native start/stop hooks. The\nexisting subordinate lifecycle filter remains in place so a child cannot open\na phantom top-level Entire session. Supporting `general-purpose` requires a\nstable parent/child/call relationship under parallel execution; descriptions\nand recency are expressly insufficient.\n\nIf current Copilot re-emits a deterministic child task ID and canonical child\nsession evidence, add a narrowly scoped adapter using that identity. Otherwise\nthe PR documents the exception and does not imply parity for that built-in.\n\n## Error handling and privacy\n\n- Malformed subagent payloads return ordinary parse errors and never create a\n  partial task record.\n- Missing optional metadata degrades field-by-field.\n- Invalid or ambiguous correlation fails closed for per-child capture while\n  preserving parent-session checkpoint behavior.\n- A native stop after parent SessionEnd is skipped unless the evidence phase\n  proves and the design explicitly handles a safe retained-state ordering.\n- Logs contain identifiers, key names, counts, and paths already permitted by\n  current operational logging; never prompts, responses, or transcript text.\n- Hook output remains empty/pass-through so Entire cannot block Copilot work.\n\n## Acceptance criteria\n\n- Fresh installation includes exactly one managed `subagentStart` and one\n  managed `subagentStop`; upgrade, reinstall, and uninstall are idempotent and\n  preserve user hooks and unknown fields.\n- Two native children with the same agent type receive different stable task\n  IDs and cannot complete each other's records.\n- A writing child contributes its file and native child transcript to its own\n  durable `tasks/` subtree after a normal user commit.\n- A read-only child still produces its own durable metadata/transcript record.\n- Duplicate stop delivery does not duplicate or overwrite another child.\n- Unmatched stops and stops after missing/ended parent state create nothing.\n- Metadata present only at stop is merged into the start-created record.\n- Missing authoritative child transcripts never fall back to a generic\n  agent-layout file.\n- Partial message-only usage, unsafe paths, and symlinks (including paths\n"},"started_at_ms":1788501507020,"completed_at_ms":1788501507020}}
{"timestamp":"2026-09-04T05:58:27.068Z","ordinal":10638,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06aff-3bfc-78f2-8f3d-22fcf8373205","call_id":"call_5Bs6sbxpOljnoXzCAktAbWA0","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\treturn \"Copilot CLI - GitHub's AI-powered coding agent\"\n}\n\n// IsPreview returns true because this is a new integration.\nfunc (c *CopilotCLIAgent) IsPreview() bool { return true }\n\n// DetectPresence checks if Entire hooks are installed in the Copilot CLI config.\n// Delegates to AreHooksInstalled which checks .github/hooks/entire.json for Entire hook entries.\nfunc (c *CopilotCLIAgent) DetectPresence(ctx context.Context) (bool, error) {\n\treturn c.AreHooksInstalled(ctx)\n}\n\n// GetSessionID extracts the session ID from hook input.\nfunc (c *CopilotCLIAgent) GetSessionID(input *agent.HookInput) string {\n\treturn input.SessionID\n}\n\n// GetSessionDir returns the directory where Copilot CLI stores session transcripts.\nfunc (c *CopilotCLIAgent) GetSessionDir(_ string) (string, error) {\n\tif override := os.Getenv(\"ENTIRE_TEST_COPILOT_SESSION_DIR\"); override != \"\" {\n\t\treturn override, nil\n\t}\n\n\t// Copilot stores its config and state under COPILOT_HOME when that is set,\n\t// falling back to ~/.copilot. Honouring it points transcript resolution at\n\t// wherever the agent actually wrote, rather than at a directory it never\n\t// used — which is what a user with COPILOT_HOME set, or a harness that\n\t// isolates Copilot state per session, would otherwise get.\n\tif copilotHome := os.Getenv(\"COPILOT_HOME\"); copilotHome != \"\" {\n\t\treturn filepath.Join(copilotHome, \"session-state\"), nil\n\t}\n\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to get home directory: %w\", err)\n\t}\n\n\treturn filepath.Join(homeDir, \".copilot\", \"session-state\"), nil\n}\n\n// ResolveSessionFile returns the path to a Copilot CLI session transcript file.\n// Copilot CLI stores transcripts at <sessionDir>/<sessionId>/events.jsonl.\nfunc (c *CopilotCLIAgent) ResolveSessionFile(sessionDir, agentSessionID string) string {\n\treturn filepath.Join(sessionDir, agentSessionID, \"events.jsonl\")\n}\n\n// ProtectedDirs returns directories that Copilot CLI uses for config/state.\nfunc (c *CopilotCLIAgent) ProtectedDirs() []string {\n\treturn []string{filepath.Join(\".github\", \"hooks\")}\n}\n\n// ReadSession reads a session from Copilot CLI's storage (JSONL transcript file).\nfunc (c *CopilotCLIAgent) ReadSession(input *agent.HookInput) (*agent.AgentSession, error) {\n\tif input.SessionRef == \"\" {\n\t\treturn nil, errors.New(\"session reference (transcript path) is required\")\n\t}\n\n\tdata, err := os.ReadFile(input.SessionRef)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\tpath string,\n\traw []byte,\n) (redacted redact.RedactedBytes, assets []cpkg.TranscriptAsset, tooLarge bool, err error) {\n\tsanitized := agent.SanitizeTranscriptForStorage(ag, raw)\n\tif len(sanitized) > agent.MaxChunkSize {\n\t\tlogging.Warn(logCtx, \"subagent transcript exceeds the blob size cap; storing task without it\",\n\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\tslog.String(\"path\", path),\n\t\t\tslog.Int(\"raw_bytes\", len(raw)),\n\t\t\tslog.Int(\"sanitized_bytes\", len(sanitized)),\n\t\t\tslog.Int(\"cap\", agent.MaxChunkSize))\n\t\treturn redact.RedactedBytes{}, nil, true, nil\n\t}\n\texternalized, assets := externalizeSessionImages(ctx, logCtx, state, sanitized)\n\t// nil repo declines prefix reuse: a subagent transcript is written once per\n\t// task, not appended across checkpoints, so there is nothing to reuse.\n\tredacted, _, err = redactSessionTranscript(logCtx, nil, \"\", externalized)\n\tif err != nil {\n\t\treturn redact.RedactedBytes{}, nil, false, err\n\t}\n\treturn redacted, assets, false, nil\n}\n\n// resolveTaskTranscriptPath falls back to the agent-layout convention when a\n// task record has no declared transcript path (e.g. an agent that reports the\n// path only on some events, or a legacy record captured before an agent\n// started reporting one at all). Mirrors cli.ResolveAgentTranscriptPath,\n// which this package cannot call directly — the cli package imports strategy,\n// so the reverse import would cycle — and the logic itself is small enough\n// that duplicating it here beats introducing a new shared package for this\n// one call site (moving the transcript resolver into paths is deliberately\n// out of scope for the durable-records plan this implements).\nfunc resolveTaskTranscriptPath(state *SessionState, agentID string) string {\n\tif agentID == \"\" || state.TranscriptPath == \"\" {\n\t\treturn \"\"\n\t}\n\ttranscriptDir := filepath.Dir(state.TranscriptPath)\n\tname := paths.AgentTranscriptFileName(agentID)\n\tif nested := filepath.Join(paths.SubagentsDir(transcriptDir, state.SessionID), name); fileExists(nested) {\n\t\treturn nested\n\t}\n\tif legacy := filepath.Join(transcriptDir, name); fileExists(legacy) {\n\t\treturn legacy\n\t}\n\treturn \"\"\n}\n\n// taskTranscriptReasonUnresolvable, taskTranscriptReasonUnreadable,\n// taskTranscriptReasonEmpty, taskTranscriptReasonRedactionFailed, and\n// taskTranscriptReasonTooLarge are the stable\n// TaskPayload.TranscriptUnavailableReason categories. They deliberately\n// carry no path or underlying-error detail: task.json is pushed to\n// entire/checkpoints/v1, so a local filesystem path (which os.ReadFile's error\n// text embeds) must never end up in it. The detailed error goes only to\n// logging.Warn at the call site.\nconst (\n\ttaskTranscriptReasonUnresolvable    = \"transcript path unresolvable\"\n\ttaskTranscriptReasonUnreadable      = \"transcript unreadable\"\n\ttaskTranscriptReasonEmpty           = \"transcript empty\"\n\ttaskTranscriptReasonRedactionFailed = \"transcript redaction failed\"\n\ttaskTranscriptReasonTooLarge        = \"transcript too large\"\n)\n\n// materializeTaskRecords resolves and redacts each of state.TaskRecords'\n// subagent transcripts for storage under this checkpoint's\n// tasks/<tool-use-id>/ subtree — the durable-records materializer for #2058:\n// subagent transcripts used to die at condensation because no producer ever\n// set the (now deleted) WriteOptions.IsTask route.\n//\n// Every record is materialized on every condensation, whether completed or\n// still in flight: a completed record's transcript is stored once here and\n// then removed from session state by the caller (see resetCheckpointWindow);\n// an in-flight record's transcript-so-far is stored and the record stays so\n// the next condensation re-materializes it. A record whose transcript cannot\n// be resolved or read still produces a payload — with TranscriptUnavailableReason\n// set instead of a Transcript — so the pointer is never silently dropped.\n//\n// A record with an unsafe or empty ToolUseID, or one whose AgentID is unsafe\n// or empty at the point a transcript would be written, is skipped entirely —\n// no payload at all, not even a reason-only one: an unsafe ToolUseID has no\n// safe tasks/<id>/ directory to put a task.json under in the first place, and\n// an empty/unsafe AgentID would corrupt the agent-<id>.jsonl filename (see\n// writeTaskRecordEntries, which re-validates as a last resort). This must\n// never wedge condensation — a poisoned record produces zero payloads, not an\n// error, and the caller's normal completed-record removal\n// (resetCheckpointWindow) still drops it once completed, since a record that\n// can never materialize would otherwise retry forever.\n//\n// Task assets are appended to the incoming assets slice and returned (rather\n// than living on TaskPayload, which has no Assets field of its own) so they\n// join the checkpoint's own Assets list — see WriteOptions.Assets.\nfunc (s *ManualCommitStrategy) materializeTaskRecords(\n\tctx, logCtx context.Context,\n\tag agent.Agent,\n\tstate *SessionState,\n\tassets []cpkg.TranscriptAsset,\n) ([]cpkg.TaskPayload, []cpkg.TranscriptAsset) {\n\tif len(state.TaskRecords) == 0 {\n\t\treturn nil, assets\n\t}\n\n\tpayloads := make([]cpkg.TaskPayload, 0, len(state.TaskRecords))\n\tfor _, record := range state.TaskRecords {\n\t\tif record.ToolUseID == \"\" || validation.ValidateToolUseID(record.ToolUseID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or empty tool_use_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\tpayload := cpkg.TaskPayload{\n\t\t\tToolUseID:       record.ToolUseID,\n\t\t\tAgentID:         record.AgentID,\n\t\t\tSubagentType:    record.SubagentType,\n\t\t\tTaskDescription: record.TaskDescription,\n\t\t\tFiles:           record.Files,\n\t\t\tTokenUsage:      record.TokenUsage,\n\t\t\tStartedAt:       record.StartedAt,\n\t\t\tCompletedAt:     record.CompletedAt,\n\t\t}\n\n\t\t// Candidate transcript paths, tried in order: the agent-declared path\n\t\t// first, then the agent-layout fallback — declared paths are\n\t\t// unreliable (agents relocate/clean up transcripts), which is why the\n\t\t// fallback resolver exists at all, so a declared-but-unreadable path\n\t\t// must not short-circuit past it.\n\t\tvar candidates []string\n\t\tif record.DeclaredTranscriptPath != \"\" {\n\t\t\tcandidates = append(candidates, record.DeclaredTranscriptPath)\n\t\t}\n\t\tif fallback := resolveTaskTranscriptPath(state, record.AgentID); fallback != \"\" && fallback != record.DeclaredTranscriptPath {\n\t\t\tcandidates = append(candidates, fallback)\n\t\t}\n\t\tif len(candidates) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnresolvable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\t// A transcript is about to be read and, if valid, stored as\n\t\t// agent-<agent-id>.jsonl — the agent ID becomes part of that path, so\n\t\t// it must be present and path-safe before going any further. Skip the\n\t\t// WHOLE record rather than merely omitting the transcript: this is\n\t\t// the same \"poisoned identifier\" shape as the ToolUseID check above.\n\t\tif record.AgentID == \"\" || validation.ValidateAgentID(record.AgentID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or missing agent_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\traw, transcriptPath, readErr := readFirstTranscript(candidates)\n\t\tif readErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to read subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", readErr.Error()),\n\t\t\t)\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnreadable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif len(raw) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonEmpty\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\tredacted, taskAssets, tooLarge, prepErr := prepareTaskTranscriptForStorage(ctx, logCtx, ag, state, transcriptPath, raw)\n\t\tif tooLarge {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonTooLarge\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif prepErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to redact subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", prepErr.Error()),\n\t\t}\n\t\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\t\treturn nil\n\t}\n\tcompleted, err := strategy.CompleteTaskRecord(logCtx, event.SessionID, rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to complete task record: %w\", err)\n\t}\n\tif !completed {\n\t\t// A racing Final event won the exactly-once completion, or the session\n\t\t// state is gone (ended and swept mid-capture) — nothing was written.\n\t\tlogging.Debug(logCtx, \"task record not completed by this capture (raced or state gone)\",\n\t\t\tslog.String(\"session_id\", event.SessionID),\n\t\t\tslog.String(\"tool_use_id\", event.ToolUseID))\n\t}\n\n\t_ = CleanupPreTaskState(logCtx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\treturn nil\n}\n\n// loadLiveTaskRecords returns sessionID's still-in-flight task records, or nil\n// when there is no state (or it cannot be read — logged, best-effort).\nfunc loadLiveTaskRecords(logCtx context.Context, sessionID string) []session.TaskRecord {\n\tstate, err := strategy.LoadSessionState(logCtx, sessionID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for in-flight task capture\",\n\t\t\tslog.String(\"session_id\", sessionID),\n\t\t\tslog.String(\"error\", err.Error()))\n\t\treturn nil\n\t}\n\tif state == nil {\n\t\treturn nil\n\t}\n\treturn state.LiveTaskRecords()\n}\n\n// completeLiveTaskRecords is the SessionEnd sweep: the session is closing with\n// these tasks still in flight, so each gets the same completion SubagentStop\n// would have performed, via the same handleSubagentStopFinal machinery (see\n// captureInFlightTaskFinal). SessionEnd is every record's last completion\n// chance, so it processes every live marker, and MUST run before the caller\n// marks the session ended and eagerly condenses (endSessionNow), so the\n// condense materializes the just-completed records.\n// Best-effort: one task's failure does not stop the others.\nfunc completeLiveTaskRecords(ctx context.Context, ag agent.Agent, sessionID, sessionRef string) {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n# Copilot CLI Native Subagent Tracking Design\n\n## Goal\n\nGive GitHub Copilot CLI the same normalized subagent lifecycle used by Claude\nCode and Codex: one correctly correlated durable task record per native child,\nincluding child metadata, files, transcript when available, and exact token\nusage when Copilot exposes it.\n\n## Current behavior\n\nEntire's Copilot adapter reflects an older CLI contract:\n\n- it installs `subagentStop` but not `subagentStart`;\n- it discards `preToolUse` and `postToolUse` payloads;\n- it converts `subagentStop` into `SubagentEnd` with only the parent session ID;\n- shared lifecycle code therefore merges all uncorrelated Copilot children into\n  the task record keyed by the empty string; and\n- its subordinate-session guard recognizes only the historical `toolu_` prefix.\n\nThis preserves parent-level file capture but is not per-child tracking.\n\nCurrent Copilot CLI documentation exposes both `subagentStart` and\n`subagentStop` for YAML-based built-in agents and custom agents. The start\npayload contains `sessionId`, `transcriptPath`, and agent metadata but no\n`agentId`; the stop payload adds `agentId`, `agentType`, and the final response.\nThe built-in `general-purpose` agent deliberately emits neither event.\n\n## Scope\n\n### In scope\n\n- Install, detect, preserve, and remove the native `subagentStart` hook.\n- Parse current camelCase Copilot CLI payloads and compatible snake_case\n  payloads without weakening existing VS Code compatibility checks.\n- Prove and use a collision-free value shared by start and stop as Entire's\n  `ToolUseID`.\n- Map stop `agentId` to `SubagentID` and retain the native child transcript path\n  only when a real current capture proves that `transcriptPath` identifies the\n  child rather than the parent.\n- Reuse the existing `SubagentStart`/`SubagentEnd`, task-record, condensation,\n  sanitization, externalization, redaction, and `tasks/` materialization paths.\n- Preserve phantom-session prevention for historical child lifecycle IDs,\n  including both observed `toolu_` and `tooluse_` spellings.\n- Validate the behavior with simulated hooks, one focused integration test,\n  the existing E2E scenario, and an end-user real Copilot smoke test.\n- Document the `general-purpose` exception truthfully.\n\n### Out of scope\n\n- Rebuilding shared task-record or checkpoint persistence.\n- Guessing child identity from task descriptions, timestamps, directory order,\n  or \"most recent\" state.\n- Claiming exact per-child tokens when Copilot exposes only a session aggregate.\n- Treating the final response text as a canonical child transcript.\n- Solving `general-purpose` through heuristic attribution. If the evidence\n  phase finds a deterministic native signal, it may be added through the same\n  tests; otherwise it remains an explicit upstream limitation and follow-up.\n- Merging any pull request.\n\n## Design\n\n### Evidence gate\n\nBefore production changes, and only after explicit authorization for a real\nCopilot invocation, run Copilot CLI 1.0.82 or newer in an isolated repository\nwith capture-only hooks. Exercise two same-type native subagents concurrently,\none writing and one read-only, and one `general-purpose` child. Record only\npayload structure, identifiers, event order, transcript locations, and token\nfields. Parallel evidence is mandatory whenever transcript-path identity is a\ncandidate correlation source.\n\nThe native implementation proceeds only if start and stop expose a stable,\none-to-one correlation source. The preferred mapping is the native child ID if\nit is present in both events. Otherwise a canonical child transcript path may\nbe converted to a path-safe deterministic digest, but only after the capture\nproves that path is stable across start/stop and unique across parallel\nchildren. Canonical store-relative layout validation must precede digesting at\nboth boundaries: equivalent spellings of one path map to one identity, while\ndistinct concurrent canonical paths remain distinct. An outside-store,\nwrong-layout, symlinked, missing, or otherwise unvalidated path creates no\nevent or marker. If neither condition holds, stop and revise the design rather\nthan ship ambiguous attribution.\n\nThe same capture must prove the ordering of child start/stop relative to parent\n`agentStop` and `sessionEnd`, when child transcript bytes become readable, and\nwhether the child transcript survives until condensation. If parent session\ntermination can precede native child stop, stop and revise the lifecycle design:\nthe current SessionEnd sweep would otherwise complete and condense a live marker\nwithout the stop's child metadata.\n\nIf transcript path is the correlation source, the capture must additionally\nshow that the canonical non-symlink child file is present and verifiable at\nboth start and stop. If child file attribution depends on transcript bytes, the\nfile must be readable at stop; otherwise the implementation pauses for a design\nthat can safely defer attribution instead of silently producing incomplete\nrecords.\n\n### Hook adapter\n\nAdd `subagent-start` beside the existing Copilot hook verbs and include the\n`subagentStart` key in installation, uninstall, idempotency, and presence/drift\ncoverage. Copilot gains a read-only `CheckHookConfig`: absent/user-only files are\nabsent, the exact managed set is current, and any managed-but-incomplete,\nstale, malformed, or unreadable configuration is outdated. Extend the\ncompatibility envelope only with fields required by the documented subagent\npayloads.\n\n`subagentStart` maps to `agent.SubagentStart` with:\n\n- the parent Copilot session as `SessionID`;\n- the proven stable correlation value as `ToolUseID`;\n- native agent name/type and description when present; and\n- the canonical child transcript as `SubagentTranscriptPath` only after\n  store-confined, no-follow validation.\n\n`subagentStop` maps to `agent.SubagentEnd` with the same `ToolUseID`, stop\n`agentId` as `SubagentID`, the parent transcript as `SessionRef`, native labels,\nand the verified child transcript path. It remains `Final: false` because\nCopilot supplies one true-completion end signal rather than Claude Code's\nlaunch-stub-plus-final pair. A narrow normalized-event marker distinguishes\nthis native start/stop lifecycle from the existing foreground PostToolUse\ncompletion path. The same marker declares that any supplied child transcript\npath is authoritative: Copilot records never probe the generic Claude-style\nsubagent layout when that path is absent, disappears, or cannot be read.\n\n### Durable capture\n\nNo new storage model is introduced. For the marked native lifecycle, generic\nstart handling adds a live `session.TaskRecord` only to an existing parent\nsession. Generic end handling requires that live record, uses only hook- or\nchild-transcript-authoritative file evidence, bypasses the no-file skip for a\nread-only child, and completes it exactly once. An unmatched, duplicate, or\nmissing/ended-parent stop is a no-op and never creates or resurrects state.\nThis path is separate from the existing Final=false foreground PostToolUse\npath, whose whole-worktree scan is unsafe for concurrent children.\n\nThe task record persists an explicit authoritative-transcript/no-fallback bit.\nCompletion merges start and stop metadata field-by-field: stop values win when\npresent, while an omitted stop field retains the start value. This includes\n`SubagentType`, `TaskDescription`, `AgentID`, the declared transcript, and its\nprovenance. Consequently, a start that lacks a description can still retain a\ndescription supplied by stop, without erasing a name learned at start.\nThe verified start transcript path is stored on the live record immediately,\nsurvives a JSON state round trip, remains when stop omits it, and is replaced\nonly by a non-empty verified stop path.\n\nCondensation writes\n`tasks/<tool-use-id>/task.json` and, when available,\n`agent-<agent-id>.jsonl`. Missing child transcripts retain a metadata record\nwith an existing path-free unavailability reason. For an authoritative Copilot\nrecord, a missing or unreadable declared path never falls through to either\n`ResolveAgentTranscriptPath` during completion or\n`resolveTaskTranscriptPath` during condensation, even if a coincidental file\nexists at the generic layout.\n\nConfinement applies to every read, not just initial hook parsing. The Copilot\nadapter performs one `SessionStore`-anchored, no-follow read at stop and derives\nboth `Event.ModifiedFiles` and exact usage from those bytes, so shared lifecycle\ncode does not reopen the path through `ExtractModifiedFilesFromOffset`.\nCondensation independently revalidates and reopens an authoritative path\nthrough `SessionStore.ReadFile`; it never sends that path to unrestricted\n`ReadTranscriptFile`/`readFirstTranscript`. A file replaced by a symlink after\nparsing or immediately before condensation therefore yields transcript\nunavailability rather than reading outside the store.\n\nExact child token usage is stored only if a canonical child transcript or\nmachine-readable per-agent usage record supplies an exact total. The Copilot\nadapter accepts usage only when the verified child transcript already contains\nthe authoritative `session.shutdown` aggregate with non-empty `modelMetrics`.\nIt uses an exact-only extractor rather than the existing calculator's partial\nassistant-message fallback, and places the result on `Event.TokenUsage` before\ndispatch. The hook path is accepted only when it resolves to the captured\ncanonical file layout beneath Copilot's session store; outside-store paths,\nsymlinks, and layout mismatches yield neither a declared child transcript nor\nchild usage. Otherwise the record's child token usage remains unavailable;\nparent session totals continue through the existing Copilot calculator and are\nnot replaced or double-counted by partial child data.\n\n### General-purpose behavior\n\nThe probe must confirm the documented absence of native start/stop hooks. The\nexisting subordinate lifecycle filter remains in place so a child cannot open\na phantom top-level Entire session. Supporting `general-purpose` requires a\nstable parent/child/call relationship under parallel execution; descriptions\nand recency are expressly insufficient.\n\nIf current Copilot re-emits a deterministic child task ID and canonical child\nsession evidence, add a narrowly scoped adapter using that identity. Otherwise\nthe PR documents the exception and does not imply parity for that built-in.\n\n## Error handling and privacy\n\n- Malformed subagent payloads return ordinary parse errors and never create a\n  partial task record.\n- Missing optional metadata degrades field-by-field.\n- Invalid or ambiguous correlation fails closed for per-child capture while\n  preserving parent-session checkpoint behavior.\n- A native stop after parent SessionEnd is skipped unless the evidence phase\n  proves and the design explicitly handles a safe retained-state ordering.\n- Logs contain identifiers, key names, counts, and paths already permitted by\n  current operational logging; never prompts, responses, or transcript text.\n- Hook output remains empty/pass-through so Entire cannot block Copilot work.\n\n## Acceptance criteria\n\n- Fresh installation includes exactly one managed `subagentStart` and one\n  managed `subagentStop`; upgrade, reinstall, and uninstall are idempotent and\n  preserve user hooks and unknown fields.\n- Two native children with the same agent type receive different stable task\n  IDs and cannot complete each other's records.\n- A writing child contributes its file and native child transcript to its own\n  durable `tasks/` subtree after a normal user commit.\n- A read-only child still produces its own durable metadata/transcript record.\n- Duplicate stop delivery does not duplicate or overwrite another child.\n- Unmatched stops and stops after missing/ended parent state create nothing.\n- Metadata present only at stop is merged into the start-created record.\n- Missing authoritative child transcripts never fall back to a generic\n  agent-layout file.\n- Partial message-only usage, unsafe paths, and symlinks (including paths\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06aeb-fba1-7c73-b9bd-e6c66f69b450","create_time":1788501507.068151}}}
{"timestamp":"2026-09-04T05:58:27.068Z","ordinal":10639,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":203404452,"cached_input_tokens":199957504,"cache_write_input_tokens":0,"output_tokens":539624,"reasoning_output_tokens":199351,"total_tokens":203944076},"last_token_usage":{"input_tokens":94003,"cached_input_tokens":92032,"cache_write_input_tokens":0,"output_tokens":176,"reasoning_output_tokens":0,"total_tokens":94179},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":100.0,"window_minutes":10080,"resets_at":1788886333},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":null},"individual_limit":null,"spend_control_reached":null,"plan_type":"self_serve_business_prolite","rate_limit_reached_type":null}}}
