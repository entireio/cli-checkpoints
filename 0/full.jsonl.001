g. If incoming is nil, returns existing unchanged.\ncmd/entire/cli/strategy/manual_commit_git.go-435-//\ncmd/entire/cli/strategy/manual_commit_git.go-436-// SubagentTokens is handled differently from the other fields: main-agent\ncmd/entire/cli/strategy/manual_commit_git.go-437-// usage (InputTokens, OutputTokens, ...) arrives per step as a delta scoped to\ncmd/entire/cli/strategy/manual_commit_git.go-438-// that step's transcript slice, so it is correct to sum deltas across steps.\ncmd/entire/cli/strategy/manual_commit_git.go-439-// Subagent usage arrives as a cumulative-since-session-start snapshot instead\ncmd/entire/cli/strategy/manual_commit_git.go-440-// — CalculateTotalTokenUsage discovers agent IDs from the full transcript\ncmd/entire/cli/strategy/manual_commit_git.go-441-// (so a subagent spawned before the current checkpoint window is still\ncmd/entire/cli/strategy/manual_commit_git.go-442-// found) and re-reads each subagent transcript from its start on every call.\ncmd/entire/cli/strategy/manual_commit_git.go-443-// Summing that snapshot across steps would re-add a subagent's full usage on\ncmd/entire/cli/strategy/manual_commit_git.go-444-// every subsequent step after it was first discovered, so SubagentTokens is\ncmd/entire/cli/strategy/manual_commit_git.go-445-// replaced with the latest snapshot rather than added.\ncmd/entire/cli/strategy/manual_commit_git.go-446-func accumulateTokenUsage(existing, incoming *agent.TokenUsage) *agent.TokenUsage {\ncmd/entire/cli/strategy/manual_commit_git.go-447-\tif incoming == nil {\ncmd/entire/cli/strategy/manual_commit_git.go-448-\t\treturn existing\ncmd/entire/cli/strategy/manual_commit_git.go-449-\t}\ncmd/entire/cli/strategy/manual_commit_git.go-450-\tif existing == nil {\ncmd/entire/cli/strategy/manual_commit_git.go-451-\t\t// Return a copy to avoid sharing the pointer\ncmd/entire/cli/strategy/manual_commit_git.go-452-\t\treturn &agent.TokenUsage{\ncmd/entire/cli/strategy/manual_commit_git.go-453-\t\t\tInputTok