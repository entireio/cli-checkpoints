     \"x-enumDescriptions\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19672-        \"preToolUse\": \"Runs before a tool is invoked.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19673-        \"preMcpToolCall\": \"Runs before an MCP tool is invoked.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19674-        \"postToolUse\": \"Runs after a tool completes successfully.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19675-        \"postToolUseFailure\": \"Runs after a tool fails.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19676-        \"userPromptSubmitted\": \"Runs after the user submits a prompt.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19677-        \"userPromptTransformed\": \"Runs after the runtime transforms the submitted prompt for the model, before it is added to session history.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19678-        \"sessionStart\": \"Runs when a session starts.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19679-        \"sessionEnd\": \"Runs when a session ends.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19680-        \"postResult\": \"Runs after an agent result is produced.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19681-        \"prePRDescription\": \"Runs before a pull request description is generated.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19682-        \"errorOccurred\": \"Runs when the agent encounters an error.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19683-        \"agentStop\": \"Runs when the agent stops.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json:19684:        \"subagentStart\": \"Runs when a subagent starts.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19685-        \"subagentStop\": \"Runs when a subagent stops.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19686-        \"preCompact\": \"Runs before conversation context is compacted.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19687-        \"permissionRequest\": \"Runs when the agent requests permission.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19688-        \"notification\": \"Runs when the agent emits a notification.\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19689-      }\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19690-    },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19691-    \"InstalledPlugin\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19692-      \"type\": \"object\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19693-      \"properties\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19694-        \"name\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19695-          \"type\": \"string\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19696-          \"description\": \"Plugin name\"\n--\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36492-          \"description\": \"Replaces the session's capability set with the given list. Use to enable or disable capabilities mid-session (e.g., remove `memory` for reproducible scripted runs). Omit the field to leave the existing capability set unchanged.\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36493-        },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36494-        \"skipEmbeddingRetrieval\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36495-          \"type\": \"boolean\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36496-          \"description\": \"Whether to skip embedding retrieval pipeline initialization and execution.\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36497-        },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36498-        \"organizationCustomInstructions\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36499-          \"type\": \"string\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36500-          \"description\": \"Organization-level custom instructions to inject into the system prompt.\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36501-        },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36502-        \"enableFileHooks\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36503-          \"type\": \"boolean\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json:36504:          \"description\": \"Whether to enable loading of `.github/hooks/` filesystem hooks. Separate from the SDK callback hook mechanism.\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36505-        },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36506-        \"enableHostGitOperations\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36507-          \"type\": \"boolean\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36508-          \"description\": \"Whether to enable host git operations (context resolution, child repo scanning, git info in system prompt).\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36509-        },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36510-        \"enableSessionStore\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36511-          \"type\": \"boolean\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36512-          \"description\": \"Whether to enable cross-session store writes and reads.\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36513-        },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36514-        \"enableSkills\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36515-          \"type\": \"boolean\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-36516-          \"description\": \"Whether to enable skill directory scanning and loading. Falls back to enableConfigDiscovery when unset.\"\n--\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4178-    - Set via /settings theme <value>, or /theme <value> (deprecated)\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4179-    - \\`colorMode\\` is a legacy alias for \\`theme\\` and still works for now\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4180-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4181-  \\`trustedFolders\\`: list of folders where permission to read or execute files has been granted.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4182-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4183-  \\`updateTerminalTitle\\`: whether to update the terminal tab/window title with current intent; defaults to \\`true\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4184-    - Shows what the agent is currently working on in the terminal title bar\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4185-    - Only works on supported terminal emulators (xterm, iTerm, Windows Terminal, etc.)\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4186-    - Can also be disabled via the \\`COPILOT_DISABLE_TERMINAL_TITLE\\` environment variable\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4187-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4188-  \\`disableAllHooks\\`: whether to disable all hooks (repo-level and user-level); defaults to \\`false\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4189-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js:4190:  \\`hooks\\`: inline hook definitions, keyed by event name (same schema as .github/hooks/*.json).\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4191-    - In global config.json these act as user-level hooks; in repo settings.json they act as repo-level hooks\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4192-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4193-  \\`ide.autoConnect\\`: whether to automatically connect to an IDE workspace on startup; defaults to \\`true\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4194-    - When \\`false\\`, the CLI will not auto-connect to IDEs or watch for new IDE lock files\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4195-    - You can still manually connect using the /ide command\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4196-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4197-  \\`ide.openDiffOnEdit\\`: whether to open file edit diffs in the connected IDE for approval; defaults to \\`true\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4198-    - When \\`false\\`, file edit approvals are shown only in the terminal\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4199-    - The IDE connection is unaffected; diagnostics and selection features still work\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4200-`},{name:\"commands\",summary:\"Interactive Mode Commands\",content:uSt(PNe().map(e=>({name:e.name,help:e.help,aliases:e.aliases?[...e.aliases]:void 0,experimental:e.experimental})))},{name:\"limits\",summary:\"Session Limits Controls\",content:`Session Limits Controls:\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4201-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4202-  Session limits are opt-in. Usage accumulates across the entire session in both interactive and non-interactive runs.\n"},"started_at_ms":1788500744562,"completed_at_ms":1788500744562}}
