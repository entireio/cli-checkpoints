g parent directories. Session\ncmd/entire/cli/agent/session_store.go-174-// layouts nest (Gemini keys by project hash, Pi by encoded repo path), so the\ncmd/entire/cli/agent/session_store.go-175-// parents are made here rather than at each call site.\ncmd/entire/cli/agent/session_store.go-176-func (s *SessionStore) WriteFile(name string, data []byte, perm os.FileMode) error {\ncmd/entire/cli/agent/session_store.go-177-\troot, err := s.openRootForWrite()\ncmd/entire/cli/agent/session_store.go-178-\tif err != nil {\ncmd/entire/cli/agent/session_store.go-179-\t\treturn err\ncmd/entire/cli/agent/session_store.go-180-\t}\ncmd/entire/cli/agent/session_store.go-181-\tdefer root.Close()\ncmd/entire/cli/agent/session_store.go-182-\tif dir := filepath.ToSlash(filepath.Dir(filepath.FromSlash(name))); dir != \".\" {\ncmd/entire/cli/agent/session_store.go-183-\t\tif err := osroot.MkdirAllNoSymlink(root, dir, 0o750); err != nil {\ncmd/entire/cli/agent/session_store.go-184-\t\t\treturn fmt.Errorf(\"create session directory: %w\", err)\ncmd/entire/cli/agent/session_store.go-185-\t\t}\ncmd/entire/cli/agent/session_store.go-186-\t}\ncmd/entire/cli/agent/session_store.go-187-\tif info, err := osroot.LstatNoSymlinks(root, name); err == nil && info.Mode()&os.ModeSymlink != 0 {\ncmd/entire/cli/agent/session_store.go-188-\t\treturn fmt.Errorf(\"write session file: %w\", osroot.ErrSymlinkedPath)\ncmd/entire/cli/agent/session_store.go-189-\t} else if err != nil && !os.IsNotExist(err) {\ncmd/entire/cli/agent/session_store.go-190-\t\treturn fmt.Errorf(\"inspect session file: %w\", err)\ncmd/entire/cli/agent/session_store.go-191-\t}\ncmd/entire/cli/agent/session_store.go-192-\treturn jsonutil.WriteFileAtomicIn(root, name, data, perm) //nolint:wrapcheck // preserved for os.IsNotExist at call sites\ncmd/entire/cli/agent/session_store.go-193-}\ncmd/entire/cli/agent/session_store.go-194-\ncmd/entire/cli/agent/session_store.go-195-// Exists reports whether name is present in the store. Lstat, not S