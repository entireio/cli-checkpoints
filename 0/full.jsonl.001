leared when AttributionBaseCommit == BaseCommit\")\n\t})\n../../../../../../../Users/peytonmontei/Documents/Documents - Peyton’s MacBook Pro/entire/devenv/entireio/cli/.worktrees/subagents/cmd/entire/cli/session/state_test.go:180: 180-192 lines are duplicate of `cmd/entire/cli/session/state_test.go:194-204` (dupl)\n\tt.Run(\"heals_stale_divergence_flag_when_attribution_empty\", func(t *testing.T) {\n\t\tt.Parallel()\n\t\t// Empty AttributionBaseCommit gets backfilled to BaseCommit below; once aligned,\n\t\t// the flag is meaningless and must clear.\n\t\tstate := &State{\n\t\t\tBaseCommit:            \"bbbbbbb\",\n\t\t\tAttributionBaseCommit: \"\",\n\t\t\tDivergenceNoticeShown: true,\n\t\t}\n\t\tstate.NormalizeAfterLoad(context.Background())\n\t\tassert.False(t, state.DivergenceNoticeShown,\n\t\t\t\"DivergenceNoticeShown must be cleared when AttributionBaseCommit is empty/backfilled\")\n\t})\n../../../../../../../Users/peytonmontei/Documents/Documents - Peyton’s MacBook Pro/entire/devenv/entireio/cli/.worktrees/subagents/cmd/entire/cli/session/state_test.go:194: 194-204 lines are duplicate of `cmd/entire/cli/session/state_test.go:165-178` (dupl)\n\tt.Run(\"preserves_divergence_flag_when_actually_diverged\", func(t *testing.T) {\n\t\tt.Parallel()\n\t\tstate := &State{\n\t\t\tBaseCommit:            \"cccccc1\",\n\t\t\tAttributionBaseCommit: \"cccccc0\",\n\t\t\tDivergenceNoticeShown: true,\n\t\t}\n\t\tstate.NormalizeAfterLoad(context.Background())\n\t\tassert.True(t, state.DivergenceNoticeShown,\n\t\t\t\"DivergenceNoticeShown must be preserved when attribution is genuinely diverged\")\n\t})\n../../../../../../../Users/peytonmontei/Documents/Documents - Peyton’s MacBook Pro/entire/devenv/entireio/cli/.worktrees/subagents/cmd/entire/cli/session_adopt_test.go:140: 140-152 lines are duplicate of `cmd/entire/cli/session_adopt_test.go:264-276` (dupl)\n\tif err := sourceStore.Save(context.Background(), &session.State{\n\t\tSessionID:             sessionID,\n\t\tAgentType:     