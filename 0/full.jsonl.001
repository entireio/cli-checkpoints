:3503:// not ended — unlike the sibling PhaseEnded_TriggersEagerCondense test above,\\ncmd/entire/cli/lifecycle_test.go-3504-// which starts already ended. The mock analyzer's onExtract callback fires\\ncmd/entire/cli/lifecycle_test.go-3505-// from inside ExtractModifiedFilesFromOffset, i.e. mid-way through\\ncmd/entire/cli/lifecycle_test.go:3506:// completeSubagentTaskRecord, and flips the persisted session to PhaseEnded via\\ncmd/entire/cli/lifecycle_test.go-3507-// strategy.MutateSessionState — simulating exactly where a racing SessionEnd\\ncmd/entire/cli/lifecycle_test.go-3508-// would land. It deliberately does not run a full endSessionNow; only the\\ncmd/entire/cli/lifecycle_test.go-3509-// phase transition matters here.\\ncmd/entire/cli/lifecycle_test.go-3510-func TestHandleLifecycleSubagentEnd_SubagentStop_SessionEndsMidCapture_StillCondenses(t *testing.T) {\\ncmd/entire/cli/lifecycle_test.go-3511-\\t// NOT parallel: uses t.Chdir via setupSubagentEndTestRepo.\\n--\\ncmd/entire/cli/lifecycle_test.go-3526-\\ncmd/entire/cli/lifecycle_test.go-3527-\\tag := &mockAnalyzerAgent{\\ncmd/entire/cli/lifecycle_test.go-3528-\\t\\tmockLifecycleAgent: newMockAgent(),\\ncmd/entire/cli/lifecycle_test.go-3529-\\t\\tonExtract: func() {\\ncmd/entire/cli/lifecycle_test.go-3530-\\t\\t\\trequire.NoError(t, strategy.MutateSessionState(ctx, sessionID, func(s *strategy.SessionState) error {\\ncmd/entire/cli/lifecycle_test.go:3531:\\t\\t\\t\\ts.Phase = session.PhaseEnded\\ncmd/entire/cli/lifecycle_test.go-3532-\\t\\t\\t\\treturn nil\\ncmd/entire/cli/lifecycle_test.go-3533-\\t\\t\\t}))\\ncmd/entire/cli/lifecycle_test.go-3534-\\t\\t},\\ncmd/entire/cli/lifecycle_test.go-3535-\\t}\\ncmd/entire/cli/lifecycle_test.go-3536-\\n--\\ncmd/entire/cli/lifecycle.go-1177-\\t}\\ncmd/entire/cli/lifecycle.go-1178-\\treturn processStart.Add(budget)\\ncmd/entire/cli/lifecycle.go-1179-}\\ncmd/entire/cli/lifecycle.go-1180-\\ncmd/entire/cli/lifecycle.go-1181-// endSessionNow runs the canonical \\\"this session is over\\\" sequence: it marks the\\ncmd/entire/cli/lifecycle.go:1182:// session ended (firing the SessionStop transition → PhaseEnded + EndedAt) and\\ncmd/entire/cli/lifecycle.go-1183-// eagerly condenses its pending work so PostCommit need not. This prevents\\ncmd/entire/cli/lifecycle.go-1184-// zombie ENDED sessions from accumulating and causing O(N) overhead on every\\ncmd/entire/cli/lifecycle.go-1185-// future commit (GitHub issue #591). It is shared by the SessionStop hook\\ncmd/entire/cli/lifecycle.go-1186-// (handleLifecycleSessionEnd) and the exited-session sweep\\ncmd/entire/cli/lifecycle.go-1187-// (finalizeExitedSessions), so the two stay in lockstep.\\n--\\ncmd/entire/cli/lifecycle.go-1354-// materializing). Completion happens LAST, inside completeSubagentTaskRecord's\\ncmd/entire/cli/lifecycle.go-1355-// exactly-once mutation (strategy.CompleteTaskRecord), so a failed capture —\\ncmd/entire/cli/lifecycle.go-1356-// analyzer error, worktree error — leaves an existing record live for the\\ncmd/entire/cli/lifecycle.go-1357-// SessionEnd sweep to retry, and two Final events racing for the same ToolUseID\\ncmd/entire/cli/lifecycle.go-1358-// complete it exactly once (the loser's extraction is discarded; nothing was\\ncmd/entire/cli/lifecycle.go:1359:// written). CompletionWithoutLaunch events may create the record here, but\\ncmd/entire/cli/lifecycle.go-1360-// only while their parent session exists and is active.\\ncmd/entire/cli/lifecycle.go-1361-//\\ncmd/entire/cli/lifecycle.go-1362-// The state loaded at the top of the function is only good for the zombie\\ncmd/entire/cli/lifecycle.go-1363-// guard above (state missing entirely), the live-record skip check, and\\ncmd/entire/cli/lifecycle.go-1364-// logging: it predates the capture that follows, and a racing SessionEnd can\\n--\\ncmd/entire/cli/lifecycle.go-1389-\\t\\t\\tslog.String(\\\"tool_use_id\\\", event.ToolUseID))\\ncmd/entire/cli/lifecycle.go-1390-\\t\\treturn nil\\ncmd/entire/cli/lifecycle.go-1391-\\t}\\ncmd/entire/cli/lifecycle.go-1392-\\ncmd/entire/cli/lifecycle.go-1393-\\tmarker := state.FindTaskRecord(event.ToolUseID)\\ncmd/entire/cli/lifecycle.go:1394:\\tif event.CompletionWithoutLaunch && state.Phase == session.PhaseEnded {\\ncmd/entire/cli/lifecycle.go-1395-\\t\\tlogging.Info(logCtx, \\\"skipping completion-only subagent capture: parent session already ended\\\",\\ncmd/entire/cli/lifecycle.go-1396-\\t\\t\\tslog.String(\\\"session_id\\\", event.SessionID),\\ncmd/entire/cli/lifecycle.go-1397-\\t\\t\\tslog.String(\\\"tool_use_id\\\", event.ToolUseID))\\ncmd/entire/cli/lifecycle.go-1398-\\t\\treturn nil\\ncmd/entire/cli/lifecycle.go-1399-\\t}\\ncmd/entire/cli/lifecycle.go:1400:\\tif (marker == nil && !event.CompletionWithoutLaunch) || (marker != nil && !marker.CompletedAt.IsZero()) {\\ncmd/entire/cli/lifecycle.go-1401-\\t\\t// No live marker: this ToolUseID was already completed at launch-time\\ncmd/entire/cli/lifecycle.go-1402-\\t\\t// post-task (foreground task), or another Final event for the same\\ncmd/entire/cli/lifecycle.go-1403-\\t\\t// ToolUseID (a duplicate SubagentStop, or a race against the\\ncmd/entire/cli/lifecycle.go-1404-\\t\\t// SessionEnd final capture) already completed it. Skip.\\ncmd/entire/cli/lifecycle.go-1405-\\t\\t// An event carrying a SubagentID or a subagent transcript path is the\\ncmd/entire/cli/lifecycle.go-1406-\\t\\t// louder variant: those fields mean a real subagent completed, so an\\ncmd/entire/cli/lifecycle.go-1407-\\t\\t// unclaimed skip is either the expected foreground dedup, a duplicate\\ncmd/entire/cli/lifecycle.go-1408-\\t\\t// event, or a misintegrated agent that sets Final without ever\\ncmd/entire/cli/lifecycle.go-1409-\\t\\t// emitting the launch-time marker — worth surfacing over Debug. A\\ncmd/entire/cli/lifecycle.go:1410:\\t\\t// CompletionWithoutLaunch event is the explicit exception handled above.\\ncmd/entire/cli/lifecycle.go-1411-\\t\\tif event.SubagentID != \\\"\\\" || event.SubagentTranscriptPath != \\\"\\\" {\\ncmd/entire/cli/lifecycle.go-1412-\\t\\t\\tlogging.Warn(logCtx, \\\"no in-flight marker for completed subagent — foreground dedup, a duplicate event, or a misintegrated agent setting Final without launch markers\\\",\\ncmd/entire/cli/lifecycle.go-1413-\\t\\t\\t\\tslog.String(\\\"session_id\\\", event.SessionID),\\ncmd/entire/cli/lifecycle.go-1414-\\t\\t\\t\\tslog.String(\\\"tool_use_id\\\", event.ToolUseID),\\ncmd/entire/cli/lifecycle.go-1415-\\t\\t\\t\\tslog.String(\\\"agent_id\\\", event.SubagentID))\\n--\\ncmd/entire/cli/lifecycle.go-1444-\\t// would risk sweeping in the parent's or another agent's later edits. See\\ncmd/entire/cli/lifecycle.go-1445-\\t// subagentCaptureOptions.analyzerFilesOnly.\\ncmd/entire/cli/lifecycle.go-1446-\\tcaptureErr := completeSubagentTaskRecord(logCtx, ag, event, subagentCaptureOptions{\\ncmd/entire/cli/lifecycle.go-1447-\\t\\tbypassNoChangesSkip: true,\\ncmd/entire/cli/lifecycle.go-1448-\\t\\tanalyzerFilesOnly:   true,\\ncmd/entire/cli/lifecycle.go:1449:\\t\\teventFilesOnly:      event.CompletionWithoutLaunch,\\ncmd/entire/cli/lifecycle.go-1450-\\t})\\ncmd/entire/cli/lifecycle.go-1451-\\tif captureErr != nil {\\ncmd/entire/cli/lifecycle.go-1452-\\t\\treturn captureErr\\ncmd/entire/cli/lifecycle.go-1453-\\t}\\ncmd/entire/cli/lifecycle.go-1454-\\ncmd/entire/cli/lifecycle.go-1455-\\t// The eager-condense decision below must use the FRESH phase, not the\\ncmd/entire/cli/lifecycle.go-1456-\\t// snapshot loaded at the top of this function. That snapshot is only\\ncmd/entire/cli/lifecycle.go-1457-\\t// valid for the zombie guard (missing state), the live-record check, and\\ncmd/entire/cli/lifecycle.go-1458-\\t// logging above — the capture we just did is exactly the window where a\\ncmd/entire/cli/lifecycle.go:1459:\\t// racing SessionEnd can flip the session to PhaseEnded (both serialize on\\ncmd/entire/cli/lifecycle.go-1460-\\t// the per-session gate, so this reduces to ordering). Deciding on the\\ncmd/entire/cli/lifecycle.go-1461-\\t// stale pre-capture phase would miss that transition and skip the eager\\ncmd/entire/cli/lifecycle.go-1462-\\t// condense, leaving the record we just completed unmaterialized until some\\ncmd/entire/cli/lifecycle.go-1463-\\t// later condensation that may never come.\\ncmd/entire/cli/lifecycle.go-1464-\\tfreshPhase := state.Phase\\n--\\ncmd/entire/cli/lifecycle.go-1481-\\t\\tlogging.Debug(logCtx, \\\"session state swept during subagent-stop capture; leaving the condense to the sweeper\\\",\\ncmd/entire/cli/lifecycle.go-1482-\\t\\t\\tslog.String(\\\"session_id\\\", event.SessionID),\\ncmd/entire/cli/lifecycle.go-1483-\\t\\t\\tslog.String(\\\"tool_use_id\\\", event.ToolUseID))\\ncmd/entire/cli/lifecycle.go-1484-\\t}\\ncmd/entire/cli/lifecycle.go-1485-\\ncmd/entire/cli/lifecycle.go:1486:\\tif freshPhase == session.PhaseEnded {\\ncmd/entire/cli/lifecycle.go-1487-\\t\\t// The session ended before or during this SubagentStop's capture.\\ncmd/entire/cli/lifecycle.go-1488-\\t\\t// Trigger the same eager condense SessionEnd uses so the\\ncmd/entire/cli/lifecycle.go-1489-\\t\\t// newly-completed record is materialized into a permanent checkpoint\\ncmd/entire/cli/lifecycle.go-1490-\\t\\t// now rather than lingering on ended session state.\\ncmd/entire/cli/lifecycle.go-1491-\\t\\tif condErr := GetStrategy(logCtx).CondenseAndMarkFullyCondensed(logCtx, event.SessionID); condErr != nil {\\n--\\ncmd/entire/cli/lifecycle.go-2034-\\tendedWhenLastSeen\\ncmd/entire/cli/lifecycle.go-2035-)\\ncmd/entire/cli/lifecycle.go-2036-\\ncmd/entire/cli/lifecycle.go-2037-// markSessionEnded transitions the session to ENDED phase via the state machine.\\ncmd/entire/cli/lifecycle.go-2038-// If event is non-nil, hook-provided metrics are persisted to state before saving.\\ncmd/entire/cli/lifecycle.go:2039:// markSessionEnded fires the SessionStop transition (PhaseEnded + EndedAt) under\\ncmd/entire/cli/lifecycle.go-2040-// the session-state lock. When guard is non-nil and returns false on the\\ncmd/entire/cli/lifecycle.go-2041-// freshly-loaded state, the transition is skipped — callers use it to\\ncmd/entire/cli/lifecycle.go-2042-// re-validate a precondition that may have changed since their snapshot (the\\ncmd/entire/cli/lifecycle.go-2043-// exited-session sweep re-checks OwnerExited under the lock so it never ends a\\ncmd/entire/cli/lifecycle.go-2044-// session a concurrent turn just revived). It reports whether the session was\\ncmd/entire/cli/agent/copilotcli/AGENT.md-227-Copilot does not create standalone child transcript files. Task metadata therefore\\ncmd/entire/cli/agent/copilotcli/AGENT.md-228-records transcript unavailability and never probes the generic Claude-style\\ncmd/entire/cli/agent/copilotcli/AGENT.md-229-`agent-<id>.jsonl` layout. Per-child token breakdown is also unavailable at hook time:\\ncmd/entire/cli/agent/copilotcli/AGENT.md:230:`session.shutdown.agentMetrics` is authoritative but is appended only after\\ncmd/entire/cli/agent/copilotcli/AGENT.md-231-`sessionEnd` returns. Entire leaves child token usage unset rather than misclassifying\\ncmd/entire/cli/agent/copilotcli/AGENT.md-232-Copilot's total-only completion value.\\ncmd/entire/cli/agent/copilotcli/AGENT.md-233-\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a08861-a963-7db3-b7f4-840a0a3e6fdf","create_time":1788997139.704193}}}
