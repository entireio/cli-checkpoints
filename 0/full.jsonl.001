/checkpoint/checkpoint_test.go-4576-\t\tt.Fatalf(\"failed to unmarshal task.json: %v\", err)\ncmd/entire/cli/checkpoint/checkpoint_test.go-4577-\t}\ncmd/entire/cli/checkpoint/checkpoint_test.go:4578:\tif meta.TranscriptUnavailableReason != \"transcript path unresolvable\" {\ncmd/entire/cli/checkpoint/checkpoint_test.go:4579:\t\tt.Errorf(\"task.json TranscriptUnavailableReason = %q, want %q\", meta.TranscriptUnavailableReason, \"transcript path unresolvable\")\ncmd/entire/cli/checkpoint/checkpoint_test.go-4580-\t}\ncmd/entire/cli/checkpoint/checkpoint_test.go-4581-\ncmd/entire/cli/checkpoint/checkpoint_test.go-4582-\t// The session's own transcript must be unaffected by the unavailable task transcript.\ncmd/entire/cli/checkpoint/checkpoint_test.go-4583-\tsessionContent, err := store.ReadSessionContent(context.Background(), checkpointID, 0)\ncmd/entire/cli/checkpoint/checkpoint_test.go-4584-\tif err != nil {\n--\ncmd/entire/cli/checkpoint/persistent.go-474-func (s *treeWriter) writeTaskRecordEntries(opts WriteOptions, basePath string, entries map[string]object.TreeEntry) error {\ncmd/entire/cli/checkpoint/persistent.go-475-\tfor _, task := range opts.Tasks {\ncmd/entire/cli/checkpoint/persistent.go-476-\t\tif err := validation.ValidateToolUseID(task.ToolUseID); err != nil {\ncmd/entire/cli/checkpoint/persistent.go-477-\t\t\treturn fmt.Errorf(\"invalid task payload: %w\", err)\ncmd/entire/cli/checkpoint/persistent.go-478-\t\t}\ncmd/entire/cli/checkpoint/persistent.go:479:\t\tif err := validation.ValidateAgentID(task.AgentID); err != nil {\ncmd/entire/cli/checkpoint/persistent.go-480-\t\t\treturn fmt.Errorf(\"invalid task payload: %w\", err)\ncmd/entire/cli/checkpoint/persistent.go-481-\t\t}\ncmd/entire/cli/checkpoint/persistent.go-482-\t\tif err := s.writeTaskRecordEntry(task, basePath, entries); err != nil {\ncmd/entire/cli/checkpoint/persistent.go-483-\t\t\treturn err\ncmd/entire/cli/checkpoint/persistent.go-484-\t\t}\n--\ncmd/entire/cli/checkpoint/persistent.go-515-\t\tTaskDescription:             redact.String(task.TaskDescription),\ncmd/entire/cli/checkpoint/persistent.go-516-\t\tFiles:                       task.Files,\ncmd/entire/cli/checkpoint/persistent.go-517-\t\tTokenUsage:                  task.TokenUsage,\ncmd/entire/cli/checkpoint/persistent.go-518-\t\tStartedAt:                   task.StartedAt,\ncmd/entire/cli/checkpoint/persistent.go-519-\t\tCompletedAt:                 task.CompletedAt,\ncmd/entire/cli/checkpoint/persistent.go:520:\t\tTranscriptUnavailableReason: task.TranscriptUnavailableReason,\ncmd/entire/cli/checkpoint/persistent.go-521-\t}\ncmd/entire/cli/checkpoint/persistent.go-522-\tmetadataJSON, err := jsonutil.MarshalIndentWithNewline(metadata, \"\", \"  \")\ncmd/entire/cli/checkpoint/persistent.go-523-\tif err != nil {\ncmd/entire/cli/checkpoint/persistent.go-524-\t\treturn fmt.Errorf(\"failed to marshal task metadata: %w\", err)\ncmd/entire/cli/checkpoint/persistent.go-525-\t}\n--\ncmd/entire/cli/checkpoint/persistent.go-1309-\t// absence from the JSON is exactly what marks the task in flight when\ncmd/entire/cli/checkpoint/persistent.go-1310-\t// this checkpoint was materialized, so a zero time.Time must actually be\ncmd/entire/cli/checkpoint/persistent.go-1311-\t// omitted, not serialized as \"0001-01-01T00:00:00Z\".\ncmd/entire/cli/checkpoint/persistent.go-1312-\tStartedAt                   time.Time `json:\"started_at,omitzero\"`\ncmd/entire/cli/checkpoint/persistent.go-1313-\tCompletedAt                 time.Time `json:\"completed_at,omitzero\"`\ncmd/entire/cli/checkpoint/persistent.go:1314:\tTranscriptUnavailableReason string    `json:\"transcript_unavailable_reason,omitempty\"`\ncmd/entire/cli/checkpoint/persistent.go-1315-}\ncmd/entire/cli/checkpoint/persistent.go-1316-\ncmd/entire/cli/checkpoint/persistent.go-1317-// Read reads a committed checkpoint's summary by ID from the entire/checkpoints/v1 branch.\ncmd/entire/cli/checkpoint/persistent.go-1318-// Returns only the CheckpointSummary (paths + aggregated stats), not actual content.\ncmd/entire/cli/checkpoint/persistent.go-1319-// Use ReadSessionContent to read actual transcript/prompts/context.\n--\ncmd/entire/cli/checkpoint/ephemeral.go-289-\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\ncmd/entire/cli/checkpoint/ephemeral.go-290-\t}\ncmd/entire/cli/checkpoint/ephemeral.go-291-\tif err := validation.ValidateToolUseID(opts.ToolUseID); err != nil {\ncmd/entire/cli/checkpoint/ephemeral.go-292-\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\ncmd/entire/cli/checkpoint/ephemeral.go-293-\t}\ncmd/entire/cli/checkpoint/ephemeral.go:294:\tif err := validation.ValidateAgentID(opts.AgentID); err != nil {\ncmd/entire/cli/checkpoint/ephemeral.go-295-\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\ncmd/entire/cli/checkpoint/ephemeral.go-296-\t}\ncmd/entire/cli/checkpoint/ephemeral.go-297-\ncmd/entire/cli/checkpoint/ephemeral.go-298-\t// Get shadow branch name\ncmd/entire/cli/checkpoint/ephemeral.go-299-\tshadowBranchName := ShadowBranchNameForCommit(opts.BaseCommit, opts.WorktreeID)\n"},"started_at_ms":1788995603383,"completed_at_ms":1788995603383}}
{"timestamp":"2026-09-09T23:13:23.440Z","ordinal":13441,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a08872-8bf0-7431-85ec-306020c30c1d","call_id":"call_8BxqtSWAB8Qer0LiGLjjDJIL","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// still in flight: a completed record's transcript is stored once here and\n// then removed from session state by the caller (see resetCheckpointWindow);\n// an in-flight record's transcript-so-far is stored and the record stays so\n// the next condensation re-materializes it. A record whose transcript cannot\n// be resolved or read still produces a payload — with TranscriptUnavailableReason\n// set instead of a Transcript — so the pointer is never silently dropped.\n//\n// A record with an unsafe or empty ToolUseID, or one whose AgentID is unsafe\n// or empty at the point a transcript would be written, is skipped entirely —\n// no payload at all, not even a reason-only one: an unsafe ToolUseID has no\n// safe tasks/<id>/ directory to put a task.json under in the first place, and\n// an empty/unsafe AgentID would corrupt the agent-<id>.jsonl filename (see\n// writeTaskRecordEntries, which re-validates as a last resort). This must\n// never wedge condensation — a poisoned record produces zero payloads, not an\n// error, and the caller's normal completed-record removal\n// (resetCheckpointWindow) still drops it once completed, since a record that\n// can never materialize would otherwise retry forever.\n//\n// Task assets are appended to the incoming assets slice and returned (rather\n// than living on TaskPayload, which has no Assets field of its own) so they\n// join the checkpoint's own Assets list — see WriteOptions.Assets.\nfunc (s *ManualCommitStrategy) materializeTaskRecords(\n\tctx, logCtx context.Context,\n\tag agent.Agent,\n\tstate *SessionState,\n\tassets []cpkg.TranscriptAsset,\n) ([]cpkg.TaskPayload, []cpkg.TranscriptAsset) {\n\tif len(state.TaskRecords) == 0 {\n\t\treturn nil, assets\n\t}\n\n\tpayloads := make([]cpkg.TaskPayload, 0, len(state.TaskRecords))\n\tfor _, record := range state.TaskRecords {\n\t\tif record.ToolUseID == \"\" || validation.ValidateToolUseID(record.ToolUseID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or empty tool_use_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\tpayload := cpkg.TaskPayload{\n\t\t\tToolUseID:       record.ToolUseID,\n\t\t\tAgentID:         record.AgentID,\n\t\t\tSubagentType:    record.SubagentType,\n\t\t\tTaskDescription: record.TaskDescription,\n\t\t\tFiles:           record.Files,\n\t\t\tTokenUsage:      record.TokenUsage,\n\t\t\tStartedAt:       record.StartedAt,\n\t\t\tCompletedAt:     record.CompletedAt,\n\t\t}\n\t\tif record.TranscriptUnavailable {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnresolvable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\t// Candidate transcript paths, tried in order: the agent-declared path\n\t\t// first, then the agent-layout fallback — declared paths are\n\t\t// unreliable (agents relocate/clean up transcripts), which is why the\n\t\t// fallback resolver exists at all, so a declared-but-unreadable path\n\t\t// must not short-circuit past it.\n\t\tvar candidates []string\n\t\tif record.DeclaredTranscriptPath != \"\" {\n\t\t\tcandidates = append(candidates, record.DeclaredTranscriptPath)\n\t\t}\n\t\tif fallback := resolveTaskTranscriptPath(state, record.AgentID); fallback != \"\" && fallback != record.DeclaredTranscriptPath {\n\t\t\tcandidates = append(candidates, fallback)\n\t\t}\n\t\tif len(candidates) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnresolvable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\t// A transcript is about to be read and, if valid, stored as\n\t\t// agent-<agent-id>.jsonl — the agent ID becomes part of that path, so\n\t\t// it must be present and path-safe before going any further. Skip the\n\t\t// WHOLE record rather than merely omitting the transcript: this is\n\t\t// the same \"poisoned identifier\" shape as the ToolUseID check above.\n\t\tif record.AgentID == \"\" || validation.ValidateAgentID(record.AgentID) != nil {\n\t\t\tlogging.Warn(logCtx, \"skipping task record: unsafe or missing agent_id\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\n\t\traw, transcriptPath, readErr := readFirstTranscript(candidates)\n\t\tif readErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to read subagent transcript; storing task without it\",\n\t\t\t\tslog.String(\"session_id\", state.SessionID),\n\t\t\t\tslog.String(\"tool_use_id\", record.ToolUseID),\n\t\t\t\tslog.String(\"error\", readErr.Error()),\n\t\t\t)\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonUnreadable\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\t\tif len(raw) == 0 {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonEmpty\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n\n\t\tredacted, taskAssets, tooLarge, prepErr := prepareTaskTranscriptForStorage(ctx, logCtx, ag, state, transcriptPath, raw)\n\t\tif tooLarge {\n\t\t\tpayload.TranscriptUnavailableReason = taskTranscriptReasonTooLarge\n\t\t\tpayloads = append(payloads, payload)\n\t\t\tcontinue\n\t\t}\n"},{"type":"input_text","text":"\n---RESULT-END---\n"},{"type":"input_text","text":"cmd/entire/cli/strategy/manual_commit_condensation.go-295-}\ncmd/entire/cli/strategy/manual_commit_condensation.go-296-\ncmd/entire/cli/strategy/manual_commit_condensation.go-297-// taskTranscriptReasonUnresolvable, taskTranscriptReasonUnreadable,\ncmd/entire/cli/strategy/manual_commit_condensation.go-298-// taskTranscriptReasonEmpty, taskTranscriptReasonRedactionFailed, and\ncmd/entire/cli/strategy/manual_commit_condensation.go-299-// taskTranscriptReasonTooLarge are the stable\ncmd/entire/cli/strategy/manual_commit_condensation.go:300:// TaskPayload.TranscriptUnavailableReason categories. They deliberately\ncmd/entire/cli/strategy/manual_commit_condensation.go-301-// carry no path or underlying-error detail: task.json is pushed to\ncmd/entire/cli/strategy/manual_commit_condensation.go-302-// entire/checkpoints/v1, so a local filesystem path (which os.ReadFile's error\ncmd/entire/cli/strategy/manual_commit_condensation.go-303-// text embeds) must never end up in it. The detailed error goes only to\ncmd/entire/cli/strategy/manual_commit_condensation.go-304-// logging.Warn at the call site.\ncmd/entire/cli/strategy/manual_commit_condensation.go-305-const (\n--\ncmd/entire/cli/strategy/manual_commit_condensation.go-319-// Every record is materialized on every condensation, whether completed or\ncmd/entire/cli/strategy/manual_commit_condensation.go-320-// still in flight: a completed record's transcript is stored once here and\ncmd/entire/cli/strategy/manual_commit_condensation.go-321-// then removed from session state by the caller (see resetCheckpointWindow);\ncmd/entire/cli/strategy/manual_commit_condensation.go-322-// an in-flight record's transcript-so-far is stored and the record stays so\ncmd/entire/cli/strategy/manual_commit_condensation.go-323-// the next condensation re-materializes it. A record whose transcript cannot\ncmd/entire/cli/strategy/manual_commit_condensation.go:324:// be resolved or read still produces a payload — with TranscriptUnavailableReason\ncmd/entire/cli/strategy/manual_commit_condensation.go-325-// set instead of a Transcript — so the pointer is never silently dropped.\ncmd/entire/cli/strategy/manual_commit_condensation.go-326-//\ncmd/entire/cli/strategy/manual_commit_condensation.go-327-// A record with an unsafe or empty ToolUseID, or one whose AgentID is unsafe\ncmd/entire/cli/strategy/manual_commit_condensation.go-328-// or empty at the point a transcript would be written, is skipped entirely —\ncmd/entire/cli/strategy/manual_commit_condensation.go-329-// no payload at all, not even a reason-only one: an unsafe ToolUseID has no\ncmd/entire/cli/strategy/manual_commit_condensation.go-330-// safe tasks/<id>/ directory to put a task.json under in the first place, and\ncmd/entire/cli/strategy/manual_commit_condensation.go-331-// an empty/unsafe AgentID would corrupt the agent-<id>.jsonl filename (see\ncmd/entire/cli/strategy/manual_commit_condensation.go-332-// writeTaskRecordEntries, which re-validates as a last resort). This must\ncmd/entire/cli/strategy/manual_commit_condensation.go:333:// never wedge condensation — a poisoned record produces zero payloads, not an\ncmd/entire/cli/strategy/manual_commit_condensation.go-334-// error, and the caller's normal completed-record removal\ncmd/entire/cli/strategy/manual_commit_condensation.go-335-// (resetCheckpointWindow) still drops it once completed, since a record that\ncmd/entire/cli/strategy/manual_commit_condensation.go-336-// can never materialize would otherwise retry forever.\ncmd/entire/cli/strategy/manual_commit_condensation.go-337-//\ncmd/entire/cli/strategy/manual_commit_condensation.go-338-// Task assets are appended to the incoming assets slice and returned (rather\n--\ncmd/entire/cli/strategy/manual_commit_condensation.go-366-\t\t\tFiles:           record.Files,\ncmd/entire/cli/strategy/manual_commit_condensation.go-367-\t\t\tTokenUsage:      record.TokenUsage,\ncmd/entire/cli/strategy/manual_commit_condensation.go-368-\t\t\tStartedAt:       record.StartedAt,\ncmd/entire/cli/strategy/manual_commit_condensation.go-369-\t\t\tCompletedAt:     record.CompletedAt,\ncmd/entire/cli/strategy/manual_commit_condensation.go-370-\t\t}\ncmd/entire/cli/strategy/manual_commit_condensation.go:371:\t\tif record.TranscriptUnavailable {\ncmd/entire/cli/strategy/manual_commit_condensation.go:372:\t\t\tpayloa