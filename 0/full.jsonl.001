t-evidence.xMqGgb/npm/package/app.js-4179-    - \\`colorMode\\` is a legacy alias for \\`theme\\` and still works for now\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4180-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4181-  \\`trustedFolders\\`: list of folders where permission to read or execute files has been granted.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4182-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4183-  \\`updateTerminalTitle\\`: whether to update the terminal tab/window title with current intent; defaults to \\`true\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4184-    - Shows what the agent is currently working on in the terminal title bar\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4185-    - Only works on supported terminal emulators (xterm, iTerm, Windows Terminal, etc.)\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4186-    - Can also be disabled via the \\`COPILOT_DISABLE_TERMINAL_TITLE\\` environment variable\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4187-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4188-  \\`disableAllHooks\\`: whether to disable all hooks (repo-level and user-level); defaults to \\`false\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4189-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js:4190:  \\`hooks\\`: inline hook definitions, keyed by event name (same schema as .github/hooks/*.json).\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4191-    - In global config.json these act as user-level hooks; in repo settings.json they act as repo-level hooks\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4192-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4193-  \\`ide.autoConnect\\`: whether to automatically connect to an IDE workspace on startup; defaults to \\`true\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4194-    - When \\`false\\`, the CLI will not auto-connect to IDEs or watch for new IDE lock files\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4195-    - You can still manually connect using the /ide command\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4196-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4197-  \\`ide.openDiffOnEdit\\`: whether to open file edit diffs in the connected IDE for approval; defaults to \\`true\\`.\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4198-    - When \\`false\\`, file edit approvals are shown only in the terminal\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4199-    - The IDE connection is unaffected; diagnostics and selection features still work\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4200-`},{name:\"commands\",summary:\"Interactive Mode Commands\",content:uSt(PNe().map(e=>({name:e.name,help:e.help,aliases:e.aliases?[...e.aliases]:void 0,experimental:e.experimental})))},{name:\"limits\",summary:\"Session Limits Controls\",content:`Session Limits Controls:\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4201-\n/private/tmp/copilot-evidence.xMqGgb/npm/package/app.js-4202-  Session limits are opt-in. Usage accumulates across the entire session in both interactive and non-interactive runs.\n","exit_code":0,"duration":{"secs":0,"nanos":3459},"formatted_output":"/private/tmp/copilot-evidence.xMqGgb/npm/package/changelog.json-10047-    {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/changelog.json-10048-      \"type\": \"fixed\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/changelog.json-10049-      \"description\": \"Input prompt collapses to a single line when empty and grows naturally as you type\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/changelog.json-10050-      \"related_pull_requests\": [\"https://github.com/github/copilot-agent-runtime/pull/8173\"]\n/private/tmp/copilot-evidence.xMqGgb/npm/package/changelog.json-10051-    },\n/private/tmp/copilot-evidence.xMqGg