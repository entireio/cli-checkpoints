{"timestamp":"2026-08-24T21:45:45.171Z","ordinal":9649,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a025ce-e754-7631-8467-eaa6035ba0f8","turn_id":"01a035bb-e411-7b32-a380-13e06970de42","item":{"type":"CommandExecution","id":"exec-58c36e85-f591-4e5e-a536-c051006fa909","process_id":"54210","command":["/bin/zsh","-lc","sed -n '1,300p' cmd/entire/cli/settings/trust.go && sed -n '1,260p' cmd/entire/cli/settings/trust_test.go"],"cwd":"file:///Users/peytonmontei/Documents/Documents%20-%20Peyton%E2%80%99s%20MacBook%20Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier","parsed_cmd":[{"type":"read","cmd":"sed -n '1,300p' cmd/entire/cli/settings/trust.go","name":"trust.go","path":"cmd/entire/cli/settings/trust.go"},{"type":"read","cmd":"sed -n '1,260p' cmd/entire/cli/settings/trust_test.go","name":"trust_test.go","path":"cmd/entire/cli/settings/trust_test.go"}],"source":"unified_exec_startup","status":"completed","stdout":"package settings\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n)\n\n// TrustIdentity is the egress-consent key for one repository. Exactly one side\n// is set: OriginKeys when every configured origin URL (fetch and push)\n// normalizes — consent requires all of them — or Path (the symlink-resolved\n// worktree root) when there is no origin or ANY URL fails to normalize. The\n// split is exclusive, never a union; an identity flip re-asks. The zero value\n// (returned alongside a non-nil error) must not be consulted.\ntype TrustIdentity struct {\n\tOriginKeys []string\n\tPath       string\n}\n\n// OriginKeyed reports which side of the identity is set: true for an\n// origin-keyed repo, false for a path-keyed one.\nfunc (id TrustIdentity) OriginKeyed() bool {\n\treturn len(id.OriginKeys) > 0\n}\n\n// DisplayScope is the identity's user-facing name: the first origin key for\n// an origin-keyed repo, else the worktree root path.\nfunc (id TrustIdentity) DisplayScope() string {\n\tif id.OriginKeyed() {\n\t\treturn id.OriginKeys[0]\n\t}\n\treturn id.Path\n}\n\n// TrustSource names what grants egress consent for a repository in the\n// global trust store, for status/doctor/revoke messaging.\ntype TrustSource string\n\nconst (\n\tTrustSourceAll  TrustSource = \"trust_all\"\n\tTrustSourceRepo TrustSource = \"repo\"\n\tTrustSourceNone TrustSource = \"none\"\n)\n\n// RepoTrustIdentity derives the trust identity of the current worktree — the\n// single derivation shared by the egress gate, the trust command, status, and\n// doctor. Errors are returned for callers to fail closed on.\nfunc RepoTrustIdentity(ctx context.Context) (TrustIdentity, error) {\n\tid, _, err := currentTrustIdentity(ctx)\n\treturn id, err\n}\n\n// currentTrustIdentity is RepoTrustIdentity plus the symlink-resolved worktree\n// root, which the write helpers need even for origin-keyed repos.\nfunc currentTrustIdentity(ctx context.Context) (TrustIdentity, string, error) {\n\troot, err := worktreeRootFn(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"resolving worktree root: %w\", err)\n\t}\n\tresolvedRoot := filepath.ToSlash(root)\n\tif resolved, symErr := filepath.EvalSymlinks(root); symErr == nil {\n\t\tresolvedRoot = filepath.ToSlash(resolved)\n\t} else {\n\t\tlogging.Debug(ctx, \"trust identity: worktree root symlink resolution failed; keying on the unresolved path\",\n\t\t\tslog.String(\"error\", symErr.Error()))\n\t}\n\turls, urlsFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"reading origin remote: %w\", err)\n\t}\n\t// Push URLs join the set: git's pushurl-replaces-url rule means egress\n\t// follows the pushurl when one is set.\n\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"reading origin pushurl: %w\", err)\n\t}\n\turls = append(urls, pushURLs...)\n\tif urlsFound || pushFound {\n\t\tvar keys []string\n\t\tfor _, u := range urls {\n\t\t\tkey := normalizeOrigin(u)\n\t\t\tif key == \"\" {\n\t\t\t\tkeys = nil // any unkeyable URL flips the identity to path (see TrustIdentity)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif !slices.Contains(keys, key) {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t}\n\t\tif len(keys) > 0 {\n\t\t\treturn TrustIdentity{OriginKeys: keys}, resolvedRoot, nil\n\t\t}\n\t}\n\treturn TrustIdentity{Path: resolvedRoot}, resolvedRoot, nil\n}\n\n// CheckpointEgressAllowed reports whether checkpoint data may leave this\n// machine for the current repository: repo-level activation intent is explicit consent\n// (which also makes any checkpoint_remote configuration moot — it can only\n// live in repo-level settings); otherwise the globally-enrolled repo must be\n// trusted. Every error path returns false (fail closed).\nfunc CheckpointEgressAllowed(ctx context.Context) bool {\n\tconfigured, err := RepoActivationConfigured(ctx)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn configured || globalTrustSource(ctx) != TrustSourceNone\n}\n\n// CurrentTrustSource names what grants egress consent in the global trust\n// store only — repo-level setup is deliberately ignored — so revoke can detect\n// a removal masked by trust_all and status can name the consent source.\nfunc CurrentTrustSource(ctx context.Context) TrustSource {\n\treturn globalTrustSource(ctx)\n}\n\n// RepoUntrustedEnrolled reports the held state: enrolled by the global tier,\n// no repo-level activation intent, egress not consented. It is the ONE predicate behind\n// every untrusted-enrolled surface (banner, status, doctor).\nfunc RepoUntrustedEnrolled(ctx context.Context) bool {\n\tconfigured, err := RepoActivationConfigured(ctx)\n\treturn err == nil && !configured && GlobalModeActive(ctx) && globalTrustSource(ctx) == TrustSourceNone\n}\n\n// globalTrustSource is the single trust decision tree behind both\n// CheckpointEgressAllowed and CurrentTrustSource. Every error path resolves\n// to TrustSourceNone (fail closed).\nfunc globalTrustSource(ctx context.Context) TrustSource {\n\tus, err := LoadUserSettings(ctx)\n\tif err != nil || us.Global == nil {\n\t\treturn TrustSourceNone\n\t}\n\tif us.Global.TrustAll {\n\t\treturn TrustSourceAll\n\t}\n\tid, err := RepoTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustSourceNone\n\t}\n\tif identityTrusted(ctx, us.Global, id) {\n\t\treturn TrustSourceRepo\n\t}\n\treturn TrustSourceNone\n}\n\n// TrustCurrentRepo records egress consent for the current repository's\n// identity and returns it. Origin-keyed repos get ALL their URL keys written;\n// any trusted_paths entry for this root is pruned in the same write, or it\n// would resurrect trust once the origin is removed. Idempotent.\nfunc TrustCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\tid, root, err := currentTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tg := us.Global\n\t\tif len(id.OriginKeys) > 0 {\n\t\t\tfor _, key := range id.OriginKeys {\n\t\t\t\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\n\t\t\t\t\tg.TrustedOrigins = append(g.TrustedOrigins, key)\n\t\t\t\t}\n\t\t\t}\n\t\t\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\n\t\t\treturn nil\n\t\t}\n\t\tif !anyPathEntryIsRoot(ctx, g.TrustedPaths, root) {\n\t\t\tg.TrustedPaths = append(g.TrustedPaths, root)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn id, nil\n}\n\n// ErrGlobalModeUnconfigured is returned by the trust writers when the global\n// tier was never configured, as a sentinel so `entire trust` can swap it for\n// a friendly message.\nvar ErrGlobalModeUnconfigured = errors.New(\"global mode is not configured; nothing to trust\")\n\n// requireConfiguredGlobal guards every trust writer: materializing the global\n// block would flip GlobalConfigured() and suppress the ask-once question.\nfunc requireConfiguredGlobal(us *UserSettings) error {\n\tif us.Global == nil {\n\t\treturn ErrGlobalModeUnconfigured\n\t}\n\treturn nil\n}\n\n// TrustAllRepos records machine-wide egress consent (trust_all). Per-repo keys\n// are left untouched, so disabling trust_all later restores the per-repo state.\nfunc TrustAllRepos(ctx context.Context) error {\n\treturn ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tus.Global.TrustAll = true\n\t\treturn nil\n\t})\n}\n\n// RevokeCurrentRepo withdraws egress consent for the current repository's\n// identity and returns it. It removes the identity's origin keys AND any\n// trusted_paths entry for this root regardless of identity side (a leftover\n// path entry would resurrect trust once the origin is removed); other repos'\n// keys, the exclude lists, and trust_all are never touched. Idempotent for a\n// configured tier; an unconfigured tier returns ErrGlobalModeUnconfigured.\n// Not retroactive.\nfunc RevokeCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\tid, root, err := currentTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tg := us.Global\n\t\tif len(id.OriginKeys) > 0 {\n\t\t\tvar kept []string\n\t\t\tfor _, e := range g.TrustedOrigins {\n\t\t\t\tif !slices.Contains(id.OriginKeys, canonicalOriginEntry(e)) {\n\t\t\t\t\tkept = append(kept, e)\n\t\t\t\t}\n\t\t\t}\n\t\t\tg.TrustedOrigins = kept\n\t\t}\n\t\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn id, nil\n}\n\n// identityTrusted checks id against the trust lists, honoring the exclusivity\n// documented on TrustIdentity: origin-keyed repos consult ONLY\n// trusted_origins (every key required), path-keyed repos ONLY trusted_paths.\nfunc identityTrusted(ctx context.Context, g *GlobalConfig, id TrustIdentity) bool {\n\tif len(id.OriginKeys) > 0 {\n\t\tfor _, key := range id.OriginKeys {\n\t\t\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\t// Per-entry so one unreadable hand-edit can't veto every valid grant; an\n\t// unreadable entry cannot grant trust either way (still fail-closed).\n\treturn anyPathEntryIsRoot(ctx, g.TrustedPaths, id.Path)\n}\n\n// canonicalOriginEntry defines hand-edited-entry tolerance for\n// trusted_origins: trimmed and case-folded, never glob-expanded. Both the\n// gate's membership check and revoke's removal filter go through it.\nfunc canonicalOriginEntry(e string) string {\n\treturn strings.ToLower(strings.TrimSpace(e))\n}\n\nfunc containsTrustedOrigin(entries []string, key string) bool {\n\tfor _, e := range entries {\n\t\tif canonicalOriginEntry(e) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// pathEntryIsRoot reports whether one trusted_paths entry refers to root, with\n// the same given/resolved/case bridging as the gate's matcher. An entry it\n// cannot interpret reports false.\nfunc pathEntryIsRoot(ctx context.Context, entry, root string) bool {\n\tok, err := matchesExcludePathExact(ctx, []string{entry}, root)\n\treturn err == nil && ok\n}\n\nfunc anyPathEntryIsRoot(ctx context.Context, entries []string, root string) bool {\n\tfor _, e := range entries {\n\t\tif pathEntryIsRoot(ctx, e, root) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc withoutPathEntriesFor(ctx context.Context, entries []string, root string) []string {\n\tvar kept []string\n\tfor _, e := range entries {\npackage settings\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// resolvedRoot returns dir in the symlink-resolved slash form trust path keys use.\nfunc resolvedRoot(t *testing.T, dir string) string {\n\tt.Helper()\n\tresolved, err := filepath.EvalSymlinks(dir)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn filepath.ToSlash(resolved)\n}\n\n// newTrustTestRepo initializes an isolated repo with a fresh user settings dir\n// and enters it. Not parallel-safe: t.Setenv/t.Chdir.\nfunc newTrustTestRepo(t *testing.T) (dir, cfg string) {\n\tt.Helper()\n\tdir = newGlobalTestRepo(t)\n\tcfg = t.TempDir()\n\tt.Setenv(\"ENTIRE_CONFIG_DIR\", cfg)\n\tt.Chdir(dir)\n\treturn dir, cfg\n}\n\n// TestCheckpointEgressAllowed drives the gate across the identity rules:\n// fetch AND push URL keys all required, unkeyable URLs flip to path,\n// exclusive identity sides, every failure holds.\nfunc TestCheckpointEgressAllowed(t *testing.T) {\n\tmultiURLOrigin := [][]string{\n\t\t{\"remote\", \"add\", \"origin\", \"git@gitlab.example.com:team/proj.git\"},\n\t\t{\"remote\", \"set-url\", \"--add\", \"origin\", \"https://github.com/Acme/Widgets.git\"},\n\t}\n\tnormalOriginWithPushurl := [][]string{\n\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t{\"config\", \"remote.origin.pushurl\", \"git@gitlab.example.com:team/proj.git\"},\n\t}\n\tfor _, tc := range []struct {\n\t\tname            string\n\t\tremotes         [][]string\n\t\tuserSettings    string // %ROOT% expands to the resolved worktree root\n\t\trepoSetup       bool\n\t\tunreadableStore bool\n\t\twant            bool\n\t}{\n\t\t// checkpoint_remote is moot: it can only live in repo-level settings.\n\t\t{\"repo-level setup passes even with checkpoint_remote configured\", nil, \"\", true, false, true},\n\t\t{\"trust_all passes\", nil, `{\"global\":{\"enabled\":true,\"trust_all\":true}}`, false, false, true},\n\t\t{\"a trusted subset of a multi-URL origin holds\", multiURLOrigin,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t{\"all origin keys trusted passes\", multiURLOrigin,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"gitlab.example.com/team/proj\",\"github.com/acme/widgets\"]}}`, false, false, true},\n\t\t// Egress follows the pushurl (pushurl-replaces-url): its key is required.\n\t\t{\"the fetch-URL key alone does not cover a differing pushurl\", normalOriginWithPushurl,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t{\"fetch-URL and pushurl keys together pass\", normalOriginWithPushurl,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\",\"gitlab.example.com/team/proj\"]}}`, false, false, true},\n\t\t// Any unkeyable URL flips the WHOLE identity to path (never partial keys).\n\t\t{\"unnormalizable pushurl flips the identity to path\", [][]string{\n\t\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t\t{\"config\", \"remote.origin.pushurl\", \"file:///srv/git/secret.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, true},\n\t\t{\"a mixed origin holds even with its normalizable key trusted\", [][]string{\n\t\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t\t{\"remote\", \"set-url\", \"--add\", \"origin\", \"file:///srv/git/secret.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t// Identity exclusivity: gaining an origin re-asks.\n\t\t{\"a trusted path does not cover an origin-keyed identity\",\n\t\t\t[][]string{{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, false},\n\t\t{\"trusted path identity passes with no origin\", nil, `{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, true},\n\t\t// settings.json as a DIRECTORY exercises the read-error branch portably.\n\t\t{\"unreadable user settings hold (fail closed)\", nil, \"\", false, true, false},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tdir, cfg := newTrustTestRepo(t)\n\t\t\tfor _, args := range tc.remotes {\n\t\t\t\taddTestRemote(t, dir, args...)\n\t\t\t}\n\t\t\tif tc.repoSetup {\n\t\t\t\tif err := os.MkdirAll(filepath.Join(dir, \".entire\"), 0o755); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\trepoSettings := `{\"enabled\":true,\"strategy_options\":{\"checkpoint_remote\":{\"provider\":\"github\",\"repo\":\"acme/widgets\"}}}`\n\t\t\t\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(repoSettings), 0o600); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif tc.unreadableStore {\n\t\t\t\tif err := os.MkdirAll(filepath.Join(cfg, UserSettingsFileName), 0o755); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif tc.userSettings != \"\" {\n\t\t\t\twriteUserSettings(t, cfg, strings.ReplaceAll(tc.userSettings, \"%ROOT%\", resolvedRoot(t, dir)))\n\t\t\t}\n\t\t\tif got := CheckpointEgressAllowed(t.Context()); got != tc.want {\n\t\t\t\tt.Fatalf(\"CheckpointEgressAllowed = %v, want %v\", got, tc.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCheckpointEgressAllowed_IncidentalRepoSettingsRequireGlobalTrust(t *testing.T) {\n\tdir, cfg := newTrustTestRepo(t)\n\tif err := os.MkdirAll(filepath.Join(dir, \".entire\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(`{\"investigate\":{\"max_turns\":4}}`), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true}}`)\n\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"an incidental repo settings file must not grant checkpoint egress\")\n\t}\n\tif !RepoUntrustedEnrolled(t.Context()) {\n\t\tt.Fatal(\"an incidental repo settings file must retain the globally enrolled trust hold\")\n\t}\n\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true,\"trust_all\":true}}`)\n\tif !CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"trust_all must grant egress when repo settings contain no activation intent\")\n\t}\n\n\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(`{\"enabled\":`), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"malformed repo settings must fail closed even when trust_all is enabled\")\n\t}\n}\n\n// TestTrustAndRevokeCurrentRepo: trusting writes ALL origin keys once\n// (idempotent) and prunes the stale path entry; revoking removes the keys AND\n// the path entry, so removing the origin later cannot resurrect trust.\nfunc TestTrustAndRevokeCurrentRepo(t *testing.T) {\n\tdir, cfg := newTrustTestRepo(t)\n\troot := resolvedRoot(t, dir)\n\taddTestRemote(t, dir, \"remote\", \"add\", \"origin\", \"git@gitlab.example.com:team/proj.git\")\n\taddTestRemote(t, dir, \"remote\", \"set-url\", \"--add\", \"origin\", \"https://github.com/acme/widgets.git\")\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true,\"trusted_paths\":[\"`+root+`\",\"/srv/other\"]}}`)\n\tfor range 2 { // second call pins idempotency (no duplicate keys)\n\t\tif _, err := TrustCurrentRepo(t.Context()); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tus, err := LoadUserSettings(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\twantKeys := []string{\"gitlab.example.com/team/proj\", \"github.com/acme/widgets\"}\n\tif !slices.Equal(us.Global.TrustedOrigins, wantKeys) {\n\t\tt.Fatalf(\"trusted_origins = %v, want ALL configured URL keys %v once\", us.Global.TrustedOrigins, wantKeys)\n\t}\n\tif !slices.Equal(us.Global.TrustedPaths, []string{\"/srv/other\"}) {\n\t\tt.Fatalf(\"trusted_paths = %v, want this root pruned and other entries kept\", us.Global.TrustedPaths)\n\t}\n\tif !CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"the gate must open immediately after trusting\")\n\t}\n\n\t// Re-seed a hand-added path entry for the root: revoke itself must drop it.\n\twriteUserSettings(t, cfg,\n\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"gitlab.example.com/team/proj\",\"github.com/acme/widgets\"],\"trusted_paths\":[\"`+root+`\"]}}`)\n\tid, err := RevokeCurrentRepo(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !slices.Equal(id.OriginKeys, wantKeys) {\n\t\tt.Fatalf(\"revoked identity = %+v, want the origin keys\", id)\n\t}\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"the revoked origin identity must hold\")\n\t}\n\taddTestRemote(t, dir, \"remote\", \"remove\", \"origin\")\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"after the origin is removed, a stale path entry must not resurrect trust\")\n\t}\n}\n\nfunc TestTrustAllRepos_UnconfiguredTierErrorsWithoutMaterializingGlobal(t *testing.T) {\n\tnewTrustTestRepo(t)\n\tif err := TrustAllRepos(t.Context()); err == nil {\n\t\tt.Fatal(\"trust_all with no global block must error, not invent one\")\n\t}\n\tus, err := LoadUserSettings(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif us.Global != nil {\n\t\tt.Fatal(\"a failed trust_all write must not materialize the global block\")\n\t}\n}\n","stderr":"","aggregated_output":"package settings\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n)\n\n// TrustIdentity is the egress-consent key for one repository. Exactly one side\n// is set: OriginKeys when every configured origin URL (fetch and push)\n// normalizes — consent requires all of them — or Path (the symlink-resolved\n// worktree root) when there is no origin or ANY URL fails to normalize. The\n// split is exclusive, never a union; an identity flip re-asks. The zero value\n// (returned alongside a non-nil error) must not be consulted.\ntype TrustIdentity struct {\n\tOriginKeys []string\n\tPath       string\n}\n\n// OriginKeyed reports which side of the identity is set: true for an\n// origin-keyed repo, false for a path-keyed one.\nfunc (id TrustIdentity) OriginKeyed() bool {\n\treturn len(id.OriginKeys) > 0\n}\n\n// DisplayScope is the identity's user-facing name: the first origin key for\n// an origin-keyed repo, else the worktree root path.\nfunc (id TrustIdentity) DisplayScope() string {\n\tif id.OriginKeyed() {\n\t\treturn id.OriginKeys[0]\n\t}\n\treturn id.Path\n}\n\n// TrustSource names what grants egress consent for a repository in the\n// global trust store, for status/doctor/revoke messaging.\ntype TrustSource string\n\nconst (\n\tTrustSourceAll  TrustSource = \"trust_all\"\n\tTrustSourceRepo TrustSource = \"repo\"\n\tTrustSourceNone TrustSource = \"none\"\n)\n\n// RepoTrustIdentity derives the trust identity of the current worktree — the\n// single derivation shared by the egress gate, the trust command, status, and\n// doctor. Errors are returned for callers to fail closed on.\nfunc RepoTrustIdentity(ctx context.Context) (TrustIdentity, error) {\n\tid, _, err := currentTrustIdentity(ctx)\n\treturn id, err\n}\n\n// currentTrustIdentity is RepoTrustIdentity plus the symlink-resolved worktree\n// root, which the write helpers need even for origin-keyed repos.\nfunc currentTrustIdentity(ctx context.Context) (TrustIdentity, string, error) {\n\troot, err := worktreeRootFn(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"resolving worktree root: %w\", err)\n\t}\n\tresolvedRoot := filepath.ToSlash(root)\n\tif resolved, symErr := filepath.EvalSymlinks(root); symErr == nil {\n\t\tresolvedRoot = filepath.ToSlash(resolved)\n\t} else {\n\t\tlogging.Debug(ctx, \"trust identity: worktree root symlink resolution failed; keying on the unresolved path\",\n\t\t\tslog.String(\"error\", symErr.Error()))\n\t}\n\turls, urlsFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"reading origin remote: %w\", err)\n\t}\n\t// Push URLs join the set: git's pushurl-replaces-url rule means egress\n\t// follows the pushurl when one is set.\n\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"reading origin pushurl: %w\", err)\n\t}\n\turls = append(urls, pushURLs...)\n\tif urlsFound || pushFound {\n\t\tvar keys []string\n\t\tfor _, u := range urls {\n\t\t\tkey := normalizeOrigin(u)\n\t\t\tif key == \"\" {\n\t\t\t\tkeys = nil // any unkeyable URL flips the identity to path (see TrustIdentity)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif !slices.Contains(keys, key) {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t}\n\t\tif len(keys) > 0 {\n\t\t\treturn TrustIdentity{OriginKeys: keys}, resolvedRoot, nil\n\t\t}\n\t}\n\treturn TrustIdentity{Path: resolvedRoot}, resolvedRoot, nil\n}\n\n// CheckpointEgressAllowed reports whether checkpoint data may leave this\n// machine for the current repository: repo-level activation intent is explicit consent\n// (which also makes any checkpoint_remote configuration moot — it can only\n// live in repo-level settings); otherwise the globally-enrolled repo must be\n// trusted. Every error path returns false (fail closed).\nfunc CheckpointEgressAllowed(ctx context.Context) bool {\n\tconfigured, err := RepoActivationConfigured(ctx)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn configured || globalTrustSource(ctx) != TrustSourceNone\n}\n\n// CurrentTrustSource names what grants egress consent in the global trust\n// store only — repo-level setup is deliberately ignored — so revoke can detect\n// a removal masked by trust_all and status can name the consent source.\nfunc CurrentTrustSource(ctx context.Context) TrustSource {\n\treturn globalTrustSource(ctx)\n}\n\n// RepoUntrustedEnrolled reports the held state: enrolled by the global tier,\n// no repo-level activation intent, egress not consented. It is the ONE predicate behind\n// every untrusted-enrolled surface (banner, status, doctor).\nfunc RepoUntrustedEnrolled(ctx context.Context) bool {\n\tconfigured, err := RepoActivationConfigured(ctx)\n\treturn err == nil && !configured && GlobalModeActive(ctx) && globalTrustSource(ctx) == TrustSourceNone\n}\n\n// globalTrustSource is the single trust decision tree behind both\n// CheckpointEgressAllowed and CurrentTrustSource. Every error path resolves\n// to TrustSourceNone (fail closed).\nfunc globalTrustSource(ctx context.Context) TrustSource {\n\tus, err := LoadUserSettings(ctx)\n\tif err != nil || us.Global == nil {\n\t\treturn TrustSourceNone\n\t}\n\tif us.Global.TrustAll {\n\t\treturn TrustSourceAll\n\t}\n\tid, err := RepoTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustSourceNone\n\t}\n\tif identityTrusted(ctx, us.Global, id) {\n\t\treturn TrustSourceRepo\n\t}\n\treturn TrustSourceNone\n}\n\n// TrustCurrentRepo records egress consent for the current repository's\n// identity and returns it. Origin-keyed repos get ALL their URL keys written;\n// any trusted_paths entry for this root is pruned in the same write, or it\n// would resurrect trust once the origin is removed. Idempotent.\nfunc TrustCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\tid, root, err := currentTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tg := us.Global\n\t\tif len(id.OriginKeys) > 0 {\n\t\t\tfor _, key := range id.OriginKeys {\n\t\t\t\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\n\t\t\t\t\tg.TrustedOrigins = append(g.TrustedOrigins, key)\n\t\t\t\t}\n\t\t\t}\n\t\t\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\n\t\t\treturn nil\n\t\t}\n\t\tif !anyPathEntryIsRoot(ctx, g.TrustedPaths, root) {\n\t\t\tg.TrustedPaths = append(g.TrustedPaths, root)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn id, nil\n}\n\n// ErrGlobalModeUnconfigured is returned by the trust writers when the global\n// tier was never configured, as a sentinel so `entire trust` can swap it for\n// a friendly message.\nvar ErrGlobalModeUnconfigured = errors.New(\"global mode is not configured; nothing to trust\")\n\n// requireConfiguredGlobal guards every trust writer: materializing the global\n// block would flip GlobalConfigured() and suppress the ask-once question.\nfunc requireConfiguredGlobal(us *UserSettings) error {\n\tif us.Global == nil {\n\t\treturn ErrGlobalModeUnconfigured\n\t}\n\treturn nil\n}\n\n// TrustAllRepos records machine-wide egress consent (trust_all). Per-repo keys\n// are left untouched, so disabling trust_all later restores the per-repo state.\nfunc TrustAllRepos(ctx context.Context) error {\n\treturn ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tus.Global.TrustAll = true\n\t\treturn nil\n\t})\n}\n\n// RevokeCurrentRepo withdraws egress consent for the current repository's\n// identity and returns it. It removes the identity's origin keys AND any\n// trusted_paths entry for this root regardless of identity side (a leftover\n// path entry would resurrect trust once the origin is removed); other repos'\n// keys, the exclude lists, and trust_all are never touched. Idempotent for a\n// configured tier; an unconfigured tier returns ErrGlobalModeUnconfigured.\n// Not retroactive.\nfunc RevokeCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\tid, root, err := currentTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tg := us.Global\n\t\tif len(id.OriginKeys) > 0 {\n\t\t\tvar kept []string\n\t\t\tfor _, e := range g.TrustedOrigins {\n\t\t\t\tif !slices.Contains(id.OriginKeys, canonicalOriginEntry(e)) {\n\t\t\t\t\tkept = append(kept, e)\n\t\t\t\t}\n\t\t\t}\n\t\t\tg.TrustedOrigins = kept\n\t\t}\n\t\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn id, nil\n}\n\n// identityTrusted checks id against the trust lists, honoring the exclusivity\n// documented on TrustIdentity: origin-keyed repos consult ONLY\n// trusted_origins (every key required), path-keyed repos ONLY trusted_paths.\nfunc identityTrusted(ctx context.Context, g *GlobalConfig, id TrustIdentity) bool {\n\tif len(id.OriginKeys) > 0 {\n\t\tfor _, key := range id.OriginKeys {\n\t\t\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\t// Per-entry so one unreadable hand-edit can't veto every valid grant; an\n\t// unreadable entry cannot grant trust either way (still fail-closed).\n\treturn anyPathEntryIsRoot(ctx, g.TrustedPaths, id.Path)\n}\n\n// canonicalOriginEntry defines hand-edited-entry tolerance for\n// trusted_origins: trimmed and case-folded, never glob-expanded. Both the\n// gate's membership check and revoke's removal filter go through it.\nfunc canonicalOriginEntry(e string) string {\n\treturn strings.ToLower(strings.TrimSpace(e))\n}\n\nfunc containsTrustedOrigin(entries []string, key string) bool {\n\tfor _, e := range entries {\n\t\tif canonicalOriginEntry(e) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// pathEntryIsRoot reports whether one trusted_paths entry refers to root, with\n// the same given/resolved/case bridging as the gate's matcher. An entry it\n// cannot interpret reports false.\nfunc pathEntryIsRoot(ctx context.Context, entry, root string) bool {\n\tok, err := matchesExcludePathExact(ctx, []string{entry}, root)\n\treturn err == nil && ok\n}\n\nfunc anyPathEntryIsRoot(ctx context.Context, entries []string, root string) bool {\n\tfor _, e := range entries {\n\t\tif pathEntryIsRoot(ctx, e, root) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc withoutPathEntriesFor(ctx context.Context, entries []string, root string) []string {\n\tvar kept []string\n\tfor _, e := range entries {\npackage settings\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// resolvedRoot returns dir in the symlink-resolved slash form trust path keys use.\nfunc resolvedRoot(t *testing.T, dir string) string {\n\tt.Helper()\n\tresolved, err := filepath.EvalSymlinks(dir)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn filepath.ToSlash(resolved)\n}\n\n// newTrustTestRepo initializes an isolated repo with a fresh user settings dir\n// and enters it. Not parallel-safe: t.Setenv/t.Chdir.\nfunc newTrustTestRepo(t *testing.T) (dir, cfg string) {\n\tt.Helper()\n\tdir = newGlobalTestRepo(t)\n\tcfg = t.TempDir()\n\tt.Setenv(\"ENTIRE_CONFIG_DIR\", cfg)\n\tt.Chdir(dir)\n\treturn dir, cfg\n}\n\n// TestCheckpointEgressAllowed drives the gate across the identity rules:\n// fetch AND push URL keys all required, unkeyable URLs flip to path,\n// exclusive identity sides, every failure holds.\nfunc TestCheckpointEgressAllowed(t *testing.T) {\n\tmultiURLOrigin := [][]string{\n\t\t{\"remote\", \"add\", \"origin\", \"git@gitlab.example.com:team/proj.git\"},\n\t\t{\"remote\", \"set-url\", \"--add\", \"origin\", \"https://github.com/Acme/Widgets.git\"},\n\t}\n\tnormalOriginWithPushurl := [][]string{\n\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t{\"config\", \"remote.origin.pushurl\", \"git@gitlab.example.com:team/proj.git\"},\n\t}\n\tfor _, tc := range []struct {\n\t\tname            string\n\t\tremotes         [][]string\n\t\tuserSettings    string // %ROOT% expands to the resolved worktree root\n\t\trepoSetup       bool\n\t\tunreadableStore bool\n\t\twant            bool\n\t}{\n\t\t// checkpoint_remote is moot: it can only live in repo-level settings.\n\t\t{\"repo-level setup passes even with checkpoint_remote configured\", nil, \"\", true, false, true},\n\t\t{\"trust_all passes\", nil, `{\"global\":{\"enabled\":true,\"trust_all\":true}}`, false, false, true},\n\t\t{\"a trusted subset of a multi-URL origin holds\", multiURLOrigin,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t{\"all origin keys trusted passes\", multiURLOrigin,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"gitlab.example.com/team/proj\",\"github.com/acme/widgets\"]}}`, false, false, true},\n\t\t// Egress follows the pushurl (pushurl-replaces-url): its key is required.\n\t\t{\"the fetch-URL key alone does not cover a differing pushurl\", normalOriginWithPushurl,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t{\"fetch-URL and pushurl keys together pass\", normalOriginWithPushurl,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\",\"gitlab.example.com/team/proj\"]}}`, false, false, true},\n\t\t// Any unkeyable URL flips the WHOLE identity to path (never partial keys).\n\t\t{\"unnormalizable pushurl flips the identity to path\", [][]string{\n\t\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t\t{\"config\", \"remote.origin.pushurl\", \"file:///srv/git/secret.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, true},\n\t\t{\"a mixed origin holds even with its normalizable key trusted\", [][]string{\n\t\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t\t{\"remote\", \"set-url\", \"--add\", \"origin\", \"file:///srv/git/secret.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t// Identity exclusivity: gaining an origin re-asks.\n\t\t{\"a trusted path does not cover an origin-keyed identity\",\n\t\t\t[][]string{{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, false},\n\t\t{\"trusted path identity passes with no origin\", nil, `{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, true},\n\t\t// settings.json as a DIRECTORY exercises the read-error branch portably.\n\t\t{\"unreadable user settings hold (fail closed)\", nil, \"\", false, true, false},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tdir, cfg := newTrustTestRepo(t)\n\t\t\tfor _, args := range tc.remotes {\n\t\t\t\taddTestRemote(t, dir, args...)\n\t\t\t}\n\t\t\tif tc.repoSetup {\n\t\t\t\tif err := os.MkdirAll(filepath.Join(dir, \".entire\"), 0o755); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\trepoSettings := `{\"enabled\":true,\"strategy_options\":{\"checkpoint_remote\":{\"provider\":\"github\",\"repo\":\"acme/widgets\"}}}`\n\t\t\t\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(repoSettings), 0o600); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif tc.unreadableStore {\n\t\t\t\tif err := os.MkdirAll(filepath.Join(cfg, UserSettingsFileName), 0o755); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif tc.userSettings != \"\" {\n\t\t\t\twriteUserSettings(t, cfg, strings.ReplaceAll(tc.userSettings, \"%ROOT%\", resolvedRoot(t, dir)))\n\t\t\t}\n\t\t\tif got := CheckpointEgressAllowed(t.Context()); got != tc.want {\n\t\t\t\tt.Fatalf(\"CheckpointEgressAllowed = %v, want %v\", got, tc.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCheckpointEgressAllowed_IncidentalRepoSettingsRequireGlobalTrust(t *testing.T) {\n\tdir, cfg := newTrustTestRepo(t)\n\tif err := os.MkdirAll(filepath.Join(dir, \".entire\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(`{\"investigate\":{\"max_turns\":4}}`), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true}}`)\n\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"an incidental repo settings file must not grant checkpoint egress\")\n\t}\n\tif !RepoUntrustedEnrolled(t.Context()) {\n\t\tt.Fatal(\"an incidental repo settings file must retain the globally enrolled trust hold\")\n\t}\n\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true,\"trust_all\":true}}`)\n\tif !CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"trust_all must grant egress when repo settings contain no activation intent\")\n\t}\n\n\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(`{\"enabled\":`), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"malformed repo settings must fail closed even when trust_all is enabled\")\n\t}\n}\n\n// TestTrustAndRevokeCurrentRepo: trusting writes ALL origin keys once\n// (idempotent) and prunes the stale path entry; revoking removes the keys AND\n// the path entry, so removing the origin later cannot resurrect trust.\nfunc TestTrustAndRevokeCurrentRepo(t *testing.T) {\n\tdir, cfg := newTrustTestRepo(t)\n\troot := resolvedRoot(t, dir)\n\taddTestRemote(t, dir, \"remote\", \"add\", \"origin\", \"git@gitlab.example.com:team/proj.git\")\n\taddTestRemote(t, dir, \"remote\", \"set-url\", \"--add\", \"origin\", \"https://github.com/acme/widgets.git\")\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true,\"trusted_paths\":[\"`+root+`\",\"/srv/other\"]}}`)\n\tfor range 2 { // second call pins idempotency (no duplicate keys)\n\t\tif _, err := TrustCurrentRepo(t.Context()); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tus, err := LoadUserSettings(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\twantKeys := []string{\"gitlab.example.com/team/proj\", \"github.com/acme/widgets\"}\n\tif !slices.Equal(us.Global.TrustedOrigins, wantKeys) {\n\t\tt.Fatalf(\"trusted_origins = %v, want ALL configured URL keys %v once\", us.Global.TrustedOrigins, wantKeys)\n\t}\n\tif !slices.Equal(us.Global.TrustedPaths, []string{\"/srv/other\"}) {\n\t\tt.Fatalf(\"trusted_paths = %v, want this root pruned and other entries kept\", us.Global.TrustedPaths)\n\t}\n\tif !CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"the gate must open immediately after trusting\")\n\t}\n\n\t// Re-seed a hand-added path entry for the root: revoke itself must drop it.\n\twriteUserSettings(t, cfg,\n\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"gitlab.example.com/team/proj\",\"github.com/acme/widgets\"],\"trusted_paths\":[\"`+root+`\"]}}`)\n\tid, err := RevokeCurrentRepo(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !slices.Equal(id.OriginKeys, wantKeys) {\n\t\tt.Fatalf(\"revoked identity = %+v, want the origin keys\", id)\n\t}\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"the revoked origin identity must hold\")\n\t}\n\taddTestRemote(t, dir, \"remote\", \"remove\", \"origin\")\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"after the origin is removed, a stale path entry must not resurrect trust\")\n\t}\n}\n\nfunc TestTrustAllRepos_UnconfiguredTierErrorsWithoutMaterializingGlobal(t *testing.T) {\n\tnewTrustTestRepo(t)\n\tif err := TrustAllRepos(t.Context()); err == nil {\n\t\tt.Fatal(\"trust_all with no global block must error, not invent one\")\n\t}\n\tus, err := LoadUserSettings(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif us.Global != nil {\n\t\tt.Fatal(\"a failed trust_all write must not materialize the global block\")\n\t}\n}\n","exit_code":0,"duration":{"secs":0,"nanos":5333},"formatted_output":"package settings\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n)\n\n// TrustIdentity is the egress-consent key for one repository. Exactly one side\n// is set: OriginKeys when every configured origin URL (fetch and push)\n// normalizes — consent requires all of them — or Path (the symlink-resolved\n// worktree root) when there is no origin or ANY URL fails to normalize. The\n// split is exclusive, never a union; an identity flip re-asks. The zero value\n// (returned alongside a non-nil error) must not be consulted.\ntype TrustIdentity struct {\n\tOriginKeys []string\n\tPath       string\n}\n\n// OriginKeyed reports which side of the identity is set: true for an\n// origin-keyed repo, false for a path-keyed one.\nfunc (id TrustIdentity) OriginKeyed() bool {\n\treturn len(id.OriginKeys) > 0\n}\n\n// DisplayScope is the identity's user-facing name: the first origin key for\n// an origin-keyed repo, else the worktree root path.\nfunc (id TrustIdentity) DisplayScope() string {\n\tif id.OriginKeyed() {\n\t\treturn id.OriginKeys[0]\n\t}\n\treturn id.Path\n}\n\n// TrustSource names what grants egress consent for a repository in the\n// global trust store, for status/doctor/revoke messaging.\ntype TrustSource string\n\nconst (\n\tTrustSourceAll  TrustSource = \"trust_all\"\n\tTrustSourceRepo TrustSource = \"repo\"\n\tTrustSourceNone TrustSource = \"none\"\n)\n\n// RepoTrustIdentity derives the trust identity of the current worktree — the\n// single derivation shared by the egress gate, the trust command, status, and\n// doctor. Errors are returned for callers to fail closed on.\nfunc RepoTrustIdentity(ctx context.Context) (TrustIdentity, error) {\n\tid, _, err := currentTrustIdentity(ctx)\n\treturn id, err\n}\n\n// currentTrustIdentity is RepoTrustIdentity plus the symlink-resolved worktree\n// root, which the write helpers need even for origin-keyed repos.\nfunc currentTrustIdentity(ctx context.Context) (TrustIdentity, string, error) {\n\troot, err := worktreeRootFn(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"resolving worktree root: %w\", err)\n\t}\n\tresolvedRoot := filepath.ToSlash(root)\n\tif resolved, symErr := filepath.EvalSymlinks(root); symErr == nil {\n\t\tresolvedRoot = filepath.ToSlash(resolved)\n\t} else {\n\t\tlogging.Debug(ctx, \"trust identity: worktree root symlink resolution failed; keying on the unresolved path\",\n\t\t\tslog.String(\"error\", symErr.Error()))\n\t}\n\turls, urlsFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"reading origin remote: %w\", err)\n\t}\n\t// Push URLs join the set: git's pushurl-replaces-url rule means egress\n\t// follows the pushurl when one is set.\n\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn TrustIdentity{}, \"\", fmt.Errorf(\"reading origin pushurl: %w\", err)\n\t}\n\turls = append(urls, pushURLs...)\n\tif urlsFound || pushFound {\n\t\tvar keys []string\n\t\tfor _, u := range urls {\n\t\t\tkey := normalizeOrigin(u)\n\t\t\tif key == \"\" {\n\t\t\t\tkeys = nil // any unkeyable URL flips the identity to path (see TrustIdentity)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif !slices.Contains(keys, key) {\n\t\t\t\tkeys = append(keys, key)\n\t\t\t}\n\t\t}\n\t\tif len(keys) > 0 {\n\t\t\treturn TrustIdentity{OriginKeys: keys}, resolvedRoot, nil\n\t\t}\n\t}\n\treturn TrustIdentity{Path: resolvedRoot}, resolvedRoot, nil\n}\n\n// CheckpointEgressAllowed reports whether checkpoint data may leave this\n// machine for the current repository: repo-level activation intent is explicit consent\n// (which also makes any checkpoint_remote configuration moot — it can only\n// live in repo-level settings); otherwise the globally-enrolled repo must be\n// trusted. Every error path returns false (fail closed).\nfunc CheckpointEgressAllowed(ctx context.Context) bool {\n\tconfigured, err := RepoActivationConfigured(ctx)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn configured || globalTrustSource(ctx) != TrustSourceNone\n}\n\n// CurrentTrustSource names what grants egress consent in the global trust\n// store only — repo-level setup is deliberately ignored — so revoke can detect\n// a removal masked by trust_all and status can name the consent source.\nfunc CurrentTrustSource(ctx context.Context) TrustSource {\n\treturn globalTrustSource(ctx)\n}\n\n// RepoUntrustedEnrolled reports the held state: enrolled by the global tier,\n// no repo-level activation intent, egress not consented. It is the ONE predicate behind\n// every untrusted-enrolled surface (banner, status, doctor).\nfunc RepoUntrustedEnrolled(ctx context.Context) bool {\n\tconfigured, err := RepoActivationConfigured(ctx)\n\treturn err == nil && !configured && GlobalModeActive(ctx) && globalTrustSource(ctx) == TrustSourceNone\n}\n\n// globalTrustSource is the single trust decision tree behind both\n// CheckpointEgressAllowed and CurrentTrustSource. Every error path resolves\n// to TrustSourceNone (fail closed).\nfunc globalTrustSource(ctx context.Context) TrustSource {\n\tus, err := LoadUserSettings(ctx)\n\tif err != nil || us.Global == nil {\n\t\treturn TrustSourceNone\n\t}\n\tif us.Global.TrustAll {\n\t\treturn TrustSourceAll\n\t}\n\tid, err := RepoTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustSourceNone\n\t}\n\tif identityTrusted(ctx, us.Global, id) {\n\t\treturn TrustSourceRepo\n\t}\n\treturn TrustSourceNone\n}\n\n// TrustCurrentRepo records egress consent for the current repository's\n// identity and returns it. Origin-keyed repos get ALL their URL keys written;\n// any trusted_paths entry for this root is pruned in the same write, or it\n// would resurrect trust once the origin is removed. Idempotent.\nfunc TrustCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\tid, root, err := currentTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tg := us.Global\n\t\tif len(id.OriginKeys) > 0 {\n\t\t\tfor _, key := range id.OriginKeys {\n\t\t\t\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\n\t\t\t\t\tg.TrustedOrigins = append(g.TrustedOrigins, key)\n\t\t\t\t}\n\t\t\t}\n\t\t\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\n\t\t\treturn nil\n\t\t}\n\t\tif !anyPathEntryIsRoot(ctx, g.TrustedPaths, root) {\n\t\t\tg.TrustedPaths = append(g.TrustedPaths, root)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn id, nil\n}\n\n// ErrGlobalModeUnconfigured is returned by the trust writers when the global\n// tier was never configured, as a sentinel so `entire trust` can swap it for\n// a friendly message.\nvar ErrGlobalModeUnconfigured = errors.New(\"global mode is not configured; nothing to trust\")\n\n// requireConfiguredGlobal guards every trust writer: materializing the global\n// block would flip GlobalConfigured() and suppress the ask-once question.\nfunc requireConfiguredGlobal(us *UserSettings) error {\n\tif us.Global == nil {\n\t\treturn ErrGlobalModeUnconfigured\n\t}\n\treturn nil\n}\n\n// TrustAllRepos records machine-wide egress consent (trust_all). Per-repo keys\n// are left untouched, so disabling trust_all later restores the per-repo state.\nfunc TrustAllRepos(ctx context.Context) error {\n\treturn ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tus.Global.TrustAll = true\n\t\treturn nil\n\t})\n}\n\n// RevokeCurrentRepo withdraws egress consent for the current repository's\n// identity and returns it. It removes the identity's origin keys AND any\n// trusted_paths entry for this root regardless of identity side (a leftover\n// path entry would resurrect trust once the origin is removed); other repos'\n// keys, the exclude lists, and trust_all are never touched. Idempotent for a\n// configured tier; an unconfigured tier returns ErrGlobalModeUnconfigured.\n// Not retroactive.\nfunc RevokeCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\tid, root, err := currentTrustIdentity(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tg := us.Global\n\t\tif len(id.OriginKeys) > 0 {\n\t\t\tvar kept []string\n\t\t\tfor _, e := range g.TrustedOrigins {\n\t\t\t\tif !slices.Contains(id.OriginKeys, canonicalOriginEntry(e)) {\n\t\t\t\t\tkept = append(kept, e)\n\t\t\t\t}\n\t\t\t}\n\t\t\tg.TrustedOrigins = kept\n\t\t}\n\t\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn id, nil\n}\n\n// identityTrusted checks id against the trust lists, honoring the exclusivity\n// documented on TrustIdentity: origin-keyed repos consult ONLY\n// trusted_origins (every key required), path-keyed repos ONLY trusted_paths.\nfunc identityTrusted(ctx context.Context, g *GlobalConfig, id TrustIdentity) bool {\n\tif len(id.OriginKeys) > 0 {\n\t\tfor _, key := range id.OriginKeys {\n\t\t\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\t// Per-entry so one unreadable hand-edit can't veto every valid grant; an\n\t// unreadable entry cannot grant trust either way (still fail-closed).\n\treturn anyPathEntryIsRoot(ctx, g.TrustedPaths, id.Path)\n}\n\n// canonicalOriginEntry defines hand-edited-entry tolerance for\n// trusted_origins: trimmed and case-folded, never glob-expanded. Both the\n// gate's membership check and revoke's removal filter go through it.\nfunc canonicalOriginEntry(e string) string {\n\treturn strings.ToLower(strings.TrimSpace(e))\n}\n\nfunc containsTrustedOrigin(entries []string, key string) bool {\n\tfor _, e := range entries {\n\t\tif canonicalOriginEntry(e) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// pathEntryIsRoot reports whether one trusted_paths entry refers to root, with\n// the same given/resolved/case bridging as the gate's matcher. An entry it\n// cannot interpret reports false.\nfunc pathEntryIsRoot(ctx context.Context, entry, root string) bool {\n\tok, err := matchesExcludePathExact(ctx, []string{entry}, root)\n\treturn err == nil && ok\n}\n\nfunc anyPathEntryIsRoot(ctx context.Context, entries []string, root string) bool {\n\tfor _, e := range entries {\n\t\tif pathEntryIsRoot(ctx, e, root) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc withoutPathEntriesFor(ctx context.Context, entries []string, root string) []string {\n\tvar kept []string\n\tfor _, e := range entries {\npackage settings\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// resolvedRoot returns dir in the symlink-resolved slash form trust path keys use.\nfunc resolvedRoot(t *testing.T, dir string) string {\n\tt.Helper()\n\tresolved, err := filepath.EvalSymlinks(dir)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn filepath.ToSlash(resolved)\n}\n\n// newTrustTestRepo initializes an isolated repo with a fresh user settings dir\n// and enters it. Not parallel-safe: t.Setenv/t.Chdir.\nfunc newTrustTestRepo(t *testing.T) (dir, cfg string) {\n\tt.Helper()\n\tdir = newGlobalTestRepo(t)\n\tcfg = t.TempDir()\n\tt.Setenv(\"ENTIRE_CONFIG_DIR\", cfg)\n\tt.Chdir(dir)\n\treturn dir, cfg\n}\n\n// TestCheckpointEgressAllowed drives the gate across the identity rules:\n// fetch AND push URL keys all required, unkeyable URLs flip to path,\n// exclusive identity sides, every failure holds.\nfunc TestCheckpointEgressAllowed(t *testing.T) {\n\tmultiURLOrigin := [][]string{\n\t\t{\"remote\", \"add\", \"origin\", \"git@gitlab.example.com:team/proj.git\"},\n\t\t{\"remote\", \"set-url\", \"--add\", \"origin\", \"https://github.com/Acme/Widgets.git\"},\n\t}\n\tnormalOriginWithPushurl := [][]string{\n\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t{\"config\", \"remote.origin.pushurl\", \"git@gitlab.example.com:team/proj.git\"},\n\t}\n\tfor _, tc := range []struct {\n\t\tname            string\n\t\tremotes         [][]string\n\t\tuserSettings    string // %ROOT% expands to the resolved worktree root\n\t\trepoSetup       bool\n\t\tunreadableStore bool\n\t\twant            bool\n\t}{\n\t\t// checkpoint_remote is moot: it can only live in repo-level settings.\n\t\t{\"repo-level setup passes even with checkpoint_remote configured\", nil, \"\", true, false, true},\n\t\t{\"trust_all passes\", nil, `{\"global\":{\"enabled\":true,\"trust_all\":true}}`, false, false, true},\n\t\t{\"a trusted subset of a multi-URL origin holds\", multiURLOrigin,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t{\"all origin keys trusted passes\", multiURLOrigin,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"gitlab.example.com/team/proj\",\"github.com/acme/widgets\"]}}`, false, false, true},\n\t\t// Egress follows the pushurl (pushurl-replaces-url): its key is required.\n\t\t{\"the fetch-URL key alone does not cover a differing pushurl\", normalOriginWithPushurl,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t{\"fetch-URL and pushurl keys together pass\", normalOriginWithPushurl,\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\",\"gitlab.example.com/team/proj\"]}}`, false, false, true},\n\t\t// Any unkeyable URL flips the WHOLE identity to path (never partial keys).\n\t\t{\"unnormalizable pushurl flips the identity to path\", [][]string{\n\t\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t\t{\"config\", \"remote.origin.pushurl\", \"file:///srv/git/secret.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, true},\n\t\t{\"a mixed origin holds even with its normalizable key trusted\", [][]string{\n\t\t\t{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"},\n\t\t\t{\"remote\", \"set-url\", \"--add\", \"origin\", \"file:///srv/git/secret.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"github.com/acme/widgets\"]}}`, false, false, false},\n\t\t// Identity exclusivity: gaining an origin re-asks.\n\t\t{\"a trusted path does not cover an origin-keyed identity\",\n\t\t\t[][]string{{\"remote\", \"add\", \"origin\", \"https://github.com/acme/widgets.git\"}},\n\t\t\t`{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, false},\n\t\t{\"trusted path identity passes with no origin\", nil, `{\"global\":{\"enabled\":true,\"trusted_paths\":[\"%ROOT%\"]}}`, false, false, true},\n\t\t// settings.json as a DIRECTORY exercises the read-error branch portably.\n\t\t{\"unreadable user settings hold (fail closed)\", nil, \"\", false, true, false},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tdir, cfg := newTrustTestRepo(t)\n\t\t\tfor _, args := range tc.remotes {\n\t\t\t\taddTestRemote(t, dir, args...)\n\t\t\t}\n\t\t\tif tc.repoSetup {\n\t\t\t\tif err := os.MkdirAll(filepath.Join(dir, \".entire\"), 0o755); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\trepoSettings := `{\"enabled\":true,\"strategy_options\":{\"checkpoint_remote\":{\"provider\":\"github\",\"repo\":\"acme/widgets\"}}}`\n\t\t\t\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(repoSettings), 0o600); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif tc.unreadableStore {\n\t\t\t\tif err := os.MkdirAll(filepath.Join(cfg, UserSettingsFileName), 0o755); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif tc.userSettings != \"\" {\n\t\t\t\twriteUserSettings(t, cfg, strings.ReplaceAll(tc.userSettings, \"%ROOT%\", resolvedRoot(t, dir)))\n\t\t\t}\n\t\t\tif got := CheckpointEgressAllowed(t.Context()); got != tc.want {\n\t\t\t\tt.Fatalf(\"CheckpointEgressAllowed = %v, want %v\", got, tc.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCheckpointEgressAllowed_IncidentalRepoSettingsRequireGlobalTrust(t *testing.T) {\n\tdir, cfg := newTrustTestRepo(t)\n\tif err := os.MkdirAll(filepath.Join(dir, \".entire\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(`{\"investigate\":{\"max_turns\":4}}`), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true}}`)\n\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"an incidental repo settings file must not grant checkpoint egress\")\n\t}\n\tif !RepoUntrustedEnrolled(t.Context()) {\n\t\tt.Fatal(\"an incidental repo settings file must retain the globally enrolled trust hold\")\n\t}\n\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true,\"trust_all\":true}}`)\n\tif !CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"trust_all must grant egress when repo settings contain no activation intent\")\n\t}\n\n\tif err := os.WriteFile(filepath.Join(dir, \".entire\", \"settings.json\"), []byte(`{\"enabled\":`), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"malformed repo settings must fail closed even when trust_all is enabled\")\n\t}\n}\n\n// TestTrustAndRevokeCurrentRepo: trusting writes ALL origin keys once\n// (idempotent) and prunes the stale path entry; revoking removes the keys AND\n// the path entry, so removing the origin later cannot resurrect trust.\nfunc TestTrustAndRevokeCurrentRepo(t *testing.T) {\n\tdir, cfg := newTrustTestRepo(t)\n\troot := resolvedRoot(t, dir)\n\taddTestRemote(t, dir, \"remote\", \"add\", \"origin\", \"git@gitlab.example.com:team/proj.git\")\n\taddTestRemote(t, dir, \"remote\", \"set-url\", \"--add\", \"origin\", \"https://github.com/acme/widgets.git\")\n\twriteUserSettings(t, cfg, `{\"global\":{\"enabled\":true,\"trusted_paths\":[\"`+root+`\",\"/srv/other\"]}}`)\n\tfor range 2 { // second call pins idempotency (no duplicate keys)\n\t\tif _, err := TrustCurrentRepo(t.Context()); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tus, err := LoadUserSettings(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\twantKeys := []string{\"gitlab.example.com/team/proj\", \"github.com/acme/widgets\"}\n\tif !slices.Equal(us.Global.TrustedOrigins, wantKeys) {\n\t\tt.Fatalf(\"trusted_origins = %v, want ALL configured URL keys %v once\", us.Global.TrustedOrigins, wantKeys)\n\t}\n\tif !slices.Equal(us.Global.TrustedPaths, []string{\"/srv/other\"}) {\n\t\tt.Fatalf(\"trusted_paths = %v, want this root pruned and other entries kept\", us.Global.TrustedPaths)\n\t}\n\tif !CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"the gate must open immediately after trusting\")\n\t}\n\n\t// Re-seed a hand-added path entry for the root: revoke itself must drop it.\n\twriteUserSettings(t, cfg,\n\t\t`{\"global\":{\"enabled\":true,\"trusted_origins\":[\"gitlab.example.com/team/proj\",\"github.com/acme/widgets\"],\"trusted_paths\":[\"`+root+`\"]}}`)\n\tid, err := RevokeCurrentRepo(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !slices.Equal(id.OriginKeys, wantKeys) {\n\t\tt.Fatalf(\"revoked identity = %+v, want the origin keys\", id)\n\t}\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"the revoked origin identity must hold\")\n\t}\n\taddTestRemote(t, dir, \"remote\", \"remove\", \"origin\")\n\tif CheckpointEgressAllowed(t.Context()) {\n\t\tt.Fatal(\"after the origin is removed, a stale path entry must not resurrect trust\")\n\t}\n}\n\nfunc TestTrustAllRepos_UnconfiguredTierErrorsWithoutMaterializingGlobal(t *testing.T) {\n\tnewTrustTestRepo(t)\n\tif err := TrustAllRepos(t.Context()); err == nil {\n\t\tt.Fatal(\"trust_all with no global block must error, not invent one\")\n\t}\n\tus, err := LoadUserSettings(t.Context())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif us.Global != nil {\n\t\tt.Fatal(\"a failed trust_all write must not materialize the global block\")\n\t}\n}\n"},"started_at_ms":1787607945171,"completed_at_ms":1787607945171}}
{"timestamp":"2026-08-24T21:45:45.234Z","ordinal":9650,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a035bc-9012-7681-aeff-3fa469a90907","call_id":"call_Nymh23vyMLVWswjOoWtqAE7o","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"c4df14\",\"wall_time_seconds\":0.000005333,\"exit_code\":0,\"original_token_count\":4738,\"output\":\"package settings\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"log/slog\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"slices\\\"\\n\\t\\\"strings\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/gitremote\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/logging\\\"\\n)\\n\\n// TrustIdentity is the egress-consent key for one repository. Exactly one side\\n// is set: OriginKeys when every configured origin URL (fetch and push)\\n// normalizes — consent requires all of them — or Path (the symlink-resolved\\n// worktree root) when there is no origin or ANY URL fails to normalize. The\\n// split is exclusive, never a union; an identity flip re-asks. The zero value\\n// (returned alongside a non-nil error) must not be consulted.\\ntype TrustIdentity struct {\\n\\tOriginKeys []string\\n\\tPath       string\\n}\\n\\n// OriginKeyed reports which side of the identity is set: true for an\\n// origin-keyed repo, false for a path-keyed one.\\nfunc (id TrustIdentity) OriginKeyed() bool {\\n\\treturn len(id.OriginKeys) > 0\\n}\\n\\n// DisplayScope is the identity's user-facing name: the first origin key for\\n// an origin-keyed repo, else the worktree root path.\\nfunc (id TrustIdentity) DisplayScope() string {\\n\\tif id.OriginKeyed() {\\n\\t\\treturn id.OriginKeys[0]\\n\\t}\\n\\treturn id.Path\\n}\\n\\n// TrustSource names what grants egress consent for a repository in the\\n// global trust store, for status/doctor/revoke messaging.\\ntype TrustSource string\\n\\nconst (\\n\\tTrustSourceAll  TrustSource = \\\"trust_all\\\"\\n\\tTrustSourceRepo TrustSource = \\\"repo\\\"\\n\\tTrustSourceNone TrustSource = \\\"none\\\"\\n)\\n\\n// RepoTrustIdentity derives the trust identity of the current worktree — the\\n// single derivation shared by the egress gate, the trust command, status, and\\n// doctor. Errors are returned for callers to fail closed on.\\nfunc RepoTrustIdentity(ctx context.Context) (TrustIdentity, error) {\\n\\tid, _, err := currentTrustIdentity(ctx)\\n\\treturn id, err\\n}\\n\\n// currentTrustIdentity is RepoTrustIdentity plus the symlink-resolved worktree\\n// root, which the write helpers need even for origin-keyed repos.\\nfunc currentTrustIdentity(ctx context.Context) (TrustIdentity, string, error) {\\n\\troot, err := worktreeRootFn(ctx)\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, \\\"\\\", fmt.Errorf(\\\"resolving worktree root: %w\\\", err)\\n\\t}\\n\\tresolvedRoot := filepath.ToSlash(root)\\n\\tif resolved, symErr := filepath.EvalSymlinks(root); symErr == nil {\\n\\t\\tresolvedRoot = filepath.ToSlash(resolved)\\n\\t} else {\\n\\t\\tlogging.Debug(ctx, \\\"trust identity: worktree root symlink resolution failed; keying on the unresolved path\\\",\\n\\t\\t\\tslog.String(\\\"error\\\", symErr.Error()))\\n\\t}\\n\\turls, urlsFound, err := gitremote.GetRemoteURLsInDirIfSet(ctx, root, \\\"origin\\\")\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, \\\"\\\", fmt.Errorf(\\\"reading origin remote: %w\\\", err)\\n\\t}\\n\\t// Push URLs join the set: git's pushurl-replaces-url rule means egress\\n\\t// follows the pushurl when one is set.\\n\\tpushURLs, pushFound, err := gitremote.GetRemotePushURLsInDirIfSet(ctx, root, \\\"origin\\\")\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, \\\"\\\", fmt.Errorf(\\\"reading origin pushurl: %w\\\", err)\\n\\t}\\n\\turls = append(urls, pushURLs...)\\n\\tif urlsFound || pushFound {\\n\\t\\tvar keys []string\\n\\t\\tfor _, u := range urls {\\n\\t\\t\\tkey := normalizeOrigin(u)\\n\\t\\t\\tif key == \\\"\\\" {\\n\\t\\t\\t\\tkeys = nil // any unkeyable URL flips the identity to path (see TrustIdentity)\\n\\t\\t\\t\\tbreak\\n\\t\\t\\t}\\n\\t\\t\\tif !slices.Contains(keys, key) {\\n\\t\\t\\t\\tkeys = append(keys, key)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif len(keys) > 0 {\\n\\t\\t\\treturn TrustIdentity{OriginKeys: keys}, resolvedRoot, nil\\n\\t\\t}\\n\\t}\\n\\treturn TrustIdentity{Path: resolvedRoot}, resolvedRoot, nil\\n}\\n\\n// CheckpointEgressAllowed reports whether checkpoint data may leave this\\n// machine for the current repository: repo-level activation intent is explicit consent\\n// (which also makes any checkpoint_remote configuration moot — it can only\\n// live in repo-level settings); otherwise the globally-enrolled repo must be\\n// trusted. Every error path returns false (fail closed).\\nfunc CheckpointEgressAllowed(ctx context.Context) bool {\\n\\tconfigured, err := RepoActivationConfigured(ctx)\\n\\tif err != nil {\\n\\t\\treturn false\\n\\t}\\n\\treturn configured || globalTrustSource(ctx) != TrustSourceNone\\n}\\n\\n// CurrentTrustSource names what grants egress consent in the global trust\\n// store only — repo-level setup is deliberately ignored — so revoke can detect\\n// a removal masked by trust_all and status can name the consent source.\\nfunc CurrentTrustSource(ctx context.Context) TrustSource {\\n\\treturn globalTrustSource(ctx)\\n}\\n\\n// RepoUntrustedEnrolled reports the held state: enrolled by the global tier,\\n// no repo-level activation intent, egress not consented. It is the ONE predicate behind\\n// every untrusted-enrolled surface (banner, status, doctor).\\nfunc RepoUntrustedEnrolled(ctx context.Context) bool {\\n\\tconfigured, err := RepoActivationConfigured(ctx)\\n\\treturn err == nil && !configured && GlobalModeActive(ctx) && globalTrustSource(ctx) == TrustSourceNone\\n}\\n\\n// globalTrustSource is the single trust decision tree behind both\\n// CheckpointEgressAllowed and CurrentTrustSource. Every error path resolves\\n// to TrustSourceNone (fail closed).\\nfunc globalTrustSource(ctx context.Context) TrustSource {\\n\\tus, err := LoadUserSettings(ctx)\\n\\tif err != nil || us.Global == nil {\\n\\t\\treturn TrustSourceNone\\n\\t}\\n\\tif us.Global.TrustAll {\\n\\t\\treturn TrustSourceAll\\n\\t}\\n\\tid, err := RepoTrustIdentity(ctx)\\n\\tif err != nil {\\n\\t\\treturn TrustSourceNone\\n\\t}\\n\\tif identityTrusted(ctx, us.Global, id) {\\n\\t\\treturn TrustSourceRepo\\n\\t}\\n\\treturn TrustSourceNone\\n}\\n\\n// TrustCurrentRepo records egress consent for the current repository's\\n// identity and returns it. Origin-keyed repos get ALL their URL keys written;\\n// any trusted_paths entry for this root is pruned in the same write, or it\\n// would resurrect trust once the origin is removed. Idempotent.\\nfunc TrustCurrentRepo(ctx context.Context) (TrustIdentity, error) {\\n\\tid, root, err := currentTrustIdentity(ctx)\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, err\\n\\t}\\n\\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\\n\\t\\tif err := requireConfiguredGlobal(us); err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tg := us.Global\\n\\t\\tif len(id.OriginKeys) > 0 {\\n\\t\\t\\tfor _, key := range id.OriginKeys {\\n\\t\\t\\t\\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\\n\\t\\t\\t\\t\\tg.TrustedOrigins = append(g.TrustedOrigins, key)\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\\n\\t\\t\\treturn nil\\n\\t\\t}\\n\\t\\tif !anyPathEntryIsRoot(ctx, g.TrustedPaths, root) {\\n\\t\\t\\tg.TrustedPaths = append(g.TrustedPaths, root)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t})\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, err\\n\\t}\\n\\treturn id, nil\\n}\\n\\n// ErrGlobalModeUnconfigured is returned by the trust writers when the global\\n// tier was never configured, as a sentinel so `entire trust` can swap it for\\n// a friendly message.\\nvar ErrGlobalModeUnconfigured = errors.New(\\\"global mode is not configured; nothing to trust\\\")\\n\\n// requireConfiguredGlobal guards every trust writer: materializing the global\\n// block would flip GlobalConfigured() and suppress the ask-once question.\\nfunc requireConfiguredGlobal(us *UserSettings) error {\\n\\tif us.Global == nil {\\n\\t\\treturn ErrGlobalModeUnconfigured\\n\\t}\\n\\treturn nil\\n}\\n\\n// TrustAllRepos records machine-wide egress consent (trust_all). Per-repo keys\\n// are left untouched, so disabling trust_all later restores the per-repo state.\\nfunc TrustAllRepos(ctx context.Context) error {\\n\\treturn ModifyUserSettings(ctx, func(us *UserSettings) error {\\n\\t\\tif err := requireConfiguredGlobal(us); err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tus.Global.TrustAll = true\\n\\t\\treturn nil\\n\\t})\\n}\\n\\n// RevokeCurrentRepo withdraws egress consent for the current repository's\\n// identity and returns it. It removes the identity's origin keys AND any\\n// trusted_paths entry for this root regardless of identity side (a leftover\\n// path entry would resurrect trust once the origin is removed); other repos'\\n// keys, the exclude lists, and trust_all are never touched. Idempotent for a\\n// configured tier; an unconfigured tier returns ErrGlobalModeUnconfigured.\\n// Not retroactive.\\nfunc RevokeCurrentRepo(ctx context.Context) (TrustIdentity, error) {\\n\\tid, root, err := currentTrustIdentity(ctx)\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, err\\n\\t}\\n\\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\\n\\t\\tif err := requireConfiguredGlobal(us); err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tg := us.Global\\n\\t\\tif len(id.OriginKeys) > 0 {\\n\\t\\t\\tvar kept []string\\n\\t\\t\\tfor _, e := range g.TrustedOrigins {\\n\\t\\t\\t\\tif !slices.Contains(id.OriginKeys, canonicalOriginEntry(e)) {\\n\\t\\t\\t\\t\\tkept = append(kept, e)\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tg.TrustedOrigins = kept\\n\\t\\t}\\n\\t\\tg.TrustedPaths = withoutPathEntriesFor(ctx, g.TrustedPaths, root)\\n\\t\\treturn nil\\n\\t})\\n\\tif err != nil {\\n\\t\\treturn TrustIdentity{}, err\\n\\t}\\n\\treturn id, nil\\n}\\n\\n// identityTrusted checks id against the trust lists, honoring the exclusivity\\n// documented on TrustIdentity: origin-keyed repos consult ONLY\\n// trusted_origins (every key required), path-keyed repos ONLY trusted_paths.\\nfunc identityTrusted(ctx context.Context, g *GlobalConfig, id TrustIdentity) bool {\\n\\tif len(id.OriginKeys) > 0 {\\n\\t\\tfor _, key := range id.OriginKeys {\\n\\t\\t\\tif !containsTrustedOrigin(g.TrustedOrigins, key) {\\n\\t\\t\\t\\treturn false\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn true\\n\\t}\\n\\t// Per-entry so one unreadable hand-edit can't veto every valid grant; an\\n\\t// unreadable entry cannot grant trust either way (still fail-closed).\\n\\treturn anyPathEntryIsRoot(ctx, g.TrustedPaths, id.Path)\\n}\\n\\n// canonicalOriginEntry defines hand-edited-entry tolerance for\\n// trusted_origins: trimmed and case-folded, never glob-expanded. Both the\\n// gate's membership check and revoke's removal filter go through it.\\nfunc canonicalOriginEntry(e string) string {\\n\\treturn strings.ToLower(strings.TrimSpace(e))\\n}\\n\\nfunc containsTrustedOrigin(entries []string, key string) bool {\\n\\tfor _, e := range entries {\\n\\t\\tif canonicalOriginEntry(e) == key {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n// pathEntryIsRoot reports whether one trusted_paths entry refers to root, with\\n// the same given/resolved/case bridging as the gate's matcher. An entry it\\n// cannot interpret reports false.\\nfunc pathEntryIsRoot(ctx context.Context, entry, root string) bool {\\n\\tok, err := matchesExcludePathExact(ctx, []string{entry}, root)\\n\\treturn err == nil && ok\\n}\\n\\nfunc anyPathEntryIsRoot(ctx context.Context, entries []string, root string) bool {\\n\\tfor _, e := range entries {\\n\\t\\tif pathEntryIsRoot(ctx, e, root) {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\nfunc withoutPathEntriesFor(ctx context.Context, entries []string, root string) []string {\\n\\tvar kept []string\\n\\tfor _, e := range entries {\\npackage settings\\n\\nimport (\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"slices\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n)\\n\\n// resolvedRoot returns dir in the symlink-resolved slash form trust path keys use.\\nfunc resolvedRoot(t *testing.T, dir string) string {\\n\\tt.Helper()\\n\\tresolved, err := filepath.EvalSymlinks(dir)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\treturn filepath.ToSlash(resolved)\\n}\\n\\n// newTrustTestRepo initializes an isolated repo with a fresh user settings dir\\n// and enters it. Not parallel-safe: t.Setenv/t.Chdir.\\nfunc newTrustTestRepo(t *testing.T) (dir, cfg string) {\\n\\tt.Helper()\\n\\tdir = newGlobalTestRepo(t)\\n\\tcfg = t.TempDir()\\n\\tt.Setenv(\\\"ENTIRE_CONFIG_DIR\\\", cfg)\\n\\tt.Chdir(dir)\\n\\treturn dir, cfg\\n}\\n\\n// TestCheckpointEgressAllowed drives the gate across the identity rules:\\n// fetch AND push URL keys all required, unkeyable URLs flip to path,\\n// exclusive identity sides, every failure holds.\\nfunc TestCheckpointEgressAllowed(t *testing.T) {\\n\\tmultiURLOrigin := [][]string{\\n\\t\\t{\\\"remote\\\", \\\"add\\\", \\\"origin\\\", \\\"git@gitlab.example.com:team/proj.git\\\"},\\n\\t\\t{\\\"remote\\\", \\\"set-url\\\", \\\"--add\\\", \\\"origin\\\", \\\"https://github.com/Acme/Widgets.git\\\"},\\n\\t}\\n\\tnormalOriginWithPushurl := [][]string{\\n\\t\\t{\\\"remote\\\", \\\"add\\\", \\\"origin\\\", \\\"https://github.com/acme/widgets.git\\\"},\\n\\t\\t{\\\"config\\\", \\\"remote.origin.pushurl\\\", \\\"git@gitlab.example.com:team/proj.git\\\"},\\n\\t}\\n\\tfor _, tc := range []struct {\\n\\t\\tname            string\\n\\t\\tremotes         [][]string\\n\\t\\tuserSettings    string // %ROOT% expands to the resolved worktree root\\n\\t\\trepoSetup       bool\\n\\t\\tunreadableStore bool\\n\\t\\twant            bool\\n\\t}{\\n\\t\\t// checkpoint_remote is moot: it can only live in repo-level settings.\\n\\t\\t{\\\"repo-level setup passes even with checkpoint_remote configured\\\", nil, \\\"\\\", true, false, true},\\n\\t\\t{\\\"trust_all passes\\\", nil, `{\\\"global\\\":{\\\"enabled\\\":true,\\\"trust_all\\\":true}}`, false, false, true},\\n\\t\\t{\\\"a trusted subset of a multi-URL origin holds\\\", multiURLOrigin,\\n\\t\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_origins\\\":[\\\"github.com/acme/widgets\\\"]}}`, false, false, false},\\n\\t\\t{\\\"all origin keys trusted passes\\\", multiURLOrigin,\\n\\t\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_origins\\\":[\\\"gitlab.example.com/team/proj\\\",\\\"github.com/acme/widgets\\\"]}}`, false, false, true},\\n\\t\\t// Egress follows the pushurl (pushurl-replaces-url): its key is required.\\n\\t\\t{\\\"the fetch-URL key alone does not cover a differing pushurl\\\", normalOriginWithPushurl,\\n\\t\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_origins\\\":[\\\"github.com/acme/widgets\\\"]}}`, false, false, false},\\n\\t\\t{\\\"fetch-URL and pushurl keys together pass\\\", normalOriginWithPushurl,\\n\\t\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_origins\\\":[\\\"github.com/acme/widgets\\\",\\\"gitlab.example.com/team/proj\\\"]}}`, false, false, true},\\n\\t\\t// Any unkeyable URL flips the WHOLE identity to path (never partial keys).\\n\\t\\t{\\\"unnormalizable pushurl flips the identity to path\\\", [][]string{\\n\\t\\t\\t{\\\"remote\\\", \\\"add\\\", \\\"origin\\\", \\\"https://github.com/acme/widgets.git\\\"},\\n\\t\\t\\t{\\\"config\\\", \\\"remote.origin.pushurl\\\", \\\"file:///srv/git/secret.git\\\"}},\\n\\t\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_paths\\\":[\\\"%ROOT%\\\"]}}`, false, false, true},\\n\\t\\t{\\\"a mixed origin holds even with its normalizable key trusted\\\", [][]string{\\n\\t\\t\\t{\\\"remote\\\", \\\"add\\\", \\\"origin\\\", \\\"https://github.com/acme/widgets.git\\\"},\\n\\t\\t\\t{\\\"remote\\\", \\\"set-url\\\", \\\"--add\\\", \\\"origin\\\", \\\"file:///srv/git/secret.git\\\"}},\\n\\t\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_origins\\\":[\\\"github.com/acme/widgets\\\"]}}`, false, false, false},\\n\\t\\t// Identity exclusivity: gaining an origin re-asks.\\n\\t\\t{\\\"a trusted path does not cover an origin-keyed identity\\\",\\n\\t\\t\\t[][]string{{\\\"remote\\\", \\\"add\\\", \\\"origin\\\", \\\"https://github.com/acme/widgets.git\\\"}},\\n\\t\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_paths\\\":[\\\"%ROOT%\\\"]}}`, false, false, false},\\n\\t\\t{\\\"trusted path identity passes with no origin\\\", nil, `{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_paths\\\":[\\\"%ROOT%\\\"]}}`, false, false, true},\\n\\t\\t// settings.json as a DIRECTORY exercises the read-error branch portably.\\n\\t\\t{\\\"unreadable user settings hold (fail closed)\\\", nil, \\\"\\\", false, true, false},\\n\\t} {\\n\\t\\tt.Run(tc.name, func(t *testing.T) {\\n\\t\\t\\tdir, cfg := newTrustTestRepo(t)\\n\\t\\t\\tfor _, args := range tc.remotes {\\n\\t\\t\\t\\taddTestRemote(t, dir, args...)\\n\\t\\t\\t}\\n\\t\\t\\tif tc.repoSetup {\\n\\t\\t\\t\\tif err := os.MkdirAll(filepath.Join(dir, \\\".entire\\\"), 0o755); err != nil {\\n\\t\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\trepoSettings := `{\\\"enabled\\\":true,\\\"strategy_options\\\":{\\\"checkpoint_remote\\\":{\\\"provider\\\":\\\"github\\\",\\\"repo\\\":\\\"acme/widgets\\\"}}}`\\n\\t\\t\\t\\tif err := os.WriteFile(filepath.Join(dir, \\\".entire\\\", \\\"settings.json\\\"), []byte(repoSettings), 0o600); err != nil {\\n\\t\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tif tc.unreadableStore {\\n\\t\\t\\t\\tif err := os.MkdirAll(filepath.Join(cfg, UserSettingsFileName), 0o755); err != nil {\\n\\t\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tif tc.userSettings != \\\"\\\" {\\n\\t\\t\\t\\twriteUserSettings(t, cfg, strings.ReplaceAll(tc.userSettings, \\\"%ROOT%\\\", resolvedRoot(t, dir)))\\n\\t\\t\\t}\\n\\t\\t\\tif got := CheckpointEgressAllowed(t.Context()); got != tc.want {\\n\\t\\t\\t\\tt.Fatalf(\\\"CheckpointEgressAllowed = %v, want %v\\\", got, tc.want)\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\\nfunc TestCheckpointEgressAllowed_IncidentalRepoSettingsRequireGlobalTrust(t *testing.T) {\\n\\tdir, cfg := newTrustTestRepo(t)\\n\\tif err := os.MkdirAll(filepath.Join(dir, \\\".entire\\\"), 0o755); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif err := os.WriteFile(filepath.Join(dir, \\\".entire\\\", \\\"settings.json\\\"), []byte(`{\\\"investigate\\\":{\\\"max_turns\\\":4}}`), 0o600); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\twriteUserSettings(t, cfg, `{\\\"global\\\":{\\\"enabled\\\":true}}`)\\n\\n\\tif CheckpointEgressAllowed(t.Context()) {\\n\\t\\tt.Fatal(\\\"an incidental repo settings file must not grant checkpoint egress\\\")\\n\\t}\\n\\tif !RepoUntrustedEnrolled(t.Context()) {\\n\\t\\tt.Fatal(\\\"an incidental repo settings file must retain the globally enrolled trust hold\\\")\\n\\t}\\n\\n\\twriteUserSettings(t, cfg, `{\\\"global\\\":{\\\"enabled\\\":true,\\\"trust_all\\\":true}}`)\\n\\tif !CheckpointEgressAllowed(t.Context()) {\\n\\t\\tt.Fatal(\\\"trust_all must grant egress when repo settings contain no activation intent\\\")\\n\\t}\\n\\n\\tif err := os.WriteFile(filepath.Join(dir, \\\".entire\\\", \\\"settings.json\\\"), []byte(`{\\\"enabled\\\":`), 0o600); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif CheckpointEgressAllowed(t.Context()) {\\n\\t\\tt.Fatal(\\\"malformed repo settings must fail closed even when trust_all is enabled\\\")\\n\\t}\\n}\\n\\n// TestTrustAndRevokeCurrentRepo: trusting writes ALL origin keys once\\n// (idempotent) and prunes the stale path entry; revoking removes the keys AND\\n// the path entry, so removing the origin later cannot resurrect trust.\\nfunc TestTrustAndRevokeCurrentRepo(t *testing.T) {\\n\\tdir, cfg := newTrustTestRepo(t)\\n\\troot := resolvedRoot(t, dir)\\n\\taddTestRemote(t, dir, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", \\\"git@gitlab.example.com:team/proj.git\\\")\\n\\taddTestRemote(t, dir, \\\"remote\\\", \\\"set-url\\\", \\\"--add\\\", \\\"origin\\\", \\\"https://github.com/acme/widgets.git\\\")\\n\\twriteUserSettings(t, cfg, `{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_paths\\\":[\\\"`+root+`\\\",\\\"/srv/other\\\"]}}`)\\n\\tfor range 2 { // second call pins idempotency (no duplicate keys)\\n\\t\\tif _, err := TrustCurrentRepo(t.Context()); err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t}\\n\\tus, err := LoadUserSettings(t.Context())\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\twantKeys := []string{\\\"gitlab.example.com/team/proj\\\", \\\"github.com/acme/widgets\\\"}\\n\\tif !slices.Equal(us.Global.TrustedOrigins, wantKeys) {\\n\\t\\tt.Fatalf(\\\"trusted_origins = %v, want ALL configured URL keys %v once\\\", us.Global.TrustedOrigins, wantKeys)\\n\\t}\\n\\tif !slices.Equal(us.Global.TrustedPaths, []string{\\\"/srv/other\\\"}) {\\n\\t\\tt.Fatalf(\\\"trusted_paths = %v, want this root pruned and other entries kept\\\", us.Global.TrustedPaths)\\n\\t}\\n\\tif !CheckpointEgressAllowed(t.Context()) {\\n\\t\\tt.Fatal(\\\"the gate must open immediately after trusting\\\")\\n\\t}\\n\\n\\t// Re-seed a hand-added path entry for the root: revoke itself must drop it.\\n\\twriteUserSettings(t, cfg,\\n\\t\\t`{\\\"global\\\":{\\\"enabled\\\":true,\\\"trusted_origins\\\":[\\\"gitlab.example.com/team/proj\\\",\\\"github.com/acme/widgets\\\"],\\\"trusted_paths\\\":[\\\"`+root+`\\\"]}}`)\\n\\tid, err := RevokeCurrentRepo(t.Context())\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif !slices.Equal(id.OriginKeys, wantKeys) {\\n\\t\\tt.Fatalf(\\\"revoked identity = %+v, want the origin keys\\\", id)\\n\\t}\\n\\tif CheckpointEgressAllowed(t.Context()) {\\n\\t\\tt.Fatal(\\\"the revoked origin identity must hold\\\")\\n\\t}\\n\\taddTestRemote(t, dir, \\\"remote\\\", \\\"remove\\\", \\\"origin\\\")\\n\\tif CheckpointEgressAllowed(t.Context()) {\\n\\t\\tt.Fatal(\\\"after the origin is removed, a stale path entry must not resurrect trust\\\")\\n\\t}\\n}\\n\\nfunc TestTrustAllRepos_UnconfiguredTierErrorsWithoutMaterializingGlobal(t *testing.T) {\\n\\tnewTrustTestRepo(t)\\n\\tif err := TrustAllRepos(t.Context()); err == nil {\\n\\t\\tt.Fatal(\\\"trust_all with no global block must error, not invent one\\\")\\n\\t}\\n\\tus, err := LoadUserSettings(t.Context())\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif us.Global != nil {\\n\\t\\tt.Fatal(\\\"a failed trust_all write must not materialize the global block\\\")\\n\\t}\\n}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a035bb-e411-7b32-a380-13e06970de42","create_time":1787607945.234192}}}
