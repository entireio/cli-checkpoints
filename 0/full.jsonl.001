{"timestamp":"2026-08-25T17:38:13.803Z","ordinal":14732,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a025ce-e754-7631-8467-eaa6035ba0f8","turn_id":"01a039b7-b242-7af0-80e0-d29bf9afbbac","item":{"type":"CommandExecution","id":"exec-a713bd80-2c99-4713-b4e2-17f4e2dc03bc","process_id":"80775","command":["/bin/zsh","-c","sed -n '1,240p' mise-tasks/test/e2e/canary"],"cwd":"file:///Users/peytonmontei/Documents/Documents%20-%20Peyton%E2%80%99s%20MacBook%20Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier","parsed_cmd":[{"type":"read","cmd":"sed -n '1,240p' mise-tasks/test/e2e/canary","name":"canary","path":"mise-tasks/test/e2e/canary"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/bin/sh\n#MISE description=\"Run E2E canary tests with deterministic agents (no API calls)\"\n#USAGE arg \"[filter]\" help=\"Test name filter (regex)\" default=\"\"\n\nset -eu\n\n# Build entire CLI\nmise run build\nexport E2E_ENTIRE_BIN=\"$PWD/entire\"\n\n# Build vogon binary\ngo build -o vogon ./e2e/vogon\nE2E_PATH=\"$PWD:$PATH\"\n\nif [ -z \"${E2E_ARTIFACT_DIR:-}\" ]; then\n  E2E_ARTIFACT_DIR=\"$PWD/e2e/artifacts/canary-$(date +%Y-%m-%dT%H-%M-%S)\"\nfi\nexport E2E_ARTIFACT_DIR\nmkdir -p \"$E2E_ARTIFACT_DIR\"\necho \"artifacts: $E2E_ARTIFACT_DIR\"\n\nfilter=\"${usage_filter:-}\"\nvogon_rc=0\nrr_rc=0\n\n# --- vogon: runs all tests (built-in agent) ---\necho \"--- canary: vogon ---\"\nPATH=\"$E2E_PATH\" E2E_AGENT=vogon gotestsum --format dots \\\n  --jsonfile \"$E2E_ARTIFACT_DIR/test-events-vogon.json\" -- \\\n  -tags=e2e -count=1 -timeout=10m \\\n  ${filter:+-run \"$filter\"} \\\n  ./e2e/tests/... || vogon_rc=$?\n\ngo run ./e2e/cmd/testreport -color \\\n  -o \"$E2E_ARTIFACT_DIR/report-vogon.txt\" \\\n  \"$E2E_ARTIFACT_DIR/test-events-vogon.json\"\n\n# --- roger-roger: external agent tests only (binaries from mise) ---\necho \"--- canary: roger-roger ---\"\n\n# Preflight: ensure required roger-roger binaries are on PATH so tests don't silently skip\nif ! command -v roger-roger >/dev/null 2>&1; then\n  echo \"error: roger-roger binary not found on PATH; install/configure it before running roger-roger canary tests.\" >&2\n  exit 1\nfi\n\nif ! command -v entire-agent-roger-roger >/dev/null 2>&1; then\n  echo \"error: entire-agent-roger-roger binary not found on PATH; install/configure it before running roger-roger canary tests.\" >&2\n  exit 1\nfi\n\nrr_filter=\"${filter:-TestExternalAgent}\"\nE2E_AGENT=roger-roger gotestsum --format dots \\\n  --jsonfile \"$E2E_ARTIFACT_DIR/test-events-roger-roger.json\" -- \\\n  -tags=e2e -count=1 -timeout=10m \\\n  -run \"$rr_filter\" \\\n  ./e2e/tests/... || rr_rc=$?\n\ngo run ./e2e/cmd/testreport -color \\\n  -o \"$E2E_ARTIFACT_DIR/report-roger-roger.txt\" \\\n  \"$E2E_ARTIFACT_DIR/test-events-roger-roger.json\"\n\necho \"\"\ncat \"$E2E_ARTIFACT_DIR/entire-version.txt\" 2>/dev/null\necho \"artifacts: $E2E_ARTIFACT_DIR\"\nif [ \"$vogon_rc\" -ne 0 ] || [ \"$rr_rc\" -ne 0 ]; then\n  exit 1\nfi\n","stderr":"","aggregated_output":"#!/bin/sh\n#MISE description=\"Run E2E canary tests with deterministic agents (no API calls)\"\n#USAGE arg \"[filter]\" help=\"Test name filter (regex)\" default=\"\"\n\nset -eu\n\n# Build entire CLI\nmise run build\nexport E2E_ENTIRE_BIN=\"$PWD/entire\"\n\n# Build vogon binary\ngo build -o vogon ./e2e/vogon\nE2E_PATH=\"$PWD:$PATH\"\n\nif [ -z \"${E2E_ARTIFACT_DIR:-}\" ]; then\n  E2E_ARTIFACT_DIR=\"$PWD/e2e/artifacts/canary-$(date +%Y-%m-%dT%H-%M-%S)\"\nfi\nexport E2E_ARTIFACT_DIR\nmkdir -p \"$E2E_ARTIFACT_DIR\"\necho \"artifacts: $E2E_ARTIFACT_DIR\"\n\nfilter=\"${usage_filter:-}\"\nvogon_rc=0\nrr_rc=0\n\n# --- vogon: runs all tests (built-in agent) ---\necho \"--- canary: vogon ---\"\nPATH=\"$E2E_PATH\" E2E_AGENT=vogon gotestsum --format dots \\\n  --jsonfile \"$E2E_ARTIFACT_DIR/test-events-vogon.json\" -- \\\n  -tags=e2e -count=1 -timeout=10m \\\n  ${filter:+-run \"$filter\"} \\\n  ./e2e/tests/... || vogon_rc=$?\n\ngo run ./e2e/cmd/testreport -