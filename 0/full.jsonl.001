(t, raw, \"checkpoint %s metadata not found at %s\", checkpointID, blob)\ne2e/testutil/assertions.go-211-\t\treturn\ne2e/testutil/assertions.go-212-\t}\ne2e/testutil/assertions.go-213-\tout := GitOutput(t, dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-214-\tassert.NotEmpty(t, out, \"checkpoint %s not found on checkpoint branch\", checkpointID)\ne2e/testutil/assertions.go-215-\ne2e/testutil/assertions.go-216-\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-217-\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-218-\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-219-\tassert.NotEmpty(t, raw,\ne2e/testutil/assertions.go-220-\t\t\"checkpoint %s metadata not found at %s\", checkpointID, path)\ne2e/testutil/assertions.go-221-}\ne2e/testutil/assertions.go-222-\ne2e/testutil/assertions.go-223-// WaitForCheckpointExists polls until the checkpoint ID appears on the\ne2e/testutil/assertions.go-224-// checkpoint branch and its metadata.json is readable, or fails after timeout.\ne2e/testutil/assertions.go-225-func WaitForCheckpointExists(t *testing.T, dir string, checkpointID string, timeout time.Duration) {\ne2e/testutil/assertions.go-226-\tt.Helper()\ne2e/testutil/assertions.go-227-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-228-\tfor time.Now().Before(deadline) {\ne2e/testutil/assertions.go-229-\t\tif UsingGitRefs() {\ne2e/testutil/assertions.go-230-\t\t\tif gitOutputSafe(dir, \"show\", checkpointBlobSpec(checkpointID, \"metadata.json\")) != \"\" {\ne2e/testutil/assertions.go-231-\t\t\t\treturn\ne2e/testutil/assertions.go-232-\t\t\t}\ne2e/testutil/assertions.go-233-\t\t\ttime.Sleep(200 * time.Millisecond)\ne2e/testutil/assertions.go-234-\t\t\tcontinue\ne2e/testutil/assertions.go-235-\t\t}\ne2e/testutil/assertions.go-236-\t\tout := gitOutputSafe(dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-237-\t\tif out != \"\" {\ne2e/testutil/assertions.go-238-\t\t\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-239-\t\t\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-240-\t\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-241-\t\t\tif raw != \"\" {\ne2e/testutil/assertions.go-242-\t\t\t\treturn\ne2e/testutil/assertions.go-243-\t\t\t}\ne2e/testutil/assertions.go-244-\t\t}\ne2e/testutil/assertions.go-245-\t\ttime.Sleep(200 * time.Millisecond)\ne2e/testutil/assertions.go-246-\t}\ne2e/testutil/assertions.go-247-\tt.Fatalf(\"checkpoint %s not found within %s\", checkpointID, timeout)\ne2e/testutil/assertions.go-248-}\ne2e/testutil/assertions.go-249-\ne2e/testutil/assertions.go-250-// AssertCommitLinkedToCheckpoint asserts the trailer exists AND the\ne2e/testutil/assertions.go-251-// checkpoint data exists on the checkpoint branch.\ne2e/testutil/assertions.go-252-func AssertCommitLinkedToCheckpoint(t *testing.T, dir string, ref string) {\ne2e/testutil/assertions.go-253-\tt.Helper()\ne2e/testutil/assertions.go-254-\ttrailer := AssertHasCheckpointTrailer(t, dir, ref)\ne2e/testutil/assertions.go-255-\tAssertCheckpointExists(t, dir, trailer)\ne2e/testutil/assertions.go-256-}\ne2e/testutil/assertions.go-257-\ne2e/testutil/assertions.go-258-// AssertCheckpointHasSingleSession asserts checkpoint metadata has exactly one session.\ne2e/testutil/assertions.go-259-func AssertCheckpointHasSingleSession(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-260-\tt.Helper()\ne2e/testutil/assertions.go-261-\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go-262-\tassert.Len(t, meta.Sessions, 1,\ne2e/testutil/assertions.go-263-\t\t\"expected 1 session in checkpoint %s, got %d\", checkpointID, len(meta.Sessions))\ne2e/testutil/assertions.go-264-}\ne2e/testutil/assertions.go-265-\ne2e/testutil/assertions.go-266-// AssertCheckpointMetadataComplete asserts essential fields in checkpoint metadata are populated.\ne2e/testutil/assertions.go-267-func AssertCheckpointMetadataComplete(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-268-\tt.Helper()\ne2e/testutil/assertions.go-269-\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go-270-\tassert.NotEmpty(t, meta.CLIVersion, \"checkpoint %s: cli_version should be set\", checkpointID)\ne2e/testutil/assertions.go-271-\tassert.NotEmpty(t, meta.Strategy, \"checkpoint %s: strategy should be set\", checkpointID)\ne2e/testutil/assertions.go-272-\tassert.NotEmpty(t, meta.Sessions, \"checkpoint %s: should have at least 1 session\", checkpointID)\ne2e/testutil/assertions.go-273-\tassert.Equal(t, checkpointID, meta.CheckpointID,\ne2e/testutil/assertions.go-274-\t\t\"checkpoint metadata ID should match expected\")\ne2e/testutil/assertions.go-275-}\ne2e/testutil/assertions.go-276-\ne2e/testutil/assertions.go-277-// WaitForCheckpointAdvanceFrom polls until the checkpoint branch advances from\ne2e/testutil/assertions.go-278-// the given ref, or fails the test after timeout. Use this when waiting for a\ne2e/testutil/assertions.go-279-// second (or subsequent) checkpoint after recording the branch position.\ne2e/testutil/assertions.go-280-func WaitForCheckpointAdvanceFrom(t *testing.T, dir string, fromRef string, timeout time.Duration) {\ne2e/testutil/assertions.go-281-\tt.Helper()\ne2e/testutil/assertions.go-282-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-283-\tfor time.Now().Before(deadline) {\n"},{"type":"input_text","text":"\n[exit 0]\n"},{"type":"input_text","text":"\t\tvar paths []string\n\t\tif err := json.Unmarshal([]byte(filePaths), &paths); err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, fp := range paths {\n\t\t\tif fp != \"\" && !seen[fp] {\n\t\t\t\tseen[fp] = true\n\t\t\t\tfiles = append(files, fp)\n\t\t\t}\n\t\t}\n\t}\n\n\treturn files\n}\n\ntype subagentStartedData struct {\n\tToolCallID       string `json:\"toolCallId\"`\n\tAgentType        string `json:\"agentType\"`\n\tAgentName        string `json:\"agentName\"`\n\tAgentDescription string `json:\"agentDescription\"`\n}\n\ntype subagentEvidence struct {\n\tToolUseID       string\n\tSubagentType    string\n\tTaskDescription string\n\tFiles           []string\n}\n\n// extractSubagentEvidence joins Copilot's parent transcript on the child UUID.\n// subagent.started supplies the stable parent task ID before subagentStop runs;\n// child tool events carry the same UUID and parentToolCallId. Ambiguous or\n// incomplete identity fails closed instead of merging concurrent children.\nfunc extractSubagentEvidence(events []copilotEvent, agentID string) (subagentEvidence, bool) {\n\tif agentID == \"\" {\n\t\treturn subagentEvidence{}, false\n\t}\n\n\ttoolUseID := \"\"\n\tvar started subagentStartedData\n\tfor i := range events {\n\t\tif events[i].Type != eventTypeSubagentStarted || events[i].AgentID != agentID {\n\t\t\tcontinue\n\t\t}\n\t\tvar data subagentStartedData\n\t\tif json.Unmarshal(events[i].Data, &data) != nil || data.ToolCallID == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif toolUseID != \"\" && toolUseID != data.ToolCallID {\n\t\t\treturn subagentEvidence{}, false\n\t\t}\n\t\ttoolUseID = data.ToolCallID\n\t\tstarted = data\n\t}\n\tif toolUseID == \"\" {\n\t\treturn subagentEvidence{}, false\n\t}\n\n\tfiles := extractModifiedFilesMatching(events, func(ev copilotEvent, data toolExecCompleteData) bool {\n\t\treturn ev.AgentID == agentID && data.ParentToolCallID == toolUseID\n\t})\n\tsubagentType := started.AgentType\n\tif subagentType == \"\" {\n\t\tsubagentType = started.AgentName\n\t}\n\treturn subagentEvidence{\n\t\tToolUseID:       toolUseID,\n\t\tSubagentType:    subagentType,\n\t\tTaskDescription: started.AgentDescription,\n\t\tFiles:           files,\n\t}, true\n}\n\n// extractPromptsFromEvents collects content from user.message events.\nfunc extractPromptsFromEvents(events []copilotEvent) []string {\n\tvar prompts []string\n\n\tfor i := range events {\n\t\tif events[i].Type != eventTypeUserMessage {\n\t\t\tcontinue\n\t\t}\n\n\t\tvar data userMessageData\n\t\tif err := json.Unmarshal(events[i].Data, &data); err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tType:      agent.SessionEnd,\n\t\tSessionID: env.SessionID,\n\t\tTimestamp: env.Timestamp,\n\t}\n}\n\nfunc (c *CopilotCLIAgent) buildSubagentStop(ctx context.Context, env *hookEnvelope) *agent.Event {\n\tevidence, ok := c.readSubagentEvidence(ctx, env)\n\tif !ok {\n\t\treturn nil\n\t}\n\tsubagentType := env.AgentType\n\tif subagentType == \"\" {\n\t\tsubagentType = env.AgentName\n\t}\n\tif subagentType == \"\" {\n\t\tsubagentType = evidence.SubagentType\n\t}\n\tdescription := env.AgentDescription\n\tif description == \"\" {\n\t\tdescription = evidence.TaskDescription\n\t}\n\treturn &agent.Event{\n\t\tType:                          agent.SubagentEnd,\n\t\tSessionID:                     env.SessionID,\n\t\tSessionRef:                    env.TranscriptPath,\n\t\tTimestamp:                     env.Timestamp,\n\t\tToolUseID:                     evidence.ToolUseID,\n\t\tSubagentID:                    env.AgentID,\n\t\tSubagentType:                  subagentType,\n\t\tTaskDescription:               description,\n\t\tModifiedFiles:                 evidence.Files,\n\t\tFinal:                         true,\n\t\tCompletionWithoutLaunch:       true,\n\t\tSubagentTranscriptUnavailable: true,\n\t}\n}\n\nfunc (c *CopilotCLIAgent) readSubagentEvidence(ctx context.Context, env *hookEnvelope) (subagentEvidence, bool) {\n\tif env.SessionID == \"\" || env.AgentID == \"\" || env.TranscriptPath == \"\" {\n\t\treturn subagentEvidence{}, false\n\t}\n\tstore, err := agent.OpenSessionStore(c, env.CWD)\n\tif err != nil {\n\t\tlogging.Warn(ctx, \"copilot-cli: cannot open session store for subagent stop\", \"err\", err)\n\t\treturn subagentEvidence{}, false\n\t}\n\tname, err := store.Name(env.TranscriptPath)\n\tif err != nil {\n\t\tlogging.Warn(ctx, \"copilot-cli: rejecting subagent stop transcript outside session store\", \"err\", err)\n\t\treturn subagentEvidence{}, false\n\t}\n\texpectedName, _, err := store.SessionFile(env.SessionID)\n\tif err != nil || name != expectedName {\n\t\tlogging.Warn(ctx, \"copilot-cli: rejecting subagent stop transcript with unexpected layout\",\n\t\t\t\"sessionID\", env.SessionID)\n\t\treturn subagentEvidence{}, false\n\t}\n\traw, err := store.ReadFile(name)\n\tif err != nil {\n\t\tlogging.Warn(ctx, \"copilot-cli: cannot read parent transcript for subagent stop\", \"err\", err)\n\t\treturn subagentEvidence{}, false\n\t}\n\tevents, err := parseEventsFromBytes(raw)\n\tif err != nil {\n\t\tlogging.Warn(ctx, \"copilot-cli: cannot parse parent transcript for subagent stop\", \"err\", err)\n\t\treturn subagentEvidence{}, false\n\t}\n\treturn extractSubagentEvidence(events, env.AgentID)\n}\n\nfunc (c *CopilotCLIAgent) readHookEnvelope(stdin io.Reader) (*hookEnvelope, error) {\n\t// Stream one JSON value rather than io.ReadAll so the hook never blocks\n\t// waiting for stdin EOF that some agents don't send on Windows (issue #1398).\n\traw, err := agent.ReadHookInputRaw(stdin)\n\tif err != nil {\n"},{"type":"input_text","text":"\n[exit 0]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a081dc-6d8d-77f3-bc0a-5b28bab962d1","create_time":1788885348.273058}}}
