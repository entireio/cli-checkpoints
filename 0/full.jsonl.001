ce.xMqGgb/npm/package/schemas/api.schema.json-19678-        \"sessionStart\": \"Runs when a session starts.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19679-        \"sessionEnd\": \"Runs when a session ends.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19680-        \"postResult\": \"Runs after an agent result is produced.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19681-        \"prePRDescription\": \"Runs before a pull request description is generated.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19682-        \"errorOccurred\": \"Runs when the agent encounters an error.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19683-        \"agentStop\": \"Runs when the agent stops.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json:19684:        \"subagentStart\": \"Runs when a subagent starts.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19685-        \"subagentStop\": \"Runs when a subagent stops.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19686-        \"preCompact\": \"Runs before conversation context is compacted.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19687-        \"permissionRequest\": \"Runs when the agent requests permission.\",\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19688-        \"notification\": \"Runs when the agent emits a notification.\"\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19689-      }\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19690-    },\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19691-    \"InstalledPlugin\": {\n/private/tmp/copilot-evidence.xMqGgb/npm/package/schemas/api.schema.json-19692-      \"type\": \"object\",\n/private/tmp/