/manual_commit_git.go-449-\t}\ncmd/entire/cli/strategy/manual_commit_git.go-450-\tif existing == nil {\ncmd/entire/cli/strategy/manual_commit_git.go-451-\t\t// Return a copy to avoid sharing the pointer\ncmd/entire/cli/strategy/manual_commit_git.go-452-\t\treturn &agent.TokenUsage{\ncmd/entire/cli/strategy/manual_commit_git.go-453-\t\t\tInputTokens:         incoming.InputTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-454-\t\t\tCacheCreationTokens: incoming.CacheCreationTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-455-\t\t\tCacheReadTokens:     incoming.CacheReadTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-456-\t\t\tOutputTokens:        incoming.OutputTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-457-\t\t\tAPICallCount:        incoming.APICallCount,\ncmd/entire/cli/strategy/manual_commit_git.go-458-\t\t\tSubagentTokens:      incoming.SubagentTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-459-\t\t}\ncmd/entire/cli/strategy/manual_commit_git.go-460-\t}\ncmd/entire/cli/strategy/manual_commit_git.go-461-\ncmd/entire/cli/strategy/manual_commit_git.go-462-\t// Accumulate values\ncmd/entire/cli/strategy/manual_commit_git.go-463-\texisting.InputTokens += incoming.InputTokens\ncmd/entire/cli/strategy/manual_commit_git.go-464-\texisting.CacheCreationTokens += incoming.CacheCreationTokens\ncmd/entire/cli/strategy/manual_commit_git.go-465-\texisting.CacheReadTokens += incoming.CacheReadTokens\ncmd/entire/cli/strategy/manual_commit_git.go-466-\texisting.OutputTokens += incoming.OutputTokens\ncmd/entire/cli/strategy/manual_commit_git.go-467-\texisting.APICallCount += incoming.APICallCount\ncmd/entire/cli/strategy/manual_commit_git.go-468-\ncmd/entire/cli/strategy/manual_commit_git.go-469-\t// Replace (not add) subagent tokens: incoming.SubagentTokens is already\ncmd/entire/cli/strategy/manual_commit_git.go-470-\t// the cumulative total as of this step, so the latest snapshot supersedes\ncmd/entire/cli/strategy/manual_commit_git.go-471-\t// whatever was recorded before rather than stacking on top of it.\ncmd/entire/cli/strategy/manual_commit_git.go-472-\tif incoming.SubagentTokens != nil {\ncmd/entire/cli/strategy/manual_commit_git.go-473-\t\texisting.SubagentTokens = incoming.SubagentTokens\ncmd/entire/cli/strategy/manual_commit_git.go-474-\t}\ncmd/entire/cli/strategy/manual_commit_git.go-475-\ncmd/entire/cli/strategy/manual_commit_git.go-476-\treturn existing\ncmd/entire/cli/strategy/manual_commit_git.go-477-}\ncmd/entire/cli/strategy/manual_commit_git.go-478-\ncmd/entire/cli/strategy/manual_commit_git.go-479-// resetCheckpointWindow resets the per-checkpoint accumulation window after a\ncmd/entire/cli/strategy/manual_commit_git.go-480-// condensation reset. It zeroes the step count, clears the checkpoint-scoped\ncmd/entire/cli/strategy/manual_commit_git.go-481-// token usage, and snapshots the cumulative subagent total into\ncmd/entire/cli/strategy/manual_commit_git.go-482-// SubagentTokensBaseline so the next window's CheckpointTokenUsage.SubagentTokens\ncmd/entire/cli/strategy/manual_commit_git.go-483-// can be rescoped to \"since this condensation\" rather than re-reporting the full\ncmd/entire/cli/strategy/manual_commit_git.go-484-// cumulative subagent total (see accumulateTokenUsage and the SaveStep rescoping\ncmd/entire/cli/strategy/manual_commit_git.go-485-// in this file, plus SessionState.SubagentTokensBaseline). Shared by all three\ncmd/entire/cli/strategy/manual_commit_git.go-486-// condensation reset sites (CondenseSessionByID, CondenseAndMarkFullyCondensed,\ncmd/entire/cli/strategy/manual_commit_git.go-487-// condenseAndUpdateState) so the baseline capture cannot drift between them.\ncmd/entire/cli/strategy/manual_commit_git.go-488-//\ncmd/entire/cli/strategy/manual_commit_git.go-489-// It is also the single post-write mutation site for the task-record\ncmd/entire/cli/strategy/manual_commit_git.go-490-// lifecycle (#2058): every one of the three callers only reaches here after a\ncmd/en