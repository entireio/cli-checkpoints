data(t, dir, checkpointID)\ne2e/testutil/assertions.go-270-\tassert.NotEmpty(t, meta.CLIVersion, \"checkpoint %s: cli_version should be set\", checkpointID)\ne2e/testutil/assertions.go-271-\tassert.NotEmpty(t, meta.Strategy, \"checkpoint %s: strategy should be set\", checkpointID)\ne2e/testutil/assertions.go-272-\tassert.NotEmpty(t, meta.Sessions, \"checkpoint %s: should have at least 1 session\", checkpointID)\ne2e/testutil/assertions.go-273-\tassert.Equal(t, checkpointID, meta.CheckpointID,\ne2e/testutil/assertions.go-274-\t\t\"checkpoint metadata ID should match expected\")\ne2e/testutil/assertions.go-275-}\ne2e/testutil/assertions.go-276-\ne2e/testutil/assertions.go-277-// WaitForCheckpointAdvanceFrom polls until the checkpoint branch advances from\ne2e/testutil/assertions.go-278-// the given ref, or fails the test after timeout. Use this when waiting for a\ne2e/testutil/assertions.go-279-// second (or subsequent) checkpoint after recording the branch position.\ne2e/testutil/assertions.go-280-func WaitForCheckpointAdvanceFrom(t *testing.T, dir string, fromRef string, timeout time.Duration) {\ne2e/testutil/assertions.go-281-\tt.Helper()\ne2e/testutil/assertions.go-282-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-283-\tfor time.Now().Before(deadline) {\n","stderr":"","aggregated_output":"package testutil\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/execx\"\n\t\"github.com/entireio/cli/e2e/agents\"\n\t\"github.com/entireio/cli/e2e/entire\"\n)\n\nconst droidRepoSettingsPath = \".factory/settings.json\"\n\nconst (\n\tcheckpointRefV1 = \"entire/checkpoints/v1\"\n)\n\n// RepoState holds the working state for a single test's cloned repository.\ntype RepoState struct {\n\tAgent            agents.Agent\n\tDir              string\n\tArtifactDir      string\n\tHeadBefore       string\n\tCheckpointBefore string\n\tConsoleLog       *os.File\n\tsession          agents.Session // interactive session, if started via StartSession\n\tskipArtifacts    bool           // suppresses artifact capture on scenario restart\n}\n\n// SetupRepo creates a fresh git repository in a temporary directory, seeds it\n// with an initial commit, and runs `entire enable` for the given agent.\n// Artifact capture is registered as a cleanup function.\n//\n// When E2E_KEEP_REPOS is set, the temporary directory is not cleaned up\n// so it can be inspected after the test. A symlink in the artifact dir\n// points to the preserved repo.\nfunc SetupRepo(t *testing.T, agent agents.Agent) *RepoState {\n\tt.Helper()\n\n\tkeepRepos := os.Getenv(\"E2E_KEEP_REPOS\") != \"\"\n\n\t// Always use os.MkdirTemp instead of t.TempDir(). Go's t.TempDir()\n\t// creates nested subdirectories (TestName.../001/) whose structure\n\t// confuses some agents' (e.g. opencode) working-directory resolution.\n\t//\n\t// Codex refuses to operate from /tmp (e.g. \"Refusing to create helper\n\t// binaries under temporary dir\"), so for codex we place the repo under\n\t// $HOME/.cache/entire-e2e-repos/ instead.\n\troot := \"\"\n\tif agent.Name() == \"codex\" {\n\t\tcache, cerr := os.UserCacheDir()\n\t\tif cerr != nil {\n\t\t\tt.Fatalf(\"resolve user cache dir: %v\", cerr)\n\t\t}\n\t\troot = filepath.Join(cache, \"entire-e2e-repos\")\n\t\tif err := os.MkdirAll(root, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create e2e repo root %q: %v\", root, err)\n\t\t}\n\t}\n\tdir, err := os.MkdirTemp(root, \"e2e-repo-*\")\n\tif err != nil {\n\t\tt.Fatalf(\"create temporary e2e repo under %q: %v\", root, err)\n\t}\n\tif keepRepos {\n\t\tt.Logf(\"E2E_KEEP_REPOS: repo will be preserved at %s\", dir)\n\t} else {\n\t\tt.Cleanup(func() { os.RemoveAll(dir) })\n\t}\n\n\t// Resolve symlinks (macOS: /var -> /private/var) so paths match\n\t// what agent CLIs see when they resolve their own CWD.\n\tif resolved, err := filepath.EvalSymlinks(dir); err == nil {\n\t\tdir = resolved\n\t}\n\n\tGit(t, dir, \"init\")\n\tGit(t, dir, \"config\", \"user.name\", \"E2E Test\")\n\tGit(t, dir, \"config\", \"user.email\", \"e2e@test.local\")\n\tGit(t, dir, \"config\", \"core.pager\", \"cat\")\n\tGit(t, dir, \"config\", \"core.autocrlf\", \"true\")\n\tGit(t, dir, \"commit\", \"--allow-empty\", \"-m\", \"initial commit\")\n\n\t// Copilot prompt mode requires repository instructions. Commit the custom\n\t// agent fixture before Entire starts capture so setup files cannot be\n\t// attributed to the child under test.\n\tif agent.Name() == \"copilot-cli\" {\n\t\tagentsDir := filepath.Join(dir, \".github\", \"agents\")\n\t\tif err := os.MkdirAll(agentsDir, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create Copilot agent directory: %v\", err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(dir, \".github\", \"copilot-instructions.md\"), []byte(\"# E2E Test\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write copilot-instructions.md: %v\", err)\n\t\t}\n\t\tagentFile := \"---\\nname: entire-e2e-subagent\\ndescription: Creates the single file delegated by the parent.\\ntools: [\\\"*\\\"]\\n---\\nCreate only the requested file and do not delegate further.\\n\"\n\t\tif err := os.WriteFile(filepath.Join(agentsDir, \"entire-e2e-subagent.agent.md\"), []byte(agentFile), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write Copilot custom agent: %v\", err)\n\t\t}\n\t\tGit(t, dir, \"add\", \".github\")\n\t\tGit(t, dir, \"commit\", \"-m\", \"Add Copilot E2E agent fixture\")\n\t}\n\n\t// External agents need external_agents enabled in settings before enable,\n\t// so the CLI can discover the agent binary via PATH during DiscoverAndRegister.\n\tif ea, ok := agent.(agents.ExternalAgent); ok && ea.IsExternalAgent() {\n\t\tentireDir := filepath.Join(dir, \".entire\")\n\t\tif err := os.MkdirAll(entireDir, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create .entire for external agent: %v\", err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(entireDir, \"settings.json\"),\n\t\t\t[]byte(\"{\\\"external_agents\\\": true}\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write external_agents setting: %v\", err)\n\t\t}\n\t}\n\n\tentire.Enable(t, dir, agent.EntireAgent())\n\tif agent.Name() == \"gemini-cli\" {\n\t\tsetupGeminiTestHome(t, dir)\n\t}\n\tif agent.Name() == \"factoryai-droid\" {\n\t\tif err := configureDroidRepoSettings(dir); err != nil {\n\t\t\tt.Fatalf(\"configure droid repo settings: %v\", err)\n\t\t}\n\t}\n\t// commit_linking=always ensures the prepare-commit-msg hook adds the\n\t// Entire-Checkpoint trailer unconditionally. This is needed because\n\t// interactive agents run inside tmux (CanPromptInteractively()=true) but\n\t// can't respond to prompts, and content detection may fail on the first\n\t// checkpoint when no shadow branch exists yet. Prompt-mode agents still\n\t// exercise the !CanPromptInteractively() fast path since they have no TTY\n\t// regardless of this setting.\n\tPatchSettings(t, dir, map[string]any{\"log_level\": \"debug\", \"commit_linking\": \"always\"})\n\n\t// OpenCode's non-interactive mode auto-rejects external_directory permission\n\t// since there's no user to prompt. Write a config to allow it.\n\tif agent.Name() == \"opencode\" {\n\t\tcfg := `{\"$schema\": \"https://opencode.ai/config.json\", \"permission\": {\"external_directory\": \"allow\"}}`\n\t\tif key := os.Getenv(\"ANTHROPIC_API_KEY\"); key != \"\" {\n\t\t\tcfg = fmt.Sprintf(`{\"$schema\": \"https://opencode.ai/config.json\", \"permission\": {\"external_directory\": \"allow\"}, \"provider\": {\"anthropic\": {\"options\": {\"apiKey\": %q}}}}`, key)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(dir, \"opencode.json\"), []byte(cfg+\"\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write opencode.json: %v\", err)\n\t\t}\n\t}\n\n\t// Create artifact dir eagerly so console.log is written to disk\n\t// incrementally. Even if the test is killed by a global timeout,\n\t// partial output survives.\n\tartDir := artifactDir(t)\n\tconsoleLog, err := os.Create(filepath.Join(artDir, \"console.log\"))\n\tif err != nil {\n\t\tt.Fatalf(\"create console.log: %v\", err)\n\t}\n\n\tstate := &RepoState{\n\t\tAgent:            agent,\n\t\tDir:              dir,\n\t\tArtifactDir:      artDir,\n\t\tHeadBefore:       GitOutput(t, dir, \"rev-parse\", \"HEAD\"),\n\t\tCheckpointBefore: CheckpointState(dir),\n\t\tConsoleLog:       consoleLog,\n\t}\n\n\tt.Cleanup(func() {\n\t\t_ = consoleLog.Close()\n\t\tif !state.skipArtifacts {\n\t\t\tCaptureArtifacts(t, state)\n\t\t}\n\t})\n\n\treturn state\n}\n\ne2e/testutil/repo.go:717:func ReadCheckpointMetadata(t *testing.T, dir string, checkpointID string) CheckpointMetadata {\ne2e/testutil/repo.go-718-\tt.Helper()\ne2e/testutil/repo.go-719-\ne2e/testutil/repo.go-720-\tblob := checkpointBlobSpec(checkpointID, \"metadata.json\")\ne2e/testutil/repo.go-721-\ne2e/testutil/repo.go-722-\traw := GitOutput(t, dir, \"show\", blob)\ne2e/testutil/repo.go-723-\ne2e/testutil/repo.go-724-\tvar meta CheckpointMetadata\ne2e/testutil/repo.go-725-\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-726-\t\tt.Fatalf(\"unmarshal checkpoint metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-727-\t}\ne2e/testutil/repo.go-728-\ne2e/testutil/repo.go-729-\treturn meta\ne2e/testutil/repo.go-730-}\ne2e/testutil/repo.go-731-\ne2e/testutil/repo.go-732-// ReadSessionMetadata reads a session's metadata.json from the tip of the\ne2e/testutil/repo.go-733-// checkpoint branch for the given checkpoint ID and session index.\ne2e/testutil/repo.go-734-func ReadSessionMetadata(t *testing.T, dir string, checkpointID string, sessionIndex int) SessionMetadata {\ne2e/testutil/repo.go-735-\tt.Helper()\ne2e/testutil/repo.go-736-\ne2e/testutil/repo.go-737-\tblob := checkpointBlobSpec(checkpointID, fmt.Sprintf(\"%d/metadata.json\", sessionIndex))\ne2e/testutil/repo.go-738-\ne2e/testutil/repo.go-739-\traw := GitOutput(t, dir, \"show\", blob)\ne2e/testutil/repo.go-740-\ne2e/testutil/repo.go-741-\tvar meta SessionMetadata\ne2e/testutil/repo.go-742-\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-743-\t\tt.Fatalf(\"unmarshal session metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-744-\t}\ne2e/testutil/repo.go-745-\ne2e/testutil/repo.go-746-\treturn meta\ne2e/testutil/repo.go-747-}\ne2e/testutil/repo.go-748-\ne2e/testutil/repo.go-749-// WaitForSessionMetadata polls until session metadata exists on the checkpoint\ne2e/testutil/repo.go-750-// branch for the given checkpoint ID and session index, then returns it.\ne2e/testutil/repo.go-751-// This handles the race where the checkpoint branch advances before session\ne2e/testutil/repo.go-752-// metadata is fully committed.\ne2e/testutil/repo.go-753-func WaitForSessionMetadata(t *testing.T, dir string, checkpointID string, sessionIndex int, timeout time.Duration) SessionMetadata {\ne2e/testutil/repo.go-754-\tt.Helper()\ne2e/testutil/repo.go-755-\ne2e/testutil/repo.go-756-\tblob := checkpointBlobSpec(checkpointID, fmt.Sprintf(\"%d/metadata.json\", sessionIndex))\ne2e/testutil/repo.go-757-\ne2e/testutil/repo.go-758-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/repo.go-759-\tfor time.Now().Before(deadline) {\ne2e/testutil/repo.go-760-\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/repo.go-761-\t\tif raw != \"\" {\ne2e/testutil/repo.go-762-\t\t\tvar meta SessionMetadata\ne2e/testutil/repo.go-763-\t\t\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-764-\t\t\t\tt.Fatalf(\"unmarshal session metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-765-\t\t\t}\ne2e/testutil/repo.go-766-\t\t\treturn meta\ne2e/testutil/repo.go-767-\t\t}\ne2e/testutil/repo.go-768-\t\ttime.Sleep(500 * time.Millisecond)\ne2e/testutil/repo.go-769-\t}\ne2e/testutil/repo.go-770-\tt.Fatalf(\"session metadata %s did not appear within %s\", blob, timeout)\ne2e/testutil/repo.go-771-\treturn SessionMetadata{}\ne2e/testutil/repo.go-772-}\ne2e/testutil/repo.go-773-\ne2e/testutil/repo.go-774-// SetupBareRemote creates a bare git repo, adds it as \"origin\", and pushes\ne2e/testutil/repo.go-775-// the initial commit. Returns the bare repo path.\ne2e/testutil/repo.go-776-func SetupBareRemote(t *testing.T, s *RepoState) string {\ne2e/testutil/repo.go-777-\tt.Helper()\ne2e/testutil/repo.go-778-\ne2e/testutil/repo.go-779-\tvar bareDir string\ne2e/testutil/repo.go-780-\tif os.Getenv(\"E2E_KEEP_REPOS\") != \"\" {\ne2e/testutil/repo.go-781-\t\tvar err error\ne2e/testutil/repo.go-782-\t\tbareDir, err = os.MkdirTemp(\"\", \"e2e-bare-*\")\ne2e/testutil/repo.go-783-\t\tif err != nil {\ne2e/testutil/repo.go-784-\t\t\tt.Fatalf(\"create bare remote dir: %v\", err)\ne2e/testutil/repo.go-785-\t\t}\ne2e/testutil/repo.go-786-\t\tt.Logf(\"E2E_KEEP_REPOS: bare remote will be preserved at %s\", bareDir)\ne2e/testutil/repo.go-787-\t} else {\ne2e/testutil/repo.go-788-\t\tbareDir = t.TempDir()\ne2e/testutil/repo.go-789-\t}\ne2e/testutil/repo.go-790-\ne2e/testutil/repo.go-791-\tGit(t, bareDir, \"init\", \"--bare\")\ne2e/testutil/repo.go-792-\tGit(t, s.Dir, \"remote\", \"add\", \"origin\", bareDir)\ne2e/testutil/repo.go-793-\tGit(t, s.Dir, \"push\", \"-u\", \"origin\", \"HEAD\")\ne2e/testutil/repo.go-794-\treturn bareDir\ne2e/testutil/repo.go-795-}\ne2e/testutil/repo.go-796-\ne2e/testutil/repo.go-797-// GitOutputErr runs a git command and returns (output, error) without\n--\ne2e/testutil/assertions.go:203:func AssertCheckpointExists(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-204-\tt.Helper()\ne2e/testutil/assertions.go-205-\tif UsingGitRefs() {\ne2e/testutil/assertions.go-206-\t\t// No single branch to grep; existence is the per-checkpoint ref carrying a\ne2e/testutil/assertions.go-207-\t\t// readable root metadata.json.\ne2e/testutil/assertions.go-208-\t\tblob := checkpointBlobSpec(checkpointID, \"metadata.json\")\ne2e/testutil/assertions.go-209-\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-210-\t\tassert.NotEmpty(t, raw, \"checkpoint %s metadata not found at %s\", checkpointID, blob)\ne2e/testutil/assertions.go-211-\t\treturn\ne2e/testutil/assertions.go-212-\t}\ne2e/testutil/assertions.go-213-\tout := GitOutput(t, dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-214-\tassert.NotEmpty(t, out, \"checkpoint %s not found on checkpoint branch\", checkpointID)\ne2e/testutil/assertions.go-215-\ne2e/testutil/assertions.go-216-\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-217-\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-218-\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-219-\tassert.NotEmpty(t, raw,\ne2e/testutil/assertions.go-220-\t\t\"checkpoint %s metadata not found at %s\", checkpointID, path)\ne2e/testutil/assertions.go-221-}\ne2e/testutil/assertions.go-222-\ne2e/testutil/assertions.go-223-// WaitForCheckpointExists polls until the checkpoint ID appears on the\ne2e/testutil/assertions.go-224-// checkpoint branch and its metadata.json is readable, or fails after timeout.\ne2e/testutil/assertions.go-225-func WaitForCheckpointExists(t *testing.T, dir string, checkpointID string, timeout time.Duration) {\ne2e/testutil/assertions.go-226-\tt.Helper()\ne2e/testutil/assertions.go-227-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-228-\tfor time.Now().Before(deadline) {\ne2e/testutil/assertions.go-229-\t\tif UsingGitRefs() {\ne2e/testutil/assertions.go-230-\t\t\tif gitOutputSafe(dir, \"show\", checkpointBlobSpec(checkpointID, \"metadata.json\")) != \"\" {\ne2e/testutil/assertions.go-231-\t\t\t\treturn\ne2e/testutil/assertions.go-232-\t\t\t}\ne2e/testutil/assertions.go-233-\t\t\ttime.Sleep(200 * time.Millisecond)\ne2e/testutil/assertions.go-234-\t\t\tcontinue\ne2e/testutil/assertions.go-235-\t\t}\ne2e/testutil/assertions.go-236-\t\tout := gitOutputSafe(dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-237-\t\tif out != \"\" {\ne2e/testutil/assertions.go-238-\t\t\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-239-\t\t\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-240-\t\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-241-\t\t\tif raw != \"\" {\ne2e/testutil/assertions.go-242-\t\t\t\treturn\ne2e/testutil/assertions.go-243-\t\t\t}\ne2e/testutil/assertions.go-244-\t\t}\ne2e/testutil/assertions.go-245-\t\ttime.Sleep(200 * time.Millisecond)\ne2e/testutil/assertions.go-246-\t}\ne2e/testutil/assertions.go-247-\tt.Fatalf(\"checkpoint %s not found within %s\", checkpointID, timeout)\ne2e/testutil/assertions.go-248-}\ne2e/testutil/assertions.go-249-\ne2e/testutil/assertions.go-250-// AssertCommitLinkedToCheckpoint asserts the trailer exists AND the\ne2e/testutil/assertions.go-251-// checkpoint data exists on the checkpoint branch.\ne2e/testutil/assertions.go-252-func AssertCommitLinkedToCheckpoint(t *testing.T, dir string, ref string) {\ne2e/testutil/assertions.go-253-\tt.Helper()\ne2e/testutil/assertions.go-254-\ttrailer := AssertHasCheckpointTrailer(t, dir, ref)\ne2e/testutil/assertions.go-255-\tAssertCheckpointExists(t, dir, trailer)\ne2e/testutil/assertions.go-256-}\ne2e/testutil/assertions.go-257-\ne2e/testutil/assertions.go-258-// AssertCheckpointHasSingleSession asserts checkpoint metadata has exactly one session.\ne2e/testutil/assertions.go-259-func AssertCheckpointHasSingleSession(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-260-\tt.Helper()\ne2e/testutil/assertions.go-261-\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go-262-\tassert.Len(t, meta.Sessions, 1,\ne2e/testutil/assertions.go-263-\t\t\"expected 1 session in checkpoint %s, got %d\", checkpointID, len(meta.Sessions))\ne2e/testutil/assertions.go-264-}\ne2e/testutil/assertions.go-265-\ne2e/testutil/assertions.go-266-// AssertCheckpointMetadataComplete asserts essential fields in checkpoint metadata are populated.\ne2e/testutil/assertions.go-267-func AssertCheckpointMetadataComplete(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-268-\tt.Helper()\ne2e/testutil/assertions.go-269-\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go-270-\tassert.NotEmpty(t, meta.CLIVersion, \"checkpoint %s: cli_version should be set\", checkpointID)\ne2e/testutil/assertions.go-271-\tassert.NotEmpty(t, meta.Strategy, \"checkpoint %s: strategy should be set\", checkpointID)\ne2e/testutil/assertions.go-272-\tassert.NotEmpty(t, meta.Sessions, \"checkpoint %s: should have at least 1 session\", checkpointID)\ne2e/testutil/assertions.go-273-\tassert.Equal(t, checkpointID, meta.CheckpointID,\ne2e/testutil/assertions.go-274-\t\t\"checkpoint metadata ID should match expected\")\ne2e/testutil/assertions.go-275-}\ne2e/testutil/assertions.go-276-\ne2e/testutil/assertions.go-277-// WaitForCheckpointAdvanceFrom polls until the checkpoint branch advances from\ne2e/testutil/assertions.go-278-// the given ref, or fails the test after timeout. Use this when waiting for a\ne2e/testutil/assertions.go-279-// second (or subsequent) checkpoint after recording the branch position.\ne2e/testutil/assertions.go-280-func WaitForCheckpointAdvanceFrom(t *testing.T, dir string, fromRef string, timeout time.Duration) {\ne2e/testutil/assertions.go-281-\tt.Helper()\ne2e/testutil/assertions.go-282-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-283-\tfor time.Now().Before(deadline) {\n","exit_code":0,"duration":{"secs":0,"nanos":2167},"formatted_output":"package testutil\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/execx\"\n\t\"github.com/entireio/cli/e2e/agents\"\n\t\"github.com/entireio/cli/e2e/entire\"\n)\n\nconst droidRepoSettingsPath = \".factory/settings.json\"\n\nconst (\n\tcheckpointRefV1 = \"entire/checkpoints/v1\"\n)\n\n// RepoState holds the working state for a single test's cloned repository.\ntype RepoState struct {\n\tAgent            agents.Agent\n\tDir              string\n\tArtifactDir      string\n\tHeadBefore       string\n\tCheckpointBefore string\n\tConsoleLog       *os.File\n\tsession          agents.Session // interactive session, if started via StartSession\n\tskipArtifacts    bool           // suppresses artifact capture on scenario restart\n}\n\n// SetupRepo creates a fresh git repository in a temporary directory, seeds it\n// with an initial commit, and runs `entire enable` for the given agent.\n// Artifact capture is registered as a cleanup function.\n//\n// When E2E_KEEP_REPOS is set, the temporary directory is not cleaned up\n// so it can be inspected after the test. A symlink in the artifact dir\n// points to the preserved repo.\nfunc SetupRepo(t *testing.T, agent agents.Agent) *RepoState {\n\tt.Helper()\n\n\tkeepRepos := os.Getenv(\"E2E_KEEP_REPOS\") != \"\"\n\n\t// Always use os.MkdirTemp instead of t.TempDir(). Go's t.TempDir()\n\t// creates nested subdirectories (TestName.../001/) whose structure\n\t// confuses some agents' (e.g. opencode) working-directory resolution.\n\t//\n\t// Codex refuses to operate from /tmp (e.g. \"Refusing to create helper\n\t// binaries under temporary dir\"), so for codex we place the repo under\n\t// $HOME/.cache/entire-e2e-repos/ instead.\n\troot := \"\"\n\tif agent.Name() == \"codex\" {\n\t\tcache, cerr := os.UserCacheDir()\n\t\tif cerr != nil {\n\t\t\tt.Fatalf(\"resolve user cache dir: %v\", cerr)\n\t\t}\n\t\troot = filepath.Join(cache, \"entire-e2e-repos\")\n\t\tif err := os.MkdirAll(root, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create e2e repo root %q: %v\", root, err)\n\t\t}\n\t}\n\tdir, err := os.MkdirTemp(root, \"e2e-repo-*\")\n\tif err != nil {\n\t\tt.Fatalf(\"create temporary e2e repo under %q: %v\", root, err)\n\t}\n\tif keepRepos {\n\t\tt.Logf(\"E2E_KEEP_REPOS: repo will be preserved at %s\", dir)\n\t} else {\n\t\tt.Cleanup(func() { os.RemoveAll(dir) })\n\t}\n\n\t// Resolve symlinks (macOS: /var -> /private/var) so paths match\n\t// what agent CLIs see when they resolve their own CWD.\n\tif resolved, err := filepath.EvalSymlinks(dir); err == nil {\n\t\tdir = resolved\n\t}\n\n\tGit(t, dir, \"init\")\n\tGit(t, dir, \"config\", \"user.name\", \"E2E Test\")\n\tGit(t, dir, \"config\", \"user.email\", \"e2e@test.local\")\n\tGit(t, dir, \"config\", \"core.pager\", \"cat\")\n\tGit(t, dir, \"config\", \"core.autocrlf\", \"true\")\n\tGit(t, dir, \"commit\", \"--allow-empty\", \"-m\", \"initial commit\")\n\n\t// Copilot prompt mode requires repository instructions. Commit the custom\n\t// agent fixture before Entire starts capture so setup files cannot be\n\t// attributed to the child under test.\n\tif agent.Name() == \"copilot-cli\" {\n\t\tagentsDir := filepath.Join(dir, \".github\", \"agents\")\n\t\tif err := os.MkdirAll(agentsDir, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create Copilot agent directory: %v\", err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(dir, \".github\", \"copilot-instructions.md\"), []byte(\"# E2E Test\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write copilot-instructions.md: %v\", err)\n\t\t}\n\t\tagentFile := \"---\\nname: entire-e2e-subagent\\ndescription: Creates the single file delegated by the parent.\\ntools: [\\\"*\\\"]\\n---\\nCreate only the requested file and do not delegate further.\\n\"\n\t\tif err := os.WriteFile(filepath.Join(agentsDir, \"entire-e2e-subagent.agent.md\"), []byte(agentFile), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write Copilot custom agent: %v\", err)\n\t\t}\n\t\tGit(t, dir, \"add\", \".github\")\n\t\tGit(t, dir, \"commit\", \"-m\", \"Add Copilot E2E agent fixture\")\n\t}\n\n\t// External agents need external_agents enabled in settings before enable,\n\t// so the CLI can discover the agent binary via PATH during DiscoverAndRegister.\n\tif ea, ok := agent.(agents.ExternalAgent); ok && ea.IsExternalAgent() {\n\t\tentireDir := filepath.Join(dir, \".entire\")\n\t\tif err := os.MkdirAll(entireDir, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create .entire for external agent: %v\", err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(entireDir, \"settings.json\"),\n\t\t\t[]byte(\"{\\\"external_agents\\\": true}\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write external_agents setting: %v\", err)\n\t\t}\n\t}\n\n\tentire.Enable(t, dir, agent.EntireAgent())\n\tif agent.Name() == \"gemini-cli\" {\n\t\tsetupGeminiTestHome(t, dir)\n\t}\n\tif agent.Name() == \"factoryai-droid\" {\n\t\tif err := configureDroidRepoSettings(dir); err != nil {\n\t\t\tt.Fatalf(\"configure droid repo settings: %v\", err)\n\t\t}\n\t}\n\t// commit_linking=always ensures the prepare-commit-msg hook adds the\n\t// Entire-Checkpoint trailer unconditionally. This is needed because\n\t// interactive agents run inside tmux (CanPromptInteractively()=true) but\n\t// can't respond to prompts, and content detection may fail on the first\n\t// checkpoint when no shadow branch exists yet. Prompt-mode agents still\n\t// exercise the !CanPromptInteractively() fast path since they have no TTY\n\t// regardless of this setting.\n\tPatchSettings(t, dir, map[string]any{\"log_level\": \"debug\", \"commit_linking\": \"always\"})\n\n\t// OpenCode's non-interactive mode auto-rejects external_directory permission\n\t// since there's no user to prompt. Write a config to allow it.\n\tif agent.Name() == \"opencode\" {\n\t\tcfg := `{\"$schema\": \"https://opencode.ai/config.json\", \"permission\": {\"external_directory\": \"allow\"}}`\n\t\tif key := os.Getenv(\"ANTHROPIC_API_KEY\"); key != \"\" {\n\t\t\tcfg = fmt.Sprintf(`{\"$schema\": \"https://opencode.ai/config.json\", \"permission\": {\"external_directory\": \"allow\"}, \"provider\": {\"anthropic\": {\"options\": {\"apiKey\": %q}}}}`, key)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(dir, \"opencode.json\"), []byte(cfg+\"\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write opencode.json: %v\", err)\n\t\t}\n\t}\n\n\t// Create artifact dir eagerly so console.log is written to disk\n\t// incrementally. Even if the test is killed by a global timeout,\n\t// partial output survives.\n\tartDir := artifactDir(t)\n\tconsoleLog, err := os.Create(filepath.Join(artDir, \"console.log\"))\n\tif err != nil {\n\t\tt.Fatalf(\"create console.log: %v\", err)\n\t}\n\n\tstate := &RepoState{\n\t\tAgent:            agent,\n\t\tDir:              dir,\n\t\tArtifactDir:      artDir,\n\t\tHeadBefore:       GitOutput(t, dir, \"rev-parse\", \"HEAD\"),\n\t\tCheckpointBefore: CheckpointState(dir),\n\t\tConsoleLog:       consoleLog,\n\t}\n\n\tt.Cleanup(func() {\n\t\t_ = consoleLog.Close()\n\t\tif !state.skipArtifacts {\n\t\t\tCaptureArtifacts(t, state)\n\t\t}\n\t})\n\n\treturn state\n}\n\ne2e/testutil/repo.go:717:func ReadCheckpointMetadata(t *testing.T, dir string, checkpointID string) CheckpointMetadata {\ne2e/testutil/repo.go-718-\tt.Helper()\ne2e/testutil/repo.go-719-\ne2e/testutil/repo.go-720-\tblob := checkpointBlobSpec(checkpointID, \"metadata.json\")\ne2e/testutil/repo.go-721-\ne2e/testutil/repo.go-722-\traw := GitOutput(t, dir, \"show\", blob)\ne2e/testutil/repo.go-723-\ne2e/testutil/repo.go-724-\tvar meta CheckpointMetadata\ne2e/testutil/repo.go-725-\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-726-\t\tt.Fatalf(\"unmarshal checkpoint metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-727-\t}\ne2e/testutil/repo.go-728-\ne2e/testutil/repo.go-729-\treturn meta\ne2e/testutil/repo.go-730-}\ne2e/testutil/repo.go-731-\ne2e/testutil/repo.go-732-// ReadSessionMetadata reads a session's metadata.json from the tip of the\ne2e/testutil/repo.go-733-// checkpoint branch for the given checkpoint ID and session index.\ne2e/testutil/repo.go-734-func ReadSessionMetadata(t *testing.T, dir string, checkpointID string, sessionIndex int) SessionMetadata {\ne2e/testutil/repo.go-735-\tt.Helper()\ne2e/testutil/repo.go-736-\ne2e/testutil/repo.go-737-\tblob := checkpointBlobSpec(checkpointID, fmt.Sprintf(\"%d/metadata.json\", sessionIndex))\ne2e/testutil/repo.go-738-\ne2e/testutil/repo.go-739-\traw := GitOutput(t, dir, \"show\", blob)\ne2e/testutil/repo.go-740-\ne2e/testutil/repo.go-741-\tvar meta SessionMetadata\ne2e/testutil/repo.go-742-\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-743-\t\tt.Fatalf(\"unmarshal session metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-744-\t}\ne2e/testutil/repo.go-745-\ne2e/testutil/repo.go-746-\treturn meta\ne2e/testutil/repo.go-747-}\ne2e/testutil/repo.go-748-\ne2e/testutil/repo.go-749-// WaitForSessionMetadata polls until session metadata exists on the checkpoint\ne2e/testutil/repo.go-750-// branch for the given checkpoint ID and session index, then returns it.\ne2e/testutil/repo.go-751-// This handles the race where the checkpoint branch advances before session\ne2e/testutil/repo.go-752-// metadata is fully committed.\ne2e/testutil/repo.go-753-func WaitForSessionMetadata(t *testing.T, dir string, checkpointID string, sessionIndex int, timeout time.Duration) SessionMetadata {\ne2e/testutil/repo.go-754-\tt.Helper()\ne2e/testutil/repo.go-755-\ne2e/testutil/repo.go-756-\tblob := checkpointBlobSpec(checkpointID, fmt.Sprintf(\"%d/metadata.json\", sessionIndex))\ne2e/testutil/repo.go-757-\ne2e/testutil/repo.go-758-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/repo.go-759-\tfor time.Now().Before(deadline) {\ne2e/testutil/repo.go-760-\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/repo.go-761-\t\tif raw != \"\" {\ne2e/testutil/repo.go-762-\t\t\tvar meta SessionMetadata\ne2e/testutil/repo.go-763-\t\t\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-764-\t\t\t\tt.Fatalf(\"unmarshal session metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-765-\t\t\t}\ne2e/testutil/repo.go-766-\t\t\treturn meta\ne2e/testutil/repo.go-767-\t\t}\ne2e/testutil/repo.go-768-\t\ttime.Sleep(500 * time.Millisecond)\ne2e/testutil/repo.go-769-\t}\ne2e/testutil/repo.go-770-\tt.Fatalf(\"session metadata %s did not appear within %s\", blob, timeout)\ne2e/testutil/repo.go-771-\treturn SessionMetadata{}\ne2e/testutil/repo.go-772-}\ne2e/testutil/repo.go-773-\ne2e/testutil/repo.go-774-// SetupBareRemote creates a bare git repo, adds it as \"origin\", and pushes\ne2e/testutil/repo.go-775-// the initial commit. Returns the bare repo path.\ne2e/testutil/repo.go-776-func SetupBareRemote(t *testing.T, s *RepoState) string {\ne2e/testutil/repo.go-777-\tt.Helper()\ne2e/testutil/repo.go-778-\ne2e/testutil/repo.go-779-\tvar bareDir string\ne2e/testutil/repo.go-780-\tif os.Getenv(\"E2E_KEEP_REPOS\") != \"\" {\ne2e/testutil/repo.go-781-\t\tvar err error\ne2e/testutil/repo.go-782-\t\tbareDir, err = os.MkdirTemp(\"\", \"e2e-bare-*\")\ne2e/testutil/repo.go-783-\t\tif err != nil {\ne2e/testutil/repo.go-784-\t\t\tt.Fatalf(\"create bare remote dir: %v\", err)\ne2e/testutil/repo.go-785-\t\t}\ne2e/testutil/repo.go-786-\t\tt.Logf(\"E2E_KEEP_REPOS: bare remote will be preserved at %s\", bareDir)\ne2e/testutil/repo.go-787-\t} else {\ne2e/testutil/repo.go-788-\t\tbareDir = t.TempDir()\ne2e/testutil/repo.go-789-\t}\ne2e/testutil/repo.go-790-\ne2e/testutil/repo.go-791-\tGit(t, bareDir, \"init\", \"--bare\")\ne2e/testutil/repo.go-792-\tGit(t, s.Dir, \"remote\", \"add\", \"origin\", bareDir)\ne2e/testutil/repo.go-793-\tGit(t, s.Dir, \"push\", \"-u\", \"origin\", \"HEAD\")\ne2e/testutil/repo.go-794-\treturn bareDir\ne2e/testutil/repo.go-795-}\ne2e/testutil/repo.go-796-\ne2e/testutil/repo.go-797-// GitOutputErr runs a git command and returns (output, error) without\n--\ne2e/testutil/assertions.go:203:func AssertCheckpointExists(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-204-\tt.Helper()\ne2e/testutil/assertions.go-205-\tif UsingGitRefs() {\ne2e/testutil/assertions.go-206-\t\t// No single branch to grep; existence is the per-checkpoint ref carrying a\ne2e/testutil/assertions.go-207-\t\t// readable root metadata.json.\ne2e/testutil/assertions.go-208-\t\tblob := checkpointBlobSpec(checkpointID, \"metadata.json\")\ne2e/testutil/assertions.go-209-\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-210-\t\tassert.NotEmpty(t, raw, \"checkpoint %s metadata not found at %s\", checkpointID, blob)\ne2e/testutil/assertions.go-211-\t\treturn\ne2e/testutil/assertions.go-212-\t}\ne2e/testutil/assertions.go-213-\tout := GitOutput(t, dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-214-\tassert.NotEmpty(t, out, \"checkpoint %s not found on checkpoint branch\", checkpointID)\ne2e/testutil/assertions.go-215-\ne2e/testutil/assertions.go-216-\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-217-\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-218-\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-219-\tassert.NotEmpty(t, raw,\ne2e/testutil/assertions.go-220-\t\t\"checkpoint %s metadata not found at %s\", checkpointID, path)\ne2e/testutil/assertions.go-221-}\ne2e/testutil/assertions.go-222-\ne2e/testutil/assertions.go-223-// WaitForCheckpointExists polls until the checkpoint ID appears on the\ne2e/testutil/assertions.go-224-// checkpoint branch and its metadata.json is readable, or fails after timeout.\ne2e/testutil/assertions.go-225-func WaitForCheckpointExists(t *testing.T, dir string, checkpointID string, timeout time.Duration) {\ne2e/testutil/assertions.go-226-\tt.Helper()\ne2e/testutil/assertions.go-227-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-228-\tfor time.Now().Before(deadline) {\ne2e/testutil/assertions.go-229-\t\tif UsingGitRefs() {\ne2e/testutil/assertions.go-230-\t\t\tif gitOutputSafe(dir, \"show\", checkpointBlobSpec(checkpointID, \"metadata.json\")) != \"\" {\ne2e/testutil/assertions.go-231-\t\t\t\treturn\ne2e/testutil/assertions.go-232-\t\t\t}\ne2e/testutil/assertions.go-233-\t\t\ttime.Sleep(200 * time.Millisecond)\ne2e/testutil/assertions.go-234-\t\t\tcontinue\ne2e/testutil/assertions.go-235-\t\t}\ne2e/testutil/assertions.go-236-\t\tout := gitOutputSafe(dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-237-\t\tif out != \"\" {\ne2e/testutil/assertions.go-238-\t\t\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-239-\t\t\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-240-\t\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-241-\t\t\tif raw != \"\" {\ne2e/testutil/assertions.go-242-\t\t\t\treturn\ne2e/testutil/assertions.go-243-\t\t\t}\ne2e/testutil/assertions.go-244-\t\t}\ne2e/testutil/assertions.go-245-\t\ttime.Sleep(200 * time.Millisecond)\ne2e/testutil/assertions.go-246-\t}\ne2e/testutil/assertions.go-247-\tt.Fatalf(\"checkpoint %s not found within %s\", checkpointID, timeout)\ne2e/testutil/assertions.go-248-}\ne2e/testutil/assertions.go-249-\ne2e/testutil/assertions.go-250-// AssertCommitLinkedToCheckpoint asserts the trailer exists AND the\ne2e/testutil/assertions.go-251-// checkpoint data exists on the checkpoint branch.\ne2e/testutil/assertions.go-252-func AssertCommitLinkedToCheckpoint(t *testing.T, dir string, ref string) {\ne2e/testutil/assertions.go-253-\tt.Helper()\ne2e/testutil/assertions.go-254-\ttrailer := AssertHasCheckpointTrailer(t, dir, ref)\ne2e/testutil/assertions.go-255-\tAssertCheckpointExists(t, dir, trailer)\ne2e/testutil/assertions.go-256-}\ne2e/testutil/assertions.go-257-\ne2e/testutil/assertions.go-258-// AssertCheckpointHasSingleSession asserts checkpoint metadata has exactly one session.\ne2e/testutil/assertions.go-259-func AssertCheckpointHasSingleSession(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-260-\tt.Helper()\ne2e/testutil/assertions.go-261-\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go-262-\tassert.Len(t, meta.Sessions, 1,\ne2e/testutil/assertions.go-263-\t\t\"expected 1 session in checkpoint %s, got %d\", checkpointID, len(meta.Sessions))\ne2e/testutil/assertions.go-264-}\ne2e/testutil/assertions.go-265-\ne2e/testutil/assertions.go-266-// AssertCheckpointMetadataComplete asserts essential fields in checkpoint metadata are populated.\ne2e/testutil/assertions.go-267-func AssertCheckpointMetadataComplete(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-268-\tt.Helper()\ne2e/testutil/assertions.go-269-\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go-270-\tassert.NotEmpty(t, meta.CLIVersion, \"checkpoint %s: cli_version should be set\", checkpointID)\ne2e/testutil/assertions.go-271-\tassert.NotEmpty(t, meta.Strategy, \"checkpoint %s: strategy should be set\", checkpointID)\ne2e/testutil/assertions.go-272-\tassert.NotEmpty(t, meta.Sessions, \"checkpoint %s: should have at least 1 session\", checkpointID)\ne2e/testutil/assertions.go-273-\tassert.Equal(t, checkpointID, meta.CheckpointID,\ne2e/testutil/assertions.go-274-\t\t\"checkpoint metadata ID should match expected\")\ne2e/testutil/assertions.go-275-}\ne2e/testutil/assertions.go-276-\ne2e/testutil/assertions.go-277-// WaitForCheckpointAdvanceFrom polls until the checkpoint branch advances from\ne2e/testutil/assertions.go-278-// the given ref, or fails the test after timeout. Use this when waiting for a\ne2e/testutil/assertions.go-279-// second (or subsequent) checkpoint after recording the branch position.\ne2e/testutil/assertions.go-280-func WaitForCheckpointAdvanceFrom(t *testing.T, dir string, fromRef string, timeout time.Duration) {\ne2e/testutil/assertions.go-281-\tt.Helper()\ne2e/testutil/assertions.go-282-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-283-\tfor time.Now().Before(deadline) {\n"},"started_at_ms":1788885348224,"completed_at_ms":1788885348224}}
{"timestamp":"2026-09-08T16:35:48.273Z","ordinal":12214,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a081e0-2fb1-7183-89b1-3d08a502ad00","call_id":"call_5CXOVcsDXgP44Hr8sgepgvyk","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"e2e/testutil/artifacts.go:62:\twriteArtifact(t, dir, \"git-tree.txt\",\ne2e/testutil/repo.go:501:func (s *RepoState) Git(t *testing.T, args ...string) {\ne2e/testutil/repo.go:612:func Git(t *testing.T, dir string, args ...string) {\ne2e/testutil/repo.go:715:// ReadCheckpointMetadata reads the checkpoint-level metadata.json from the\ne2e/testutil/repo.go:717:func ReadCheckpointMetadata(t *testing.T, dir string, checkpointID string) CheckpointMetadata {\ne2e/testutil/assertions.go:261:\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go:269:\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go:350:\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go:359:\tmeta := ReadCheckpointMetadata(t, dir, checkpointID)\ne2e/testutil/assertions.go:387:\t\tmeta := ReadCheckpointMetadata(t, dir, v.CheckpointID)\n"},{"type":"input_text","text":"\n[exit 0]\n"},{"type":"input_text","text":"package testutil\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/execx\"\n\t\"github.com/entireio/cli/e2e/agents\"\n\t\"github.com/entireio/cli/e2e/entire\"\n)\n\nconst droidRepoSettingsPath = \".factory/settings.json\"\n\nconst (\n\tcheckpointRefV1 = \"entire/checkpoints/v1\"\n)\n\n// RepoState holds the working state for a single test's cloned repository.\ntype RepoState struct {\n\tAgent            agents.Agent\n\tDir              string\n\tArtifactDir      string\n\tHeadBefore       string\n\tCheckpointBefore string\n\tConsoleLog       *os.File\n\tsession          agents.Session // interactive session, if started via StartSession\n\tskipArtifacts    bool           // suppresses artifact capture on scenario restart\n}\n\n// SetupRepo creates a fresh git repository in a temporary directory, seeds it\n// with an initial commit, and runs `entire enable` for the given agent.\n// Artifact capture is registered as a cleanup function.\n//\n// When E2E_KEEP_REPOS is set, the temporary directory is not cleaned up\n// so it can be inspected after the test. A symlink in the artifact dir\n// points to the preserved repo.\nfunc SetupRepo(t *testing.T, agent agents.Agent) *RepoState {\n\tt.Helper()\n\n\tkeepRepos := os.Getenv(\"E2E_KEEP_REPOS\") != \"\"\n\n\t// Always use os.MkdirTemp instead of t.TempDir(). Go's t.TempDir()\n\t// creates nested subdirectories (TestName.../001/) whose structure\n\t// confuses some agents' (e.g. opencode) working-directory resolution.\n\t//\n\t// Codex refuses to operate from /tmp (e.g. \"Refusing to create helper\n\t// binaries under temporary dir\"), so for codex we place the repo under\n\t// $HOME/.cache/entire-e2e-repos/ instead.\n\troot := \"\"\n\tif agent.Name() == \"codex\" {\n\t\tcache, cerr := os.UserCacheDir()\n\t\tif cerr != nil {\n\t\t\tt.Fatalf(\"resolve user cache dir: %v\", cerr)\n\t\t}\n\t\troot = filepath.Join(cache, \"entire-e2e-repos\")\n\t\tif err := os.MkdirAll(root, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create e2e repo root %q: %v\", root, err)\n\t\t}\n\t}\n\tdir, err := os.MkdirTemp(root, \"e2e-repo-*\")\n\tif err != nil {\n\t\tt.Fatalf(\"create temporary e2e repo under %q: %v\", root, err)\n\t}\n\tif keepRepos {\n\t\tt.Logf(\"E2E_KEEP_REPOS: repo will be preserved at %s\", dir)\n\t} else {\n\t\tt.Cleanup(func() { os.RemoveAll(dir) })\n\t}\n\n\t// Resolve symlinks (macOS: /var -> /private/var) so paths match\n\t// what agent CLIs see when they resolve their own CWD.\n\tif resolved, err := filepath.EvalSymlinks(dir); err == nil {\n\t\tdir = resolved\n\t}\n\n\tGit(t, dir, \"init\")\n\tGit(t, dir, \"config\", \"user.name\", \"E2E Test\")\n\tGit(t, dir, \"config\", \"user.email\", \"e2e@test.local\")\n\tGit(t, dir, \"config\", \"core.pager\", \"cat\")\n\tGit(t, dir, \"config\", \"core.autocrlf\", \"true\")\n\tGit(t, dir, \"commit\", \"--allow-empty\", \"-m\", \"initial commit\")\n\n\t// Copilot prompt mode requires repository instructions. Commit the custom\n\t// agent fixture before Entire starts capture so setup files cannot be\n\t// attributed to the child under test.\n\tif agent.Name() == \"copilot-cli\" {\n\t\tagentsDir := filepath.Join(dir, \".github\", \"agents\")\n\t\tif err := os.MkdirAll(agentsDir, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create Copilot agent directory: %v\", err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(dir, \".github\", \"copilot-instructions.md\"), []byte(\"# E2E Test\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write copilot-instructions.md: %v\", err)\n\t\t}\n\t\tagentFile := \"---\\nname: entire-e2e-subagent\\ndescription: Creates the single file delegated by the parent.\\ntools: [\\\"*\\\"]\\n---\\nCreate only the requested file and do not delegate further.\\n\"\n\t\tif err := os.WriteFile(filepath.Join(agentsDir, \"entire-e2e-subagent.agent.md\"), []byte(agentFile), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write Copilot custom agent: %v\", err)\n\t\t}\n\t\tGit(t, dir, \"add\", \".github\")\n\t\tGit(t, dir, \"commit\", \"-m\", \"Add Copilot E2E agent fixture\")\n\t}\n\n\t// External agents need external_agents enabled in settings before enable,\n\t// so the CLI can discover the agent binary via PATH during DiscoverAndRegister.\n\tif ea, ok := agent.(agents.ExternalAgent); ok && ea.IsExternalAgent() {\n\t\tentireDir := filepath.Join(dir, \".entire\")\n\t\tif err := os.MkdirAll(entireDir, 0o755); err != nil {\n\t\t\tt.Fatalf(\"create .entire for external agent: %v\", err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(entireDir, \"settings.json\"),\n\t\t\t[]byte(\"{\\\"external_agents\\\": true}\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write external_agents setting: %v\", err)\n\t\t}\n\t}\n\n\tentire.Enable(t, dir, agent.EntireAgent())\n\tif agent.Name() == \"gemini-cli\" {\n\t\tsetupGeminiTestHome(t, dir)\n\t}\n\tif agent.Name() == \"factoryai-droid\" {\n\t\tif err := configureDroidRepoSettings(dir); err != nil {\n\t\t\tt.Fatalf(\"configure droid repo settings: %v\", err)\n\t\t}\n\t}\n\t// commit_linking=always ensures the prepare-commit-msg hook adds the\n\t// Entire-Checkpoint trailer unconditionally. This is needed because\n\t// interactive agents run inside tmux (CanPromptInteractively()=true) but\n\t// can't respond to prompts, and content detection may fail on the first\n\t// checkpoint when no shadow branch exists yet. Prompt-mode agents still\n\t// exercise the !CanPromptInteractively() fast path since they have no TTY\n\t// regardless of this setting.\n\tPatchSettings(t, dir, map[string]any{\"log_level\": \"debug\", \"commit_linking\": \"always\"})\n\n\t// OpenCode's non-interactive mode auto-rejects external_directory permission\n\t// since there's no user to prompt. Write a config to allow it.\n\tif agent.Name() == \"opencode\" {\n\t\tcfg := `{\"$schema\": \"https://opencode.ai/config.json\", \"permission\": {\"external_directory\": \"allow\"}}`\n\t\tif key := os.Getenv(\"ANTHROPIC_API_KEY\"); key != \"\" {\n\t\t\tcfg = fmt.Sprintf(`{\"$schema\": \"https://opencode.ai/config.json\", \"permission\": {\"external_directory\": \"allow\"}, \"provider\": {\"anthropic\": {\"options\": {\"apiKey\": %q}}}}`, key)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(dir, \"opencode.json\"), []byte(cfg+\"\\n\"), 0o644); err != nil {\n\t\t\tt.Fatalf(\"write opencode.json: %v\", err)\n\t\t}\n\t}\n\n\t// Create artifact dir eagerly so console.log is written to disk\n\t// incrementally. Even if the test is killed by a global timeout,\n\t// partial output survives.\n\tartDir := artifactDir(t)\n\tconsoleLog, err := os.Create(filepath.Join(artDir, \"console.log\"))\n\tif err != nil {\n\t\tt.Fatalf(\"create console.log: %v\", err)\n\t}\n\n\tstate := &RepoState{\n\t\tAgent:            agent,\n\t\tDir:              dir,\n\t\tArtifactDir:      artDir,\n\t\tHeadBefore:       GitOutput(t, dir, \"rev-parse\", \"HEAD\"),\n\t\tCheckpointBefore: CheckpointState(dir),\n\t\tConsoleLog:       consoleLog,\n\t}\n\n\tt.Cleanup(func() {\n\t\t_ = consoleLog.Close()\n\t\tif !state.skipArtifacts {\n\t\t\tCaptureArtifacts(t, state)\n\t\t}\n\t})\n\n\treturn state\n}\n\ne2e/testutil/repo.go:717:func ReadCheckpointMetadata(t *testing.T, dir string, checkpointID string) CheckpointMetadata {\ne2e/testutil/repo.go-718-\tt.Helper()\ne2e/testutil/repo.go-719-\ne2e/testutil/repo.go-720-\tblob := checkpointBlobSpec(checkpointID, \"metadata.json\")\ne2e/testutil/repo.go-721-\ne2e/testutil/repo.go-722-\traw := GitOutput(t, dir, \"show\", blob)\ne2e/testutil/repo.go-723-\ne2e/testutil/repo.go-724-\tvar meta CheckpointMetadata\ne2e/testutil/repo.go-725-\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-726-\t\tt.Fatalf(\"unmarshal checkpoint metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-727-\t}\ne2e/testutil/repo.go-728-\ne2e/testutil/repo.go-729-\treturn meta\ne2e/testutil/repo.go-730-}\ne2e/testutil/repo.go-731-\ne2e/testutil/repo.go-732-// ReadSessionMetadata reads a session's metadata.json from the tip of the\ne2e/testutil/repo.go-733-// checkpoint branch for the given checkpoint ID and session index.\ne2e/testutil/repo.go-734-func ReadSessionMetadata(t *testing.T, dir string, checkpointID string, sessionIndex int) SessionMetadata {\ne2e/testutil/repo.go-735-\tt.Helper()\ne2e/testutil/repo.go-736-\ne2e/testutil/repo.go-737-\tblob := checkpointBlobSpec(checkpointID, fmt.Sprintf(\"%d/metadata.json\", sessionIndex))\ne2e/testutil/repo.go-738-\ne2e/testutil/repo.go-739-\traw := GitOutput(t, dir, \"show\", blob)\ne2e/testutil/repo.go-740-\ne2e/testutil/repo.go-741-\tvar meta SessionMetadata\ne2e/testutil/repo.go-742-\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-743-\t\tt.Fatalf(\"unmarshal session metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-744-\t}\ne2e/testutil/repo.go-745-\ne2e/testutil/repo.go-746-\treturn meta\ne2e/testutil/repo.go-747-}\ne2e/testutil/repo.go-748-\ne2e/testutil/repo.go-749-// WaitForSessionMetadata polls until session metadata exists on the checkpoint\ne2e/testutil/repo.go-750-// branch for the given checkpoint ID and session index, then returns it.\ne2e/testutil/repo.go-751-// This handles the race where the checkpoint branch advances before session\ne2e/testutil/repo.go-752-// metadata is fully committed.\ne2e/testutil/repo.go-753-func WaitForSessionMetadata(t *testing.T, dir string, checkpointID string, sessionIndex int, timeout time.Duration) SessionMetadata {\ne2e/testutil/repo.go-754-\tt.Helper()\ne2e/testutil/repo.go-755-\ne2e/testutil/repo.go-756-\tblob := checkpointBlobSpec(checkpointID, fmt.Sprintf(\"%d/metadata.json\", sessionIndex))\ne2e/testutil/repo.go-757-\ne2e/testutil/repo.go-758-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/repo.go-759-\tfor time.Now().Before(deadline) {\ne2e/testutil/repo.go-760-\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/repo.go-761-\t\tif raw != \"\" {\ne2e/testutil/repo.go-762-\t\t\tvar meta SessionMetadata\ne2e/testutil/repo.go-763-\t\t\tif err := json.Unmarshal([]byte(raw), &meta); err != nil {\ne2e/testutil/repo.go-764-\t\t\t\tt.Fatalf(\"unmarshal session metadata from %s: %v\", blob, err)\ne2e/testutil/repo.go-765-\t\t\t}\ne2e/testutil/repo.go-766-\t\t\treturn meta\ne2e/testutil/repo.go-767-\t\t}\ne2e/testutil/repo.go-768-\t\ttime.Sleep(500 * time.Millisecond)\ne2e/testutil/repo.go-769-\t}\ne2e/testutil/repo.go-770-\tt.Fatalf(\"session metadata %s did not appear within %s\", blob, timeout)\ne2e/testutil/repo.go-771-\treturn SessionMetadata{}\ne2e/testutil/repo.go-772-}\ne2e/testutil/repo.go-773-\ne2e/testutil/repo.go-