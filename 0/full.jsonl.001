)\n\tif err != nil {\n\t\treturn false\n\t}\n\tvalue, ok := raw[\"enabled\"]\n\tif !ok {\n\t\treturn false\n\t}\n\tvar enabled bool\n\tif err := json.Unmarshal(value, &enabled); err != nil {\n\t\treturn false\n\t}\n\treturn !enabled\ncmd/entire/cli/setup_test.go:38:func setupTestDir(t *testing.T) string {\ncmd/entire/cli/setup_test.go:49:func setupTestRepo(t *testing.T) {\ncmd/entire/cli/setup_test.go:38:func setupTestDir(t *testing.T) string {\ncmd/entire/cli/setup_test.go:49:func setupTestRepo(t *testing.T) {\ncmd/entire/cli/state_test.go:375:func setupTestRepoWithTranscript(t *testing.T, transcriptContent string, transcriptName string) (transcriptPath string) {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0371f-4feb-7263-aacd-7041d40b862c","create_time":1787631595.338247}}}
