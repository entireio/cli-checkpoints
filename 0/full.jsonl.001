ion from tool input\ncmd/entire/cli/lifecycle.go:1307:\treturn completeSubagentTaskRecord(logCtx, ag, event, subagentCaptureOptions{ensureSessionState: true})\ncmd/entire/cli/lifecycle.go:1313:// is the first point that sees the subagent's actual work. Tolerates\ncmd/entire/cli/lifecycle.go:1317:\tlogging.Debug(logCtx, \"background subagent launch detected; deferring capture to subagent-stop\",\ncmd/entire/cli/lifecycle.go:1353:// no-changes skip gate: a read-only subagent still produced a transcript worth\ncmd/entire/cli/lifecycle.go:1359:// written). CompletionWithoutLaunch events may create the record here, but\ncmd/entire/cli/lifecycle.go:1375:\t\tlogging.Warn(logCtx, \"skipping subagent-stop capture: failed to load session state\",\ncmd/entire/cli/lifecycle.go:1383:\t\t// The subagent transcript remains on disk in the agent's own directory;\ncmd/entire/cli/lifecycle.go:1387:\t\tlogging.Info(logCtx, \"skipping subagent-stop capture: session state not found\",\ncmd/entire/cli/lifecycle.go:1394:\tif event.CompletionWithoutLaunch && state.Phase == session.PhaseEnded {\ncmd/entire/cli/lifecycle.go:1395:\t\tlogging.Info(logCtx, \"skipping completion-only subagent capture: parent session already ended\",\ncmd/entire/cli/lifecycle.go:1400:\tif (marker == nil && !event.CompletionWithoutLaunch) || (marker != nil && !marker.CompletedAt.IsZero()) {\ncmd/entire/cli/lifecycle.go:1405:\t\t// An event carrying a SubagentID or a subagent transcript path is the\ncmd/entire/cli/lifecycle.go:1406:\t\t// louder variant: those fields mean a real subagent completed, so an\ncmd/entire/cli/lifecycle.go:1410:\t\t// CompletionWithoutLaunch event is the explicit exception handled above.\ncmd/entire/cli/lifecycle.go:1412:\t\t\tlogging.Warn(logCtx, \"no in-flight marker for completed subagent — foreground dedup, a duplicate event, or a misintegrated agent setting Final without launch markers\",\ncmd/entire/cli/lifecycle.go:1418:\t\tlogging.Debug(logCtx, \"no live in-flight marker for subagent-stop; skipping duplicate/foreground/racing capture\",\ncmd/entire/cli/lifecycle.go:1445:\t// subagentCaptureOptions.analyzerFilesOnly.\ncmd/entire/cli/lifecycle.go:1446:\tcaptureErr := completeSubagentTaskRecord(logCtx, ag, event, subagentCaptureOptions{\ncmd/entire/cli/lifecycle.go:1449:\t\teventFilesOnly:      event.CompletionWithoutLaunch,\ncmd/entire/cli/lifecycle.go:1469:\t\tlogging.Warn(logCtx, \"failed to reload session state after subagent-stop capture; falling back to pre-capture phase for condense decision\",\ncmd/entire/cli/lifecycle.go:1481:\t\tlogging.Debug(logCtx, \"session state swept during subagent-stop capture; leaving the condense to the sweeper\",\ncmd/entire/cli/lifecycle.go:1492:\t\t\tlogging.Warn(logCtx, \"eager condense after late subagent-stop capture failed\",\ncmd/entire/cli/lifecycle.go:1501:// subagentCaptureOptions controls completeSubagentTaskRecord's behavior across\ncmd/entire/cli/lifecycle.go:1504:type subagentCaptureOptions struct {\ncmd/entire/cli/lifecycle.go:1507:\t// read-only background subagent (e.g. a reviewer) still produced a\ncmd/entire/cli/lifecycle.go:1531:// completeSubagentTaskRecord detects a completed subagent invocation's changes\ncmd/entire/cli/lifecycle.go:1535:func completeSubagentTaskRecord(logCtx context.Context, ag agent.Agent, event *agent.Event, opts subagentCaptureOptions) error {\ncmd/entire/cli/lifecycle.go:1540:\tvar subagentTranscriptPath string\ncmd/entire/cli/lifecycle.go:1542:\t\tsubagentTranscriptPath = declaredSubagentTranscript(logCtx, event)\ncmd/entire/cli/lifecycle.go:1544:\tif subagentTranscriptPath == \"\" && !opts.eventFilesOnly {\ncmd/entire/cli/lifecycle.go:1545:\t\tsubagentTranscriptPath = ResolveAgentTranscriptPath(filepath.Dir(event.SessionRef), event.SessionID, event.SubagentID)\ncmd/entire/cli/lifecycle.go:1549:\tsubagentEndAttrs := []any{\ncmd/entire/cli/lifecycle.go:1555:\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"agent_id\", event.SubagentID))\ncmd/entire/cli/