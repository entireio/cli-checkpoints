o read parent transcripts and join on child UUIDs via \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"subagent.started\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" events, extracting the stable parent tool call ID for file attribution\",\n                      \"type\": \"text\"\n                    }\n                  ]\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"orderedList\",\n          \"attrs\": {\n            \"start\": 1\n          },\n          \"content\": [\n            {\n              \"type\": \"listItem\",\n              \"content\": [\n                {\n                  \"type\": \"paragraph\",\n                  \"content\": [\n                    {\n                      \"text\": \"File extraction\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"bold\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \": Updated event parsing to pull files from \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"subagent.started\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" / \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"tool.execution_complete\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" events, where files are indexed by parent task ID and scoped to each child via \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"agentId\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" and \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"parentToolCallId\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" fields\",\n                      \"type\": \"text\"\n                    }\n                  ]\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"orderedList\",\n          \"attrs\": {\n            \"start\": 1\n          },\n          \"content\": [\n            {\n              \"type\": \"listItem\",\n              \"content\": [\n                {\n                  \"type\": \"paragraph\",\n                  \"content\": [\n                    {\n                      \"text\": \"Transcript unavailability marker\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"bold\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \": Added \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"TranscriptUnavailable\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" to \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"TaskRecord\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" to prevent condensation from probing for generic \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"agent-\\u003cid\\u003e.jsonl\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" layouts when a child has no standalone transcript\",\n                      \"type\": \"text\"\n                    }\n                  ]\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"orderedList\",\n          \"attrs\": {\n            \"start\": 1\n          },\n          \"content\": [\n            {\n              \"type\": \"listItem\",\n              \"content\": [\n                {\n                  \"type\": \"paragraph\",\n                  \"content\": [\n                    {\n                      \"text\": \"Completion-only lifecycle\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"bold\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \": Copilot's stop hook arrives with identity but never saw a start hook (pass-through), so introduced \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"CompletionWithoutLaunch\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" flag to handle creation at completion time without spinning up a phantom session\",\n                      \"type\": \"text\"\n                    }\n                  ]\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"orderedList\",\n          \"attrs\": {\n            \"start\": 1\n          },\n          \"content\": [\n            {\n              \"type\": \"listItem\",\n              \"content\": [\n                {\n                  \"type\": \"paragraph\",\n                  \"content\": [\n                    {\n                      \"text\": \"Event enrichment\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"bold\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \": \",\n                      \"type\": \"text\"\n                    },\n                    {\n                      \"text\": \"SubagentEnd\",\n                      \"type\": \"text\",\n                      \"marks\": [\n                        {\n                          \"type\": \"code\",\n                          \"attrs\": {}\n                        }\n                      ]\n                    },\n                    {\n                      \"text\": \" events now carry file lists and task metadata extracted from the parent transcript before the hook runs\",\n                      \"type\": \"text\"\n                    }\n                  ]\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"paragraph\",\n          \"content\": [\n            {\n              \"text\": \"All changes are backward-compatible; legacy stops without \",\n              \"type\": \"text\"\n            },\n            {\n              \"text\": \"agentId\",\n              \"type\": \"text\",\n              \"marks\": [\n                {\n                  \"type\": \"code\",\n                  \"attrs\": {}\n                }\n              ]\n            },\n            {\n              \"text\": \" fall back to matching starts by name when there's exactly one incomplete start.\",\n              \"type\": \"text\"\n            }\n          ]\n        }\n      ]\n    },\n    \"textSnapshot\": \"Problem:\\nCopilot CLI 1.0.82+ now emits native subagent hooks and interleaves child events into the parent transcript (rather than using standalone child transcript files). The previous implementation could not correlate subagentStop events to their starts or extract child-scoped files accurately, and falsely attributed unrelated files during condensation.\\nSolution:\\nHook parsing: Added subagentStart hook support and enriched the hook envelope to capture child identity fields (AgentID, AgentType, AgentName, AgentDescription)\\nTranscript correlation: Implemented extractSubagentEvidence() to read parent transcripts and join on child UUIDs via subagent.started events, extracting the stable parent tool call ID for file attribution\\nFile extraction: Updated event parsing to pull files from subagent.started / tool.execution_complete events, where files are indexed by parent task ID and scoped to each child via agentId and parentToolCallId fields\\nTranscript unavailability marker: Added TranscriptUnavailable to TaskRecord to prevent condensation from probing for generic agent-\\u003cid\\u003e.jsonl layouts when a child has no standalone transcript\\nCompletion-only lifecycle: Copilot's stop hook arrives with identity but never saw a start hook (pass-through), so introduced CompletionWithoutLaunch flag to handle creation at completion time without spinning up a phantom session\\nEvent enrichment: SubagentEnd events now carry file lists and task metadata extracted from the parent transcript before the hook runs\\nAll changes are backward-compatible; legacy stops without agentId fall back to matching starts by name when there's exactly one incomplete start.\",\n    \"updatedAt\": \"2026-09-09T22:56:25.936Z\",\n    \"etag\": \"W/\\\"2026-09-09T22:56:25.936816Z\\\"\"\n  },\n  \"monitors\": [\n    {\n      \"key\": \"confidence\",\n      \"label\": \"Confidence\",\n      \"valueType\": \"percent\",\n      \"percentValue\": 78,\n      \"sizeValue\": null,\n      \"booleanValue\": null,\n      \"rationale\": \"Strong unit and integration test coverage with explicit security tests for path traversal and symlink rejection. Complex transcript correlation logic is well-tested with edge cases (concurrent children, legacy fallback, ambiguous identity). Minor gaps: cross-platform edge cases not explicitly covered, and high code complexity in evidence extraction increases risk despite good tests.\",\n      \"polarity\": \"higher_is_better\",\n      \"trendDelta\": -7,\n      \"evaluating\": false,\n      \"lastFailedAttempt\": null,\n      \"history\": [\n        {\n          \"percentValue\": 78,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Strong unit and integration test coverage with explicit security tests for path traversal and symlink rejection. Complex transcript correlation logic is well-tested with edge cases (concurrent children, legacy fallback, ambiguous identity). Minor gaps: cross-platform edge cases not explicitly covered, and high code complexity in evidence extraction increases risk despite good tests.\",\n          \"runId\": \"01M247XVXVWZFPQADCHW4M2GYH\",\n          \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n          \"updatedAt\": \"2026-09-09T23:26:55.420Z\"\n        },\n        {\n          \"percentValue\": 85,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Every changed path — hook correlation, concurrency, fail-closed ambiguity, symlink containment, condensation attribution, idempotent completion, and state round-trip — has focused unit tests asserting real behavior on isolated temp repos, plus e2e extension and per-PR canary on both backends; gates (gofmt/lint/test:ci) would plausibly pass. Docked mainly because the live copilot-cli correlation is only validated in on-demand e2e (not per-PR) and depends on version-specific transcript shapes.\",\n          \"runId\": \"01M2464WAMS6BQ0VMQ9ZH0W5MY\",\n          \"headSha\": \"392897cf99082892ab733c7545ee8859bc7fb1cd\",\n          \"updatedAt\": \"2026-09-09T22:57:23.055Z\"\n        }\n      ],\n      \"runId\": \"01M247XVXVWZFPQADCHW4M2GYH\",\n      \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n      \"updatedAt\": \"2026-09-09T23:26:55.420Z\",\n      \"state\": \"evaluated\",\n      \"outcome\": null,\n      \"staleReason\": null,\n      \"evaluatedAtSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\"\n    },\n    {\n      \"key\": \"drift\",\n      \"label\": \"Drift\",\n      \"valueType\": \"percent\",\n      \"percentValue\": 8,\n      \"sizeValue\": null,\n      \"booleanValue\": null,\n      \"rationale\": \"Changes introduce well-justified new patterns (CompletionWithoutLaunch, SubagentTranscriptUnavailable) that cleanly extend existing agent abstractions with opt-in flags. Implementation follows established conventions throughout with proper error handling and test coverage.\",\n      \"polarity\": \"lower_is_better\",\n      \"trendDelta\": -4,\n      \"evaluating\": false,\n      \"lastFailedAttempt\": null,\n      \"history\": [\n        {\n          \"percentValue\": 8,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Changes introduce well-justified new patterns (CompletionWithoutLaunch, SubagentTranscriptUnavailable) that cleanly extend existing agent abstractions with opt-in flags. Implementation follows established conventions throughout with proper error handling and test coverage.\",\n          \"runId\": \"01M247XVYA4YQVYP08J1P3C803\",\n          \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n          \"updatedAt\": \"2026-09-09T23:26:55.435Z\"\n        },\n        {\n          \"percentValue\": 12,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Changes follow established agent-integration patterns closely: CheckHookConfig/HookFreshness mirrors four existing agents, subagent reads use the sanctioned SessionStore root-anchor abstraction, and the two new Event fields extend the documented Final two-signal model. Only minor drift: two new Event abstraction fields and one trivial unrelated redact test cleanup.\",\n          \"runId\": \"01M2464WAZEFZRHQDDG4KS5J8Z\",\n          \"headSha\": \"392897cf99082892ab733c7545ee8859bc7fb1cd\",\n          \"updatedAt\": \"2026-09-09T22:56:50.885Z\"\n        }\n      ],\n      \"runId\": \"01M247XVYA4YQVYP08J1P3C803\",\n      \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n      \"updatedAt\": \"2026-09-09T23:26:55.435Z\",\n      \"state\": \"evaluated\",\n      \"outcome\": null,\n      \"staleReason\": null,\n      \"evaluatedAtSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\"\n    },\n    {\n      \"key\": \"risk\",\n      \"label\": \"Risk\",\n      \"valueType\": \"percent\",\n      \"percentValue\": 48,\n      \"sizeValue\": null,\n      \"booleanValue\": null,\n      \"rationale\": \"Moderate risk: changes checkpoint/session internals (task record creation, condensation) but adds defensive guards, has strong test coverage, involves no destructive git ops or redaction weakening, and reads are confined through SessionStore.\",\n      \"polarity\": \"lower_is_better\",\n      \"trendDelta\": -9,\n      \"evaluating\": false,\n      \"lastFailedAttempt\": null,\n      \"history\": [\n        {\n          \"percentValue\": 48,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Moderate risk: changes checkpoint/session internals (task record creation, condensation) but adds defensive guards, has strong test coverage, involves no destructive git ops or redaction weakening, and reads are confined through SessionStore.\",\n          \"runId\": \"01M247XVZ0WXVJP92Y4BDEQ5C4\",\n          \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n          \"updatedAt\": \"2026-09-09T23:26:55.456Z\"\n        },\n        {\n          \"percentValue\": 57,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Touches checkpoint condensation and lifecycle subagent-capture internals that govern what transcript content is materialized into checkpoints and pushed to the remote, reaching all users on upgrade; but it contains no destructive git ops, no redaction weakening, and the egress-facing change actually narrows attribution and is well-covered by new regression tests.\",\n          \"runId\": \"01M2464WBN20Z62H0KKJ4RXN7H\",\n          \"headSha\": \"392897cf99082892ab733c7545ee8859bc7fb1cd\",\n          \"updatedAt\": \"2026-09-09T22:56:24.688Z\"\n        }\n      ],\n      \"runId\": \"01M247XVZ0WXVJP92Y4BDEQ5C4\",\n      \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n      \"updatedAt\": \"2026-09-09T23:26:55.456Z\",\n      \"state\": \"evaluated\",\n      \"outcome\": null,\n      \"staleReason\": null,\n      \"evaluatedAtSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\"\n    },\n    {\n      \"key\": \"security\",\n      \"label\": \"Security\",\n      \"valueType\": \"percent\",\n      \"percentValue\": 35,\n      \"sizeValue\": null,\n      \"booleanValue\": null,\n      \"rationale\": \"Security-relevant code touching transcript/path handling, but properly validated via SessionStore containment checks, ID validation, and explicit symlink/traversal rejection tests. No exec, egress, or auth changes.\",\n      \"polarity\": \"lower_is_better\",\n      \"trendDelta\": 15,\n      \"evaluating\": false,\n      \"lastFailedAttempt\": null,\n      \"history\": [\n        {\n          \"percentValue\": 35,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Security-relevant code touching transcript/path handling, but properly validated via SessionStore containment checks, ID validation, and explicit symlink/traversal rejection tests. No exec, egress, or auth changes.\",\n          \"runId\": \"01M247XVZBRSEPNP8RAA0AF5ZR\",\n          \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n          \"updatedAt\": \"2026-09-09T23:26:55.467Z\"\n        },\n        {\n          \"percentValue\": 20,\n          \"sizeValue\": null,\n          \"booleanValue\": null,\n          \"rationale\": \"Adds Copilot CLI subagent tracking touching hook install and a read of a hook-supplied transcript path; the sole untrusted-input path is properly confined via SessionStore (traversal check + exact session-file match + no-symlink-follow rooted read, with a symlink-rejection test), new hooks invoke the trusted installed binary, and there are no dep/CI/egress/auth/redaction changes.\",\n          \"runId\": \"01M2464WC10FCZJ6AE4FKVSFR6\",\n          \"headSha\": \"392897cf99082892ab733c7545ee8859bc7fb1cd\",\n          \"updatedAt\": \"2026-09-09T22:57:34.198Z\"\n        }\n      ],\n      \"runId\": \"01M247XVZBRSEPNP8RAA0AF5ZR\",\n      \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n      \"updatedAt\": \"2026-09-09T23:26:55.467Z\",\n      \"state\": \"evaluated\",\n      \"outcome\": null,\n      \"staleReason\": null,\n      \"evaluatedAtSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\"\n    }\n  ],\n  \"gates\": [\n    {\n      \"runnerIds\": [],\n      \"id\": \"\",\n      \"gateDefinitionId\": \"01M07N12HETFQ886QDXQF0Y071\",\n      \"gateKey\": \"approvals\",\n      \"gateType\": \"approvals\",\n      \"blocking\": true,\n      \"status\": \"failed\",\n      \"headSha\": \"9497adaf84c951da89036649265b2ee8fe2850de\",\n      \"value\": {\n        \"approved\": 0,\n        \"required\": 1,\n        \"total\": 0,\n        \"changes_requested\": false,\n        \"self_excluded\": false,\n        \"stale_dismissed\": 0,\n        \"config\": {\n          \"version\": 1,\n          \"min_reviewers\": 1,\n          \"allow_self_approval\": false,\n          \"dismiss_stale_approvals_on_push\": false\n        }\n      },\n      \"rationale\": \"No reviewers have approved this trail\",\n      \"createdAt\": \"2026-09-09T23:33:32.903123399Z\",\n      \"comple