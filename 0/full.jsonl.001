"agentName\": \"general-purpose\",\n      \"agentDisplayName\": \"Check file existence\",\n      \"model\": \"gpt-5.4\",\n      \"firstDispatchedModel\": \"gpt-5.4\",\n      \"totalToolCalls\": 1,\n      \"totalTokens\": 27263,\n      \"durationMs\": 2934\n    }\n  ],\n  \"child_ids\": [\n    \"toolu_01PW9oL1QTxu6LbkdKRfuYwX\"\n  ],\n  \"shutdown_agent_metric_keys\": [\n    \"24d8773a-06e8-435c-9257-8ccb89a54f33\",\n    \"main\"\n  ]\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06aeb-fba1-7c73-b9bd-e6c66f69b450","create_time":1788501454.472393}}}
