dd a subagent's full usage on\ncmd/entire/cli/strategy/manual_commit_git.go-444-// every subsequent step after it was first discovered, so SubagentTokens is\ncmd/entire/cli/strategy/manual_commit_git.go-445-// replaced with the latest snapshot rather than added.\ncmd/entire/cli/strategy/manual_commit_git.go-446-func accumulateTokenUsage(existing, incoming *agent.TokenUsage) *agent.TokenUsage {\ncmd/entire/cli/strategy/manual_commit_git.go-447-\tif incoming == nil {\ncmd/entire/cli/strategy/manual_commit_git.go-448-\t\treturn existing\ncmd/entire/cli/strategy/manual_commit_git.go-449-\t}\ncmd/entire/cli/strategy/manual_commit_git.go-450-\tif existing == nil {\ncmd/entire/cli/strategy/manual_commit_git.go-451-\t\t// Return a copy to avoid sharing the pointer\ncmd/entire/cli/strategy/manual_commit_git.go-452-\t\treturn &agent.TokenUsage{\ncmd/entire/cli/strategy/manual_commit_git.go-453-\t\t\tInputTokens:         incoming.InputTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-454-\t\t\tCacheCreationTokens: incoming.CacheCreationTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-455-\t\t\tCacheReadTokens:     incoming.CacheReadTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-456-\t\t\tOutputTokens:        incoming.OutputTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-457-\t\t\tAPICallCount:        incoming.APICallCount,\ncmd/entire/cli/strategy/manual_commit_git.go-458-\t\t\tSubagentTokens:      incoming.SubagentTokens,\ncmd/entire/cli/strategy/manual_commit_git.go-459-\t\t}\ncmd/entire/cli/strategy/manual_commit_git.go-460-\t}\ncmd/entire/cli/strategy/manual_commit_git.go-461-\ncmd/entire/cli/strategy/manual_commit_git.go-462-\t// Accumulate values\ncmd/entire/cli/strategy/manual_commit_git.go-463-\texisting.InputTokens += incoming.InputTokens\ncmd/entire/cli/strategy/manual_commit_git.go-464-\texisting.CacheCreationTokens += incoming.CacheCreationTokens\ncmd/entire/cli/strategy/manual_commit_git.go-465-\texisting.CacheReadTokens += incoming.CacheRead