:func maybeMigrateGlobalRuntimeData(ctx context.Context, w io.Writer) {\\ncmd/entire/cli/doctor.go:809:func checkGlobalTracking(cmd *cobra.Command) {\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a035c5-5c5e-7ca3-86ab-631a16cc0d4a","create_time":1787608569.167281}}}
