util/repo.go-779-\tvar bareDir string\ne2e/testutil/repo.go-780-\tif os.Getenv(\"E2E_KEEP_REPOS\") != \"\" {\ne2e/testutil/repo.go-781-\t\tvar err error\ne2e/testutil/repo.go-782-\t\tbareDir, err = os.MkdirTemp(\"\", \"e2e-bare-*\")\ne2e/testutil/repo.go-783-\t\tif err != nil {\ne2e/testutil/repo.go-784-\t\t\tt.Fatalf(\"create bare remote dir: %v\", err)\ne2e/testutil/repo.go-785-\t\t}\ne2e/testutil/repo.go-786-\t\tt.Logf(\"E2E_KEEP_REPOS: bare remote will be preserved at %s\", bareDir)\ne2e/testutil/repo.go-787-\t} else {\ne2e/testutil/repo.go-788-\t\tbareDir = t.TempDir()\ne2e/testutil/repo.go-789-\t}\ne2e/testutil/repo.go-790-\ne2e/testutil/repo.go-791-\tGit(t, bareDir, \"init\", \"--bare\")\ne2e/testutil/repo.go-792-\tGit(t, s.Dir, \"remote\", \"add\", \"origin\", bareDir)\ne2e/testutil/repo.go-793-\tGit(t, s.Dir, \"push\", \"-u\", \"origin\", \"HEAD\")\ne2e/testutil/repo.go-794-\treturn bareDir\ne2e/testutil/repo.go-795-}\ne2e/testutil/repo.go-796-\ne2e/testutil/repo.go-797-// GitOutputErr runs a git command and returns (output, error) without\n--\ne2e/testutil/assertions.go:203:func AssertCheckpointExists(t *testing.T, dir string, checkpointID string) {\ne2e/testutil/assertions.go-204-\tt.Helper()\ne2e/testutil/assertions.go-205-\tif UsingGitRefs() {\ne2e/testutil/assertions.go-206-\t\t// No single branch to grep; existence is the per-checkpoint ref carrying a\ne2e/testutil/assertions.go-207-\t\t// readable root metadata.json.\ne2e/testutil/assertions.go-208-\t\tblob := checkpointBlobSpec(checkpointID, \"metadata.json\")\ne2e/testutil/assertions.go-209-\t\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-210-\t\tassert.NotEmpty(t, raw, \"checkpoint %s metadata not found at %s\", checkpointID, blob)\ne2e/testutil/assertions.go-211-\t\treturn\ne2e/testutil/assertions.go-212-\t}\ne2e/testutil/assertions.go-213-\tout := GitOutput(t, dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-214-\tassert.NotEmpty(t, out, \"checkpoint %s not found on checkpoint branch\", checkpointID)\ne2e/testutil/assertions.go-215-\ne2e/testutil/assertions.go-216-\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-217-\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-218-\traw := gitOutputSafe(dir, \"show\", blob)\ne2e/testutil/assertions.go-219-\tassert.NotEmpty(t, raw,\ne2e/testutil/assertions.go-220-\t\t\"checkpoint %s metadata not found at %s\", checkpointID, path)\ne2e/testutil/assertions.go-221-}\ne2e/testutil/assertions.go-222-\ne2e/testutil/assertions.go-223-// WaitForCheckpointExists polls until the checkpoint ID appears on the\ne2e/testutil/assertions.go-224-// checkpoint branch and its metadata.json is readable, or fails after timeout.\ne2e/testutil/assertions.go-225-func WaitForCheckpointExists(t *testing.T, dir string, checkpointID string, timeout time.Duration) {\ne2e/testutil/assertions.go-226-\tt.Helper()\ne2e/testutil/assertions.go-227-\tdeadline := time.Now().Add(timeout)\ne2e/testutil/assertions.go-228-\tfor time.Now().Before(deadline) {\ne2e/testutil/assertions.go-229-\t\tif UsingGitRefs() {\ne2e/testutil/assertions.go-230-\t\t\tif gitOutputSafe(dir, \"show\", checkpointBlobSpec(checkpointID, \"metadata.json\")) != \"\" {\ne2e/testutil/assertions.go-231-\t\t\t\treturn\ne2e/testutil/assertions.go-232-\t\t\t}\ne2e/testutil/assertions.go-233-\t\t\ttime.Sleep(200 * time.Millisecond)\ne2e/testutil/assertions.go-234-\t\t\tcontinue\ne2e/testutil/assertions.go-235-\t\t}\ne2e/testutil/assertions.go-236-\t\tout := gitOutputSafe(dir, \"log\", checkpointReadRef(), \"--grep=\"+checkpointID, \"--oneline\")\ne2e/testutil/assertions.go-237-\t\tif out != \"\" {\ne2e/testutil/assertions.go-238-\t\t\tpath := CheckpointPath(checkpointID) + \"/metadata.json\"\ne2e/testutil/assertions.go-239-\t\t\tblob := checkpointReadRef() + \":\" + path\ne2e/testutil/assertions.go-240-\t\t\traw := gitOutputSafe(dir, \"show\", blob)\ne