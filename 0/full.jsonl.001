test.go:804:// hold (branch lands, checkpoints stay home) → trust → drain → revoke → re-hold.\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:805:func TestGlobalEnrolledRepoHoldsCheckpointSyncUntilTrusted(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:808:\t\tenv, extraEnv := newGloballyTrackedEnv(t, true)\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:812:\t\tcommitGlobalSession(t, env, extraEnv, \"trust-gate-session-1\", \"gate.txt\", \"held until trusted\\n\", \"Create gate file\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:827:\t\t\tt.Error(\"no refs/entire/* may reach the remote while the repo is untrusted\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:830:\t\t\tt.Error(\"the v1 branch may not reach the remote while the repo is untrusted\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:836:\t\ttrustOut := env.RunCLI(\"trust\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:837:\t\tif !strings.Contains(trustOut, \"Trusted\") {\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:838:\t\t\tt.Fatalf(\"entire trust did not confirm trust, got:\\n%s\", trustOut)\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:840:\t\tenv.WriteFile(\"after-trust.txt\", \"synced\\n\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:841:\t\tenv.GitAdd(\"after-trust.txt\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:842:\t\tenv.GitCommit(\"Add after-trust file\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:846:\t\t\tt.Errorf(\"a trusted push is silent about holds, got:\\n%s\", output)\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:849:\t\t\tt.Errorf(\"checkpoint %s held while untrusted should drain to origin on the first trusted push\", checkpointID)\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:853:\t\tenv.RunCLI(\"trust\", \"--revoke\")\ncmd/entire/cli/integration_test/checkpoint_sync_remote_test.go:856:\t\tcommitGlobalSession(t, env, extraEnv, \"trust-gate-session-2\", \"revoked.txt\", \"held again after revoke\\n\", \"Create revoked file\")\n","exit_code":0,"duration":{"secs":0,"nanos":6167},"formatted_output":"cmd/entire/cli/strategy/trust_prompt_test.go:15:// newGloballyEnrolledPromptRepo creates a globally enrolled repo (no\ncmd/entire/cli/strategy/trust_prompt_test.go:17:func newGloballyEnrolledPromptRepo(t *testing.T, userSettingsJSON string) {\ncmd/entire/cli/strategy/trust_prompt_test.go:24:\tenrollRepoGlobally(t, userSettingsJSON)\ncmd/entire/cli/strategy/trust_prompt_test.go:27:// TestResolveTrustDecision: a non-interactive pre-push holds WITHOUT\ncmd/entire/cli/strategy/trust_prompt_test.go:29:// writers `entire trust` uses; a failed prompt or trust write holds.\ncmd/entire/cli/strategy/trust_prompt_test.go:30:func TestResolveTrustDecision(t *testing.T) {\ncmd/entire/cli/strategy/trust_prompt_test.go:31:\taskErr := errors.New(\"trust prompt: terminal gone\")\ncmd/entire/cli/strategy/trust_prompt_test.go:34:\t\tunconfigured   bool // no global block: the trust write fails\ncmd/entire/cli/strategy/trust_prompt_test.go:36:\t\tchoice         trustChoice\ncmd/entire/cli/strategy/trust_prompt_test.go:39:\t\twant           TrustDecision\ncmd/entire/cli/strategy/trust_prompt_test.go:40:\t\twantSource     settings.TrustSource\ncmd/entire/cli/strategy/trust_prompt_test.go:43:\t\t{name: \"non-interactive holds without prompting\", nonInteractive: true, want: TrustHeld},\ncmd/entire/cli/strategy/trust_prompt_test.go:44:\t\t{name: \"yes persists repo trust\", choice: trustChoiceYes, want: TrustGranted, wantSource: settings.TrustSourceRepo},\ncmd/entire/cli/strategy/trust_prompt_test.go:45:\t\t{name: \"always sets trust_all\", choice: trustChoiceAlways, want: TrustGranted, wantSource: settings.TrustSourceAll},\ncmd/entire/cli/strategy/trust_prompt_test.go:46:\t\t{name: \"not now holds and writes nothing\", choice: trustChoiceNotNow, want: TrustHeld},\ncmd/entire/cli/strategy/trust_prompt_test.go:47:\t\t{name: \"ask error holds and propagates\", choice: trustChoiceYes, askErr: askErr, wantErr: askErr, want: TrustHeld},\ncmd/entire/cli/strategy/trust_prompt_test.go:48:\t\t{name: \"trust write failure warns and holds\", unconfigured: true, choice: trustChoiceYes, want: TrustHeld, wantWarn: true},\ncmd/entire/cli/strategy/trust_prompt_test.go:51:\t\t\tuserSettings := `{\"global\":{\"enabled\":true}}`\ncmd/entire/cli/strategy/trust_prompt_test.go:55:\t\t\tnewGloballyEnrolledPromptRepo(t, userSettings)\ncmd/entire/cli/strategy/trust_prompt_test.go:57:\t\t\task := func() (trustChoice, error) {\ncmd/entire/cli/strategy/trust_prompt_test.go:65:\t\t\td, err := resolveTrustDecision(ctx, !tc.nonInteractive, ask, &warnings)\ncmd/entire/cli/strategy/trust_prompt_test.go:73:\t\t\t\ttc.wantSource = settings.TrustSourceNone\ncmd/entire/cli/strategy/trust_prompt_test.go:75:\t\t\trequire.Equal(t, tc.wantSource, settings.CurrentTrustSource(ctx))\ncmd/entire/cli/strategy/trust_prompt.go:16:// TrustDecision is the resolved egress-trust outcome for a single pre-push in\ncmd/entire/cli/strategy/trust_prompt.go:17:// a globally enrolled repo.\ncmd/entire/cli/strategy/trust_prompt.go:18:type TrustDecision int\ncmd/entire/cli/strategy/trust_prompt.go:21:\tTrustHeld    TrustDecision = iota // checkpoints stay local this push; re-ask next push\ncmd/entire/cli/strategy/trust_prompt.go:22:\tTrustGranted                      // consent recorded — the caller re-evaluates the gate, never reuses this as a boolean\ncmd/entire/cli/strategy/trust_prompt.go:25:type trustChoice string\ncmd/entire/cli/strategy/trust_prompt.go:28:\ttrustChoiceYes    trustChoice = \"yes\"\ncmd/entire/cli/strategy/trust_prompt.go:29:\ttrustChoiceNotNow trustChoice = \"not_now\"\ncmd/entire/cli/strategy/trust_prompt.go:30:\ttrustChoiceAlways trustChoice = \"always\"\ncmd/entire/cli/strategy/trust_prompt.go:33:// resolveTrustDecision holds without prompting when there is no user to ask,\ncmd/entire/cli/strategy/trust_prompt.go:35:func resolveTrustDecision(ctx context.Context, hasTTY bool, ask func() (trustChoice, error), errOut io.Writer) (TrustDecision, error) {\ncmd/entire/cli/strategy/trust_prompt.go:37:\t\treturn TrustHeld, nil\ncmd/entire/cli/strategy/trust_prompt.go:41:\t\treturn TrustHeld, err\ncmd/entire/cli/strategy/trust_prompt.go:43:\treturn applyTrustChoice(ctx, choice, errOut), nil\ncmd/entire/cli/strategy/trust_prompt.go:46:// resolveTrustDecisionForPrePush is the production wiring: TTY detection plus\ncmd/entire/cli/strategy/trust_prompt.go:48:func resolveTrustDecisionForPrePush(ctx context.Context, errOut io.Writer) (TrustDecision, error) {\ncmd/entire/cli/strategy/trust_prompt.go:49:\treturn resolveTrustDecision(ctx, interactive.CanPromptInteractively(),\ncmd/entire/cli/strategy/trust_prompt.go:50:\t\tfunc() (trustChoice, error) { return askTrustPrompt(ctx) }, errOut)\ncmd/entire/cli/strategy/trust_prompt.go:53:// applyTrustChoice persists the user's answer. A write failure warns and\ncmd/entire/cli/strategy/trust_prompt.go:56:func applyTrustChoice(ctx context.Context, choice trustChoice, errOut io.Writer) TrustDecision {\ncmd/entire/cli/strategy/trust_prompt.go:58:\tcase trustChoiceYes:\ncmd/entire/cli/strategy/trust_prompt.go:59:\t\t// The same writer bare `entire trust` uses (one consent key shape).\ncmd/entire/cli/strategy/trust_prompt.go:60:\t\tif _, err := settings.TrustCurrentRepo(ctx); err != nil {\ncmd/entire/cli/strategy/trust_prompt.go:61:\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust for this repo: %v\\n\", err)\ncmd/entire/cli/strategy/trust_prompt.go:62:\t\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:64:\t\treturn TrustGranted\ncmd/entire/cli/strategy/trust_prompt.go:65:\tcase trustChoiceAlways:\ncmd/entire/cli/strategy/trust_prompt.go:66:\t\tif err := settings.TrustAllRepos(ctx); err != nil {\ncmd/entire/cli/strategy/trust_prompt.go:67:\t\t\tfmt.Fprintf(errOut, \"Warning: couldn't save trust_all: %v\\n\", err)\ncmd/entire/cli/strategy/trust_prompt.go:68:\t\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:70:\t\treturn TrustGranted\ncmd/entire/cli/strategy/trust_prompt.go:71:\tcase trustChoiceNotNow:\ncmd/entire/cli/strategy/trust_prompt.go:72:\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:74:\t\treturn TrustHeld\ncmd/entire/cli/strategy/trust_prompt.go:78:// askTrustPrompt shows the three-option trust select. Pre-push stdin carries\ncmd/entire/cli/strategy/trust_prompt.go:81:func askTrustPrompt(ctx context.Context) (trustChoice, error) {\ncmd/entire/cli/strategy/trust_prompt.go:82:\t// An identity error needs no handling here: TrustCurrentRepo re-derives\ncmd/entire/cli/strategy/trust_prompt.go:83:\t// it and its failure is warned-and-held by applyTrustChoice.\ncmd/entire/cli/strategy/trust_prompt.go:84:\tyesLabel := \"Yes — trust this repo (this folder only)\"\ncmd/entire/cli/strategy/trust_prompt.go:85:\tif id, err := settings.RepoTrustIdentity(ctx); err == nil && id.OriginKeyed() {\ncmd/entire/cli/strategy/trust_prompt.go:86:\t\tyesLabel = fmt.Sprintf(\"Yes — trust this repo (all clones of %s)\", id.DisplayScope())\ncmd/entire/cli/strategy/trust_prompt.go:90:\tchoice := trustChoice(\"\")\ncmd/entire/cli/strategy/trust_prompt.go:93:\t\t\thuh.NewSelect[trustChoice]().\ncmd/entire/cli/strategy/trust_prompt.go:94:\t\t\t\tTitle(\"Entire captured agent sessions in this repo via global mode.\").\ncmd/entire/cli/strategy/trust_prompt.go:95:\t\t\t\tDescription(\"Trust this folder and sync its checkpoints to your checkpoint sync remote?\").\ncmd/entire/cli/strategy/trust_prompt.go:97:\t\t\t\t\thuh.NewOption(yesLabel, trustChoiceYes),\ncmd/entire/cli/strategy/trust_prompt.go:98:\t\t\t\t\thuh.NewOption(\"Not now — keep capturing locally, ask again next push\", trustChoiceNotNow),\ncmd/entire/cli/strategy/trust_prompt.go:99:\t\t\t\t\thuh.NewOption(\"Always — trust