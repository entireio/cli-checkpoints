{"timestamp":"2026-08-25T16:53:25.289Z","ordinal":14601,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a025ce-e754-7631-8467-eaa6035ba0f8","turn_id":"01a039b7-b242-7af0-80e0-d29bf9afbbac","item":{"type":"CommandExecution","id":"exec-4ce04b76-204f-4c84-bbfc-6b145e298a91","process_id":"71738","command":["/bin/zsh","-c","sed -n '1,150p' cmd/entire/cli/settings/repopolicy/route.go; sed -n '1,120p' cmd/entire/cli/settings/repopolicy/setup.go; sed -n '100,175p' cmd/entire/cli/settings/repopolicy/trust.go; sed -n '1,180p' cmd/entire/cli/settings/repopolicy/repository.go"],"cwd":"file:///Users/peytonmontei/Documents/Documents%20-%20Peyton%E2%80%99s%20MacBook%20Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier","parsed_cmd":[{"type":"read","cmd":"sed -n '1,150p' cmd/entire/cli/settings/repopolicy/route.go","name":"route.go","path":"cmd/entire/cli/settings/repopolicy/route.go"},{"type":"read","cmd":"sed -n '1,120p' cmd/entire/cli/settings/repopolicy/setup.go","name":"setup.go","path":"cmd/entire/cli/settings/repopolicy/setup.go"},{"type":"read","cmd":"sed -n '100,175p' cmd/entire/cli/settings/repopolicy/trust.go","name":"trust.go","path":"cmd/entire/cli/settings/repopolicy/trust.go"},{"type":"read","cmd":"sed -n '1,180p' cmd/entire/cli/settings/repopolicy/repository.go","name":"repository.go","path":"cmd/entire/cli/settings/repopolicy/repository.go"}],"source":"unified_exec_startup","status":"completed","stdout":"package repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/flock\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst (\n\trouteFileName = \"route.json\"\n\trouteLockWait = 2 * time.Second\n)\n\nfunc routePath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), routeFileName)\n}\n\n// ReadRuntimeRoute reads and fully verifies an established route. found is\n// false only when the route does not exist; corrupt and identity-mismatched\n// records return an error.\nfunc ReadRuntimeRoute(repository Repository) (route RuntimeRoute, found bool, err error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn RuntimeRoute{}, false, err\n\t}\n\tdata, err := os.ReadFile(routePath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn RuntimeRoute{}, false, nil\n\t\t}\n\t\treturn RuntimeRoute{}, false, fmt.Errorf(\"reading runtime route: %w\", err)\n\t}\n\tif err := decodeStrict(data, &route); err != nil {\n\t\treturn RuntimeRoute{}, false, fmt.Errorf(\"parsing runtime route: %w\", err)\n\t}\n\tif err := validateRuntimeRoute(repository, route); err != nil {\n\t\treturn RuntimeRoute{}, false, err\n\t}\n\treturn route, true, nil\n}\n\nfunc validateRuntimeRoute(repository Repository, route RuntimeRoute) error {\n\tif route.Version != recordVersion {\n\t\treturn fmt.Errorf(\"unsupported runtime route version %d\", route.Version)\n\t}\n\tif route.Layout != RuntimeWorktree && route.Layout != RuntimeGitCommon {\n\t\treturn fmt.Errorf(\"invalid runtime route layout %q\", route.Layout)\n\t}\n\tif route.CanonicalWorktree != repository.WorktreeRoot || route.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn errors.New(\"runtime route repository identity mismatch\")\n\t}\n\treturn nil\n}\n\n// EnsureRuntimeRoute establishes the policy's proposed route without replacing\n// an existing winner, then rereads and returns that complete winner.\nfunc EnsureRuntimeRoute(ctx context.Context, policy RepoPolicy) (RepoPolicy, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn policy, fmt.Errorf(\"ensuring runtime route: %w\", err)\n\t}\n\trepository := Repository{\n\t\tWorktreeRoot: policy.WorktreeRoot,\n\t\tGitCommonDir: policy.GitCommonDir,\n\t\tWorktreeKey:  policy.WorktreeKey,\n\t}\n\tif err := validateRepository(repository); err != nil {\n\t\treturn policy, err\n\t}\n\tif err := validateRuntimeRoute(repository, policy.Route); err != nil {\n\t\treturn policy, fmt.Errorf(\"invalid proposed runtime route: %w\", err)\n\t}\n\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn policy, err\n\t} else if found {\n\t\tpolicy.Route = winner\n\t\treturn policy, nil\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn policy, err\n\t}\n\tlockCtx, cancel := context.WithTimeout(ctx, routeLockWait)\n\tdefer cancel()\n\trelease, err := flock.AcquireContext(lockCtx, routePath(repository)+\".lock\")\n\tif err != nil {\n\t\treturn policy, fmt.Errorf(\"locking runtime route: %w\", err)\n\t}\n\tdefer release()\n\tif err := ctx.Err(); err != nil {\n\t\treturn policy, fmt.Errorf(\"locking runtime route: %w\", err)\n\t}\n\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn policy, err\n\t} else if found {\n\t\tpolicy.Route = winner\n\t\treturn policy, nil\n\t}\n\tif err := publishRouteNoReplace(routePath(repository), policy.Route); err != nil {\n\t\tif !errors.Is(err, fs.ErrExist) {\n\t\t\treturn policy, fmt.Errorf(\"publishing runtime route: %w\", err)\n\t\t}\n\t}\n\twinner, found, err := ReadRuntimeRoute(repository)\n\tif err != nil {\n\t\treturn policy, err\n\t}\n\tif !found {\n\t\treturn policy, errors.New(\"runtime route winner was not published\")\n\t}\n\tpolicy.Route = winner\n\treturn policy, nil\n}\n\nfunc publishRouteNoReplace(path string, route RuntimeRoute) error {\n\tdata, err := jsonutil.MarshalIndentWithNewline(route, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding route: %w\", err)\n\t}\n\ttmp, err := os.CreateTemp(filepath.Dir(path), filepath.Base(path)+\".*.tmp\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"creating route temp: %w\", err)\n\t}\n\ttmpName := tmp.Name()\n\tdefer func() { _ = os.Remove(tmpName) }()\n\tif _, err := tmp.Write(data); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"writing route temp: %w\", err)\n\t}\n\tif err := tmp.Chmod(0o600); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"securing route temp: %w\", err)\n\t}\n\tif err := tmp.Sync(); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"syncing route temp: %w\", err)\n\t}\n\tif err := tmp.Close(); err != nil {\n\t\treturn fmt.Errorf(\"closing route temp: %w\", err)\n\t}\n\tif err := os.Link(tmpName, path); err != nil {\n\t\treturn fmt.Errorf(\"linking route record: %w\", err)\n\t}\n\tif err := jsonutil.SyncDir(filepath.Dir(path)); err != nil {\n\t\treturn fmt.Errorf(\"syncing route registry: %w\", err)\n\t}\npackage repopolicy\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst setupFileName = \"setup.json\"\n\nfunc setupPath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), setupFileName)\n}\n\n// ReadSetupRecord reads and verifies the current worktree's component record.\nfunc ReadSetupRecord(repository Repository) (record SetupRecord, found bool, err error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn SetupRecord{}, false, err\n\t}\n\tdata, err := os.ReadFile(setupPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn SetupRecord{}, false, nil\n\t\t}\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"reading setup record: %w\", err)\n\t}\n\tif err := decodeStrict(data, &record); err != nil {\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"parsing setup record: %w\", err)\n\t}\n\tif record.Version != recordVersion {\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"unsupported setup record version %d\", record.Version)\n\t}\n\tif record.CanonicalWorktree != repository.WorktreeRoot || record.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn SetupRecord{}, false, errors.New(\"setup record repository identity mismatch\")\n\t}\n\tif record.GitHooksSpec < 0 || record.PrimaryRefSpec < 0 {\n\t\treturn SetupRecord{}, false, errors.New(\"invalid setup component version\")\n\t}\n\treturn record, true, nil\n}\n\n// WriteSetupRecord atomically publishes a verified component record.\nfunc WriteSetupRecord(repository Repository, record SetupRecord) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif existing, found, err := ReadSetupRecord(repository); err != nil {\n\t\treturn err\n\t} else if found && (existing.CanonicalWorktree != repository.WorktreeRoot || existing.CanonicalGitCommon != repository.GitCommonDir) {\n\t\treturn errors.New(\"setup record repository identity mismatch\")\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\trecord.Version = recordVersion\n\trecord.CanonicalWorktree = repository.WorktreeRoot\n\trecord.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(record, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding setup record: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(setupPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing setup record: %w\", err)\n\t}\n\treturn nil\n}\n\n// RemoveWorktreeRuntime removes only current-worktree runtime and route/setup\n// records. The activation record is deliberately retained as a tombstone.\nfunc RemoveWorktreeRuntime(repository Repository) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif _, _, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn err\n\t}\n\tif _, _, err := ReadSetupRecord(repository); err != nil {\n\t\treturn err\n\t}\n\tdir := registryDir(repository)\n\tfor _, name := range []string{routeFileName, routeFileName + \".lock\", setupFileName, \"metadata\", \"logs\", \"tmp\"} {\n\t\tif err := os.RemoveAll(filepath.Join(dir, name)); err != nil {\n\t\t\treturn fmt.Errorf(\"removing worktree runtime %s: %w\", name, err)\n\t\t}\n\t}\n\tif err := jsonutil.SyncDir(dir); err != nil && !errors.Is(err, fs.ErrNotExist) {\n\t\treturn fmt.Errorf(\"syncing worktree registry: %w\", err)\n\t}\n\treturn nil\n}\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\n\treturn err == nil && matched\n}\n\nfunc containsOrigin(entries []string, key string) bool {\n\tfor _, entry := range entries {\n\t\tif CanonicalTrustOrigin(entry) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\nfunc CanonicalTrustOrigin(value string) string {\n\treturn strings.ToLower(strings.TrimSpace(value))\n}\n\n// ReadTrustGrantLedger returns the verified machine-local grant history.\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn TrustGrantLedger{}, false, err\n\t}\n\tdata, err := os.ReadFile(trustLedgerPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn TrustGrantLedger{}, false, nil\n\t\t}\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"reading trust ledger: %w\", err)\n\t}\n\tvar ledger TrustGrantLedger\n\tif err := decodeStrict(data, &ledger); err != nil {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"parsing trust ledger: %w\", err)\n\t}\n\tif ledger.Version != recordVersion {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"unsupported trust ledger version %d\", ledger.Version)\n\t}\n\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn TrustGrantLedger{}, false, errors.New(\"trust ledger repository identity mismatch\")\n\t}\n\treturn ledger, true, nil\n}\n\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\tledger.Version = recordVersion\n\tledger.CanonicalWorktree = repository.WorktreeRoot\n\tledger.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding trust ledger: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing trust ledger: %w\", err)\n\t}\n\treturn nil\n}\npackage repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/worktreeid\"\n)\n\n// Repository contains the stable repository facts needed by policy.\ntype Repository struct {\n\tWorktreeRoot string\n\tGitCommonDir string\n\tWorktreeID   string\n\tWorktreeKey  string\n}\n\n// RepositoryResolver resolves repository facts lazily after global enablement\n// and exclusion validation have passed their no-Git fast path.\ntype RepositoryResolver func(context.Context) (Repository, error)\n\n// HashWorktreeID returns the stable namespace key used for a Git worktree.\nfunc HashWorktreeID(worktreeID string) string {\n\treturn worktreeid.Hash(worktreeID)\n}\n\n// ResolveRepository resolves repository facts for the current directory.\nfunc ResolveRepository(ctx context.Context) (Repository, error) {\n\treturn ResolveRepositoryAt(ctx, \".\")\n}\n\n// ResolveRepositoryAt resolves repository facts without importing the parent\n// settings or paths packages.\nfunc ResolveRepositoryAt(ctx context.Context, dir string) (Repository, error) {\n\tcmd := exec.CommandContext(ctx, \"git\", \"rev-parse\", \"--show-toplevel\", \"--git-common-dir\")\n\tcmd.Dir = dir\n\toutput, err := cmd.Output()\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository: %w\", err)\n\t}\n\tlines := strings.Split(strings.TrimSuffix(string(output), \"\\n\"), \"\\n\")\n\tif len(lines) != 2 {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository: expected two paths, got %d\", len(lines))\n\t}\n\tbase, err := filepath.Abs(dir)\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository base: %w\", err)\n\t}\n\troot := canonicalPath(absolutizeGitPath(base, lines[0]))\n\tcommonDir := canonicalPath(absolutizeGitPath(base, lines[1]))\n\tworktreeID, err := worktreeid.Get(root)\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving worktree identity: %w\", err)\n\t}\n\treturn Repository{\n\t\tWorktreeRoot: root,\n\t\tGitCommonDir: commonDir,\n\t\tWorktreeID:   worktreeID,\n\t\tWorktreeKey:  HashWorktreeID(worktreeID),\n\t}, nil\n}\n\nfunc absolutizeGitPath(base, path string) string {\n\tpath = strings.TrimSpace(path)\n\tif filepath.IsAbs(path) {\n\t\treturn filepath.Clean(path)\n\t}\n\treturn filepath.Clean(filepath.Join(base, path))\n}\n\nfunc canonicalPath(path string) string {\n\tif resolved, err := filepath.EvalSymlinks(path); err == nil {\n\t\treturn filepath.Clean(resolved)\n\t}\n\treturn filepath.Clean(path)\n}\n\nfunc inactiveGlobalPolicy(reason InactiveReason) RepoPolicy {\n\treturn RepoPolicy{ActivationSource: ActivationInactive, InactiveReason: reason}\n}\n\nfunc policyForRepository(repository Repository) RepoPolicy {\n\treturn RepoPolicy{\n\t\tActivationSource: ActivationGlobal,\n\t\tWorktreeRoot:     repository.WorktreeRoot,\n\t\tGitCommonDir:     repository.GitCommonDir,\n\t\tWorktreeKey:      repository.WorktreeKey,\n\t}\n}\n\n// ClassifyGlobalConfig evaluates global activation without logging or writes.\n// Disabled and invalid configurations return before repository resolution.\nfunc ClassifyGlobalConfig(ctx context.Context, config *GlobalConfig, resolve RepositoryResolver) (RepoPolicy, error) {\n\tif config == nil || !config.Enabled {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), nil\n\t}\n\tif problems := validateGlobalExclusions(config); len(problems) > 0 {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalExcluded), errors.New(strings.Join(problems, \"; \"))\n\t}\n\tif resolve == nil {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), errors.New(\"repository resolver is nil\")\n\t}\n\trepository, err := resolve(ctx)\n\tif err != nil {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), err\n\t}\n\tpolicy := policyForRepository(repository)\n\n\texcluded, err := MatchesExcludePath(ctx, config.ExcludePaths, repository.WorktreeRoot)\n\tif err != nil {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, err\n\t}\n\tif excluded {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, nil\n\t}\n\texcluded, err = MatchesExcludePathExact(ctx, config.ExcludePathsExact, repository.WorktreeRoot)\n\tif err != nil {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, err\n\t}\n\tif excluded {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, nil\n\t}\n\tif len(config.ExcludeOrigins) > 0 {\n\t\torigins, found, lookupErr := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\t\tif lookupErr != nil {\n\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\treturn policy, fmt.Errorf(\"reading origin remote: %w\", lookupErr)\n\t\t}\n\t\tif found {\n\t\t\tfor _, origin := range origins {\n\t\t\t\tnormalized := NormalizeOrigin(origin)\n\t\t\t\tif normalized == \"\" {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, errors.New(\"origin remote cannot be normalized\")\n\t\t\t\t}\n\t\t\t\tmatched, matchErr := MatchesExcludeOrigin(ctx, config.ExcludeOrigins, normalized)\n\t\t\t\tif matchErr != nil {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, matchErr\n\t\t\t\t}\n\t\t\t\tif matched {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, nil\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tpolicy.Active = true\n\tpolicy.InactiveReason = InactiveReasonNone\n\treturn policy, nil\n}\n\nvar globalModeCache struct {\n\tsync.Mutex\n\n\tkey    string\n\tset    bool\n\tpolicy RepoPolicy\n\terr    error\n}\n\n","stderr":"","aggregated_output":"package repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/flock\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst (\n\trouteFileName = \"route.json\"\n\trouteLockWait = 2 * time.Second\n)\n\nfunc routePath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), routeFileName)\n}\n\n// ReadRuntimeRoute reads and fully verifies an established route. found is\n// false only when the route does not exist; corrupt and identity-mismatched\n// records return an error.\nfunc ReadRuntimeRoute(repository Repository) (route RuntimeRoute, found bool, err error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn RuntimeRoute{}, false, err\n\t}\n\tdata, err := os.ReadFile(routePath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn RuntimeRoute{}, false, nil\n\t\t}\n\t\treturn RuntimeRoute{}, false, fmt.Errorf(\"reading runtime route: %w\", err)\n\t}\n\tif err := decodeStrict(data, &route); err != nil {\n\t\treturn RuntimeRoute{}, false, fmt.Errorf(\"parsing runtime route: %w\", err)\n\t}\n\tif err := validateRuntimeRoute(repository, route); err != nil {\n\t\treturn RuntimeRoute{}, false, err\n\t}\n\treturn route, true, nil\n}\n\nfunc validateRuntimeRoute(repository Repository, route RuntimeRoute) error {\n\tif route.Version != recordVersion {\n\t\treturn fmt.Errorf(\"unsupported runtime route version %d\", route.Version)\n\t}\n\tif route.Layout != RuntimeWorktree && route.Layout != RuntimeGitCommon {\n\t\treturn fmt.Errorf(\"invalid runtime route layout %q\", route.Layout)\n\t}\n\tif route.CanonicalWorktree != repository.WorktreeRoot || route.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn errors.New(\"runtime route repository identity mismatch\")\n\t}\n\treturn nil\n}\n\n// EnsureRuntimeRoute establishes the policy's proposed route without replacing\n// an existing winner, then rereads and returns that complete winner.\nfunc EnsureRuntimeRoute(ctx context.Context, policy RepoPolicy) (RepoPolicy, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn policy, fmt.Errorf(\"ensuring runtime route: %w\", err)\n\t}\n\trepository := Repository{\n\t\tWorktreeRoot: policy.WorktreeRoot,\n\t\tGitCommonDir: policy.GitCommonDir,\n\t\tWorktreeKey:  policy.WorktreeKey,\n\t}\n\tif err := validateRepository(repository); err != nil {\n\t\treturn policy, err\n\t}\n\tif err := validateRuntimeRoute(repository, policy.Route); err != nil {\n\t\treturn policy, fmt.Errorf(\"invalid proposed runtime route: %w\", err)\n\t}\n\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn policy, err\n\t} else if found {\n\t\tpolicy.Route = winner\n\t\treturn policy, nil\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn policy, err\n\t}\n\tlockCtx, cancel := context.WithTimeout(ctx, routeLockWait)\n\tdefer cancel()\n\trelease, err := flock.AcquireContext(lockCtx, routePath(repository)+\".lock\")\n\tif err != nil {\n\t\treturn policy, fmt.Errorf(\"locking runtime route: %w\", err)\n\t}\n\tdefer release()\n\tif err := ctx.Err(); err != nil {\n\t\treturn policy, fmt.Errorf(\"locking runtime route: %w\", err)\n\t}\n\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn policy, err\n\t} else if found {\n\t\tpolicy.Route = winner\n\t\treturn policy, nil\n\t}\n\tif err := publishRouteNoReplace(routePath(repository), policy.Route); err != nil {\n\t\tif !errors.Is(err, fs.ErrExist) {\n\t\t\treturn policy, fmt.Errorf(\"publishing runtime route: %w\", err)\n\t\t}\n\t}\n\twinner, found, err := ReadRuntimeRoute(repository)\n\tif err != nil {\n\t\treturn policy, err\n\t}\n\tif !found {\n\t\treturn policy, errors.New(\"runtime route winner was not published\")\n\t}\n\tpolicy.Route = winner\n\treturn policy, nil\n}\n\nfunc publishRouteNoReplace(path string, route RuntimeRoute) error {\n\tdata, err := jsonutil.MarshalIndentWithNewline(route, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding route: %w\", err)\n\t}\n\ttmp, err := os.CreateTemp(filepath.Dir(path), filepath.Base(path)+\".*.tmp\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"creating route temp: %w\", err)\n\t}\n\ttmpName := tmp.Name()\n\tdefer func() { _ = os.Remove(tmpName) }()\n\tif _, err := tmp.Write(data); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"writing route temp: %w\", err)\n\t}\n\tif err := tmp.Chmod(0o600); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"securing route temp: %w\", err)\n\t}\n\tif err := tmp.Sync(); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"syncing route temp: %w\", err)\n\t}\n\tif err := tmp.Close(); err != nil {\n\t\treturn fmt.Errorf(\"closing route temp: %w\", err)\n\t}\n\tif err := os.Link(tmpName, path); err != nil {\n\t\treturn fmt.Errorf(\"linking route record: %w\", err)\n\t}\n\tif err := jsonutil.SyncDir(filepath.Dir(path)); err != nil {\n\t\treturn fmt.Errorf(\"syncing route registry: %w\", err)\n\t}\npackage repopolicy\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst setupFileName = \"setup.json\"\n\nfunc setupPath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), setupFileName)\n}\n\n// ReadSetupRecord reads and verifies the current worktree's component record.\nfunc ReadSetupRecord(repository Repository) (record SetupRecord, found bool, err error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn SetupRecord{}, false, err\n\t}\n\tdata, err := os.ReadFile(setupPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn SetupRecord{}, false, nil\n\t\t}\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"reading setup record: %w\", err)\n\t}\n\tif err := decodeStrict(data, &record); err != nil {\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"parsing setup record: %w\", err)\n\t}\n\tif record.Version != recordVersion {\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"unsupported setup record version %d\", record.Version)\n\t}\n\tif record.CanonicalWorktree != repository.WorktreeRoot || record.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn SetupRecord{}, false, errors.New(\"setup record repository identity mismatch\")\n\t}\n\tif record.GitHooksSpec < 0 || record.PrimaryRefSpec < 0 {\n\t\treturn SetupRecord{}, false, errors.New(\"invalid setup component version\")\n\t}\n\treturn record, true, nil\n}\n\n// WriteSetupRecord atomically publishes a verified component record.\nfunc WriteSetupRecord(repository Repository, record SetupRecord) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif existing, found, err := ReadSetupRecord(repository); err != nil {\n\t\treturn err\n\t} else if found && (existing.CanonicalWorktree != repository.WorktreeRoot || existing.CanonicalGitCommon != repository.GitCommonDir) {\n\t\treturn errors.New(\"setup record repository identity mismatch\")\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\trecord.Version = recordVersion\n\trecord.CanonicalWorktree = repository.WorktreeRoot\n\trecord.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(record, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding setup record: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(setupPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing setup record: %w\", err)\n\t}\n\treturn nil\n}\n\n// RemoveWorktreeRuntime removes only current-worktree runtime and route/setup\n// records. The activation record is deliberately retained as a tombstone.\nfunc RemoveWorktreeRuntime(repository Repository) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif _, _, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn err\n\t}\n\tif _, _, err := ReadSetupRecord(repository); err != nil {\n\t\treturn err\n\t}\n\tdir := registryDir(repository)\n\tfor _, name := range []string{routeFileName, routeFileName + \".lock\", setupFileName, \"metadata\", \"logs\", \"tmp\"} {\n\t\tif err := os.RemoveAll(filepath.Join(dir, name)); err != nil {\n\t\t\treturn fmt.Errorf(\"removing worktree runtime %s: %w\", name, err)\n\t\t}\n\t}\n\tif err := jsonutil.SyncDir(dir); err != nil && !errors.Is(err, fs.ErrNotExist) {\n\t\treturn fmt.Errorf(\"syncing worktree registry: %w\", err)\n\t}\n\treturn nil\n}\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\n\treturn err == nil && matched\n}\n\nfunc containsOrigin(entries []string, key string) bool {\n\tfor _, entry := range entries {\n\t\tif CanonicalTrustOrigin(entry) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\nfunc CanonicalTrustOrigin(value string) string {\n\treturn strings.ToLower(strings.TrimSpace(value))\n}\n\n// ReadTrustGrantLedger returns the verified machine-local grant history.\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn TrustGrantLedger{}, false, err\n\t}\n\tdata, err := os.ReadFile(trustLedgerPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn TrustGrantLedger{}, false, nil\n\t\t}\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"reading trust ledger: %w\", err)\n\t}\n\tvar ledger TrustGrantLedger\n\tif err := decodeStrict(data, &ledger); err != nil {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"parsing trust ledger: %w\", err)\n\t}\n\tif ledger.Version != recordVersion {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"unsupported trust ledger version %d\", ledger.Version)\n\t}\n\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn TrustGrantLedger{}, false, errors.New(\"trust ledger repository identity mismatch\")\n\t}\n\treturn ledger, true, nil\n}\n\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\tledger.Version = recordVersion\n\tledger.CanonicalWorktree = repository.WorktreeRoot\n\tledger.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding trust ledger: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing trust ledger: %w\", err)\n\t}\n\treturn nil\n}\npackage repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/worktreeid\"\n)\n\n// Repository contains the stable repository facts needed by policy.\ntype Repository struct {\n\tWorktreeRoot string\n\tGitCommonDir string\n\tWorktreeID   string\n\tWorktreeKey  string\n}\n\n// RepositoryResolver resolves repository facts lazily after global enablement\n// and exclusion validation have passed their no-Git fast path.\ntype RepositoryResolver func(context.Context) (Repository, error)\n\n// HashWorktreeID returns the stable namespace key used for a Git worktree.\nfunc HashWorktreeID(worktreeID string) string {\n\treturn worktreeid.Hash(worktreeID)\n}\n\n// ResolveRepository resolves repository facts for the current directory.\nfunc ResolveRepository(ctx context.Context) (Repository, error) {\n\treturn ResolveRepositoryAt(ctx, \".\")\n}\n\n// ResolveRepositoryAt resolves repository facts without importing the parent\n// settings or paths packages.\nfunc ResolveRepositoryAt(ctx context.Context, dir string) (Repository, error) {\n\tcmd := exec.CommandContext(ctx, \"git\", \"rev-parse\", \"--show-toplevel\", \"--git-common-dir\")\n\tcmd.Dir = dir\n\toutput, err := cmd.Output()\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository: %w\", err)\n\t}\n\tlines := strings.Split(strings.TrimSuffix(string(output), \"\\n\"), \"\\n\")\n\tif len(lines) != 2 {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository: expected two paths, got %d\", len(lines))\n\t}\n\tbase, err := filepath.Abs(dir)\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository base: %w\", err)\n\t}\n\troot := canonicalPath(absolutizeGitPath(base, lines[0]))\n\tcommonDir := canonicalPath(absolutizeGitPath(base, lines[1]))\n\tworktreeID, err := worktreeid.Get(root)\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving worktree identity: %w\", err)\n\t}\n\treturn Repository{\n\t\tWorktreeRoot: root,\n\t\tGitCommonDir: commonDir,\n\t\tWorktreeID:   worktreeID,\n\t\tWorktreeKey:  HashWorktreeID(worktreeID),\n\t}, nil\n}\n\nfunc absolutizeGitPath(base, path string) string {\n\tpath = strings.TrimSpace(path)\n\tif filepath.IsAbs(path) {\n\t\treturn filepath.Clean(path)\n\t}\n\treturn filepath.Clean(filepath.Join(base, path))\n}\n\nfunc canonicalPath(path string) string {\n\tif resolved, err := filepath.EvalSymlinks(path); err == nil {\n\t\treturn filepath.Clean(resolved)\n\t}\n\treturn filepath.Clean(path)\n}\n\nfunc inactiveGlobalPolicy(reason InactiveReason) RepoPolicy {\n\treturn RepoPolicy{ActivationSource: ActivationInactive, InactiveReason: reason}\n}\n\nfunc policyForRepository(repository Repository) RepoPolicy {\n\treturn RepoPolicy{\n\t\tActivationSource: ActivationGlobal,\n\t\tWorktreeRoot:     repository.WorktreeRoot,\n\t\tGitCommonDir:     repository.GitCommonDir,\n\t\tWorktreeKey:      repository.WorktreeKey,\n\t}\n}\n\n// ClassifyGlobalConfig evaluates global activation without logging or writes.\n// Disabled and invalid configurations return before repository resolution.\nfunc ClassifyGlobalConfig(ctx context.Context, config *GlobalConfig, resolve RepositoryResolver) (RepoPolicy, error) {\n\tif config == nil || !config.Enabled {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), nil\n\t}\n\tif problems := validateGlobalExclusions(config); len(problems) > 0 {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalExcluded), errors.New(strings.Join(problems, \"; \"))\n\t}\n\tif resolve == nil {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), errors.New(\"repository resolver is nil\")\n\t}\n\trepository, err := resolve(ctx)\n\tif err != nil {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), err\n\t}\n\tpolicy := policyForRepository(repository)\n\n\texcluded, err := MatchesExcludePath(ctx, config.ExcludePaths, repository.WorktreeRoot)\n\tif err != nil {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, err\n\t}\n\tif excluded {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, nil\n\t}\n\texcluded, err = MatchesExcludePathExact(ctx, config.ExcludePathsExact, repository.WorktreeRoot)\n\tif err != nil {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, err\n\t}\n\tif excluded {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, nil\n\t}\n\tif len(config.ExcludeOrigins) > 0 {\n\t\torigins, found, lookupErr := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\t\tif lookupErr != nil {\n\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\treturn policy, fmt.Errorf(\"reading origin remote: %w\", lookupErr)\n\t\t}\n\t\tif found {\n\t\t\tfor _, origin := range origins {\n\t\t\t\tnormalized := NormalizeOrigin(origin)\n\t\t\t\tif normalized == \"\" {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, errors.New(\"origin remote cannot be normalized\")\n\t\t\t\t}\n\t\t\t\tmatched, matchErr := MatchesExcludeOrigin(ctx, config.ExcludeOrigins, normalized)\n\t\t\t\tif matchErr != nil {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, matchErr\n\t\t\t\t}\n\t\t\t\tif matched {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, nil\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tpolicy.Active = true\n\tpolicy.InactiveReason = InactiveReasonNone\n\treturn policy, nil\n}\n\nvar globalModeCache struct {\n\tsync.Mutex\n\n\tkey    string\n\tset    bool\n\tpolicy RepoPolicy\n\terr    error\n}\n\n","exit_code":0,"duration":{"secs":0,"nanos":3291},"formatted_output":"package repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/flock\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst (\n\trouteFileName = \"route.json\"\n\trouteLockWait = 2 * time.Second\n)\n\nfunc routePath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), routeFileName)\n}\n\n// ReadRuntimeRoute reads and fully verifies an established route. found is\n// false only when the route does not exist; corrupt and identity-mismatched\n// records return an error.\nfunc ReadRuntimeRoute(repository Repository) (route RuntimeRoute, found bool, err error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn RuntimeRoute{}, false, err\n\t}\n\tdata, err := os.ReadFile(routePath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn RuntimeRoute{}, false, nil\n\t\t}\n\t\treturn RuntimeRoute{}, false, fmt.Errorf(\"reading runtime route: %w\", err)\n\t}\n\tif err := decodeStrict(data, &route); err != nil {\n\t\treturn RuntimeRoute{}, false, fmt.Errorf(\"parsing runtime route: %w\", err)\n\t}\n\tif err := validateRuntimeRoute(repository, route); err != nil {\n\t\treturn RuntimeRoute{}, false, err\n\t}\n\treturn route, true, nil\n}\n\nfunc validateRuntimeRoute(repository Repository, route RuntimeRoute) error {\n\tif route.Version != recordVersion {\n\t\treturn fmt.Errorf(\"unsupported runtime route version %d\", route.Version)\n\t}\n\tif route.Layout != RuntimeWorktree && route.Layout != RuntimeGitCommon {\n\t\treturn fmt.Errorf(\"invalid runtime route layout %q\", route.Layout)\n\t}\n\tif route.CanonicalWorktree != repository.WorktreeRoot || route.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn errors.New(\"runtime route repository identity mismatch\")\n\t}\n\treturn nil\n}\n\n// EnsureRuntimeRoute establishes the policy's proposed route without replacing\n// an existing winner, then rereads and returns that complete winner.\nfunc EnsureRuntimeRoute(ctx context.Context, policy RepoPolicy) (RepoPolicy, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn policy, fmt.Errorf(\"ensuring runtime route: %w\", err)\n\t}\n\trepository := Repository{\n\t\tWorktreeRoot: policy.WorktreeRoot,\n\t\tGitCommonDir: policy.GitCommonDir,\n\t\tWorktreeKey:  policy.WorktreeKey,\n\t}\n\tif err := validateRepository(repository); err != nil {\n\t\treturn policy, err\n\t}\n\tif err := validateRuntimeRoute(repository, policy.Route); err != nil {\n\t\treturn policy, fmt.Errorf(\"invalid proposed runtime route: %w\", err)\n\t}\n\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn policy, err\n\t} else if found {\n\t\tpolicy.Route = winner\n\t\treturn policy, nil\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn policy, err\n\t}\n\tlockCtx, cancel := context.WithTimeout(ctx, routeLockWait)\n\tdefer cancel()\n\trelease, err := flock.AcquireContext(lockCtx, routePath(repository)+\".lock\")\n\tif err != nil {\n\t\treturn policy, fmt.Errorf(\"locking runtime route: %w\", err)\n\t}\n\tdefer release()\n\tif err := ctx.Err(); err != nil {\n\t\treturn policy, fmt.Errorf(\"locking runtime route: %w\", err)\n\t}\n\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn policy, err\n\t} else if found {\n\t\tpolicy.Route = winner\n\t\treturn policy, nil\n\t}\n\tif err := publishRouteNoReplace(routePath(repository), policy.Route); err != nil {\n\t\tif !errors.Is(err, fs.ErrExist) {\n\t\t\treturn policy, fmt.Errorf(\"publishing runtime route: %w\", err)\n\t\t}\n\t}\n\twinner, found, err := ReadRuntimeRoute(repository)\n\tif err != nil {\n\t\treturn policy, err\n\t}\n\tif !found {\n\t\treturn policy, errors.New(\"runtime route winner was not published\")\n\t}\n\tpolicy.Route = winner\n\treturn policy, nil\n}\n\nfunc publishRouteNoReplace(path string, route RuntimeRoute) error {\n\tdata, err := jsonutil.MarshalIndentWithNewline(route, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding route: %w\", err)\n\t}\n\ttmp, err := os.CreateTemp(filepath.Dir(path), filepath.Base(path)+\".*.tmp\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"creating route temp: %w\", err)\n\t}\n\ttmpName := tmp.Name()\n\tdefer func() { _ = os.Remove(tmpName) }()\n\tif _, err := tmp.Write(data); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"writing route temp: %w\", err)\n\t}\n\tif err := tmp.Chmod(0o600); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"securing route temp: %w\", err)\n\t}\n\tif err := tmp.Sync(); err != nil {\n\t\t_ = tmp.Close()\n\t\treturn fmt.Errorf(\"syncing route temp: %w\", err)\n\t}\n\tif err := tmp.Close(); err != nil {\n\t\treturn fmt.Errorf(\"closing route temp: %w\", err)\n\t}\n\tif err := os.Link(tmpName, path); err != nil {\n\t\treturn fmt.Errorf(\"linking route record: %w\", err)\n\t}\n\tif err := jsonutil.SyncDir(filepath.Dir(path)); err != nil {\n\t\treturn fmt.Errorf(\"syncing route registry: %w\", err)\n\t}\npackage repopolicy\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n)\n\nconst setupFileName = \"setup.json\"\n\nfunc setupPath(repository Repository) string {\n\treturn filepath.Join(registryDir(repository), setupFileName)\n}\n\n// ReadSetupRecord reads and verifies the current worktree's component record.\nfunc ReadSetupRecord(repository Repository) (record SetupRecord, found bool, err error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn SetupRecord{}, false, err\n\t}\n\tdata, err := os.ReadFile(setupPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn SetupRecord{}, false, nil\n\t\t}\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"reading setup record: %w\", err)\n\t}\n\tif err := decodeStrict(data, &record); err != nil {\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"parsing setup record: %w\", err)\n\t}\n\tif record.Version != recordVersion {\n\t\treturn SetupRecord{}, false, fmt.Errorf(\"unsupported setup record version %d\", record.Version)\n\t}\n\tif record.CanonicalWorktree != repository.WorktreeRoot || record.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn SetupRecord{}, false, errors.New(\"setup record repository identity mismatch\")\n\t}\n\tif record.GitHooksSpec < 0 || record.PrimaryRefSpec < 0 {\n\t\treturn SetupRecord{}, false, errors.New(\"invalid setup component version\")\n\t}\n\treturn record, true, nil\n}\n\n// WriteSetupRecord atomically publishes a verified component record.\nfunc WriteSetupRecord(repository Repository, record SetupRecord) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif existing, found, err := ReadSetupRecord(repository); err != nil {\n\t\treturn err\n\t} else if found && (existing.CanonicalWorktree != repository.WorktreeRoot || existing.CanonicalGitCommon != repository.GitCommonDir) {\n\t\treturn errors.New(\"setup record repository identity mismatch\")\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\trecord.Version = recordVersion\n\trecord.CanonicalWorktree = repository.WorktreeRoot\n\trecord.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(record, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding setup record: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(setupPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing setup record: %w\", err)\n\t}\n\treturn nil\n}\n\n// RemoveWorktreeRuntime removes only current-worktree runtime and route/setup\n// records. The activation record is deliberately retained as a tombstone.\nfunc RemoveWorktreeRuntime(repository Repository) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif _, _, err := ReadRuntimeRoute(repository); err != nil {\n\t\treturn err\n\t}\n\tif _, _, err := ReadSetupRecord(repository); err != nil {\n\t\treturn err\n\t}\n\tdir := registryDir(repository)\n\tfor _, name := range []string{routeFileName, routeFileName + \".lock\", setupFileName, \"metadata\", \"logs\", \"tmp\"} {\n\t\tif err := os.RemoveAll(filepath.Join(dir, name)); err != nil {\n\t\t\treturn fmt.Errorf(\"removing worktree runtime %s: %w\", name, err)\n\t\t}\n\t}\n\tif err := jsonutil.SyncDir(dir); err != nil && !errors.Is(err, fs.ErrNotExist) {\n\t\treturn fmt.Errorf(\"syncing worktree registry: %w\", err)\n\t}\n\treturn nil\n}\n\t\t\t}\n\t\t}\n\t\treturn true\n\t}\n\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\n\treturn err == nil && matched\n}\n\nfunc containsOrigin(entries []string, key string) bool {\n\tfor _, entry := range entries {\n\t\tif CanonicalTrustOrigin(entry) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\nfunc CanonicalTrustOrigin(value string) string {\n\treturn strings.ToLower(strings.TrimSpace(value))\n}\n\n// ReadTrustGrantLedger returns the verified machine-local grant history.\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn TrustGrantLedger{}, false, err\n\t}\n\tdata, err := os.ReadFile(trustLedgerPath(repository))\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn TrustGrantLedger{}, false, nil\n\t\t}\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"reading trust ledger: %w\", err)\n\t}\n\tvar ledger TrustGrantLedger\n\tif err := decodeStrict(data, &ledger); err != nil {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"parsing trust ledger: %w\", err)\n\t}\n\tif ledger.Version != recordVersion {\n\t\treturn TrustGrantLedger{}, false, fmt.Errorf(\"unsupported trust ledger version %d\", ledger.Version)\n\t}\n\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\n\t\treturn TrustGrantLedger{}, false, errors.New(\"trust ledger repository identity mismatch\")\n\t}\n\treturn ledger, true, nil\n}\n\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\n\tif err := validateRepository(repository); err != nil {\n\t\treturn err\n\t}\n\tif err := ensureRegistryDir(repository); err != nil {\n\t\treturn err\n\t}\n\tledger.Version = recordVersion\n\tledger.CanonicalWorktree = repository.WorktreeRoot\n\tledger.CanonicalGitCommon = repository.GitCommonDir\n\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encoding trust ledger: %w\", err)\n\t}\n\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"writing trust ledger: %w\", err)\n\t}\n\treturn nil\n}\npackage repopolicy\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/gitremote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/internal/worktreeid\"\n)\n\n// Repository contains the stable repository facts needed by policy.\ntype Repository struct {\n\tWorktreeRoot string\n\tGitCommonDir string\n\tWorktreeID   string\n\tWorktreeKey  string\n}\n\n// RepositoryResolver resolves repository facts lazily after global enablement\n// and exclusion validation have passed their no-Git fast path.\ntype RepositoryResolver func(context.Context) (Repository, error)\n\n// HashWorktreeID returns the stable namespace key used for a Git worktree.\nfunc HashWorktreeID(worktreeID string) string {\n\treturn worktreeid.Hash(worktreeID)\n}\n\n// ResolveRepository resolves repository facts for the current directory.\nfunc ResolveRepository(ctx context.Context) (Repository, error) {\n\treturn ResolveRepositoryAt(ctx, \".\")\n}\n\n// ResolveRepositoryAt resolves repository facts without importing the parent\n// settings or paths packages.\nfunc ResolveRepositoryAt(ctx context.Context, dir string) (Repository, error) {\n\tcmd := exec.CommandContext(ctx, \"git\", \"rev-parse\", \"--show-toplevel\", \"--git-common-dir\")\n\tcmd.Dir = dir\n\toutput, err := cmd.Output()\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository: %w\", err)\n\t}\n\tlines := strings.Split(strings.TrimSuffix(string(output), \"\\n\"), \"\\n\")\n\tif len(lines) != 2 {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository: expected two paths, got %d\", len(lines))\n\t}\n\tbase, err := filepath.Abs(dir)\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving repository base: %w\", err)\n\t}\n\troot := canonicalPath(absolutizeGitPath(base, lines[0]))\n\tcommonDir := canonicalPath(absolutizeGitPath(base, lines[1]))\n\tworktreeID, err := worktreeid.Get(root)\n\tif err != nil {\n\t\treturn Repository{}, fmt.Errorf(\"resolving worktree identity: %w\", err)\n\t}\n\treturn Repository{\n\t\tWorktreeRoot: root,\n\t\tGitCommonDir: commonDir,\n\t\tWorktreeID:   worktreeID,\n\t\tWorktreeKey:  HashWorktreeID(worktreeID),\n\t}, nil\n}\n\nfunc absolutizeGitPath(base, path string) string {\n\tpath = strings.TrimSpace(path)\n\tif filepath.IsAbs(path) {\n\t\treturn filepath.Clean(path)\n\t}\n\treturn filepath.Clean(filepath.Join(base, path))\n}\n\nfunc canonicalPath(path string) string {\n\tif resolved, err := filepath.EvalSymlinks(path); err == nil {\n\t\treturn filepath.Clean(resolved)\n\t}\n\treturn filepath.Clean(path)\n}\n\nfunc inactiveGlobalPolicy(reason InactiveReason) RepoPolicy {\n\treturn RepoPolicy{ActivationSource: ActivationInactive, InactiveReason: reason}\n}\n\nfunc policyForRepository(repository Repository) RepoPolicy {\n\treturn RepoPolicy{\n\t\tActivationSource: ActivationGlobal,\n\t\tWorktreeRoot:     repository.WorktreeRoot,\n\t\tGitCommonDir:     repository.GitCommonDir,\n\t\tWorktreeKey:      repository.WorktreeKey,\n\t}\n}\n\n// ClassifyGlobalConfig evaluates global activation without logging or writes.\n// Disabled and invalid configurations return before repository resolution.\nfunc ClassifyGlobalConfig(ctx context.Context, config *GlobalConfig, resolve RepositoryResolver) (RepoPolicy, error) {\n\tif config == nil || !config.Enabled {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), nil\n\t}\n\tif problems := validateGlobalExclusions(config); len(problems) > 0 {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalExcluded), errors.New(strings.Join(problems, \"; \"))\n\t}\n\tif resolve == nil {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), errors.New(\"repository resolver is nil\")\n\t}\n\trepository, err := resolve(ctx)\n\tif err != nil {\n\t\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), err\n\t}\n\tpolicy := policyForRepository(repository)\n\n\texcluded, err := MatchesExcludePath(ctx, config.ExcludePaths, repository.WorktreeRoot)\n\tif err != nil {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, err\n\t}\n\tif excluded {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, nil\n\t}\n\texcluded, err = MatchesExcludePathExact(ctx, config.ExcludePathsExact, repository.WorktreeRoot)\n\tif err != nil {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, err\n\t}\n\tif excluded {\n\t\tpolicy.ActivationSource = ActivationInactive\n\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\treturn policy, nil\n\t}\n\tif len(config.ExcludeOrigins) > 0 {\n\t\torigins, found, lookupErr := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \"origin\")\n\t\tif lookupErr != nil {\n\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\treturn policy, fmt.Errorf(\"reading origin remote: %w\", lookupErr)\n\t\t}\n\t\tif found {\n\t\t\tfor _, origin := range origins {\n\t\t\t\tnormalized := NormalizeOrigin(origin)\n\t\t\t\tif normalized == \"\" {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, errors.New(\"origin remote cannot be normalized\")\n\t\t\t\t}\n\t\t\t\tmatched, matchErr := MatchesExcludeOrigin(ctx, config.ExcludeOrigins, normalized)\n\t\t\t\tif matchErr != nil {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, matchErr\n\t\t\t\t}\n\t\t\t\tif matched {\n\t\t\t\t\tpolicy.ActivationSource = ActivationInactive\n\t\t\t\t\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\n\t\t\t\t\treturn policy, nil\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tpolicy.Active = true\n\tpolicy.InactiveReason = InactiveReasonNone\n\treturn policy, nil\n}\n\nvar globalModeCache struct {\n\tsync.Mutex\n\n\tkey    string\n\tset    bool\n\tpolicy RepoPolicy\n\terr    error\n}\n\n"},"started_at_ms":1787676805289,"completed_at_ms":1787676805289}}
{"timestamp":"2026-08-25T16:53:32.383Z","ordinal":14602,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a039d7-645f-72c3-a9ce-facb60367d19","call_id":"call_nGOazjK9tVveCX951rRTxbab","output":[{"type":"input_text","text":"Script completed\nWall time 7.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"402fcc\",\"wall_time_seconds\":0.000003291,\"exit_code\":0,\"original_token_count\":3996,\"output\":\"package repopolicy\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"time\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/internal/flock\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/jsonutil\\\"\\n)\\n\\nconst (\\n\\trouteFileName = \\\"route.json\\\"\\n\\trouteLockWait = 2 * time.Second\\n)\\n\\nfunc routePath(repository Repository) string {\\n\\treturn filepath.Join(registryDir(repository), routeFileName)\\n}\\n\\n// ReadRuntimeRoute reads and fully verifies an established route. found is\\n// false only when the route does not exist; corrupt and identity-mismatched\\n// records return an error.\\nfunc ReadRuntimeRoute(repository Repository) (route RuntimeRoute, found bool, err error) {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn RuntimeRoute{}, false, err\\n\\t}\\n\\tdata, err := os.ReadFile(routePath(repository))\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn RuntimeRoute{}, false, nil\\n\\t\\t}\\n\\t\\treturn RuntimeRoute{}, false, fmt.Errorf(\\\"reading runtime route: %w\\\", err)\\n\\t}\\n\\tif err := decodeStrict(data, &route); err != nil {\\n\\t\\treturn RuntimeRoute{}, false, fmt.Errorf(\\\"parsing runtime route: %w\\\", err)\\n\\t}\\n\\tif err := validateRuntimeRoute(repository, route); err != nil {\\n\\t\\treturn RuntimeRoute{}, false, err\\n\\t}\\n\\treturn route, true, nil\\n}\\n\\nfunc validateRuntimeRoute(repository Repository, route RuntimeRoute) error {\\n\\tif route.Version != recordVersion {\\n\\t\\treturn fmt.Errorf(\\\"unsupported runtime route version %d\\\", route.Version)\\n\\t}\\n\\tif route.Layout != RuntimeWorktree && route.Layout != RuntimeGitCommon {\\n\\t\\treturn fmt.Errorf(\\\"invalid runtime route layout %q\\\", route.Layout)\\n\\t}\\n\\tif route.CanonicalWorktree != repository.WorktreeRoot || route.CanonicalGitCommon != repository.GitCommonDir {\\n\\t\\treturn errors.New(\\\"runtime route repository identity mismatch\\\")\\n\\t}\\n\\treturn nil\\n}\\n\\n// EnsureRuntimeRoute establishes the policy's proposed route without replacing\\n// an existing winner, then rereads and returns that complete winner.\\nfunc EnsureRuntimeRoute(ctx context.Context, policy RepoPolicy) (RepoPolicy, error) {\\n\\tif err := ctx.Err(); err != nil {\\n\\t\\treturn policy, fmt.Errorf(\\\"ensuring runtime route: %w\\\", err)\\n\\t}\\n\\trepository := Repository{\\n\\t\\tWorktreeRoot: policy.WorktreeRoot,\\n\\t\\tGitCommonDir: policy.GitCommonDir,\\n\\t\\tWorktreeKey:  policy.WorktreeKey,\\n\\t}\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn policy, err\\n\\t}\\n\\tif err := validateRuntimeRoute(repository, policy.Route); err != nil {\\n\\t\\treturn policy, fmt.Errorf(\\\"invalid proposed runtime route: %w\\\", err)\\n\\t}\\n\\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\\n\\t\\treturn policy, err\\n\\t} else if found {\\n\\t\\tpolicy.Route = winner\\n\\t\\treturn policy, nil\\n\\t}\\n\\tif err := ensureRegistryDir(repository); err != nil {\\n\\t\\treturn policy, err\\n\\t}\\n\\tlockCtx, cancel := context.WithTimeout(ctx, routeLockWait)\\n\\tdefer cancel()\\n\\trelease, err := flock.AcquireContext(lockCtx, routePath(repository)+\\\".lock\\\")\\n\\tif err != nil {\\n\\t\\treturn policy, fmt.Errorf(\\\"locking runtime route: %w\\\", err)\\n\\t}\\n\\tdefer release()\\n\\tif err := ctx.Err(); err != nil {\\n\\t\\treturn policy, fmt.Errorf(\\\"locking runtime route: %w\\\", err)\\n\\t}\\n\\tif winner, found, err := ReadRuntimeRoute(repository); err != nil {\\n\\t\\treturn policy, err\\n\\t} else if found {\\n\\t\\tpolicy.Route = winner\\n\\t\\treturn policy, nil\\n\\t}\\n\\tif err := publishRouteNoReplace(routePath(repository), policy.Route); err != nil {\\n\\t\\tif !errors.Is(err, fs.ErrExist) {\\n\\t\\t\\treturn policy, fmt.Errorf(\\\"publishing runtime route: %w\\\", err)\\n\\t\\t}\\n\\t}\\n\\twinner, found, err := ReadRuntimeRoute(repository)\\n\\tif err != nil {\\n\\t\\treturn policy, err\\n\\t}\\n\\tif !found {\\n\\t\\treturn policy, errors.New(\\\"runtime route winner was not published\\\")\\n\\t}\\n\\tpolicy.Route = winner\\n\\treturn policy, nil\\n}\\n\\nfunc publishRouteNoReplace(path string, route RuntimeRoute) error {\\n\\tdata, err := jsonutil.MarshalIndentWithNewline(route, \\\"\\\", \\\"  \\\")\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"encoding route: %w\\\", err)\\n\\t}\\n\\ttmp, err := os.CreateTemp(filepath.Dir(path), filepath.Base(path)+\\\".*.tmp\\\")\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"creating route temp: %w\\\", err)\\n\\t}\\n\\ttmpName := tmp.Name()\\n\\tdefer func() { _ = os.Remove(tmpName) }()\\n\\tif _, err := tmp.Write(data); err != nil {\\n\\t\\t_ = tmp.Close()\\n\\t\\treturn fmt.Errorf(\\\"writing route temp: %w\\\", err)\\n\\t}\\n\\tif err := tmp.Chmod(0o600); err != nil {\\n\\t\\t_ = tmp.Close()\\n\\t\\treturn fmt.Errorf(\\\"securing route temp: %w\\\", err)\\n\\t}\\n\\tif err := tmp.Sync(); err != nil {\\n\\t\\t_ = tmp.Close()\\n\\t\\treturn fmt.Errorf(\\\"syncing route temp: %w\\\", err)\\n\\t}\\n\\tif err := tmp.Close(); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"closing route temp: %w\\\", err)\\n\\t}\\n\\tif err := os.Link(tmpName, path); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"linking route record: %w\\\", err)\\n\\t}\\n\\tif err := jsonutil.SyncDir(filepath.Dir(path)); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"syncing route registry: %w\\\", err)\\n\\t}\\npackage repopolicy\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/jsonutil\\\"\\n)\\n\\nconst setupFileName = \\\"setup.json\\\"\\n\\nfunc setupPath(repository Repository) string {\\n\\treturn filepath.Join(registryDir(repository), setupFileName)\\n}\\n\\n// ReadSetupRecord reads and verifies the current worktree's component record.\\nfunc ReadSetupRecord(repository Repository) (record SetupRecord, found bool, err error) {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn SetupRecord{}, false, err\\n\\t}\\n\\tdata, err := os.ReadFile(setupPath(repository))\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn SetupRecord{}, false, nil\\n\\t\\t}\\n\\t\\treturn SetupRecord{}, false, fmt.Errorf(\\\"reading setup record: %w\\\", err)\\n\\t}\\n\\tif err := decodeStrict(data, &record); err != nil {\\n\\t\\treturn SetupRecord{}, false, fmt.Errorf(\\\"parsing setup record: %w\\\", err)\\n\\t}\\n\\tif record.Version != recordVersion {\\n\\t\\treturn SetupRecord{}, false, fmt.Errorf(\\\"unsupported setup record version %d\\\", record.Version)\\n\\t}\\n\\tif record.CanonicalWorktree != repository.WorktreeRoot || record.CanonicalGitCommon != repository.GitCommonDir {\\n\\t\\treturn SetupRecord{}, false, errors.New(\\\"setup record repository identity mismatch\\\")\\n\\t}\\n\\tif record.GitHooksSpec < 0 || record.PrimaryRefSpec < 0 {\\n\\t\\treturn SetupRecord{}, false, errors.New(\\\"invalid setup component version\\\")\\n\\t}\\n\\treturn record, true, nil\\n}\\n\\n// WriteSetupRecord atomically publishes a verified component record.\\nfunc WriteSetupRecord(repository Repository, record SetupRecord) error {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif existing, found, err := ReadSetupRecord(repository); err != nil {\\n\\t\\treturn err\\n\\t} else if found && (existing.CanonicalWorktree != repository.WorktreeRoot || existing.CanonicalGitCommon != repository.GitCommonDir) {\\n\\t\\treturn errors.New(\\\"setup record repository identity mismatch\\\")\\n\\t}\\n\\tif err := ensureRegistryDir(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\trecord.Version = recordVersion\\n\\trecord.CanonicalWorktree = repository.WorktreeRoot\\n\\trecord.CanonicalGitCommon = repository.GitCommonDir\\n\\tdata, err := jsonutil.MarshalIndentWithNewline(record, \\\"\\\", \\\"  \\\")\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"encoding setup record: %w\\\", err)\\n\\t}\\n\\tif err := jsonutil.WriteFileAtomic(setupPath(repository), data, 0o600); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"writing setup record: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\n\\n// RemoveWorktreeRuntime removes only current-worktree runtime and route/setup\\n// records. The activation record is deliberately retained as a tombstone.\\nfunc RemoveWorktreeRuntime(repository Repository) error {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif _, _, err := ReadRuntimeRoute(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif _, _, err := ReadSetupRecord(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tdir := registryDir(repository)\\n\\tfor _, name := range []string{routeFileName, routeFileName + \\\".lock\\\", setupFileName, \\\"metadata\\\", \\\"logs\\\", \\\"tmp\\\"} {\\n\\t\\tif err := os.RemoveAll(filepath.Join(dir, name)); err != nil {\\n\\t\\t\\treturn fmt.Errorf(\\\"removing worktree runtime %s: %w\\\", name, err)\\n\\t\\t}\\n\\t}\\n\\tif err := jsonutil.SyncDir(dir); err != nil && !errors.Is(err, fs.ErrNotExist) {\\n\\t\\treturn fmt.Errorf(\\\"syncing worktree registry: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn true\\n\\t}\\n\\tmatched, err := MatchesExcludePathExact(ctx, global.TrustedPaths, identity.Path)\\n\\treturn err == nil && matched\\n}\\n\\nfunc containsOrigin(entries []string, key string) bool {\\n\\tfor _, entry := range entries {\\n\\t\\tif CanonicalTrustOrigin(entry) == key {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n// CanonicalTrustOrigin normalizes a hand-edited exact trust key.\\nfunc CanonicalTrustOrigin(value string) string {\\n\\treturn strings.ToLower(strings.TrimSpace(value))\\n}\\n\\n// ReadTrustGrantLedger returns the verified machine-local grant history.\\nfunc ReadTrustGrantLedger(repository Repository) (TrustGrantLedger, bool, error) {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn TrustGrantLedger{}, false, err\\n\\t}\\n\\tdata, err := os.ReadFile(trustLedgerPath(repository))\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, fs.ErrNotExist) {\\n\\t\\t\\treturn TrustGrantLedger{}, false, nil\\n\\t\\t}\\n\\t\\treturn TrustGrantLedger{}, false, fmt.Errorf(\\\"reading trust ledger: %w\\\", err)\\n\\t}\\n\\tvar ledger TrustGrantLedger\\n\\tif err := decodeStrict(data, &ledger); err != nil {\\n\\t\\treturn TrustGrantLedger{}, false, fmt.Errorf(\\\"parsing trust ledger: %w\\\", err)\\n\\t}\\n\\tif ledger.Version != recordVersion {\\n\\t\\treturn TrustGrantLedger{}, false, fmt.Errorf(\\\"unsupported trust ledger version %d\\\", ledger.Version)\\n\\t}\\n\\tif ledger.CanonicalWorktree != repository.WorktreeRoot || ledger.CanonicalGitCommon != repository.GitCommonDir {\\n\\t\\treturn TrustGrantLedger{}, false, errors.New(\\\"trust ledger repository identity mismatch\\\")\\n\\t}\\n\\treturn ledger, true, nil\\n}\\n\\n// WriteTrustGrantLedger atomically records CLI-owned consent keys.\\nfunc WriteTrustGrantLedger(repository Repository, ledger TrustGrantLedger) error {\\n\\tif err := validateRepository(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif err := ensureRegistryDir(repository); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tledger.Version = recordVersion\\n\\tledger.CanonicalWorktree = repository.WorktreeRoot\\n\\tledger.CanonicalGitCommon = repository.GitCommonDir\\n\\tdata, err := jsonutil.MarshalIndentWithNewline(ledger, \\\"\\\", \\\"  \\\")\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"encoding trust ledger: %w\\\", err)\\n\\t}\\n\\tif err := jsonutil.WriteFileAtomic(trustLedgerPath(repository), data, 0o600); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"writing trust ledger: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\npackage repopolicy\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"os\\\"\\n\\t\\\"os/exec\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"sync\\\"\\n\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/gitremote\\\"\\n\\t\\\"github.com/entireio/cli/cmd/entire/cli/internal/worktreeid\\\"\\n)\\n\\n// Repository contains the stable repository facts needed by policy.\\ntype Repository struct {\\n\\tWorktreeRoot string\\n\\tGitCommonDir string\\n\\tWorktreeID   string\\n\\tWorktreeKey  string\\n}\\n\\n// RepositoryResolver resolves repository facts lazily after global enablement\\n// and exclusion validation have passed their no-Git fast path.\\ntype RepositoryResolver func(context.Context) (Repository, error)\\n\\n// HashWorktreeID returns the stable namespace key used for a Git worktree.\\nfunc HashWorktreeID(worktreeID string) string {\\n\\treturn worktreeid.Hash(worktreeID)\\n}\\n\\n// ResolveRepository resolves repository facts for the current directory.\\nfunc ResolveRepository(ctx context.Context) (Repository, error) {\\n\\treturn ResolveRepositoryAt(ctx, \\\".\\\")\\n}\\n\\n// ResolveRepositoryAt resolves repository facts without importing the parent\\n// settings or paths packages.\\nfunc ResolveRepositoryAt(ctx context.Context, dir string) (Repository, error) {\\n\\tcmd := exec.CommandContext(ctx, \\\"git\\\", \\\"rev-parse\\\", \\\"--show-toplevel\\\", \\\"--git-common-dir\\\")\\n\\tcmd.Dir = dir\\n\\toutput, err := cmd.Output()\\n\\tif err != nil {\\n\\t\\treturn Repository{}, fmt.Errorf(\\\"resolving repository: %w\\\", err)\\n\\t}\\n\\tlines := strings.Split(strings.TrimSuffix(string(output), \\\"\\\\n\\\"), \\\"\\\\n\\\")\\n\\tif len(lines) != 2 {\\n\\t\\treturn Repository{}, fmt.Errorf(\\\"resolving repository: expected two paths, got %d\\\", len(lines))\\n\\t}\\n\\tbase, err := filepath.Abs(dir)\\n\\tif err != nil {\\n\\t\\treturn Repository{}, fmt.Errorf(\\\"resolving repository base: %w\\\", err)\\n\\t}\\n\\troot := canonicalPath(absolutizeGitPath(base, lines[0]))\\n\\tcommonDir := canonicalPath(absolutizeGitPath(base, lines[1]))\\n\\tworktreeID, err := worktreeid.Get(root)\\n\\tif err != nil {\\n\\t\\treturn Repository{}, fmt.Errorf(\\\"resolving worktree identity: %w\\\", err)\\n\\t}\\n\\treturn Repository{\\n\\t\\tWorktreeRoot: root,\\n\\t\\tGitCommonDir: commonDir,\\n\\t\\tWorktreeID:   worktreeID,\\n\\t\\tWorktreeKey:  HashWorktreeID(worktreeID),\\n\\t}, nil\\n}\\n\\nfunc absolutizeGitPath(base, path string) string {\\n\\tpath = strings.TrimSpace(path)\\n\\tif filepath.IsAbs(path) {\\n\\t\\treturn filepath.Clean(path)\\n\\t}\\n\\treturn filepath.Clean(filepath.Join(base, path))\\n}\\n\\nfunc canonicalPath(path string) string {\\n\\tif resolved, err := filepath.EvalSymlinks(path); err == nil {\\n\\t\\treturn filepath.Clean(resolved)\\n\\t}\\n\\treturn filepath.Clean(path)\\n}\\n\\nfunc inactiveGlobalPolicy(reason InactiveReason) RepoPolicy {\\n\\treturn RepoPolicy{ActivationSource: ActivationInactive, InactiveReason: reason}\\n}\\n\\nfunc policyForRepository(repository Repository) RepoPolicy {\\n\\treturn RepoPolicy{\\n\\t\\tActivationSource: ActivationGlobal,\\n\\t\\tWorktreeRoot:     repository.WorktreeRoot,\\n\\t\\tGitCommonDir:     repository.GitCommonDir,\\n\\t\\tWorktreeKey:      repository.WorktreeKey,\\n\\t}\\n}\\n\\n// ClassifyGlobalConfig evaluates global activation without logging or writes.\\n// Disabled and invalid configurations return before repository resolution.\\nfunc ClassifyGlobalConfig(ctx context.Context, config *GlobalConfig, resolve RepositoryResolver) (RepoPolicy, error) {\\n\\tif config == nil || !config.Enabled {\\n\\t\\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), nil\\n\\t}\\n\\tif problems := validateGlobalExclusions(config); len(problems) > 0 {\\n\\t\\treturn inactiveGlobalPolicy(InactiveReasonGlobalExcluded), errors.New(strings.Join(problems, \\\"; \\\"))\\n\\t}\\n\\tif resolve == nil {\\n\\t\\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), errors.New(\\\"repository resolver is nil\\\")\\n\\t}\\n\\trepository, err := resolve(ctx)\\n\\tif err != nil {\\n\\t\\treturn inactiveGlobalPolicy(InactiveReasonGlobalOff), err\\n\\t}\\n\\tpolicy := policyForRepository(repository)\\n\\n\\texcluded, err := MatchesExcludePath(ctx, config.ExcludePaths, repository.WorktreeRoot)\\n\\tif err != nil {\\n\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\treturn policy, err\\n\\t}\\n\\tif excluded {\\n\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\treturn policy, nil\\n\\t}\\n\\texcluded, err = MatchesExcludePathExact(ctx, config.ExcludePathsExact, repository.WorktreeRoot)\\n\\tif err != nil {\\n\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\treturn policy, err\\n\\t}\\n\\tif excluded {\\n\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\treturn policy, nil\\n\\t}\\n\\tif len(config.ExcludeOrigins) > 0 {\\n\\t\\torigins, found, lookupErr := gitremote.GetRemoteURLsInDirIfSet(ctx, repository.WorktreeRoot, \\\"origin\\\")\\n\\t\\tif lookupErr != nil {\\n\\t\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\t\\treturn policy, fmt.Errorf(\\\"reading origin remote: %w\\\", lookupErr)\\n\\t\\t}\\n\\t\\tif found {\\n\\t\\t\\tfor _, origin := range origins {\\n\\t\\t\\t\\tnormalized := NormalizeOrigin(origin)\\n\\t\\t\\t\\tif normalized == \\\"\\\" {\\n\\t\\t\\t\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\t\\t\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\t\\t\\t\\treturn policy, errors.New(\\\"origin remote cannot be normalized\\\")\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tmatched, matchErr := MatchesExcludeOrigin(ctx, config.ExcludeOrigins, normalized)\\n\\t\\t\\t\\tif matchErr != nil {\\n\\t\\t\\t\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\t\\t\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\t\\t\\t\\treturn policy, matchErr\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tif matched {\\n\\t\\t\\t\\t\\tpolicy.ActivationSource = ActivationInactive\\n\\t\\t\\t\\t\\tpolicy.InactiveReason = InactiveReasonGlobalExcluded\\n\\t\\t\\t\\t\\treturn policy, nil\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tpolicy.Active = true\\n\\tpolicy.InactiveReason = InactiveReasonNone\\n\\treturn policy, nil\\n}\\n\\nvar globalModeCache struct {\\n\\tsync.Mutex\\n\\n\\tkey    string\\n\\tset    bool\\n\\tpolicy RepoPolicy\\n\\terr    error\\n}\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a039b7-b242-7af0-80e0-d29bf9afbbac","create_time":1787676812.383406}}}
