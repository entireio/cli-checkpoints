err := currentPolicy(ctx)\\n+\\treturn err == nil && policy.Active && policy.ActivationSource == repopolicy.ActivationGlobal && !policy.Trust.Allowed\\n+}\\n+\\n+func TrustCurrentRepo(ctx context.Context) (TrustIdentity, error) {\\n+\\trepository, err := repopolicy.ResolveRepository(ctx)\\n+\\tif err != nil {\\n+\\t\\treturn TrustIdentity{}, fmt.Errorf(\\\"resolving repository: %w\\\", err)\\n+\\t}\\n+\\tidentity, err := repopolicy.ResolveTrustIdentity(ctx, repository)\\n+\\tif err != nil {\\n+\\t\\treturn TrustIdentity{}, err\\n+\\t}\\n+\\tledger, _, err := repopolicy.ReadTrustGrantLedger(repository)\\n+\\tif err != nil {\\n+\\t\\treturn TrustIdentity{}, err\\n+\\t}\\n+\\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\\n+\\t\\tif err := requireConfiguredGlobal(us); err != nil {\\n+\\t\\t\\treturn err\\n+\\t\\t}\\n+\\t\\tremoveLedgerOwnedTrust(ctx, us.Global, ledger)\\n+\\t\\tif identity.OriginKeyed() {\\n+\\t\\t\\tfor _, key := range identity.OriginKeys {\\n+\\t\\t\\t\\tif !containsTrustedOrigin(us.Global.TrustedOrigins, key) {\\n+\\t\\t\\t\\t\\tus.Global.TrustedOrigins = append(us.Global.TrustedOrigins, key)\\n+\\t\\t\\t\\t}\\n+\\t\\t\\t\\tif !slices.Contains(ledger.OriginKeys, key) {\\n+\\t\\t\\t\\t\\tledger.OriginKeys = append(ledger.OriginKeys, key)\\n+\\t\\t\\t\\t}\\n+\\t\\t\\t}\\n+\\t\\t} else {\\n+\\t\\t\\tif !anyPathEntryIsRoot(ctx, us.Global.TrustedPaths, identity.Path) {\\n+\\t\\t\\t\\tus.Global.TrustedPaths = append(us.Global.TrustedPaths, identity.Path)\\n+\\t\\t\\t}\\n+\\t\\t\\tif !slices.Contains(ledger.Paths, identity.Path) {\\n+\\t\\t\\t\\tledger.Paths = append(ledger.Paths, identity.Path)\\n+\\t\\t\\t}\\n+\\t\\t}\\n+\\t\\treturn repopolicy.WriteTrustGrantLedger(repository, ledger)\\n+\\t})\\n+\\tif err != nil {\\n+\\t\\treturn TrustIdentity{}, err\\n+\\t}\\n+\\treturn identity, nil\\n+}\\n+\\n+var ErrGlobalModeUnconfigured = errors.New(\\\"global mode is not configured; nothing to trust\\\")\\n+\\n+func requireConfiguredGlobal(us *UserSettings) error {\\n+\\tif us.Global == nil {\\n+\\t\\treturn ErrGlobalModeUnconfigured\\n+\\t}\\n+\\treturn nil\\n+}\\n+\\n+func TrustAllRepos(ctx context.Context) error {\\n+\\treturn ModifyUserSettings(ctx, func(us *UserSettings) error {\\n+\\t\\tif err := requireConfiguredGlobal(us); err != nil {\\n+\\t\\t\\treturn err\\n+\\t\\t}\\n+\\t\\tus.Global.TrustAll = true\\n+\\t\\treturn nil\\n+\\t})\\n+}\\n+\\n+func RevokeCurrentRepo(ctx context.Context) (TrustIdentity, error) {\\n+\\trepository, err := repopolicy.ResolveRepository(ctx)\\n+\\tif err != nil {\\n+\\t\\treturn TrustIdentity{}, fmt.Errorf(\\\"resolving repository: %w\\\", err)\\n+\\t}\\n+\\tidentity, identityErr := repopolicy.ResolveTrustIdentity(ctx, repository)\\n+\\tif identityErr != nil {\\n+\\t\\tidentity = TrustIdentity{Path: repository.WorktreeRoot}\\n+\\t}\\n+\\tledger, _, err := repopolicy.ReadTrustGrantLedger(repository)\\n+\\tif err != nil {\\n+\\t\\treturn TrustIdentity{}, err\\n+\\t}\\n+\\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\\n+\\t\\tif err := requireConfiguredGlobal(us); err != nil {\\n+\\t\\t\\treturn err\\n+\\t\\t}\\n+\\t\\tremoveLedgerOwnedTrust(ctx, us.Global, ledger)\\n+\\t\\tledger.OriginKeys = nil\\n+\\t\\tledger.Paths = nil\\n+\\t\\treturn repopolicy.WriteTrustGrantLedger(repository, ledger)\\n+\\t})\\n+\\tif err != nil {\\n+\\t\\treturn TrustIdentity{}, err\\n+\\t}\\n+\\treturn identity, nil\\n+}\\n+\\n+func removeLedgerOwnedTrust(ctx context.Context, global *GlobalConfig, ledger repopolicy.TrustGrantLedger) {\\n+\\torigins := global.TrustedOrigins[:0]\\n+\\tfor _, entry := range global.TrustedOrigins {\\n+\\t\\tif !slices.Contains(ledger.OriginKeys, repopolicy.CanonicalTrustOrigin(entry)) {\\n+\\t\\t\\torigins = append(origins, entry)\\n+\\t\\t}\\n+\\t}\\n+\\tglobal.TrustedOrigins = origins\\n+\\tpaths := global.TrustedPaths[:0]\\n+\\tfor _, entry := range global.TrustedPaths {\\n+\\t\\towned := false\\n+\\t\\tfor _, recorded := range ledger.Paths {\\n+\\t\\t\\tif pathEntryIsRoot(ctx, entry, recorded) {\\n+\\t\\t\\t\\towned = true\\n+\\t\\t\\t\\tbreak\\n+\\t\\t\\t}\\n+\\t\\t}\\n+\\t\\tif !owned {\\n+\\t\\t\\tpaths = append(paths, entry)\\n+\\t\\t}\\n+\\t}\\n+\\tglobal.TrustedPaths = paths\\n+}\\n+\\n+func containsTrustedOrigin(entries []string, key string) bool {\\n+\\tfor _, entry := range entries {\\n+\\t\\tif repopolicy.CanonicalTrustOrigin(entry) == key {\\n+\\t\\t\\treturn true\\n+\\t\\t}\\n+\\t}\\n+\\treturn false\\n+}\\n+\\n+func pathEntryIsRoot(ctx context.Context, entry, root string) bool {\\n+\\tok, err := matchesExcludePathExact(ctx, []string{entry}, root)\\n+\\treturn err == nil && ok\\n+}\\n+\\n+func anyPathEntryIsRoot(ctx context.Context, entries []string, root string) bool {\\n+\\tfor _, entry := range entries {\\n+\\t\\tif pathEntryIsRoot(ctx, entry, root) {\\n+\\t\\t\\treturn true\\n+\\t\\t}\\n+\\t}\\n+\\treturn false\\n+}\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a0371f-4feb-7263-aacd-7041d40b862c","create_time":1787633510.990362}}}
{"timestamp":"2026-08-25T04:52:15.097Z","ordinal":12927,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a025ce-e754-7631-8467-eaa6035ba0f8","turn_id":"01a0371f-4feb-7263-aacd-7041d40b862c","item":{"type":"FileChange","id":"exec-8b68917c-c6ed-4150-bd28-190b34265a92","changes":{"/Users/peytonmontei/Documents/Documents - Peyton’s MacBook Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier/cmd/entire/cli/settings/trust.go":{"type":"add","content":"package settings\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"slices\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings/repopolicy\"\n)\n\ntype TrustIdentity = repopolicy.TrustIdentity\ntype TrustSource = repopolicy.TrustSource\n\nconst (\n\tTrustSourceNone  = repopolicy.TrustSourceNone\n\tTrustSourceLocal = repopolicy.TrustSourceLocal\n\tTrustSourceAll   = repopolicy.TrustSourceAll\n\tTrustSourceRepo  = repopolicy.TrustSourceRepo\n)\n\nfunc RepoTrustIdentity(ctx context.Context) (TrustIdentity, error) {\n\trepository, err := repopolicy.ResolveRepository(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"resolving repository: %w\", err)\n\t}\n\treturn repopolicy.ResolveTrustIdentity(ctx, repository)\n}\n\nfunc currentPolicy(ctx context.Context) (repopolicy.RepoPolicy, error) {\n\tif policy, ok := repopolicy.RepoPolicyFromContext(ctx); ok {\n\t\treturn policy, nil\n\t}\n\treturn repopolicy.ClassifyRepoPolicy(ctx)\n}\n\nfunc CheckpointEgressAllowed(ctx context.Context) bool {\n\tpolicy, err := currentPolicy(ctx)\n\treturn err == nil && policy.Active && policy.Trust.Allowed\n}\n\nfunc CurrentTrustSource(ctx context.Context) TrustSource {\n\tpolicy, err := currentPolicy(ctx)\n\tif err != nil {\n\t\treturn TrustSourceNone\n\t}\n\treturn policy.Trust.Source\n}\n\nfunc RepoUntrustedEnrolled(ctx context.Context) bool {\n\tpolicy, err := currentPolicy(ctx)\n\treturn err == nil && policy.Active && policy.ActivationSource == repopolicy.ActivationGlobal && !policy.Trust.Allowed\n}\n\nfunc TrustCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\trepository, err := repopolicy.ResolveRepository(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"resolving repository: %w\", err)\n\t}\n\tidentity, err := repopolicy.ResolveTrustIdentity(ctx, repository)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\tledger, _, err := repopolicy.ReadTrustGrantLedger(repository)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tremoveLedgerOwnedTrust(ctx, us.Global, ledger)\n\t\tif identity.OriginKeyed() {\n\t\t\tfor _, key := range identity.OriginKeys {\n\t\t\t\tif !containsTrustedOrigin(us.Global.TrustedOrigins, key) {\n\t\t\t\t\tus.Global.TrustedOrigins = append(us.Global.TrustedOrigins, key)\n\t\t\t\t}\n\t\t\t\tif !slices.Contains(ledger.OriginKeys, key) {\n\t\t\t\t\tledger.OriginKeys = append(ledger.OriginKeys, key)\n\t\t\t\t}\n\t\t\t}\n\t\t} else {\n\t\t\tif !anyPathEntryIsRoot(ctx, us.Global.TrustedPaths, identity.Path) {\n\t\t\t\tus.Global.TrustedPaths = append(us.Global.TrustedPaths, identity.Path)\n\t\t\t}\n\t\t\tif !slices.Contains(ledger.Paths, identity.Path) {\n\t\t\t\tledger.Paths = append(ledger.Paths, identity.Path)\n\t\t\t}\n\t\t}\n\t\treturn repopolicy.WriteTrustGrantLedger(repository, ledger)\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn identity, nil\n}\n\nvar ErrGlobalModeUnconfigured = errors.New(\"global mode is not configured; nothing to trust\")\n\nfunc requireConfiguredGlobal(us *UserSettings) error {\n\tif us.Global == nil {\n\t\treturn ErrGlobalModeUnconfigured\n\t}\n\treturn nil\n}\n\nfunc TrustAllRepos(ctx context.Context) error {\n\treturn ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tus.Global.TrustAll = true\n\t\treturn nil\n\t})\n}\n\nfunc RevokeCurrentRepo(ctx context.Context) (TrustIdentity, error) {\n\trepository, err := repopolicy.ResolveRepository(ctx)\n\tif err != nil {\n\t\treturn TrustIdentity{}, fmt.Errorf(\"resolving repository: %w\", err)\n\t}\n\tidentity, identityErr := repopolicy.ResolveTrustIdentity(ctx, repository)\n\tif identityErr != nil {\n\t\tidentity = TrustIdentity{Path: repository.WorktreeRoot}\n\t}\n\tledger, _, err := repopolicy.ReadTrustGrantLedger(repository)\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\terr = ModifyUserSettings(ctx, func(us *UserSettings) error {\n\t\tif err := requireConfiguredGlobal(us); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tremoveLedgerOwnedTrust(ctx, us.Global, ledger)\n\t\tledger.OriginKeys = nil\n\t\tledger.Paths = nil\n\t\treturn repopolicy.WriteTrustGrantLedger(repository, ledger)\n\t})\n\tif err != nil {\n\t\treturn TrustIdentity{}, err\n\t}\n\treturn identity, nil\n}\n\nfunc removeLedgerOwnedTrust(ctx context.Context, global *GlobalConfig, ledger repopolicy.TrustGrantLedger) {\n\torigins := global.TrustedOrigins[:0]\n\tfor _, entry := range global.TrustedOrigins {\n\t\tif !slices.Contains(ledger.OriginKeys, repopolicy.CanonicalTrustOrigin(entry)) {\n\t\t\torigins = append(origins, entry)\n\t\t}\n\t}\n\tglobal.TrustedOrigins = origins\n\tpaths := global.TrustedPaths[:0]\n\tfor _, entry := range global.TrustedPaths {\n\t\towned := false\n\t\tfor _, recorded := range ledger.Paths {\n\t\t\tif pathEntryIsRoot(ctx, entry, recorded) {\n\t\t\t\towned = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !owned {\n\t\t\tpaths = append(paths, entry)\n\t\t}\n\t}\n\tglobal.TrustedPaths = paths\n}\n\nfunc containsTrustedOrigin(entries []string, key string) bool {\n\tfor _, entry := range entries {\n\t\tif repopolicy.CanonicalTrustOrigin(entry) == key {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc pathEntryIsRoot(ctx context.Context, entry, root string) bool {\n\tok, err := matchesExcludePathExact(ctx, []string{entry}, root)\n\treturn err == nil && ok\n}\n\nfunc anyPathEntryIsRoot(ctx context.Context, entries []string, root string) bool {\n\tfor _, entry := range entries {\n\t\tif pathEntryIsRoot(ctx, entry, root) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/peytonmontei/Documents/Documents - Peyton’s MacBook Pro/entire/devenv/entireio/cli/.worktrees/global-settings-tier/cmd/entire/cli/settings/trust.go\n","stderr":""},"started_at_ms":1787633535031,"completed_at_ms":1787633535097}}
