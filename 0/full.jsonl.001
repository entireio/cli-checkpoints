common-dir>/entire/worktree/<worktree-key>/<sub> for such repos. The\\n60-// worktree key namespaces the shared common dir per worktree (linked\\n61-// worktrees of one clone share the common dir but must not interleave\\n62:// runtime data); it is the same worktree-ID hash shadow branch names use.\\n63-// Explicit repo-level activation pins every path to the worktree,\\n64-// byte-identical to the historical behavior. Settings created by unrelated\\n65-// features do not change routing.\\n66-\\n67-// invisibleRuntimeSubdir is the directory inside the git common dir that\\n68:// holds rerouted runtime data, one <worktree-key> namespace per worktree.\\n69-// It sits next to entire/preferences.json.\\n70-const invisibleRuntimeSubdir = \\\"entire/worktree\\\"\\n71-\\n72:// InvisibleRuntimeDir returns the directory invisible routing resolves\\n73:// runtime data under for the worktree rooted at root, given the repo's\\n74:// git common dir: <commonDir>/entire/worktree/<worktree-key>.\\n75-// Precondition: commonDir must be absolute — the result is joined onto it\\n76-// verbatim, so a relative commonDir would silently produce a cwd-relative\\n77:// runtime dir.\\n78-// The key is HashWorktreeID over the worktree's git identifier (\\\"\\\" for the\\n79-// main worktree), so every worktree of a clone gets its own namespace.\\n80-// This is the single source of truth for the layout — the enable-time\\n81-// migration (setup_global.go, arriving with the enable --global layer) uses\\n82-// it to move only the current worktree's namespace, and\\n83-// InvisibleRuntimeSubdirs enumerates the subtrees below it.\\n84:func InvisibleRuntimeDir(commonDir, root string) (string, error) {\\n85-\\tworktreeID, err := GetWorktreeID(root)\\n86-\\tif err != nil {\\n87-\\t\\treturn \\\"\\\", err\\n--\\n93-// The settings package imports paths, so the constant cannot be shared.\\n94-const settingsLocalFileName = \\\"settings.local.json\\\"\\n95-\\n96:// runtimeDataPrefixes are the .entire subtrees that hold runtime data (as\\n97-// opposed to configuration). Only these are ever rerouted: settings files,\\n98-// .entire/.gitignore, and redactor packs must stay worktree-resolved — the\\n99-// settings files' worktree presence is itself the routing discriminator —\\n--\\n101-// working trees the user deliberately checks out and cds into, so hiding\\n102-// them under .git would defeat their purpose, and a repo with trail\\n103-// worktrees has repo-level setup anyway.\\n104:var runtimeDataPrefixes = []string{EntireMetadataDir, EntireLogsDir, EntireTmpDir}\\n105-\\n106-// InvisibleRuntimeSubdirs returns the subtree names invisible routing places\\n107:// under InvisibleRuntimeDir — the layout's single source of truth, derived\\n108:// from runtimeDataPrefixes (\\\"metadata\\\", \\\"logs\\\", \\\"tmp\\\"). The enable-time\\n109-// migration iterates exactly these when moving a namespace back into the\\n110-// worktree.\\n111-func InvisibleRuntimeSubdirs() []string {\\n112:\\tsubs := make([]string, len(runtimeDataPrefixes))\\n113:\\tfor i, prefix := range runtimeDataPrefixes {\\n114-\\t\\tsubs[i] = strings.TrimPrefix(prefix, EntireDir+\\\"/\\\")\\n115-\\t}\\n116-\\treturn subs\\n117-}\\n118-\\n119:// runtimeDataSubpath reports whether relPath addresses runtime data and, if\\n120-// so, returns its path relative to the .entire directory (slash-separated,\\n121-// e.g. \\\"metadata/<session>/prompt.txt\\\"). It assumes every entry in\\n122:// runtimeDataPrefixes lives directly under EntireDir — the TrimPrefix below\\n123-// strips exactly that one leading component, so a prefix outside .entire (or\\n124-// nested deeper) would produce a wrong subpath rather than fail loudly.\\n125:func runtimeDataSubpath(relPath string) (string, bool) {\\n126-\\trel := filepath.ToSlash(relPath)\\n127:\\tfor _, prefix := range runtimeDataPrefixes {\\n128-\\t\\tif rel == prefix || strings.HasPrefix(rel, prefix+\\\"/\\\") {\\n129-\\t\\t\\treturn strings.TrimPrefix(rel, EntireDir+\\\"/\\\"), true\\n130-\\t\\t}\\n--\\n165-\\tinvisibleMu.Unlock()\\n166-}\\n167-\\n168:// invisibleRuntimeBase returns the absolute directory runtime data resolves\\n169-// under for the repo rooted at root (the caller's already-resolved worktree\\n170:// root). \\\"\\\" with a nil error means runtime data lives in the worktree\\n171-// (repo-level setup present, or global tier off). A non-nil error — carrying\\n172-// ErrUnroutableRuntimePath, or the context's own cancellation — means the\\n173-// global tier owns the repo but the git-side location could not be resolved;\\n--\\n181-\\t\\t// teardown paths may resolve paths under an already-canceled context.\\n182-\\t\\tif invisibleCache.err != nil {\\n183-\\t\\t\\tif ctxErr := ctx.Err(); ctxErr != nil {\\n184:\\t\\t\\t\\treturn \\\"\\\", fmt.Errorf(\\\"resolving runtime base: %w\\\", ctxErr)\\n185-\\t\\t\\t}\\n186-\\t\\t}\\n187-\\t\\treturn invisibleCache.base, invisibleCache.err\\n--\\n199-\\treturn base, err\\n200-}\\n201-\\n202:// computeInvisibleRuntimeBase decides where runtime data lives for the repo\\n203-// rooted at root. Precondition: the process's current working directory is\\n204-// inside that repo — the git-common-dir probe below runs in the cwd, so a\\n205-// mismatched cwd would resolve another repo's common dir.\\n--\\n235-\\t\\t}\\n236-\\t\\treturn \\\"\\\", fmt.Errorf(\\\"%w: resolving git common dir: %w\\\", ErrUnroutableRuntimePath, err)\\n237-\\t}\\n238:\\tbase, err := InvisibleRuntimeDir(commonDir, root)\\n239-\\tif err != nil {\\n240-\\t\\treturn \\\"\\\", fmt.Errorf(\\\"%w: classifying worktree: %w\\\", ErrUnroutableRuntimePath, err)\\n241-\\t}\\n--\\n245-// repoActivationConfigured mirrors settings.RepoActivationConfigured at the\\n246-// path-routing layer. paths cannot import settings because settings imports\\n247-// paths. Only a top-level enabled key records repo-local activation intent;\\n248:// incidental settings files keep runtime data on the invisible git-side\\n249-// route. Unreadable or malformed files are ignored here deliberately: the\\n250-// strict settings gate fails closed, while this lower-level probe must fail\\n251:// toward invisibility and never create worktree runtime data.\\n252-func repoActivationConfigured(ctx context.Context, root string) bool {\\n253-\\tfor _, name := range []string{SettingsFileName, settingsLocalFileName} {\\n254-\\t\\tdata, err := os.ReadFile(filepath.Join(root, EntireDir, name)) //nolint:gosec // entire-join-ok: this read decides whether invisible routing applies; root is the resolved worktree and names are fixed\\n--\\n310-//\\n311-// Divergence from the strict gate is deliberately one-sided: lenient\\n312-// decoding and no exclude lists make this probe a strict superset of the\\n313:// strict gate, so divergence can only route runtime I/O to an empty\\n314-// .git-side location, never produce worktree writes.\\n315-func userGlobalTierEnabled() bool {\\n316-\\tconfigDir, err := userdirs.ResolveConfig()\\n30:// runEnableGlobalMode turns the user-global tracking tier on. It only writes\\n33:func runEnableGlobalMode(ctx context.Context, w io.Writer) error {\\n171:\\t// Same shape as runEnableGlobalMode: probe for the actionable message,\\n348:\\t\\t\\tfmt.Fprintln(w, \\\"  Runtime data migration deferred: routed location could not be resolved — re-run 'entire enable'.\\\")\\n369:\\t\\tlogging.Warn(ctx, \\\"global runtime data migration deferred: worktree migration gate is busy\\\", \\\"error\\\", lockErr)\\n370:\\t\\tfmt.Fprintln(w, \\\"  Runtime data migration deferred: an agent hook is still active — re-run 'entire enable'.\\\")\\n376:\\t\\tlogging.Warn(ctx, \\\"global runtime data migration deferred: active agent session(s) in this worktree\\\", \\\"count\\\", n)\\n377:\\t\\tfmt.Fprintf(w, \\\"  Runtime data migration deferred: %d agent session(s) active in this worktree — re-run 'entire enable' once they finish.\\\\n\\\", n)\\n395:\\t\\t\\t\\tlogging.Warn(ctx, \\\"global runtime data migration: routed namespace cleanup incomplete\\\", \\\"path\\\", plan.source, \\\"error\\\", err)\\n467:// maybeMigrateGlobalRuntimeData is the direct migration/recovery entry point\\n471:func maybeMigrateGlobalRuntimeData(ctx context.Context, w io.Writer) {\\n492:// non-empty. Best-effort by contract — enable never aborts on migration\\n500:\\twarnLog := &migrationWarnLog{}\\n502:\\t\\t// The migration's DESTINATION is deliberately the literal worktree\\n509:\\t\\tm, s, f := moveDirContents(ctx, warnLog, filepath.Join(plan.source, sub), filepath.Join(plan.root, paths.EntireDir, sub)) // entire-join-ok: migration destination, routing-independent by design\\n624:\\tnewPath = filepath.Join(plan.root, paths.EntireDir, rel) // entire-join-ok: migration destination, routing-independent by design\\n625:\\t// A retained source means migration did not establish that the destination\\n644:// migration for one worktree. The lock file is a sibling of the routed\\n656:\\tlockPath := runtimeDir + \\\".migration.lock\\\"\\n658:\\t\\treturn nil, fmt.Errorf(\\\"create migration lock directory: %w\\\", err)\\n662:\\t\\treturn nil, fmt.Errorf(\\\"acquire migration lock: %w\\\", err)\\n670:// zero after a Warn, so the migration proceeds exactly as it would have\\n675:\\t\\tlogging.Warn(ctx, \\\"could not check for active sessions before runtime data migration\\\", \\\"error\\\", err)\\n695:// migrationWarnLimit caps the per-file Warn records one migration emits. The\\n700:const migrationWarnLimit = 5\\n702:// migrationWarnLog is the capped Warn sink shared across one migration's\\n704:type migrationWarnLog struct {\\n709:func (l *migrationWarnLog) warn(ctx context.Context, msg string, args ...any) {\\n710:\\tif l.emitted >= migrationWarnLimit {\\n719:func (l *migrationWarnLog) flush(ctx context.Context) {\\n721:\\t\\tlogging.Warn(ctx, \\\"global runtime data migration: further failures suppressed (counts in the summary line)\\\", \\\"count\\\", l.suppressed)\\n736:func moveDirContents(ctx context.Context, warnLog *migrationWarnLog, src, dst string) (moved, skipped, failed int) {\\n742:\\t\\twarnLog.warn(ctx, \\\"global runtime data migration: source directory unreadable\\\", \\\"path\\\", src, \\\"error\\\", err)\\n757:\\t\\t\\t// post-flip session between two migration attempts — so divergent\\n763:\\t\\t\\t\\twarnLog.warn(ctx, \\\"global runtime data migration: destination exists but could not be compared with source\\\", \\\"path\\\", srcPath, \\\"error\\\", cmpErr)\\n766:\\t\\t\\t\\twarnLog.warn(ctx, \\\"global runtime data migration: destination already exists with different content; source left in place\\\", \\\"path\\\", srcPath)\\n770:\\t\\t\\t\\t\\twarnLog.warn(ctx, \\\"global runtime data migration: identical duplicate source could not be removed\\\", \\\"path\\\", srcPath, \\\"error\\\", rmErr)\\n780:\\t\\t\\twarnLog.warn(ctx, \\\"global runtime data migration: cannot create destination directory\\\", \\\"path\\\", dst, \\\"error\\\", mkErr)\\n788:\\t\\t\\t\\twarnLog.warn(ctx, \\\"global runtime data migration: file copied but source residue remains\\\", \\\"path\\\", srcPath, \\\"error\\\", moveErr)\\n790:\\t\\t\\t\\twarnLog.warn(ctx, \\\"global runtime data migration: file could not be moved\\\", \\\"path\\\", srcPath, \\\"error\\\", moveErr)\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a035c5-5c5e-7ca3-86ab-631a16cc0d4a","create_time":1787608675.634967}}}
