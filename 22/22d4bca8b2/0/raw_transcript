nil {\n835\t\t\treturn 0, err\n836\t\t}\n837\t\treturn sessionIndex, nil\n838\t}\n839\t\n840\t// writeMainCheckpointEntries orchestrates writing session data to the /main ref.\n841\t// It mirrors GitStore.writeStandardCheckpointEntries but excludes raw transcript blobs.\n842\t// Returns the session index used, for coordination with writeCommittedFullTranscript.\n843\tfunc (s *V2GitStore) writeMainCheckpointEntries(ctx context.Context, opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry) (int, error) {\n844\t\t// Read existing summary to get current session count\n845\t\tvar existingSummary *CheckpointSummary\n846\t\tmetadataPath := basePath + paths.MetadataFileName\n847\t\tif entry, exists := entries[metadataPath]; exists {\n848\t\t\texisting, err := readJSONFromBlob[CheckpointSummary](s.repo, entry.Hash)\n849\t\t\tif err == nil {\n850\t\t\t\texistingSummary = existing\n851\t\t\t}\n852\t\t}\n853\t\n854\t\t// Determine session index\n855\t\tsessionIndex := s.gs.findSessionIndex(ctx, basePath, existingSummary, entries, opts.SessionID)\n856\t\n857\t\t// Refuse if slot 0 already holds metadata for a DIFFERENT session ID.\n858\t\t// Mirrors GitStore.writeStandardCheckpointEntries: findSessionIndex only\n859\t\t// picks slot 0 when existingSummary is nil or when the summary claims slot 0\n860\t\t// belongs to us, so the actual tree holding session-0 metadata for someone\n861\t\t// else is a corruption / stale-summary shape. Read BEFORE\n862\t\t// writeMainSessionToSubdirectory clears the subtree, or we'd only ever see\n863\t\t// our own write.\n864\t\tif sessionIndex == 0 {\n865\t\t\tif entry, exists := entries[fmt.Sprintf(\"%s0/%s\", basePath, paths.MetadataFileName)]; exists {\n866\t\t\t\tif existingMeta, readErr := s.gs.readMetadataFromBlob(entry.Hash); readErr == nil && existingMeta.SessionID != opts.SessionID {\n867\t\t\t\t\tlogging.Error(ctx, \"refusing v2 checkpoint write: session 0 holds a different sessionID\",\n868\t\t\t\t\t\tslog.String(\"checkpoint_id\", opts.CheckpointID.String()),\n869\t\t\t\t\t\tslog.String(\"existing_session_id\", existingMeta.SessionID),\n870\t\t\t\t\t\tslog.String(\"write_session_id\", opts.SessionID),\n871\t\t\t\t\t\tslog.Bool(\"existing_summary_nil\", existingSummary == nil))\n872\t\t\t\t\treturn 0, fmt.Errorf(\n873\t\t\t\t\t\t\"refusing to overwrite session 0 of checkpoint %s: existing session ID %q differs from write session ID %q. The v2 checkpoint tree is inconsistent (session 0 belongs to a different session than this write claims). No automated repair exists for this shape — please report it along with the output of `git ls-tree %s %s/`\",\n874\t\t\t\t\t\topts.CheckpointID, existingMeta.SessionID, opts.SessionID, paths.V2MainRefName, opts.CheckpointID.Path(),\n875\t\t\t\t\t)\n876\t\t\t\t}\n877\t\t\t}\n878\t\t}\n879\t\n880\t\t// Write session files (metadata and prompts — no transcript or content hash)\n881\t\tsessionPath := fmt.Sprintf(\"%s%d/\", basePath, sessionIndex)\n882\t\tsessionFilePaths, err := s.writeMainSessionToSubdirectory(opts, sessionPath, entries)\n883\t\tif err != nil {\n884\t\t\treturn 0, err\n885\t\t}\n886\t\n887\t\t// Build the sessions array\n888\t\tvar sessions []SessionFilePaths\n889\t\tif existingSummary != nil {\n890\t\t\tsessions = make([]SessionFilePaths, max(len(existingSummary.Sessions), sessionIndex+1))\n891\t\t\tcopy(sessions, existingSummary.Sessions)\n892\t\t} else {\n893\t\t\tsessions = make([]SessionFilePaths, 1)\n894\t\t}\n895\t\tsessions[sessionIndex] = sessionFilePaths\n896\t\n897\t\t// Write root CheckpointSummary\n898\t\tif err := s.gs.writeCheckpointSummary(opts, basePath, entries, sessions); err != nil {\n899\t\t\treturn 0, err\n900\t\t}\n901\t\treturn sessionIndex, nil\n902\t}\n903\t\n904\t// writeMainSessionToSubdirectory writes a single session's metadata, prompts,\n905\t// and compact transcript to a session subdirectory (0/, 1/, 2/, … indexed by\n906\t// session order within the checkpoint). The raw transcript (raw_t