sessionPath + paths.CompactTranscriptHashFileName\n950\t\t}\n951\t\n952\t\t// Write session metadata\n953\t\tsessionMetadata := CommittedMetadata{\n954\t\t\tCheckpointID:                opts.CheckpointID,\n955\t\t\tSessionID:                   opts.SessionID,\n956\t\t\tStrategy:                    opts.Strategy,\n957\t\t\tCreatedAt:                   checkpointCreatedAt(opts),\n958\t\t\tBranch:                      opts.Branch,\n959\t\t\tCheckpointsCount:            opts.CheckpointsCount,\n960\t\t\tFilesTouched:                opts.FilesTouched,\n961\t\t\tAgent:                       opts.Agent,\n962\t\t\tModel:                       opts.Model,\n963\t\t\tTurnID:                      opts.TurnID,\n964\t\t\tIsTask:                      opts.IsTask,\n965\t\t\tToolUseID:                   opts.ToolUseID,\n966\t\t\tTranscriptIdentifierAtStart: opts.TranscriptIdentifierAtStart,\n967\t\t\tCheckpointTranscriptStart:   opts.CompactTranscriptStart,\n968\t\t\tTokenUsage:                  opts.TokenUsage,\n969\t\t\tSessionMetrics:              opts.SessionMetrics,\n970\t\t\tInitialAttribution:          opts.InitialAttribution,\n971\t\t\tPromptAttributions:          opts.PromptAttributionsJSON,\n972\t\t\tSummary:                     redactSummary(opts.Summary),\n973\t\t\tCLIVersion:                  versioninfo.Version,\n974\t\t\tKind:                        opts.Kind,\n975\t\t\tReviewSkills:                opts.ReviewSkills,\n976\t\t\tReviewPrompt:                opts.ReviewPrompt,\n977\t\t}\n978\t\n979\t\tmetadataJSON, err := jsonutil.MarshalIndentWithNewline(sessionMetadata, \"\", \"  \")\n980\t\tif err != nil {\n981\t\t\treturn filePaths, fmt.Errorf(\"failed to marshal session metadata: %w\", err)\n982\t\t}\n983\t\tmetadataHash, err := CreateBlobFromContent(s.repo, metadataJSON)\n984\t\tif err != nil {\n985\t\t\treturn filePaths, err\n986\t\t}\n987\t\tentries[sessionPath+paths.MetadataFileName] = object.TreeEntry{\n988\t\t\tName: sessionPath + paths.MetadataFileName,\n989\t