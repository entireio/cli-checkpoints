3\t\t}\n234\t\tentries[basePath+paths.MetadataFileName] = object.TreeEntry{\n235\t\t\tName: basePath + paths.MetadataFileName,\n236\t\t\tMode: filemode.Regular,\n237\t\t\tHash: metadataHash,\n238\t\t}\n239\t\treturn nil\n240\t}\n241\t\n242\t// buildMainBatchGroupTree writes every session in one checkpoint group into an\n243\t// isolated checkpoint subtree. WriteCommittedMainBatch splices all returned\n244\t// checkpoint trees into /main in one pass, instead of rewriting the root and\n245\t// shard trees once per checkpoint.\n246\tfunc (s *V2GitStore) buildMainBatchGroupTree(ctx context.Context, rootTreeHash plumbing.Hash, cpID id.CheckpointID, ordinals []int, batch []WriteCommittedOptions, sessionIndexes []int) (plumbing.Hash, error) {\n247\t\tbasePath := cpID.Path() + \"/\"\n248\t\tcheckpointPath := cpID.Path()\n249\t\n250\t\tentries, err := s.gs.flattenCheckpointEntries(rootTreeHash, checkpointPath)\n251\t\tif err != nil {\n252\t\t\treturn plumbing.ZeroHash, err\n253\t\t}\n254\t\n255\t\tvar existingSummary *CheckpointSummary\n256\t\tif entry, exists := entries[basePath+paths.MetadataFileName]; exists {\n257\t\t\tif existing, readErr := readJSONFromBlob[CheckpointSummary](s.repo, entry.Hash); readErr == nil {\n258\t\t\t\texistingSummary = existing\n259\t\t\t}\n260\t\t}\n261\t\n262\t\t// Track the sessions slice as we write so writeCheckpointSummary at the\n263\t\t// end of the group sees a complete picture and findSessionIndex on later\n264\t\t// entries in the group can dedupe against earlier ones.\n265\t\tvar sessions []SessionFilePaths\n266\t\tif existingSummary != nil {\n267\t\t\tsessions = make([]SessionFilePaths, len(existingSummary.Sessions))\n268\t\t\tcopy(sessions, existingSummary.Sessions)\n269\t\t}\n270\t\n271\t\tfor _, ordinal := range ordinals {\n272\t\t\topts := batch[ordinal]\n273\t\n274\t\t\t// findSessionIndex needs a summary whose Sessions length reflects\n275\t\t\t// what we've written so far in this group.\n276\t\t\trunningSummary := existingSummary\n277\t\t\tif len(sessions) > 0 {\n278\t\t\t\trunningSummary = &CheckpointSummary{Sessions: sessions}\n279\t\t\t}\n280\t\t\tsessionIndex := s.gs.findSessionIndex(ctx, basePath, runningSummary, entries, opts.SessionID)\n281\t\n282\t\t\tif sessionIndex == 0 {\n283\t\t\t\tif entry, exists := entries[fmt.Sprintf(\"%s0/%s\", basePath, paths.MetadataFileName)]; exists {\n284\t\t\t\t\tif existingMeta, readErr := s.gs.readMetadataFromBlob(entry.Hash); readErr == nil && existingMeta.SessionID != opts.SessionID {\n285\t\t\t\t\t\tlogging.Error(ctx, \"refusing v2 checkpoint write: session 0 holds a different sessionID\",\n286\t\t\t\t\t\t\tslog.String(\"checkpoint_id\", opts.CheckpointID.String()),\n287\t\t\t\t\t\t\tslog.String(\"existing_session_id\", existingMeta.SessionID),\n288\t\t\t\t\t\t\tslog.String(\"write_session_id\", opts.SessionID),\n289\t\t\t\t\t\t\tslog.Bool(\"existing_summary_nil\", existingSummary == nil))\n290\t\t\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\n291\t\t\t\t\t\t\t\"refusing to overwrite session 0 of checkpoint %s: existing session ID %q differs from write session ID %q. The v2 checkpoint tree is inconsistent (session 0 belongs to a different session than this write claims). No automated repair exists for this shape — please report it along with the output of `git ls-tree %s %s/`\",\n292\t\t\t\t\t\t\topts.CheckpointID, existingMeta.SessionID, opts.SessionID, paths.V2MainRefName, opts.CheckpointID.Path(),\n293\t\t\t\t\t\t)\n294\t\t\t\t\t}\n295\t\t\t\t}\n296\t\t\t}\n297\t\n298\t\t\tsessionPath := fmt.Sprintf(\"%s%d/\", basePath, sessionIndex)\n299\t\t\tfilePaths, err := s.writeMainSessionToSubdirectory(opts, sessionPath, entries)\n300\t\t\tif err != nil {\n301\t\t\t\treturn plumbing.ZeroHash, err\n302\t\t\t}\n303\t\n304\t\t\tif sessionIndex >= len(sessions) {\n305\t\t\t\tgrown := make([]SessionFilePaths, sessionIndex+1)\n306\t\t\t\tcopy(grown, sessions)\n307\t\t\t\tsessions = grown\n308\t\t\t}\n309\t\t\tsessions[sessionIndex] = filePaths\n310\t\t\tsessionIndexes[ordinal] = sessionIndex\n311\t\t}\n312\t\n313\t\t// Last write wins for combinedAttribution / HasReview, matching the\n314\t\t// behavior of N sequential writeCommittedMain calls where each rewrites\n315\t\t// the summary blob.\n316\t\tlastOpts := batch[ordinals[len(ordinals)-1]]\n317\t\tif err := s.gs.writeCheckpointSummary(lastOpts, basePath, entries, sessions); err != nil {\n318\t\t\treturn plumbing.ZeroHash, err\n319\t\t}\n320\t\n321\t\treturn s.buildCheckpointSubtree(ctx, basePath, entries)\n322\t}\n323\t\n324\tfunc (s *V2GitStore) buildCheckpointSubtree(ctx context.Context, basePath string, entries map[string]object.TreeEntry) (plumbing.Hash, error) {\n325\t\trelEntries := make(map[string]object.TreeEntry, len(entries))\n326\t\tfor path, entry := range entries {\n327\t\t\trelPath := strings.TrimPrefix(path, basePath)\n328\t\t\tif relPath == path {\n329\t\t\t\tcontinue\n330\t\t\t}\n331\t\t\trelEntries[relPath] = entry\n332\t\t}\n333\t\n334\t\tcheckpointTreeHash, err := BuildTreeFromEntries(ctx, s.repo, relEntries)\n335\t\tif err != nil {\n336\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to build checkpoint subtree: %w\", err)\n337\t\t}\n338\t\treturn checkpointTreeHash, nil\n339\t}\n340\t\n341\t// UpdateCommitted replaces the prompts and/or transcript for an existing v2\n342\t// checkpoint. Called at stop time to finalize checkpoints with the complete\n343\t// session transcript.\n344\t//\n345\t// On /main: replaces prompts and compact transcript (if provided).\n346\t// On /full/*: replaces the raw transcript where the session artifacts already\n347\t// live, or writes to /full/current if the session has no full artifacts yet.\n348\t//\n349\t// Returns ErrCheckpointNotFound if the checkpoint doesn't exist on /main.\n350\tfunc (s *V2GitStore) UpdateCommitted(ctx context.Context, opts UpdateCommittedOptions) error {\n351\t\tif opts.CheckpointID.IsEmpty() {\n352\t\t\treturn errors.New(\"invalid update options: checkpoint ID is required\")\n353\t\t}\n354\t\n355\t\tsessionIndex, err := s.updateCommittedMain(ctx, opts)\n356\t\tif err != nil {\n357\t\t\treturn fmt.Errorf(\"v2 /main update failed: %w\", err)\n358\t\t}\n359\t\n360\t\tif opts.Transcript.Len() > 0 {\n361\t\t\tif err := s.updateCommittedFullTranscript(ctx, opts, sessionIndex); err != nil {\n362\t\t\t\treturn fmt.Errorf(\"v2 /full/* update failed: %w\", err)\n363\t\t\t}\n364\t\t}\n365\t\n366\t\treturn nil\n367\t}\n368\t\n369\t// fullSessionArtifacts describes where a checkpoint session's raw transcript\n370\t// artifacts live across the v2 /full/* refs.\n371\ttype fullSessionArtifacts struct {\n372\t\tRefName       plumbing.ReferenceName\n373\t\tFound         bool\n374\t\tHasTranscript bool\n375\t\tHasHash       bool\n376\t}\n377\t\n378\t// HasFullSessionArtifacts reports whether the raw transcript and content hash\n379\t// for a checkpoint session exist in any local v2 /full/* ref.\n380\tfunc (s *V2GitStore) HasFullSessionArtifacts(checkpointID id.CheckpointID, sessionIndex int) (bool, error) {\n381\t\tartifacts, err := s.findFullSessionArtifacts(checkpointID, sessionIndex)\n382\t\tif err != nil {\n383\t\t\treturn false, err\n384\t\t}\n385\t\treturn artifacts.Found && artifacts.HasTranscript && artifacts.HasHash, nil\n386\t}\n387\t\n388\tfunc (s *V2GitStore) findFullSessionArtifacts(checkpointID id.CheckpointID, sessionIndex int) (fullSessionArtifacts, error) {\n389\t\trefNames, err := s.fullRefSearchOrder()\n390\t\tif err != nil {\n391\t\t\treturn fullSessionArtifacts{}, err\n392\t\t}\n393\t\n394\t\tvar firstFound fullSessionArtifacts\n395\t\tfor _, refName := range refNames {\n396\t\t\tartifacts, inspectErr := s.inspectFullSessionArtifacts(refName, checkpointID, sessionIndex)\n397\t\t\tif inspectErr != nil {\n398\t\t\t\treturn fullSessionArtifacts{}, inspectErr\n399\t\t\t}\n400\t\t\tif !artifacts.Found {\n401\t\t\t\tcontinue\n402\t\t\t}\n403\t\t\tif artifacts.HasTranscript && artifacts.HasHash {\n404\t\t\t\treturn artifacts, nil\n405\t\t\t}\n406\t\t\tif !firstFound.Found {\n407\t\t\t\tfirstFound = artifacts\n408\t\t\t}\n409\t\t}\n410\t\n411\t\tif firstFound.Found {\n412\t\t\treturn firstFound, nil\n413\t\t}\n414\t\n415\t\treturn fullSessionArtifacts{}, nil\n416\t}\n417\t\n418\t// FullSessionArtifactsIndex answers \"does this session have complete /full/*\n419\t// artifacts?\" with an O(1) map lookup. Build it once via\n420\t// BuildFullSessionArtifactsIndex.\n421\ttype FullSessionArtifactsIndex map[string]struct{}\n422\t\n423\t// Has reports whether the given session has a complete pair of\n424\t// raw_transcript and raw_transcript_hash.txt entries in some /full/* ref.\n425\tfunc (idx FullSessionArtifactsIndex) Has(checkpointID id.CheckpointID, sessionIndex int) bool {\n426\t\tif idx == nil {\n427\t\t\treturn false\n428\t\t}\n429\t\t_, ok := idx[fullArtifactsIndexKey(checkpointID, sessionIndex)]\n430\t\treturn ok\n431\t}\n432\t\n433\tfunc fullArtifactsIndexKey(checkpointID id.CheckpointID, sessionIndex int) string {\n434\t\treturn string(checkpointID) + \"/\" + strconv.Itoa(sessionIndex)\n435\t}\n436\t\n437\t// BuildFullSessionArtifactsIndex walks every /full/* ref's tree once and\n438\t// records sessions whose subtree contains both raw_transcript[/.NNN] and\n439\t// raw_transcript_hash.txt. Amortizes per-session HasFullSessionArtifacts\n440\t// calls — each of which would otherwise list every git ref and re-walk every\n441\t// /full/* tree — across the rest of the run.\n442\tfunc (s *V2GitStore) BuildFullSessionArtifactsIndex() (FullSessionArtifactsIndex, error) {\n443\t\trefNames, err := s.fullRefSearchOrder()\n444\t\tif err != nil {\n445\t\t\treturn nil, err\n446\t\t}\n447\t\n448\t\tindex := make(FullSessionArtifactsIndex)\n449\t\tfor _, refName := range refNames {\n450\t\t\t_, rootTreeHash, refErr := s.GetRefState(refName)\n451\t\t\tif refErr != nil {\n452\t\t\t\tif errors.Is(refErr, plumbing.ErrReferenceNotFound) {\n453\t\t\t\t\tcontinue\n454\t\t\t\t}\n455\t\t\t\treturn nil, fmt.Errorf(\"read %s: %w\", refName, refErr)\n456\t\t\t}\n457\t\t\trootTree, treeErr := s.repo.TreeObject(rootTreeHash)\n458\t\t\tif treeErr != nil {\n459\t\t\t\treturn nil, fmt.Errorf(\"read %s root tree: %w\", refName, treeErr)\n460\t\t\t}\n461\t\t\tkeys, err := s.listFullSessionsInTree(rootTree)\n462\t\t\tif err != nil {\n463\t\t\t\treturn nil, fmt.Errorf(\"walk %s: %w\", refName, err)\n464\t\t\t}\n465\t\t\tfor _, key := range keys {\n466\t\t\t\tindex[key] = struct{}{}\n467\t\t\t}\n468\t\t}\n469\t\treturn index, nil\n470\t}\n471\t\n472\tfunc (s *V2GitStore) listFullSessionsInTree(rootTree *object.Tree) ([]string, error) {\n473\t\tvar keys []string\n474\t\tfor _, shardEntry := range rootTree.Entries {\n475\t\t\tif shardEntry.Mode != filemode.Dir || len(shardEntry.Name) != 2 {\n476\t\t\t\tcontinue\n477\t\t\t}\n478\t\t\tshardTree, err := s.repo.TreeObject(shardEntry.Hash)\n479\t\t\tif err != nil {\n480\t\t\t\treturn nil, fmt.Errorf(\"read shard %s: %w\", shardEntry.Name, err)\n481\t\t\t}\n482\t\t\tfor _, cpEntry := range shardTree.Entries {\n483\t\t\t\tif cpEntry.Mode != filemode.Dir {\n484\t\t\t\t\tcontinue\n485\t\t\t\t}\n486\t\t\t\tcpTree, err := s.repo.TreeObject(cpEntry.Hash)\n487\t\t\t\tif err != nil {\n488\t\t\t\t\treturn nil, fmt.Errorf(\"read checkpoint tree %s/%s: %w\", shardEntry.Name, cpEntry.Name, err)\n489\t\t\t\t}\n490\t\t\t\tcpid := id.CheckpointID(shardEntry.Name + cpEntry.Name)\n491\t\t\t\tfor _, sessionEntry := range cpTree.Entries {\n492\t\t\t\t\tif sessionEntry.Mode != filemode.Dir {\n493\t\t\t\t\t\tcontinue\n494\t\t\t\t\t}\n495\t\t\t\t\tsessionIdx, atoiErr := strconv.Atoi(sessionEntry.Name)\n496\t\t\t\t\tif atoiErr != nil {\n497\t\t\t\t\t\tcontinue\n498\t\t\t\t\t}\n499\t\t\t\t\tsessionTree, err := s.repo.TreeObject(sessionEntry.Hash)\n500\t\t\t\t\tif err != nil {\n501\t\t\t\t\t\treturn nil, fmt.Errorf(\"read session tree %s/%s/%d: %w\", shardEntry.Name, cpEntry.Name, sessionIdx, err)\n502\t\t\t\t\t}\n503\t\t\t\t\tif !sessionHasCompleteFullArtifacts(sessionTree.Entries) {\n504\t\t\t\t\t\tcontinue\n505\t\t\t\t\t}\n506\t\t\t\t\tkeys = append(keys, fullArtifactsIndexKey(cpid, sessionIdx))\n507\t\t\t\t}\n508\t\t\t}\n509\t\t}\n510\t\treturn keys, nil\n511\t}\n512\t\n513\tfunc sessionHasCompleteFullArtifacts(entries []object.TreeEntry) bool {\n514\t\thasTranscript := false\n515\t\thasHash := false\n516\t\tfor _, entry := range entries {\n517\t\t\tswitch {\n518\t\t\tcase entry.Name == paths.V2RawTranscriptFileName,\n519\t\t\t\tstrings.HasPrefix(entry.Name, paths.V2RawTranscriptFileName+\".\"):\n520\t\t\t\thasTranscript = true\n521\t\t\tcase entry.Name == paths.V2RawTranscriptHashFileName:\n522\t\t\t\thasHash = true\n523\t\t\t}\n524\t\t}\n525\t\treturn hasTranscript && hasHash\n526\t}\n527\t\n528\tfunc (s *V2GitStore) fullRefSearchOrder() ([]plumbing.ReferenceName, error) {\n529\t\trefNames := []plumbing.ReferenceName{plumbing.ReferenceName(paths.V2FullCurrentRefName)}\n530\t\n531\t\tarchived, err := s.ListArchivedGenerations()\n532\t\tif err != nil {\n533\t\t\treturn nil, err\n534\t\t}\n535\t\tfor i := len(archived) - 1; i >= 0; i-- {\n536\t\t\trefNames = append(refNames, plumbing.ReferenceName(paths.V2FullRefPrefix+archived[i]))\n537\t\t}\n538\t\n539\t\treturn refNames, nil\n540\t}\n541\t\n542\tfunc (s *V2GitStore) inspectFullSessionArtifacts(refName plumbing.ReferenceName, checkpointID id.CheckpointID, sessionIndex int) (fullSessionArtifacts, error) {\n543\t\t_, rootTreeHash, err := s.GetRefState(refName)\n544\t\tif err != nil {\n545\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n546\t\t\t\treturn fullSessionArtifacts{}, nil\n547\t\t\t}\n548\t\t\treturn fullSessionArtifacts{}, err\n549\t\t}\n550\t\n551\t\trootTree, err := s.repo.TreeObject(rootTreeHash)\n552\t\tif err != nil {\n553\t\t\treturn fullSessionArtifacts{}, fmt.Errorf(\"failed to read %s tree: %w\", refName, err)\n554\t\t}\n555\t\n556\t\tsessionPath := fmt.Sprintf(\"%s/%d\", checkpointID.Path(), sessionIndex)\n557\t\tsessionTree, err := rootTree.Tree(sessionPath)\n558\t\tif err != nil {\n559\t\t\tif errors.Is(err, object.ErrDirectoryNotFound) {\n560\t\t\t\treturn fullSessionArtifacts{}, nil\n561\t\t\t}\n562\t\t\treturn fullSessionArtifacts{}, fmt.Errorf(\"failed to read %s session tree %s: %w\", refName, sessionPath, err)\n563\t\t}\n564\t\n565\t\tartifacts := fullSessionArtifacts{RefName: refName, Found: true}\n566\t\tfor _, entry := range sessionTree.Entries {\n567\t\t\tswitch {\n568\t\t\tcase entry.Name == paths.V2RawTranscriptFileName:\n569\t\t\t\tartifacts.HasTranscript = true\n570\t\t\tcase strings.HasPrefix(entry.Name, paths.V2RawTranscriptFileName+\".\"):\n571\t\t\t\tartifacts.HasTranscript = true\n572\t\t\tcase entry.Name == paths.V2RawTranscriptHashFileName:\n573\t\t\t\tartifacts.HasHash = true\n574\t\t\t}\n575\t\t}\n576\t\n577\t\treturn artifacts, nil\n578\t}\n579\t\n580\t// updateCommittedMain updates prompts and compact transcript on the /main ref for an existing checkpoint.\n581\t// Returns the session index for coordination with /full/current.\n582\tfunc (s *V2GitStore) updateCommittedMain(ctx context.Context, opts UpdateCommittedOptions) (int, error) {\n583\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n584\t\tparentHash, rootTreeHash, err := s.GetRefState(refName)\n585\t\tif err != nil {\n586\t\t\treturn 0, ErrCheckpointNotFound\n587\t\t}\n588\t\n589\t\tbasePath := opts.CheckpointID.Path() + \"/\"\n590\t\tcheckpointPath := opts.CheckpointID.Path()\n591\t\n592\t\tentries, err := s.gs.flattenCheckpointEntries(rootTreeHash, checkpointPath)\n593\t\tif err != nil {\n594\t\t\treturn 0, err\n595\t\t}\n596\t\n597\t\trootMetadataPath := basePath + paths.MetadataFileName\n598\t\tentry, exists := entries[rootMetadataPath]\n599\t\tif !exists {\n600\t\t\treturn 0, ErrCheckpointNotFound\n601\t\t}\n602\t\n603\t\tsummary, err := readJSONFromBlob[CheckpointSummary](s.repo, entry.Hash)\n604\t\tif err != nil {\n605\t\t\treturn 0, fmt.Errorf(\"failed to read checkpoint summary: %w\", err)\n606\t\t}\n607\t\tif len(summary.Sessions) == 0 {\n608\t\t\treturn 0, ErrCheckpointNotFound\n609\t\t}\n610\t\n611\t\t// Find session index by ID, fall back to latest\n612\t\tsessionIndex := s.gs.findSessionIndex(ctx, basePath, summary, entries, opts.SessionID)\n613\t\tif sessionIndex >= len(summary.Sessions) {\n614\t\t\t// findSessionIndex returns next-available when not found; fall back to latest\n615\t\t\tsessionIndex = len(summary.Sessions) - 1\n616\t\t\tlogging.Debug(ctx, \"v2 UpdateCommitted: session ID not found, falling back to latest\",\n617\t\t\t\tslog.String(\"session_id\", opts.SessionID),\n618\t\t\t\tslog.String(\"checkpoint_id\", string(opts.CheckpointID)),\n619\t\t\t\tslog.Int(\"fallback_index\", sessionIndex),\n620\t\t\t)\n621\t\t}\n622\t\n623\t\tsessionPath := fmt.Sprintf(\"%s%d/\", basePath, sessionIndex)\n624\t\n625\t\tif len(opts.Prompts) > 0 {\n626\t\t\tpromptContent := redact.String(JoinPrompts(opts.Prompts))\n627\t\t\tblobHash, err := CreateBlobFromContent(s.repo, []byte(promptContent))\n628\t\t\tif err != nil {\n629\t\t\t\treturn 0, fmt.Errorf(\"failed to create prompt blob: %w\", err)\n630\t\t\t}\n631\t\t\tentries[sessionPath+paths.PromptFileName] = object.TreeEntry{\n632\t\t\t\tName: sessionPath + paths.PromptFileName,\n633\t\t\t\tMode: filemode.Regular,\n634\t\t\t\tHash: blobHash,\n635\t\t\t}\n636\t\t}\n637\t\n638\t\t// Replace compact transcript if provided\n639\t\tif len(opts.CompactTranscript) > 0 {\n640\t\t\tblobHash, err := CreateBlobFromContent(s.repo, opts.CompactTranscript)\n641\t\t\tif err != nil {\n642\t\t\t\treturn 0, fmt.Errorf(\"failed to create compact transcript blob: %w\", err)\n643\t\t\t}\n644\t\t\tentries[sessionPath+paths.CompactTranscriptFileName] = object.TreeEntry{\n645\t\t\t\tName: sessionPath + paths.CompactTranscriptFileName,\n646\t\t\t\tMode: filemode.Regular,\n647\t\t\t\tHash: blobHash,\n648\t\t\t}\n649\t\n650\t\t\tif err := s.writeCompactTranscriptHash(opts.CompactTranscript, sessionPath, entries); err != nil {\n651\t\t\t\treturn 0, fmt.Errorf(\"failed to write compact transcript hash: %w\", err)\n652\t\t\t}\n653\t\n654\t\t\t// Keep root checkpoint summary in sync with compact artifact paths.\n655\t\t\tif sessionIndex >= 0 && sessionIndex < len(summary.Sessions) {\n656\t\t\t\tsummary.Sessions[sessionIndex].Transcript = \"/\" + sessionPath + paths.CompactTranscriptFileName\n657\t\t\t\tsummary.Sessions[sessionIndex].ContentHash = \"/\" + sessionPath + paths.CompactTranscriptHashFileName\n658\t\n659\t\t\t\tsummaryBytes, err := jsonutil.MarshalIndentWithNewline(summary, \"\", \"  \")\n660\t\t\t\tif err != nil {\n661\t\t\t\t\treturn 0, fmt.Errorf(\"failed to marshal checkpoint summary: %w\", err)\n662\t\t\t\t}\n663\t\t\t\tsummaryHash, err := CreateBlobFromContent(s.repo, summaryBytes)\n664\t\t\t\tif err != nil {\n665\t\t\t\t\treturn 0, fmt.Errorf(\"failed to create checkpoint summary blob: %w\", err)\n666\t\t\t\t}\n667\t\t\t\tentries[rootMetadataPath] = object.TreeEntry{\n668\t\t\t\t\tName: rootMetadataPath,\n669\t\t\t\t\tMode: filemode.Regular,\n670\t\t\t\t\tHash: summaryHash,\n671\t\t\t\t}\n672\t\t\t}\n673\t\t}\n674\t\n675\t\tnewTreeHash, err := s.gs.spliceCheckpointSubtree(ctx, rootTreeHash, opts.CheckpointID, basePath, entries)\n676\t\tif err != nil {\n677\t\t\treturn 0, err\n678\t\t}\n679\t\n680\t\tauthorName, authorEmail := GetGitAuthorFromRepo(s.repo)\n681\t\tcommitMsg := fmt.Sprintf(\"Finalize checkpoint: %s\\n\", opts.CheckpointID)\n682\t\tif err := s.updateRef(ctx, refName, newTreeHash, parentHash, commitMsg, authorName, authorEmail); err != nil {\n683\t\t\treturn 0, err\n684\t\t}\n685\t\n686\t\treturn sessionIndex, nil\n687\t}\n688\t\n689\t// updateCommittedFullTranscript replaces the transcript for a specific checkpoint\n690\t// on the /full/* ref where that checkpoint session already lives, while\n691\t// preserving other checkpoints' transcripts in the tree. If the session has no\n692\t// full-transcript artifacts yet, it writes to /full/current.\n693\tfunc (s *V2GitStore) updateCommittedFullTranscript(ctx context.Context, opts UpdateCommittedOptions, sessionIndex int) error {\n694\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n695\t\n696\t\texisting, findErr := s.findFullSessionArtifacts(opts.CheckpointID, sessionIndex)\n697\t\tif findErr != nil {\n698\t\t\treturn findErr\n699\t\t}\n700\t\tif existing.Found {\n701\t\t\trefName = existing.RefName\n702\t\t}\n703\t\n704\t\tif refName == plumbing.ReferenceName(paths.V2FullCurrentRefName) {\n705\t\t\tif err := s.ensureRef(ctx, refName); err != nil {\n706\t\t\t\treturn fmt.Errorf(\"failed to ensure /full/current ref: %w\", err)\n707\t\t\t}\n708\t\t}\n709\t\n710\t\tparentHash, rootTreeHash, err := s.GetRefState(refName)\n711\t\tif err != nil {\n712\t\t\treturn err\n713\t\t}\n714\t\n715\t\tbasePath := opts.CheckpointID.Path() + \"/\"\n716\t\tcheckpointPath := opts.CheckpointID.Path()\n717\t\tsessionPath := fmt.Sprintf(\"%s%d/\", basePath, sessionIndex)\n718\t\n719\t\t// Read existing entries and replace transcript for this checkpoint only\n720\t\tentries, err := s.gs.flattenCheckpointEntries(rootTreeHash, checkpointPath)\n721\t\tif err != nil {\n722\t\t\treturn err\n723\t\t}\n724\t\n725\t\t// Ignore precompute if invariants are violated — fall back to fresh chunking.\n726\t\tprecomputed := opts.PrecomputedBlobs\n727\t\tif precomputed != nil && !precomputed.isUsable() {\n728\t\t\tprecomputed = nil\n729\t\t}\n730\t\n731\t\t// Short-circuit: if the existing raw_transcript_hash.txt already matches\n732\t\t// the new transcript's sha256, the existing chunk entries represent the\n733\t\t// same content — preserve them and skip chunking + zlib.\n734\t\trawTranscriptPath := sessionPath + paths.V2RawTranscriptFileName\n735\t\trawHashPath := sessionPath + paths.V2RawTranscriptHashFileName\n736\t\tvar newContentHash string\n737\t\tif precomputed != nil {\n738\t\t\tnewContentHash = precomputed.ContentHash\n739\t\t} else {\n740\t\t\tnewContentHash = fmt.Sprintf(\"sha256:%x\", sha256.Sum256(opts.Transcript.