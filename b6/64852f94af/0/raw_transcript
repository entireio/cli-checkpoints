= range strings.SplitSeq(strings.TrimSpace(string(output)), \"\\n\") {\n242\t\t\tif line == \"\" {\n243\t\t\t\tcontinue\n244\t\t\t}\n245\t\t\tparts := strings.Fields(line)\n246\t\t\tif len(parts) < 2 || parts[1] != refName.String() {\n247\t\t\t\tcontinue\n248\t\t\t}\n249\t\t\tif len(parts[0]) != 40 {\n250\t\t\t\treturn plumbing.ZeroHash, false, fmt.Errorf(\"invalid remote hash %q for %s\", parts[0], refName)\n251\t\t\t}\n252\t\t\treturn plumbing.NewHash(parts[0]), true, nil\n253\t\t}\n254\t\treturn plumbing.ZeroHash, false, nil\n255\t}\n256\t\n257\tfunc refSpecsForRefs(refs []plumbing.ReferenceName) []string {\n258\t\trefSpecs := make([]string, 0, len(refs))\n259\t\tfor _, refName := range refs {\n260\t\t\trefSpecs = append(refSpecs, fmt.Sprintf(\"%s:%s\", refName, refName))\n261\t\t}\n262\t\treturn refSpecs\n263\t}\n264\t\n265\tfunc parsePushRefResults(ctx context.Context, output string, refs []plumbing.ReferenceName, pushErr error) []v2RefPushResult {\n266\t\tparsed := make(map[plumbing.ReferenceName]v2RefPushResult, len(refs))\n267\t\tfor line := range strings.SplitSeq(output, \"\\n\") {\n268\t\t\tresult, ok := parsePushRefStatusLine(line)\n269\t\t\tif ok {\n270\t\t\t\tparsed[result.refName] = result\n271\t\t\t}\n272\t\t}\n273\t\n274\t\tvar fallbackErr error\n275\t\tif pushErr != nil {\n276\t\t\tfallbackErr = classifyPushFailure(ctx, output, pushErr)\n277\t\t\tif len(parsed) > 0 && len(parsed) < len(refs) {\n278\t\t\t\tlogging.Debug(ctx, \"push-v2: incomplete push porcelain output\",\n279\t\t\t\t\tslog.Int(\"parsed_refs\", len(parsed)),\n280\t\t\t\t\tslog.Int(\"expected_refs\", len(refs)),\n281\t\t\t\t\tslog.String(\"error\", pushErr.Error()),\n282\t\t\t\t\tslog.String(\"output\", output),\n283\t\t\t\t)\n284\t\t\t}\n285\t\t}\n286\t\n287\t\tresults := make([]v2RefPushResult, 0, len(refs))\n288\t\tfor _, refName := range refs {\n289\t\t\tif result, ok := parsed[refName]; ok {\n290\t\t\t\tresults = append(results, result)\n291\t\t\t\tcontinue\n292\t\t\t}\n293\t\t\tif pushErr != nil && len(parsed) > 0 {\n294\t\t\t\tresults = append(results, v2RefPushResult{\n295\t\t\t\t\trefName: refName,\n296\t\t\t\t\terr:     fmt.Errorf(\"status missing for %s\", shortRefName(refName)),\n297\t\t\t\t})\n298\t\t\t\tcontinue\n299\t\t\t}\n300\t\t\terr := fallbackErr\n301\t\t\tif err != nil {\n302\t\t\t\terr = fmt.Errorf(\"failed to push %s: %w\", shortRefName(refName), err)\n303\t\t\t}\n304\t\t\tresults = append(results, v2RefPushResult{\n305\t\t\t\trefName: refName,\n306\t\t\t\terr:     err,\n307\t\t\t})\n308\t\t}\n309\t\treturn results\n310\t}\n311\t\n312\tfunc parsePushRefStatusLine(line string) (v2RefPushResult, bool) {\n313\t\tfields := strings.Split(line, \"\\t\")\n314\t\tif len(fields) < 2 || fields[0] == \"\" {\n315\t\t\treturn v2RefPushResult{}, false\n316\t\t}\n317\t\n318\t\trefName, ok := pushStatusRef(fields[1])\n319\t\tif !ok {\n320\t\t\treturn v2RefPushResult{}, false\n321\t\t}\n322\t\n323\t\tswitch fields[0][0] {\n324\t\tcase '!':\n325\t\t\terr := classifyPushOutput(strings.Join(fields[2:], \"\\t\"))\n326\t\t\treturn v2RefPushResult{\n327\t\t\t\trefName: refName,\n328\t\t\t\terr:     fmt.Errorf(\"failed to push %s: %w\", shortRefName(refName), err),\n329\t\t\t}, true\n330\t\tcase '=':\n331\t\t\treturn v2RefPushResult{\n332\t\t\t\trefName: refName,\n333\t\t\t\tresult:  pushResult{upToDate: true},\n334\t\t\t}, true\n335\t\tdefault:\n336\t\t\treturn v2RefPushResult{refName: refName}, true\n337\t\t}\n338\t}\n339\t\n340\tfunc pushStatusRef(statusRef string) (plumbing.ReferenceName, bool) {\n341\t\t_, dst, ok := strings.Cut(statusRef, \":\")\n342\t\tif !ok || dst == \"\" {\n343\t\t\treturn \"\", false\n344\t\t}\n345\t\treturn plumbing.ReferenceName(dst), true\n346\t}\n347\t\n348\t// fetchAndMergeRef fetches a remote custom ref and merges it into the local ref.\n349\t// Uses the same tree-flattening merge as v1 (sharded paths are unique, so no conflicts).\n350\t//\n351\t// For /full/current: if the remote has archived generations not present locally,\n352\t// another machine rotated. In that case, local data is merged into the latest\n353\t// archived generation instead of into /full/current (see handleRotationConflict).\n354\tfunc fetchAndMergeRef(ctx context.Context, target string, refName plumbing.ReferenceName) error {\n355\t\tctx, cancel := context.WithTimeout(ctx, 2*time.Minute)\n356\t\tdefer cancel()\n357\t\n358\t\tfetchTarget, err := remote.ResolveFetchTarget(ctx, target)\n359\t\tif err != nil {\n360\t\t\treturn fmt.Errorf(\"resolve fetch target: %w\", err)\n361\t\t}\n362\t\n363\t\t// Fetch to a temp ref\n364\t\ttmpRefSuffix := strings.ReplaceAll(string(refName), \"/\", \"-\")\n365\t\ttmpRefName := plumbing.ReferenceName(\"refs/entire-fetch-tmp/\" + tmpRefSuffix)\n366\t\trefSpec := fmt.Sprintf(\"+%s:%s\", refName, tmpRefName)\n367\t\n368\t\tif output, err := remote.Fetch(ctx, remote.FetchOptions{\n369\t\t\tRemote:    fetchTarget,\n370\t\t\tRefSpecs:  []string{refSpec},\n371\t\t\tNoTags:    true,\n372\t\t\tExtraArgs: []string{\"--no-write-fetch-head\"},\n373\t\t}); err != nil {\n374\t\t\treturn fmt.Errorf(\"fetch failed: %s\", output)\n375\t\t}\n376\t\n377\t\trepo, err := OpenRepository(ctx)\n378\t\tif err != nil {\n379\t\t\treturn fmt.Errorf(\"failed to open repository: %w\", err)\n380\t\t}\n381\t\tdefer func() {\n382\t\t\t_ = repo.Storer.RemoveReference(tmpRefName) //nolint:errcheck // cleanup is best-effort\n383\t\t}()\n384\t\n385\t\t// Check for rotation conflict on /full/current\n386\t\tif refName == plumbing.ReferenceName(paths.V2FullCurrentRefName) {\n387\t\t\tremoteRotationArchives, detectErr := detectRemoteRotationArchives(ctx, target, repo)\n388\t\t\tif detectErr == nil && len(remoteRotationArchives) > 0 {\n389\t\t\t\treturn handleRotationConflict(ctx, target, fetchTarget, repo, refName, tmpRefName, remoteRotationArchives)\n390\t\t\t}\n391\t\t}\n392\t\n393\t\t// Standard tree merge (no rotation detected)\n394\t\tlocalRef, err := repo.Reference(refName, true)\n395\t\tif err != nil {\n396\t\t\treturn fmt.Errorf(\"failed to get local ref: %w\", err)\n397\t\t}\n398\t\tlocalCommit, err := repo.CommitObject(localRef.Hash())\n399\t\tif err != nil {\n400\t\t\treturn fmt.Errorf(\"failed to get local commit: %w\", err)\n401\t\t}\n402\t\tlocalTree, err := localCommit.Tree()\n403\t\tif err != nil {\n404\t\t\treturn fmt.Errorf(\"failed to get local tree: %w\", err)\n405\t\t}\n406\t\n407\t\tremoteRef, err := repo.Reference(tmpRefName, true)\n408\t\tif err != nil {\n409\t\t\treturn fmt.Errorf(\"failed to get remote ref: %w\", err)\n410\t\t}\n411\t\tremoteCommit, err := repo.CommitObject(remoteRef.Hash())\n412\t\tif err != nil {\n413\t\t\treturn fmt.Errorf(\"failed to get remote commit: %w\", err)\n414\t\t}\n415\t\tremoteTree, err := remoteCommit.Tree()\n416\t\tif err != nil {\n417\t\t\treturn fmt.Errorf(\"failed to get remote tree: %w\", err)\n418\t\t}\n419\t\n420\t\tentries := make(map[string]object.TreeEntry)\n421\t\tif err := checkpoint.FlattenTree(repo, localTree, \"\", entries); err != nil {\n422\t\t\treturn fmt.Errorf(\"failed to flatten local tree: %w\", err)\n423\t\t}\n424\t\tif err := checkpoint.FlattenTree(repo, remoteTree, \"\", entries); err != nil {\n425\t\t\treturn fmt.Errorf(\"failed to flatten remote tree: %w\", err)\n426\t\t}\n427\t\n428\t\tmergedTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, entries)\n429\t\tif err != nil {\n430\t\t\treturn fmt.Errorf(\"failed to build merged tree: %w\", err)\n431\t\t}\n432\t\n433\t\tmergeCommitHash, err := createMergeCommitCommon(ctx, repo, mergedTreeHash,\n434\t\t\t[]plumbing.Hash{localRef.Hash(), remoteRef.Hash()},\n435\t\t\t\"Merge remote \"+shortRefName(refName))\n436\t\tif err != nil {\n437\t\t\treturn fmt.Errorf(\"failed to create merge commit: %w\", err)\n438\t\t}\n439\t\n440\t\tnewRef := plumbing.NewHashReference(refName, mergeCommitHash)\n441\t\tif err := repo.Storer.SetReference(newRef); err != nil {\n442\t\t\treturn fmt.Errorf(\"failed to update ref: %w\", err)\n443\t\t}\n444\t\n445\t\treturn nil\n446\t}\n447\t\n448\t// detectRemoteRotationArchives discovers archived generation refs on the remote\n449\t// that are missing locally or whose local ref hash differs from the remote ref\n450\t// hash. Returns them sorted ascending (oldest first).\n451\tfunc detectRemoteRotationArchives(ctx context.Context, target string, repo *git.Repository) ([]string, error) {\n452\t\tctx, cancel := context.WithTimeout(ctx, 30*time.Second)\n453\t\tdefer cancel()\n454\t\n455\t\toutput, err := remote.LsRemote(ctx, target, paths.V2FullRefPrefix+\"*\")\n456\t\tif err != nil {\n457\t\t\treturn nil, fmt.Errorf(\"ls-remote failed: %w\", err)\n458\t\t}\n459\t\n460\t\tvar remoteRotationArchives []string\n461\t\tfor line := range strings.SplitSeq(strings.TrimSpace(string(output)), \"\\n\") {\n462\t\t\tif line == \"\" {\n463\t\t\t\tcontinue\n464\t\t\t}\n465\t\t\tparts := strings.Fields(line)\n466\t\t\tif len(parts) < 2 {\n467\t\t\t\tcontinue\n468\t\t\t}\n469\t\t\trefName := parts[1]\n470\t\t\tsuffix := strings.TrimPrefix(refName, paths.V2FullRefPrefix)\n471\t\t\tif suffix == \"current\" || !checkpoint.GenerationRefPattern.MatchString(suffix) {\n472\t\t\t\tcontinue\n473\t\t\t}\n474\t\t\tif len(parts[0]) != 40 {\n475\t\t\t\treturn nil, fmt.Errorf(\"invalid remote archive hash %q for %s\", parts[0], refName)\n476\t\t\t}\n477\t\t\tremoteHash := plumbing.NewHash(parts[0])\n478\t\t\tlocalRef, err := repo.Reference(plumbing.ReferenceName(refName), true)\n479\t\t\tif err != nil || localRef.Hash() != remoteHash {\n480\t\t\t\tremoteRotationArchives = append(remoteRotationArchives, suffix)\n481\t\t\t}\n482\t\t}\n483\t\n484\t\tsort.Strings(remoteRotationArchives)\n485\t\treturn remoteRotationArchives, nil\n486\t}\n487\t\n488\ttype fetchedRemoteRotationArchive struct {\n489\t\trefName    plumbing.ReferenceName\n490\t\ttmpRefName plumbing.ReferenceName\n491\t\tref        *plumbing.Reference\n492\t\ttree       *object.Tree\n493\t}\n494\t\n495\tfunc readFetchedRemoteRotationArchive(repo *git.Repository, archive string) (fetchedRemoteRotationArchive, error) {\n496\t\tarchiveRefName := plumbing.ReferenceName(paths.V2FullRefPrefix + archive)\n497\t\tarchiveTmpRef := plumbing.ReferenceName(\"refs/entire-fetch-tmp/archive-\" + archive)\n498\t\tarchiveRef, err := repo.Reference(archiveTmpRef, true)\n499\t\tif err != nil {\n500\t\t\treturn fetchedRemoteRotationArchive{}, fmt.Errorf(\"failed to get archived ref: %w\", err)\n501\t\t}\n502\t\tarchiveCommit, err := repo.CommitObject(archiveRef.Hash())\n503\t\tif err != nil {\n504\t\t\treturn fetchedRemoteRotationArchive{}, fmt.Errorf(\"failed to get archive commit: %w\", err)\n505\t\t}\n506\t\tarchiveTree, err := archiveCommit.Tree()\n507\t\tif err != nil {\n508\t\t\treturn fetchedRemoteRotationArchive{}, fmt.Errorf(\"failed to get archive tree: %w\", err)\n509\t\t}\n510\t\n511\t\treturn fetchedRemoteRotationArchive{\n512\t\t\trefName:    archiveRefName,\n513\t\t\ttmpRefName: archiveTmpRef,\n514\t\t\tref:        archiveRef,\n515\t\t\ttree:       archiveTree,\n516\t\t}, nil\n517\t}\n518\t\n519\tfunc fetchRelatedRemoteRotationArchive(ctx context.Context, fetchTarget string, repo *git.Repository, archives []string, localCurrentHash plumbing.Hash) (fetchedRemoteRotationArchive, error) {\n520\t\trefSpecs := make([]string, 0, len(archives))\n521\t\tfor _, archive := range archives {\n522\t\t\tarchiveRefName := plumbing.ReferenceName(paths.V2FullRefPrefix + archive)\n523\t\t\tarchiveTmpRef := plumbing.ReferenceName(\"refs/entire-fetch-tmp/archive-\" + archive)\n524\t\t\trefSpecs = append(refSpecs, fmt.Sprintf(\"+%s:%s\", archiveRefName, archiveTmpRef))\n525\t\t}\n526\t\tif output, fetchErr := remote.Fetch(ctx, remote.FetchOptions{\n527\t\t\tRemote:    fetchTarget,\n528\t\t\tRefSpecs:  refSpecs,\n529\t\t\tNoTags:    true,\n530\t\t\tExtraArgs: []string{\"--no-write-fetch-head\"},\n531\t\t}); fetchErr != nil {\n532\t\t\treturn fetchedRemoteRotationArchive{}, fmt.Errorf(\"fetch archived generations failed: %s\", output)\n533\t\t}\n534\t\n535\t\tlocalCurrentAncestors, ok := currentGenerationAncestors(ctx, repo, localCurrentHash)\n536\t\tif !ok {\n537\t\t\treturn fetchedRemoteRotationArchive{}, errors.New(\"failed to read local /full/current history\")\n538\t\t}\n539\t\tfor _, archive := range archives {\n540\t\t\tfetched, err := readFetchedRemoteRotationArchive(repo, archive)\n541\t\t\tif err != nil {\n542\t\t\t\treturn fetchedRemoteRotationArchive{}, err\n543\t\t\t}\n544\t\t\tif archiveSharesHistoryWithCurrentGeneration(ctx, repo, localCurrentAncestors, fetched.ref.Hash()) {\n545\t\t\t\treturn fetched, nil\n546\t\t\t}\n547\t\t\t_ = repo.Storer.RemoveReference(fetched.tmpRefName) //nolint:errcheck // cleanup is best-effort\n548\t\t}\n549\t\treturn fetchedRemoteRotationArchive{}, errors.New(\"no remote archive shares history with local /full/current\")\n550\t}\n551\t\n552\tfunc currentGenerationAncestors(ctx context.Context, repo *git.Repository, currentHash plumbing.Hash) (map[plumbing.Hash]struct{}, bool) {\n553\t\tancestors := make(map[plumbing.Hash]struct{})\n554\t\titer, err := repo.Log(&git.LogOptions{From: currentHash})\n555\t\tif err != nil {\n556\t\t\treturn nil, false\n557\t\t}\n558\t\tdefer iter.Close()\n559\t\n560\t\tcount := 0\n561\t\t_ = iter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort search, errors are non-fatal\n562\t\t\tif err := ctx.Err(); err != nil {\n563\t\t\t\treturn err //nolint:wrapcheck // Propagating context cancellation\n564\t\t\t}\n565\t\t\tcount++\n566\t\t\tif count > MaxCommitTraversalDepth {\n567\t\t\t\treturn errStop\n568\t\t\t}\n569\t\t\tancestors[c.Hash] = struct{}{}\n570\t\t\treturn nil\n571\t\t})\n572\t\treturn ancestors, true\n573\t}\n574\t\n575\tfunc archiveSharesHistoryWithCurrentGeneration(ctx context.Context, repo *git.Repository, currentAncestors map[plumbing.Hash]struct{}, archiveHash plumbing.Hash) bool {\n576\t\tif _, ok := currentAncestors[archiveHash]; ok {\n577\t\t\treturn true\n578\t\t}\n579\t\n580\t\titer, err := repo.Log(&git.LogOptions{From: archiveHash})\n581\t\tif err != nil {\n582\t\t\treturn false\n583\t\t}\n584\t\tdefer iter.Close()\n585\t\n586\t\tfound := false\n587\t\tcount := 0\n588\t\t_ = iter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort search, errors are non-fatal\n589\t\t\tif err := ctx.Err(); err != nil {\n590\t\t\t\treturn err //nolint:wrapcheck // Propagating context cancellation\n591\t\t\t}\n592\t\t\tcount++\n593\t\t\tif count > MaxCommitTraversalDepth {\n594\t\t\t\treturn errStop\n595\t\t\t}\n596\t\t\tif _, ok := currentAncestors[c.Hash]; ok {\n597\t\t\t\tfound = true\n598\t\t\t\treturn errStop\n599\t\t\t}\n600\t\t\treturn nil\n601\t\t})\n602\t\treturn found\n603\t}\n604\t\n605\t// handleRotationConflict handles the case where remote /full/current was rotated.\n606\t// Merges local /full/current into the related remote archived generation to avoid\n607\t// duplicating checkpoint data, then adopts remote's /full/current as local.\n608\tfunc handleRotationConflict(ctx context.Context, target, fetchTarget string, repo *git.Repository, refName, tmpRefName plumbing.ReferenceName, remoteRotationArchives []string) error {\n609\t\t// Get local /full/current state before selecting an archive. If the remote\n610\t\t// rotated multiple times, the latest archive may belong to a different\n611\t\t// generation chain.\n612\t\tlocalRef, err := repo.Reference(refName, true)\n613\t\tif err != nil {\n614\t\t\treturn fmt.Errorf(\"failed to get local ref: %w\", err)\n615\t\t}\n616\t\tlocalCommit, err := repo.CommitObject(localRef.Hash())\n617\t\tif err != nil {\n618\t\t\treturn fmt.Errorf(\"failed to get local commit: %w\", err)\n619\t\t}\n620\t\tlocalTree, err := localCommit.Tree()\n621\t\tif err != nil {\n622\t\t\treturn fmt.Errorf(\"failed to get local tree: %w\", err)\n623\t\t}\n624\t\n625\t\tarchive, err := fetchRelatedRemoteRotationArchive(ctx, fetchTarget, repo, remoteRotationArchives, localRef.Hash())\n626\t\tif err != nil {\n627\t\t\t