se, fmt.Errorf(\"failed to read generation tree: %w\", err)\n181\t\t}\n182\t\n183\t\tvar gen GenerationMetadata\n184\t\tfound := false\n185\t\tmissingCheckpointTimestamp := false\n186\t\terr = WalkCheckpointShards(s.repo, rootTree, func(cpID id.CheckpointID, cpTreeHash plumbing.Hash) error {\n187\t\t\tif mainTree != nil {\n188\t\t\t\tif cpGen, ok := s.checkpointTimestampRangeFromMain(mainTree, cpID); ok {\n189\t\t\t\t\tmergeGenerationRange(&gen, &found, cpGen)\n190\t\t\t\t\treturn nil\n191\t\t\t\t}\n192\t\t\t}\n193\t\n194\t\t\tcpTree, treeErr := s.repo.TreeObject(cpTreeHash)\n195\t\t\tif treeErr != nil {\n196\t\t\t\tmissingCheckpointTimestamp = true\n197\t\t\t\treturn nil //nolint:nilerr // Skip unreadable checkpoint trees and fall back to generation.json.\n198\t\t\t}\n199\t\t\tif cpGen, ok := checkpointTimestampRangeFromFullTree(cpTree); ok {\n200\t\t\t\tmergeGenerationRange(&gen, &found, cpGen)\n201\t\t\t\treturn nil\n202\t\t\t}\n203\t\t\tmissingCheckpointTimestamp = true\n204\t\t\treturn nil\n205\t\t})\n206\t\tif err != nil {\n207\t\t\treturn GenerationMetadata{}, false, err\n208\t\t}\n209\t\tif missingCheckpointTimestamp {\n210\t\t\treturn GenerationMetadata{}, false, nil\n211\t\t}\n212\t\n213\t\treturn gen, found, nil\n214\t}\n215\t\n216\t// computeGenerationTimestamps derives timestamps for a generation being archived.\n217\t// It uses checkpoint metadata/transcript timestamps rather than git commit times\n218\t// so migration and ref-repair commits don't reset retention age.\n219\tfunc (s *V2GitStore) computeGenerationTimestamps(rootTreeHash plumbing.Hash) GenerationMetadata {\n220\t\tif gen, ok, err := s.ComputeGenerationCheckpointTimestamps(rootTreeHash); err == nil && ok {\n221\t\t\treturn gen\n222\t\t}\n223\t\treturn s.computeGenerationTimestampsFromCommitHistory()\n224\t}\n225\t\n226\tfunc (s *V2GitStore) computeGenerationTimestampsFromCommitHistory() GenerationMetadata {\n227\t\tnow := time.Now().UTC()\n228\t\tfallback := GenerationMetadata{OldestCheckpointAt: now, NewestCheckpointAt: now}\n229\t\n230\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n231\t\tref, err := s.repo.Reference(refName, true)\n232\t\tif err != nil {\n233\t\t\treturn fallback\n234\t\t}\n235\t\n236\t\tcommit, err := s.repo.CommitObject(ref.Hash())\n237\t\tif err != nil {\n238\t\t\treturn fallback\n239\t\t}\n240\t\n241\t\tnewest := commit.Committer.When.UTC()\n242\t\n243\t\t// Walk parents to find the oldest commit in this generation\n244\t\titer := commit\n245\t\tfor len(iter.ParentHashes) > 0 {\n246\t\t\tparent, parentErr := s.repo.CommitObject(iter.ParentHashes[0])\n247\t\t\tif parentErr != nil {\n248\t\t\t\tbreak\n249\t\t\t}\n250\t\t\titer = parent\n251\t\t}\n252\t\toldest := iter.Committer.When.UTC()\n253\t\n254\t\treturn GenerationMetadata{\n255\t\t\tOldestCheckpointAt: oldest,\n256\t\t\tNewestCheckpointAt: newest,\n257\t\t}\n258\t}\n259\t\n260\tfunc (s *V2GitStore) v2MainTree() (*object.Tree, error) {\n261\t\tref, err := s.repo.Reference(plumbing.ReferenceName(paths.V2MainRefName), true)\n262\t\tif err != nil {\n263\t\t\treturn nil, fmt.Errorf(\"failed to read v2 main ref: %w\", err)\n264\t\t}\n265\t\tcommit, err := s.repo.CommitObject(ref.Hash())\n266\t\tif err != nil {\n267\t\t\treturn nil, fmt.Errorf(\"failed to read v2 main commit: %w\", err)\n268\t\t}\n269\t\ttree, err := commit.Tree()\n270\t\tif err != nil {\n271\t\t\treturn nil, fmt.Errorf(\"failed to read v2 main tree: %w\", err)\n272\t\t}\n273\t\treturn tree, nil\n274\t}\n275\t\n276\tfunc (s *V2GitStore) checkpointTimestampRangeFromMain(mainTree *object.Tree, cpID id.CheckpointID) (GenerationMetadata, bool) {\n277\t\tcpTree, err := mainTree.Tree(cpID.Path())\n278\t\tif err != nil {\n279\t\t\treturn GenerationMetadata{}, false\n280\t\t}\n281\t\n282\t\tvar gen GenerationMetadata\n283\t\tfound := false\n284\t\tfor _, entry := range cpTree.Entries {\n285\t\t\tif entry.Mode != filemode.Dir {\n286\t\t\t\tcontinue\n287\t\t\t}\n288\t\t\tif _, err := strconv.Atoi(entry.