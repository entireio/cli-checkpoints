 *V2GitStore) marshalGenerationBlob(gen GenerationMetadata) (object.TreeEntry, error) {\n93\t\tdata, err := jsonutil.MarshalIndentWithNewline(gen, \"\", \"  \")\n94\t\tif err != nil {\n95\t\t\treturn object.TreeEntry{}, fmt.Errorf(\"failed to marshal %s: %w\", paths.GenerationFileName, err)\n96\t\t}\n97\t\n98\t\tblobHash, err := CreateBlobFromContent(s.repo, data)\n99\t\tif err != nil {\n100\t\t\treturn object.TreeEntry{}, fmt.Errorf(\"failed to create %s blob: %w\", paths.GenerationFileName, err)\n101\t\t}\n102\t\n103\t\treturn object.TreeEntry{\n104\t\t\tName: paths.GenerationFileName,\n105\t\t\tMode: filemode.Regular,\n106\t\t\tHash: blobHash,\n107\t\t}, nil\n108\t}\n109\t\n110\t// writeGeneration marshals gen as generation.json and adds the blob entry to entries.\n111\tfunc (s *V2GitStore) writeGeneration(gen GenerationMetadata, entries map[string]object.TreeEntry) error {\n112\t\tentry, err := s.marshalGenerationBlob(gen)\n113\t\tif err != nil {\n114\t\t\treturn err\n115\t\t}\n116\t\tentries[paths.GenerationFileName] = entry\n117\t\treturn nil\n118\t}\n119\t\n120\t// CountCheckpointsInTree counts checkpoint shard directories in a /full/* tree.\n121\t// The tree structure is <id[:2]>/<id[2:]>/ — we count second-level directories\n122\t// across all shard prefixes. Returns 0 for an empty tree.\n123\tfunc (s *V2GitStore) CountCheckpointsInTree(treeHash plumbing.Hash) (int, error) {\n124\t\tif treeHash == plumbing.ZeroHash {\n125\t\t\treturn 0, nil\n126\t\t}\n127\t\n128\t\ttree, err := s.repo.TreeObject(treeHash)\n129\t\tif err != nil {\n130\t\t\treturn 0, fmt.Errorf(\"failed to read tree: %w\", err)\n131\t\t}\n132\t\n133\t\tcount := 0\n134\t\tif err := WalkCheckpointShards(s.repo, tree, func(_ id.CheckpointID, _ plumbing.Hash) error {\n135\t\t\tcount++\n136\t\t\treturn nil\n137\t\t}); err != nil {\n138\t\t\treturn 0, err\n139\t\t}\n140\t\n141\t\treturn count, nil\n142\t}\n143\t\n144\t// AddGenerationJSONToTree adds generation.json to an existing root tree, returni