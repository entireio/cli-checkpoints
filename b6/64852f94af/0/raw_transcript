\t\n87\t\temptyTreeHash, err := BuildTreeFromEntries(ctx, s.repo, make(map[string]object.TreeEntry))\n88\t\tif err != nil {\n89\t\t\treturn fmt.Errorf(\"failed to build empty tree: %w\", err)\n90\t\t}\n91\t\n92\t\tauthorName, authorEmail := GetGitAuthorFromRepo(s.repo)\n93\t\tcommitHash, err := CreateCommit(ctx, s.repo, emptyTreeHash, plumbing.ZeroHash, \"Initialize v2 ref\", authorName, authorEmail)\n94\t\tif err != nil {\n95\t\t\treturn fmt.Errorf(\"failed to create initial commit: %w\", err)\n96\t\t}\n97\t\n98\t\tref := plumbing.NewHashReference(refName, commitHash)\n99\t\tif err := s.repo.Storer.SetReference(ref); err != nil {\n100\t\t\treturn fmt.Errorf(\"failed to set ref %s: %w\", refName, err)\n101\t\t}\n102\t\n103\t\treturn nil\n104\t}\n105\t\n106\t// GetRefState returns the parent commit hash and root tree hash for a ref.\n107\tfunc (s *V2GitStore) GetRefState(refName plumbing.ReferenceName) (parentHash, treeHash plumbing.Hash, err error) {\n108\t\tref, err := s.repo.Reference(refName, true)\n109\t\tif err != nil {\n110\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"ref %s not found: %w\", refName, err)\n111\t\t}\n112\t\n113\t\tcommit, err := s.repo.CommitObject(ref.Hash())\n114\t\tif err != nil {\n115\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get commit for ref %s: %w\", refName, err)\n116\t\t}\n117\t\n118\t\treturn ref.Hash(), commit.TreeHash, nil\n119\t}\n120\t\n121\t// updateRef creates a new commit on a ref with the given tree, updating the ref to point to it.\n122\tfunc (s *V2GitStore) updateRef(ctx context.Context, refName plumbing.ReferenceName, treeHash, parentHash plumbing.Hash, message, authorName, authorEmail string) error {\n123\t\tcommitHash, err := CreateCommit(ctx, s.repo, treeHash, parentHash, message, authorName, authorEmail)\n124\t\tif err != nil {\n125\t\t\treturn fmt.Errorf(\"failed to create commit: %w\", err)\n126\t\t}\n127\t\n128\t\tref := plumbing.NewHashReference(refName, commitHash)\