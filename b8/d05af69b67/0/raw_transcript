,"originalFile":"package agent\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n)\n\n// WalkClaudeCode parses a Claude Code session JSONL transcript and emits each\n// content-bearing string to v. Structural fields (uuid, promptId, sessionId,\n// requestId, timestamps, cwd, gitBranch, version, message.id, message.model,\n// signatures, token counts, tool_use.id, tool_result.tool_use_id, …) are\n// never emitted.\n//\n// Schema reference (one line per JSON object):\n//\n//\t{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\": \"...\" | [block,...]}, ...metadata...}\n//\t{\"type\":\"assistant\",\"message\":{\"id\":\"msg_…\",\"content\":[block,...]}, ...metadata...}\n//\n// User content blocks:\n//\n//\t{\"type\":\"text\",\"text\":\"...\"}                            → KindUserText\n//\t{\"type\":\"tool_result\",\"tool_use_id\":\"…\",\"content\":\"…\"}  → KindToolOutput\n//\t{\"type\":\"image\", ...}                                   → skipped\n//\n// Assistant content blocks:\n//\n//\t{\"type\":\"text\",\"text\":\"...\"}                          → KindAssistantText\n//\t{\"type\":\"thinking\",\"thinking\":\"…\",\"signature\":\"…\"}    → text only; signature skipped\n//\t{\"type\":\"redacted_thinking\", ...}                     → skipped (already redacted)\n//\t{\"type\":\"tool_use\",\"name\":\"…\",\"input\":{…}}            → name + recursive input\nfunc WalkClaudeCode(raw []byte, v Visitor) error {\n\tr := bufio.NewReader(bytes.NewReader(raw))\n\tfor {\n\t\tline, err := r.ReadBytes('\\n')\n\t\tif len(bytes.TrimSpace(line)) > 0 {\n\t\t\tif walkErr := walkClaudeCodeLine(line, v); walkErr != nil {\n\t\t\t\treturn walkErr\n\t\t\t}\n\t\t}\n\t\tif err == io.EOF {\n\t\t\treturn nil\n\t\t}\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"read jsonl: %w\", err)\n\t\t}\n\t}\n}\n\nfunc walkClaudeCodeLine(line []byte, v Visitor) error {\n\tvar head struct {\n\t\tType    string          `json:\"type\"`\n\t\tMessage json.RawMessage `json:\"message\"`\n\t}\n\tif err := json.Unmarshal(line, &head); err != nil {\n\t\t// Malformed line — skip silently. Matches existing redactor behavior.\n\t\treturn nil\n\t}\n\tswitch head.Type {\n\tcase \"user\", \"human\":\n\t\treturn walkClaudeUserMessage(head.Message, v)\n\tcase \"assistant\":\n\t\treturn walkClaudeAssistantMessage(head.Message, v)\n\t}\n\t// Other types (progress, file-history-snapshot, summary, system, …) carry\n\t// no user-authored content.\n\treturn nil\n}\n\nfunc walkClaudeUserMessage(msg json.RawMessage, v Visitor) error {\n\tif len(msg) == 0 {\n\t\treturn nil\n\t}\n\tvar envelope struct {\n\t\tContent json.RawMessage `json:\"content\"`\n\t}\n\tif err := json.Unmarshal(msg, &envelope); err != nil {\n\t\treturn nil\n\t}\n\tif len(envelope.Content) == 0 {\n\t\treturn nil\n\t}\n\t// Content can be a plain string OR an array of typed blocks.\n\tvar asString string\n\tif json.Unmarshal(envelope.Content, &asString) == nil {\n\t\tv.OnString(KindUserText, asString)\n\t\treturn nil\n\t}\n\tvar blocks []map[string]json.RawMessage\n\tif err := json.Unmarshal(envelope.Content, &blocks); err != nil {\n\t\treturn nil\n\t}\n\tfor _, b := range blocks {\n\t\tswitch unquote(b[\"type\"]) {\n\t\tcase \"text\":\n\t\t\tv.OnString(KindUserText, unquote(b[\"text\"]))\n\t\tcase \"tool_result\":\n\t\t\t// content can be a string or an array of {type:\"text\",text:\"…\"}/{type:\"image\",…}\n\t\t\temitToolResultContent(b[\"content\"], v)\n\t\t}\n\t\t// image blocks: deliberately skipped.\n\t}\n\treturn nil\n}\n\nfunc walkClaudeAssistantMessage(msg json.RawMessage, v Visitor) error {\n\tif len(msg) == 0 {\n\t\treturn nil\n\t}\n\tvar envelope struct {\n\t\tContent json.RawMessage `json:\"content\"`\n\t}\n\tif err := json.Unmarshal(msg, &envelope); err != nil {\n\t\treturn nil\n\t}\n\tvar blocks []map[string]json.RawMessage\n\tif err := json.Unmarshal(envelope.Content, &blocks); err != nil {\n\t\treturn nil\n\t}\n\tfor _, b := range blocks {\n\t\tswitch unquote(b[\"type\"]) {