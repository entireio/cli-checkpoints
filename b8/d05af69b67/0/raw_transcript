+ `]+`)\n37\t\tkeywordDSNPattern    = regexp.MustCompile(`(?i)\\b[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)(?:\\s+[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)){2,}`)\n38\t\tsemicolonConnPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)(?:;[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)){2,}`)\n39\t\t// credentialValuePattern requires the prefix to start at a non-alphanumeric\n40\t\t// boundary, so APP_DB_PASSWORD matches via the leading `_` but mydbpassword\n41\t\t// does not.\n42\t\tcredentialValuePattern = regexp.MustCompile(`(?i)(?:^|[^A-Za-z0-9])(` + dbPasswordKeyShape + `)\\s*=\\s*(\"[^\"]*\"|'[^']*'|[^\\s,;&]+)`)\n43\t\n44\t\tkeywordHostPattern      = regexp.MustCompile(`(?i)(?:^|\\s)host=`)\n45\t\tkeywordUserPattern      = regexp.MustCompile(`(?i)(?:^|\\s)user=`)\n46\t\tsemicolonServerPattern  = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:server|data source|datasource|addr|address|network address)\\s*=`)\n47\t\tsemicolonUserPattern    = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:user id|userid|user|uid)\\s*=`)\n48\t\tpasswordAssignmentRegex = regexp.MustCompile(`(?i)(?:^|[?&;\\s])(?:password|pwd)=(\"[^\"]*\"|'[^']*'|[^&;\\s\"']+)`)\n49\t\t// credentialJSONKeyRegex operates on output of normalizeCredentialJSONKey\n50\t\t// (already lowercased, `-`/` `/`.` → `_`), so the `(?i)` flag is unnecessary.\n51\t\tcredentialJSONKeyRegex  = regexp.MustCompile(`^` + dbPasswordKeyShape + `$`)\n52\t\tgenericPasswordKeyRegex = regexp.MustCompile(`(?i)^(?:password|passwd|pwd)$`)\n53\t)\n54\t\n55\t// entropyThreshold is the minimum Shannon entropy for a string to be considered\n56\t// a secret. 4.5 was chosen through trial and error: high enough to avoid false\n57\t// positives on common words and identifiers, low enough to catch typical API keys\n58\t// and tokens which tend to have entropy well above 5.0.\n59\tconst entropyThreshold = 4.5\n60\t\n61\t// RedactedPlaceholder is the replacement text used f