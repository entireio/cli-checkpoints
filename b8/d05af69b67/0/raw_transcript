eUser      = \"user\"\n\tcodexRoleAssistant = \"assistant\"\n\n\tcodexBlockInputText  = \"input_text\"\n\tcodexBlockOutputText = \"output_text\"\n)\n\n// codexSystemPrefixes mirrors compact/codex.go's isCodexSystemContent. These\n// blocks are Codex-injected (permissions, AGENTS.md, environment_context, …)\n// and contain bounded structural metadata rather than user-authored content.\nvar codexSystemPrefixes = []string{\n\t\"<permissions\",\n\t\"<collaboration_mode>\",\n\t\"<skills_instructions>\",\n\t\"<environment_context>\",\n\t\"<turn_aborted>\",\n\t\"# AGENTS.md\",\n}\n\n// WalkCodex parses a Codex session JSONL transcript and emits each\n// content-bearing string to v. Structural fields (call_id, turn_id, model,\n// timestamps, encrypted_content, session_meta payload, event_msg metadata, …)\n// are never emitted.\n//\n// Schema reference (one JSON object per line):\n//\n//\t{\"type\":\"session_meta\", ...}                              → skipped\n//\t{\"type\":\"event_msg\",    \"payload\":{...}}                  → skipped\n//\t{\"type\":\"turn_context\", \"payload\":{...}}                  → skipped\n//\t{\"type\":\"response_item\",\"payload\":{\"type\":\"message\",  \"role\":..., \"content\":[...]}}\n//\t{\"type\":\"response_item\",\"payload\":{\"type\":\"function_call\", \"name\":..., \"arguments\":\"<JSON string>\", ...}}\n//\t{\"type\":\"response_item\",\"payload\":{\"type\":\"function_call_output\", \"output\":\"...\", ...}}\n//\t{\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\", \"input\":\"...\", ...}}\n//\t{\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\", \"output\":<string|object>}}\n//\t{\"type\":\"response_item\",\"payload\":{\"type\":\"reasoning\", \"encrypted_content\":\"...\", ...}} → skipped\n//\n// Notes:\n//   - `arguments` on function_call is a JSON-encoded string; its inner values\n//     are walked recursively as KindToolInput.\n//   - `developer`-role message blocks (system prompts) are skipped, as are\n//     `input_text` blocks beginning with codexSystemPrefixes.\nfunc WalkCodex(raw []byte, v Visitor) error {\n\tsc := bufio.NewScanner(bytes.NewReader(raw))\n\tsc.Buffer(make([]byte, 0, 64*1024), maxJSONLLineBytes)\n\tfor sc.Scan() {\n\t\tline := sc.Bytes()\n\t\tif len(bytes.TrimSpace(line)) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\twalkCodexLine(line, v)\n\t}\n\tif err := sc.Err(); err != nil {\n\t\treturn fmt.Errorf(\"scan jsonl: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc walkCodexLine(line []byte, v Visitor) {\n\tvar head struct {\n\t\tType    string          `json:\"type\"`\n\t\tPayload json.RawMessage `json:\"payload\"`\n\t}\n\tif json.Unmarshal(line, &head) != nil || head.Type != codexLineResponseItem {\n\t\treturn\n\t}\n\tvar p struct {\n\t\tType      string          `json:\"type\"`\n\t\tRole      string          `json:\"role\"`\n\t\tContent   json.RawMessage `json:\"content\"`\n\t\tArguments string          `json:\"arguments\"`\n\t\tInput     string          `json:\"input\"`\n\t\tOutput    json.RawMessage `json:\"output\"`\n\t}\n\tif json.Unmarshal(head.Payload, &p) != nil {\n\t\treturn\n\t}\n\tswitch p.Type {\n\tcase codexPayloadMessage:\n\t\twalkCodexMessage(p.Role, p.Content, v)\n\tcase codexPayloadFunctionCall:\n\t\t// arguments is a JSON-encoded object (already string-decoded by Go).\n\t\t// Reinterpret as raw JSON and walk all string leaves.\n\t\tif p.Arguments != \"\" {\n\t\t\temitJSONStrings(json.RawMessage(p.Arguments), KindToolInput, v)\n\t\t}\n\tcase codexPayloadCustomToolCall:\n\t\t// input is plain text (e.g., apply_patch payload), not JSON.\n\t\tif p.Input != \"\" {\n\t\t\tv.OnString(KindToolInput, p.Input)\n\t\t}\n\tcase codexPayloadFunctionCallOutput:\n\t\tif s := unquote(p.Output); s != \"\" {\n\t\t\tv.OnString(KindToolOutput, s)\n\t\t}\n\tcase codexPayloadCustomToolCallOutput:\n\t\temitCodexCustomOutput(p.Output, v)\n\t}\n\t// session_meta, event_msg, turn_context, reasoning: no user/assistant\n\t// content reachable; reasoning's encrypted_content is structural.\n}\n\nfunc walkCodexMessage(role string, content json.RawMessage, v Visitor) {\n\tif len(content) == 0 {\n\t\treturn\n\t}\n\tvar blocks []map[string]json.RawMessage\n\tif json.Unmarshal(content, &blocks) != nil {\n\t\treturn\n\t}\n\tfor _, b := range blocks {\n\t\tswitch unquote(b[\"type\"]) {\n\t\tcase codexBlockInputText:\n\t\t\tif role != codexRoleUser {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\ttext := unquote(b[\"text\"])\n\t\t\tif isCodexSystemContent(text) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tv.OnString(KindUserText, text)\n\t\tcase codexBlockOutputText:\n\t\t\tif role != codexRoleAssistant {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tv.OnString(KindAssistantText, unquote(b[\"text\"]))\n\t\t}\n\t}\n}\n\n// emitCodexCustomOutput handles custom_tool_call_output.output, which is\n// either a plain string or an object like {\"type\":\"text\",\"text\":\"…\"}.\nfunc emitCodexCustomOutput(output json.RawMessage, v Visitor) {\n\tif len(output) == 0 {\n\t\treturn\n\t}\n\tvar s string\n\tif json.Unmarshal(output, &s) == nil {\n\t\tv.OnString(KindToolOutput, s)\n\t\treturn\n\t}\n\tvar obj map[string]json.RawMessage\n\tif json.Unmarshal(output, &obj) != nil {\n\t\treturn\n\t}\n\tif t := unquote(obj[\"text\"]); t != \"\" {\n\t\tv.OnString(KindToolOutput, t)\n\t}\n}\n\nfunc isCodexSystemContent(text string) bool {\n\tfor _, p := range codexSystemPrefixes {\n\t\tif strings.HasPrefix(text, p) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","structuredPatch":[{"oldStart":97,"oldLines":10,"newStart":97,"newLines":15,"lines":["   case codexPayloadMessage:","     walkCodexMessage(p.Role, p.Content, v)","   case codexPayloadFunctionCall:","-    // arguments is a JSON-encoded object (already string-decoded by Go).","-    // Reinterpret as raw JSON and walk all string leaves.","+    // arguments is a JSON-encoded string that wraps another JSON object,","+    // so its inner string values appear DOUBLE-escaped in raw bytes","+    // (one escape for the inner JSON, 