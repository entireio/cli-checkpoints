eadyRedacted(data []byte) RedactedBytes {\n109\t\treturn RedactedBytes{data: data}\n110\t}\n111\t\n112\tvar (\n113\t\tbetterleaksDetector     *detect.Detector\n114\t\tbetterleaksDetectorOnce sync.Once\n115\t)\n116\t\n117\tfunc getDetector() *detect.Detector {\n118\t\tbetterleaksDetectorOnce.Do(func() {\n119\t\t\td, err := detect.NewDetectorDefaultConfig()\n120\t\t\tif err != nil {\n121\t\t\t\treturn\n122\t\t\t}\n123\t\t\tbetterleaksDetector = d\n124\t\t})\n125\t\treturn betterleaksDetector\n126\t}\n127\t\n128\t// region represents a byte range to redact.\n129\ttype region struct{ start, end int }\n130\t\n131\t// taggedRegion extends region with a label for typed replacement tokens.\n132\t// Empty label = secret (produces \"REDACTED\"). Non-empty = PII (produces \"[REDACTED_<LABEL>]\").\n133\ttype taggedRegion struct {\n134\t\tregion\n135\t\n136\t\tlabel string\n137\t}\n138\t\n139\ttype jsonReplacement struct {\n140\t\tkey      string\n141\t\toriginal string\n142\t\tredacted string\n143\t}\n144\t\n145\ttype connectionStringRule struct {\n146\t\tpattern   *regexp.Regexp\n147\t\thasSecret func(string) bool\n148\t}\n149\t\n150\tvar connectionStringRules = []connectionStringRule{\n151\t\t{pattern: jdbcPattern, hasSecret: hasJDBCPassword},\n152\t\t{pattern: databaseURLPattern, hasSecret: hasDatabaseURLSecret},\n153\t\t{pattern: keywordDSNPattern, hasSecret: hasKeywordDSNPassword},\n154\t\t{pattern: semicolonConnPattern, hasSecret: hasSemicolonConnectionPassword},\n155\t}\n156\t\n157\t// String replaces secrets and PII in s using layered detection:\n158\t// 1. Entropy-based: high-entropy alphanumeric sequences (threshold 4.5)\n159\t// 2. Pattern-based: betterleaks regex rules (260+ known secret formats)\n160\t// 3. Credentialed URIs: URLs containing userinfo passwords\n161\t// 4. Database connection strings: JDBC, keyword DSNs, and semicolon strings\n162\t// 5. Bounded credential key/value pairs: DB_PASSWORD=...\n163\t// 6. PII detection: email, phone, address patterns (only when configured via ConfigurePII)\n164\t// A string is redacted if ANY method flags it.\n165\tfunc String(s string) string {\n166\t\tvar regions []taggedRegion\n167\t\n168\t\t// 1. Entropy-based detection (secrets — always on).\n169\t\tfor _, loc := range secretPattern.FindAllStringIndex(s, -1) {\n170\t\t\tstart, end := loc[0], loc[1]\n171\t\n172\t\t\t// Don't consume characters that are part of JSON/string escape sequences.\n173\t\t\t// Example: in \"controller.go\\nmodel.go\", the regex could match \"nmodel\"\n174\t\t\t// (consuming the 'n' from '\\n'), and after replacement the '\\' would be\n175\t\t\t// followed by 'R' from \"REDACTED\", creating invalid escape '\\R'.\n176\t\t\t// Only skip for known JSON escape letters to avoid trimming real secrets\n177\t\t\t// that happen to follow a literal backslash in decoded content.\n178\t\t\tif start > 0 && s[start-1] == '\\\\' {\n179\t\t\t\tswitch s[start] {\n180\t\t\t\tcase 'n', 't', 'r', 'b', 'f', 'u', '\"', '\\\\', '/':\n181\t\t\t\t\tstart++\n182\t\t\t\t\tif end-start < 10 {\n183\t\t\t\t\t\tcontinue\n184\t\t\t\t\t}\n185\t\t\t\t}\n186\t\t\t}\n187\t\n188\t\t\tif shannonEntropy(s[start:end]) > entropyThreshold {\n189\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n190\t\t\t}\n191\t\t}\n192\t\n193\t\t// 2. Pattern-based detection via betterleaks (secrets — always on).\n194\t\tif d := getDetector(); d != nil {\n195\t\t\tfor _, f := range d.DetectString(s) {\n196\t\t\t\tif f.Secret == \"\" {\n197\t\t\t\t\tcontinue\n198\t\t\t\t}\n199\t\t\t\tsearchFrom := 0\n200\t\t\t\tfor {\n201\t\t\t\t\tidx := strings.Index(s[searchFrom:], f.Secret)\n202\t\t\t\t\tif idx < 0 {\n203\t\t\t\t\t\tbreak\n204\t\t\t\t\t}\n205\t\t\t\t\tabsIdx := searchFrom + idx\n206\t\t\t\t\tregions = append(regions, taggedRegion{region: region{absIdx, absIdx + len(f.Secret)}})\n207\t\t\t\t\tsearchFrom = absIdx + len(f.Secret)\n208\t\t\t\t}\n209\t\t\t}\n210\t\t}\n211\t\n212\t\t// 3. Credentialed URIs (secrets — always on).\n213\t\tfor _, loc := range credentialedURIPattern.FindAllStringIndex(s, -1) {\n214\t\t\tregions = append(regions, taggedRegion{region: region{loc[0], loc[1]}})\n215\t\t}\n216\t\n217\t\t// 4. Database and connection-string detection (secrets — always on).\n218\t\tregions = append(regions, detectConnectionStrings(s)...)\n219\t\n220\t\t// 5. Bounded credential key/value detection (secrets — always on).\n221\t\tregions = append(regions, detectCredentialValues(s)...)\n222\t\n223\t\t// 6. PII detection (opt-in — only runs when configured).\n224\t\tregions = append(regions, detectPII(getPIIConfig(), s)...)\n225\t\n226\t\tif len(regions) == 0 {\n227\t\t\treturn s\n228\t\t}\n229\t\n230\t\t// Merge overlapping regions and build result.\n231\t\tsort.Slice(regions, func(i, j int) bool {\n232\t\t\tif regions[i].start != regions[j].start {\n233\t\t\t\treturn regions[i].start < regions[j].start\n234\t\t\t}\n235\t\t\tif regions[i].end != regions[j].end {\n236\t\t\t\treturn regions[i].end > regions[j].end // larger region first\n237\t\t\t}\n238\t\t\treturn regions[i].label < regions[j].label // deterministic tie-break\n239\t\t})\n240\t\tmerged := []taggedRegion{regions[0]}\n241\t\tfor _, r := range regions[1:] {\n242\t\t\tlast := &merged[len(merged)-1]\n243\t\t\tif r.start <= last.end {\n244\t\t\t\tif r.end > last.end {\n245\t\t\t\t\tlast.end = r.end\n246\t\t\t\t}\n247\t\t\t\t// Keep the existing label (first/larger region wins)\n248\t\t\t} else {\n249\t\t\t\tmerged = append(merged, r)\n250\t\t\t}\n251\t\t}\n252\t\n253\t\tvar b strings.Builder\n254\t\tprev := 0\n255\t\tfor _, r := range merged {\n256\t\t\tb.WriteString(s[prev:r.start])\n257\t\t\tb.WriteString(replacementToken(r.label))\n258\t\t\tprev = r.end\n259\t\t}\n260\t\tb.WriteString(s[prev:])\n261\t\treturn b.String()\n262\t}\n263\t\n264\tfunc detectConnectionStrings(s string) []taggedRegion {\n265\t\tif !strings.ContainsRune(s, '=') {\n266\t\t\treturn nil\n267\t\t}\n268\t\tvar regions []taggedRegion\n269\t\tfor _, rule := range connectionStringRules {\n270\t\t\tregions = append(regions, detectConnectionStringRule(s, rule)...)\n271\t\t}\n272\t\treturn regions\n273\t}\n274\t\n275\tfunc detectConnectionStringRule(s string, rule connectionStringRule) []taggedRegion {\n276\t\tvar regions []taggedRegion\n277\t\tfor _, loc := range rule.pattern.FindAllStringIndex(s, -1) {\n278\t\t\tstart, end := loc[0], trimConnectionStringEnd(s, loc[0], loc[1])\n279\t\t\tif start >= end {\n280\t\t\t\tcontinue\n281\t\t\t}\n282\t\t\tif rule.hasSecret(s[start:end]) {\n283\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n284\t\t\t}\n285\t\t}\n286\t\treturn regions\n287\t}\n288\t\n289\tfunc trimConnectionStringEnd(s string, start, end int) int {\n290\t\tfor end > start {\n291\t\t\tswitch s[end-1] {\n292\t\t\tcase '.', ',', ';', ':', '!', '?', ')', ']':\n293\t\t\t\tend--\n294\t\t\tdefault:\n295\t\t\t\treturn end\n296\t\t\t}\n297\t\t}\n298\t\treturn end\n299\t}\n300\t\n301\tfunc hasJDBCPassword(candidate string) bool {\n302\t\tif !strings.HasPrefix(strings.ToLower(candidate), \"jdbc:\") {\n303\t\t\treturn false\n304\t\t}\n305\t\treturn hasNonPlaceholderPasswordAssignment(candidate)\n306\t}\n307\t\n308\tfunc hasDatabaseURLSecret(candidate string) bool {\n309\t\tu, err := url.Parse(candidate)\n310\t\tif err != nil || u.Scheme == \"\" || u.Host == \"\" {\n311\t\t\treturn false\n312\t\t}\n313\t\tfor key, values := range u.Query() {\n314\t\t\tif !isPasswordQueryKey(key) {\n315\t\t\t\tcontinue\n316\t\t\t}\n317\t\t\tfor _, value := range values {\n318\t\t\t\tif hasNonPlaceholderPasswordValue(value) {\n319\t\t\t\t\treturn true\n320\t\t\t\t}\n321\t\t\t}\n322\t\t}\n323\t\treturn false\n324\t}\n325\t\n326\tfunc isPasswordQueryKey(key string) bool {\n327\t\treturn strings.EqualFold(key, \"password\") || strings.EqualFold(key, \"pwd\")\n328\t}\n329\t\n330\tfunc hasKeywordDSNPassword(candidate string) bool {\n331\t\treturn keywordHostPattern.MatchString(candidate) &&\n332\t\t\tkeywordUserPattern.MatchString(candidate) &&\n333\t\t\thasNonPlaceholderPasswordAssignment(candidate)\n334\t}\n335\t\n336\tfunc hasSemicolonConnectionPassword(candidate string) bool {\n337\t\treturn semicolonServerPattern.MatchString(candidate) &&\n338\t\t\tsemicolonUserPattern.MatchString(candidate) &&\n339\t\t\thasNonPlaceholderPasswordAssignment(candidate)\n340\t}\n341\t\n342\tfunc detectCredentialValues(s string) []taggedRegion {\n343\t\tvar regions []taggedRegion\n344\t\tfor _, loc := range credentialValuePattern.FindAllStringSubmatchIndex(s, -1) {\n345\t\t\tif len(loc) < 6 || loc[4] < 0 || loc[5] < 0 {\n346\t\t\t\tcontinue\n347\t\t\t}\n348\t\t\tstart, end := unquoteRange(s, loc[4], loc[5])\n349\t\t\tif hasNonPlaceholderPasswordValue(s[start:end]) {\n350\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n351\t\t\t}\n352\t\t}\n353\t\treturn regions\n354\t}\n355\t\n356\tfunc unquoteRange(s string, start, end int) (int, int) {\n357\t\tif end-start < 2 {\n358\t\t\treturn start, end\n359\t\t}\n360\t\tfirst, last := s[start], s[end-1]\n361\t\tif (first == '\"' && last == '\"') || (first == '\\'' && last == '\\'') {\n362\t\t\treturn start + 1, end - 1\n363\t\t}\n364\t\treturn start, end\n365\t}\n366\t\n367\tfunc hasNonPlaceholderPasswordAssignment(candidate string) bool {\n368\t\tfor _, loc := range passwordAssignmentRegex.FindAllStringSubmatchIndex(candidate, -1) {\n369\t\t\tif len(loc) >= 4 && loc[2] >= 0 && loc[3] >= 0 {\n370\t\t\t\tstart, end := unquoteRange(candidate, loc[2], loc[3])\n371\t\t\t\tif hasNonPlaceholderPasswordValue(candidate[start:end]) {\n372\t\t\t\t\treturn true\n373\t\t\t\t}\n374\t\t\t}\n375\t\t}\n376\t\treturn false\n377\t}\n378\t\n379\tfunc hasNonPlaceholderPasswordValue(value string) bool {\n380\t\treturn value != \"\" && !isPlaceholderSecretValue(value)\n381\t}\n382\t\n383\tfunc isPlaceholderSecretValue(value string) bool {\n384\t\ttrimmed := strings.Trim(strings.TrimSpace(value), `\"'`)\n385\t\tif trimmed == \"\" {\n386\t\t\treturn true\n387\t\t}\n388\t\tif isBracketedPlaceholder(trimmed) {\n389\t\t\treturn true\n390\t\t}\n391\t\tnormalized := strings.ToLower(trimmed)\n392\t\tif strings.HasPrefix(normalized, \"${\") && strings.HasSuffix(normalized, \"}\") {\n393\t\t\treturn true\n394\t\t}\n395\t\tif _, ok := placeholderSecretValues[normalized]; ok {\n396\t\t\treturn true\n397\t\t}\n398\t\treturn isRepeatedCharPlaceholder(normalized)\n399\t}\n400\t\n401\t// bracketedPlaceholderInteriorRE matches the inside of a \"<…>\" placeholder\n402\t// shape: lowercase letters joined by `-` or `_`. Digits, mixed case, and\n403\t// special chars are rejected so values like `<hunter2>` or `<RealPassword>`\n404\t// still fall through to redaction.\n405\tvar bracketedPlaceholderInteriorRE = regexp.MustCompile(`^[a-z][a-z_-]*$`)\n406\t\n407\t// isBracketedPlaceholder reports whether s is a \"<name>\" doc placeholder\n408\t// (e.g. \"<password>\", \"<your-db-password>\"). The minimum total length of 5\n409\t// keeps this from firing on `<a>` / `<ab>`.\n410\tfunc isBracketedPlaceholder(s string) bool {\n411\t\tif len(s) < 5 || s[0] != '<' || s[len(s)-1] != '>' {\n412\t\t\treturn false\n413\t\t}\n414\t\treturn bracketedPlaceholderInteriorRE.MatchString(s[1 : len(s)-1])\n415\t}\n416\t\n417\t// isRepeatedCharPlaceholder reports whether s is a run of a single masking\n418\t// character commonly used to redact values in docs and screenshots, e.g.\n419\t// \"***\", \"xxxx\", \"....\", \"----\". The minimum length of 3 keeps single-char\n420\t// or 2-char values like `x` or `**` from being treated as masks.\n421\tfunc isRepeatedCharPlaceholder(s string) bool {\n422\t\tif len(s) < 3 {\n423\t\t\treturn false\n424\t\t}\n425\t\tfirst := s[0]\n426\t\tswitch first {\n427\t\tcase '*', 'x', '.', '-':\n428\t\tdefault:\n429\t\t\treturn false\n430\t\t}\n431\t\tfor i := 1; i < len(s); i++ {\n432\t\t\tif s[i] != first {\n433\t\t\t\treturn false\n434\t\t\t}\n435\t\t}\n436\t\treturn true\n437\t}\n438\t\n439\tfunc isCredentialJSONSecretKey(key string, credentialContext bool) bool {\n440\t\tnormalized := normalizeCredentialJSONKey(key)\n441\t\tif credentialJSONKeyRegex.MatchString(normalized) {\n442\t\t\treturn true\n443\t\t}\n444\t\treturn credentialContext && genericPasswordKeyRegex.MatchString(normalized)\n445\t}\n446\t\n447\tfunc isCredentialJSONObject(obj map[string]any) bool {\n448\t\tvar hasHost, hasUser bool\n449\t\tfor key := range obj {\n450\t\t\tswitch normalizeCredentialJSONKey(key) {\n451\t\t\tcase \"host\", \"hostname\", \"server\", \"addr\", \"address\", \"datasource\", \"data_source\":\n452\t\t\t\thasHost = true\n453\t\t\tcase \"user\", \"username\", \"userid\", \"user_id\", \"uid\":\n454\t\t\t\thasUser = true\n455\t\t\t}\n456\t\t\tif hasHost && hasUser {\n457\t\t\t\treturn true\n458\t\t\t}\n459\t\t}\n460\t\treturn false\n461\t}\n462\t\n463\tfunc normalizeCredentialJSONKey(key string) string {\n464\t\tkey = strings.ToLower(strings.TrimSpace(key))\n465\t\tkey = strings.ReplaceAll(key, \"-\", \"_\")\n466\t\tkey = strings.ReplaceAll(key, \" \", \"_\")\n467\t\t// Flattened-config exporters (Spring, dotnet, Hashicorp Vault) emit dotted keys\n468\t\t// like \"db.password\" or \"mysql.root.password\"; treat them like underscored.\n469\t\tkey = strings.ReplaceAll(key, \".\", \"_\")\n470\t\treturn key\n471\t}\n472\t\n473\t// Bytes is a convenience wrapper around String for []byte content.\n474\tfunc Bytes(b []byte) []byte {\n475\t\ts := string(b)\n476\t\tredacted := String(s)\n477\t\tif redacted == s {\n478\t\t\treturn b\n479\t\t}\n480\t\treturn []byte(redacted)\n481\t}\n482\t\n483\t// JSONLBytes redacts secrets in JSONL-formatted byte content and returns\n484\t// the result as RedactedBytes, certifying the output has been through redaction.\n485\tfunc JSONLBytes(b []byte) (RedactedBytes, error) {\n486\t\ts := string(b)\n487\t\tredacted, err := JSONLContent(s)\n488\t\tif err != nil {\n489\t\t\treturn RedactedBytes{}, err\n490\t\t}\n491\t\tif redacted == s {\n492\t\t\treturn RedactedBytes{data: b}, nil\n493\t\t}\n494\t\treturn RedactedBytes{data: []byte(redacted)}, nil\n495\t}\n496\t\n497\t// JSONLContent parses each line as JSON to determine which string values\n498\t// need redaction, then performs targeted replacements on the raw JSON bytes.\n499\t// Lines with no secrets are returned unchanged, preserving original formatting.\n500\t//\n501\t// For multi-line JSON content (e.g., pretty-printed single JSON objects like\n502\t// OpenCode export), the function first attempts to parse the entire content as\n503\t// a single JSON value. This ensures field-aware redaction (which skips ID fields)\n504\t// is used instead of falling back to entropy-based detection on raw text lines,\n505\t// which would corrupt high-entropy identifiers.\n506\tfunc JSONLContent(content string) (string, error) {\n507\t\t// Try parsing the entire content as a single JSON value first.\n508\t\t// Uses a streaming decoder to avoid copying the full content into []byte.\n509\t\t// After decoding, attempts a second Decode to confirm EOF — if it succeeds,\n510\t\t// the content is JSONL (multiple values) and we fall through to line-by-line.\n511\t\ttrimmed := strings.TrimSpace(content)\n512\t\tif len(trimmed) > 0 {\n513\t\t\tdec := json.NewDecoder(strings.NewReader(trimmed))\n514\t\t\tvar parsed any\n515\t\t\tif err := dec.Decode(&parsed); err == nil && isSingleJSONValue(dec) {\n516\t\t\t\t// Content is a single JSON value (object/array) — redact field-aware.\n517\t\t\t\tresult, err := applyJSONReplacements(content, collectJSONLReplacements(parsed))\n518\t\t\t\tif err != nil {\n519\t\t\t\t\treturn \"\", err\n520\t\t\t\t}\n521\t\t\t\treturn result, nil\n522\t\t\t}\n523\t\t}\n524\t\n525\t\t// Fall back to line-by-line JSONL processing.\n526\t\tlines := strings.Split(content, \"\\n\")\n527\t\tvar b strings.Builder\n528\t\tfor i, line := range lines {\n529\t\t\tif i > 0 {\n530\t\t\t\tb.WriteByte('\\n')\n531\t\t\t}\n532\t\t\tlineTrimmed := strings.TrimSpace(line)\n533\t\t\tif lineTrimmed == \"\" {\n534\t\t\t\tb.WriteString(line)\n535\t\t\t\tcontinue\n536\t\t\t}\n537\t\t\tvar parsed any\n538\t\t\tif err := json.Unmarshal([]byte(lineTrimmed), &parsed); err != nil {\n539\t\t\t\tb.WriteString(String(line))\n540\t\t\t\tcontinue\n541\t\t\t}\n542\t\t\tresult, err := applyJSONReplacements(line, collectJSONLReplacements(parsed))\n543\t\t\tif err != nil {\n544\t\t\t\treturn \"\", err\n545\t\t\t}\n546\t\t\tb.WriteString(result)\n547\t\t}\n548\t\treturn b.String(), nil\n549\t}\n550\t\n551\t// applyJSONReplacements applies collected (original, redacted) string pairs\n552\t// to the raw JSON text, replacing JSON-encoded originals with their redacted forms.\n553\t// Returns s unchanged if repls is empty.\n554\tfunc applyJSONReplacements(s string, repls []jsonReplacement) (string, error) {\n555\t\tif len(repls) == 0 {\n556\t\t\treturn s, nil\n557\t\t}\n558\t\tfor _, r := range repls {\n559\t\t\torigJSON, err := jsonEncodeString(r.original)\n560\t\t\tif err != nil {\n561\t\t\t\treturn \"\", err\n562\t\t\t}\n563\t\t\treplJSON, err := jsonEncodeString(r.redacted)\n564\t\t\tif err != nil {\n565\t\t\t\treturn \"\", err\n566\t\t\t}\n567\t\t\tif r.key == \"\" {\n568\t\t\t\ts = strings.ReplaceAll(s, origJSON, replJSON)\n569\t\t\t\tcontinue\n570\t\t\t}\n571\t\t\tkeyJSON, err := jsonEncodeString(r.key)\n572\t\t\tif err != nil {\n573\t\t\t\treturn \"\", err\n574\t\t\t}\n575\t\t\ts = replaceKeyedJSONValue(s, keyJSON, origJSON, replJSON)\n576\t\t}\n577\t\treturn s, nil\n578\t}\n579\t\n580\t// replaceKeyedJSONValue replaces every occurrence of origJSON that follows\n581\t// keyJSON + optional whitespace + ':' + optional whitespace. Restricts\n582\t// substitution to value positions so a key's own redacted text is not\n583\t// rewritten when it collides with another field's value.\n584\tfunc replaceKeyedJSONValue(s, keyJSON, origJSON, replJSON string) string {\n585\t\tif !strings.Contains(s, keyJSON) {\n586\t\t\treturn s\n587\t\t}\n588\t\tvar b strings.Builder\n589\t\tb.Grow(len(s))\n590\t\ti := 0\n591\t\tfor i < len(s) {\n592\t\t\tj := strings.Index(s[i:], keyJSON)\n593\t\t\tif j < 0 {\n594\t\t\t\tb.WriteString(s[i:])\n595\t\t\t\tbreak\n596\t\t\t}\n597\t\t\tkeyEnd := i + j + len(keyJSON)\n598\t\t\tb.WriteString(s[i : i+j])\n599\t\t\tb.WriteString(keyJSON)\n600\t\t\tp := keyEnd\n601\t\t\tfor p < len(s) && isJSONWhitespace(s[p]) {\n602\t\t\t\tp++\n603\t\t\t}\n604\t\t\tif p >= len(s) || s[p] != ':' {\n605\t\t\t\ti = keyEnd\n606\t\t\t\tcontinue\n607\t\t\t}\n608\t\t\tp++\n609\t\t\tfor p < len(s) && isJSONWhitespace(s[p]) {\n610\t\t\t\tp++\n611\t\t\t}\n612\t\t\tif p+len(origJSON) <= len(s) && s[p:p+len(origJSON)] == origJSON {\n613\t\t\t\tb.WriteString(s[keyEnd:p])\n614\t\t\t\tb.WriteString(replJSON)\n615\t\t\t\ti = p + len(origJSON)\n616\t\t\t\tcontinue\n617\t\t\t}\n618\t\t\ti = keyEnd\n619\t\t}\n620\t\treturn b.String()\n621\t}\n622\t\n623\tfunc isJSONWhitespace(c byte) bool {\n624\t\treturn c == ' ' || c == '\\t' || c == '\\n' || c == '\\r'\n625\t}\n626\t\n627\t// isSingleJSONValue returns true if the decoder has reached EOF (no more\n628\t// top-level values). This distinguishes a single JSON value (e.g., pretty-printed\n629\t// object) from JSONL (multiple concatenated values). We attempt a second Decode\n630\t// and require io.EOF rather than relying on dec.More(), which is documented for\n631\t// use inside arrays/objects and not for top-level value boundaries.\n632\tfunc isSingleJSONValue(dec *json.Decoder) bool {\n633\t\tvar discard json.RawMessage\n634\t\treturn dec.Decode(&discard) == io.EOF\n635\t}\n636\t\n637\t// collectJSONLReplacements walks a parsed JSON value and collects unique string\n638\t// replacements for values that need redaction.\n639\tfunc collectJSONLReplacements(v any) []jsonReplacement {\n640\t\tseen := make(map[string]bool)\n641\t\tvar repls []jsonReplacement\n642\t\tvar walk func(key string, credentialContext bool, v any)\n643\t\twalk = func(key string, credentialContext bool, v any) {\n644\t\t\tswitch val := v.(type) {\n645\t\t\tcase map[string]any:\n646\t\t\t\tif shouldSkipJSONLObject(val) {\n647\t\t\t\t\treturn\n648\t\t\t\t}\n649\t\t\t\tchildCredentialContext := credentialContext || isCredentialJSONObject(val)\n650\t\t\t\tfor k, child := range val {\n651\t\t\t\t\tif shouldSkipJSONLField(k) {\n652\t\t\t\t\t\tcontinue\n653\t\t\t\t\t}\n654\t\t\t\t\twalk(k, childCredentialContext, child)\n655\t\t\t\t}\n656\t\t\tcase []any:\n657\t\t\t\tfor _, child := range val {\n658\t\t\t\t\twalk(\"\", credentialContext, child)\n659\t\t\t\t}\n660\t\t\tcase string:\n661\t\t\t\tredacted := String(val)\n662\t\t\t\tif redacted == val && isCredentialJSONSecretKey(key, credentialContext) && hasNonPlaceholderPasswordValue(val) {\n663\t\t\t\t\tredacted = RedactedPlaceholder\n664\t\t\t\t}\n665\t\t\t\tif redacted != val {\n666\t\t\t\t\tseenKey := key + \"\\x00\" + val\n667\t\t\t\t\tif !seen[seenKey] {\n668\t\t\t\t\t\tseen[seenKey] = true\n669\t\t\t\t\t\trepls = append(repls, jsonReplacement{key: key, original: val, redacted: redacted})\n670\t\t\t\t\t}\n671\t\t\t\t}\n672\t\t\t}\n673\t\t}\n674\t\twalk(\"\", false, v)\n675\t\treturn repls\n676\t}\n677\t\n678\t// shouldSkipJSONLField returns true if a JSON key should be excluded from scanning/redaction.\n679\t// Skips \"signature\" (exact), ID fields (ending in \"id\"/\"ids\"), and common path/directory fields.\n680\tfunc shouldSkipJSONLField(key string) bool {\n681\t\tif key == \"signature\" {\n682\t\t\treturn true\n683\t\t}\n684\t\tlower := strings.ToLower(key)\n685\t\n686\t\t// Skip ID fields\n687\t\tif strings.HasSuffix(lower, \"id\") || strings.HasSuffix(lower, \"ids\") {\n688\t\t\treturn true\n689\t\t}\n690\t\n691\t\t// Skip common path and directory fields from agent transcripts.\n692\t\t// These appear frequently in tool calls and are structural, not secrets.\n693\t\tswitch lower {\n694\t\tcase \"filepath\", \"file_path\", \"cwd\", \"root\", \"directory\", \"dir\", \"path\":\n695\t\t\treturn true\n696\t\t}\n697\t\n698\t\treturn false\n699\t}\n700\t\n701\t// shouldSkipJSONLObject returns true if the object has \"type\":\"image\" or \"type\":\"image_url\".\n702\tfunc shouldSkipJSONLObject(obj map[string]any) bool {\n703\t\tt, ok := obj[\"type\"].(string)\n704\t\treturn ok && (strings.HasPrefix(t, \"image\") || t == \"base64\")\n705\t}\n706\t\n707\tfunc shannonEntropy(s string) float64 {\n708\t\tif len(s) == 0 {\n709\t\t\treturn 0\n710\t\t}\n711\t\tfreq := make(map[byte]int)\n712\t\tfor i := range len(s) {\n713\t\t\tfreq[s[i]]++\n714\t\t}\n715\t\tlength := float64(len(s))\n716\t\tvar entropy float64\n717\t\tfor _, count := range freq {\n718\t\t\tp := float64(count) / length\n719\t\t\tentropy -= p * math.Log2(p)\n720\t\t}\n721\t\treturn entropy\n722\t}\n723\t\n724\t// jsonEncodeString returns the JSON encoding of s without HTML escaping.\n725\tfunc jsonEncodeString(s string) (string, error) {\n726\t\tvar buf bytes.Buffer\n727\t\tenc := json.NewEncoder(&buf)\n728\t\tenc.SetEscapeHTML(false)\n729\t\tif err := enc.Encode(s); err != nil {\n730\t\t\treturn \"\", fmt.Errorf(\"json encode string: %w\", err)\n731\t\t}\n732\t\treturn strings.TrimSuffix(buf.String(), \"\\n\"), nil\n733\t}\n734\t"}]},"uuid":"219b4505-5a76-4e33-85a6-c59d8dbb8bf1","timestamp":"2026-05-11T12:23:20.622Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli/redact/redact.go","content":"package redact\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"math\"\n\t\"net/url\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/betterleaks/betterleaks/detect\"\n)\n\n// secretPattern matches high-entropy strings that may be secrets.\n// Note: / is excluded to prevent matching entire file paths as single tokens.\n// Base64 and JWT tokens are still caught via high-entropy segments between slashes.\nvar secretPattern = regexp.MustCompile(`[A-Za-z0-9+_=-]{10,}`)\n\n// credentialedURIPattern matches URLs that embed userinfo with a password, such\n// as postgres://user:pass@host/db or redis://:pass@host/0. These often have\n// moderate entropy and are not reliably covered by vendor-specific scanners.\nvar credentialedURIPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9+.-]{1,31}://[^\\s/?#@\"'` + \"`\" + `<>:]*:[^\\s/?#@\"'` + \"`\" + `<>]+@[^\\s\"'` + \"`\" + `<>]+`)\n\n// dbPasswordKeyShape matches a DB-prefixed credential key (vendor prefix +\n// optional `_word`/`-word` segments + `password`/`passwd`/`pwd`). Used to\n// compose both the env-var assignment regex and the JSON-key regex so the\n// vendor list stays in one place.\nconst dbPasswordKeyShape = `(?:db|database|pg|postgres|postgresql|mysql|mariadb|redis|mongo|mongodb|sqlserver|mssql|jdbc)(?:[_-]+[a-z0-9]+)*[_-]*(?:password|passwd|pwd)` //nolint:gosec // regex literal, not a credential\n\nvar (\n\tjdbcPattern          = regexp.MustCompile(`(?i)\\bjdbc:[^\\s\"'<>` + \"`\" + `]+`)\n\tdatabaseURLPattern   = regexp.MustCompile(`(?i)\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis)://[^\\s\"'<>` + \"`\" + `]+`)\n\tkeywordDSNPattern    = regexp.MustCompile(`(?i)\\b[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)(?:\\s+[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)){2,}`)\n\tsemicolonConnPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)(?:;[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)){2,}`)\n\t// credentialValuePattern requires the prefix to start at a non-alphanumeric\n\t// boundary, so APP_DB_PASSWORD matches via the leading `_` but mydbpassword\n\t// does not.\n\tcredentialValuePattern = regexp.MustCompile(`(?i)(?:^|[^A-Za-z0-9])(` + dbPasswordKeyShape + `)\\s*=\\s*(\"[^\"]*\"|'[^']*'|[^\\s,;&]+)`)\n\n\tkeywordHostPattern      = regexp.MustCompile(`(?i)(?:^|\\s)host=`)\n\tkeywordUserPattern      = regexp.MustCompile(`(?i)(?:^|\\s)user=`)\n\tsemicolonServerPattern  = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:server|data source|datasource|addr|address|network address)\\s*=`)\n\tsemicolonUserPattern    = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:user id|userid|user|uid)\\s*=`)\n\tpasswordAssignmentRegex = regexp.MustCompile(`(?i)(?:^|[?&;\\s])(?:password|pwd)=(\"[^\"]*\"|'[^']*'|[^&;\\s\"']+)`)\n\t// credentialJSONKeyRegex operates on output of normalizeCredentialJSONKey\n\t// (already lowercased, `-`/` `/`.` → `_`), so the `(?i)` flag is unnecessary.\n\tcredentialJSONKeyRegex  = regexp.MustCompile(`^` + dbPasswordKeyShape + `$`)\n\tgenericPasswordKeyRegex = regexp.MustCompile(`(?i)^(?:password|passwd|pwd)$`)\n)\n\n// entropyThreshold is the minimum Shannon entropy for a string to be considered\n// a secret. 4.5 was chosen through trial and error: high enough to avoid false\n// positives on common words and identifiers, low enough to catch typical API keys\n// and tokens which tend to have entropy well above 5.0.\nconst entropyThreshold = 4.5\n\n// RedactedPlaceholder is the replacement text used for redacted secrets.\nconst RedactedPlaceholder = \"REDACTED\"\n\n// placeholderSecretValues lists lowercase values that should be treated as\n// non-secrets when they appear as a credential value: prior redactions\n// (REDACTED / [REDACTED] / <REDACTED>), common documentation placeholders,\n// and obviously-non-real defaults. Values matched by shape (mask runs,\n// `<…>` brackets, `${…}` shell expansion) are handled separately.\nvar placeholderSecretValues = func() map[string]struct{} {\n\tlower := strings.ToLower(RedactedPlaceholder)\n\tvalues := []string{\n\t\tlower, \"[\" + lower + \"]\", \"<\" + lower + \">\",\n\t\t\"changeme\", \"example\", \"placeholder\",\n\t\t\"your_password\", \"your_db_password\", \"your_secret\",\n\t\t\"secret_here\",\n\t}\n\tout := make(map[string]struct{}, len(values))\n\tfor _, v := range values {\n\t\tout[v] = struct{}{}\n\t}\n\treturn out\n}()\n\n// RedactedBytes represents transcript data that has been through secret\n// redaction. Consumers that require pre-redacted input (e.g., compact.Compact,\n// checkpoint stores) accept this type to enforce the contract at compile time.\n//\n// Produced by JSONLBytes (primary constructor) or trusted wrappers for data\n// previously persisted by checkpoint writers.\ntype RedactedBytes struct {\n\tdata []byte\n}\n\n// Bytes returns the underlying byte slice.\nfunc (r RedactedBytes) Bytes() []byte {\n\treturn r.data\n}\n\n// Len returns the number of bytes in the redacted payload.\nfunc (r RedactedBytes) Len() int {\n\treturn len(r.data)\n}\n\n// AlreadyRedacted wraps transcript bytes known to already be redacted by a\n// prior write path. Use this ONLY for trusted sources such as persisted\n// checkpoint transcripts or controlled test fixtures. For fresh transcript\n// input, use JSONLBytes.\nfunc AlreadyRedacted(data []byte) RedactedBytes {\n\treturn RedactedBytes{data: data}\n}\n\nvar (\n\tbetterleaksDetector     *detect.Detector\n\tbetterleaksDetectorOnce sync.Once\n)\n\nfunc getDetector() *detect.Detector {\n\tbetterleaksDetectorOnce.Do(func() {\n\t\td, err := detect.NewDetectorDefaultConfig()\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tbetterleaksDetector = d\n\t})\n\treturn betterleaksDetector\n}\n\n// region represents a byte range to redact.\ntype region struct{ start, end int }\n\n// taggedRegion extends region with a label for typed replacement tokens.\n// Empty label = secret (produces \"REDACTED\"). Non-empty = PII (produces \"[REDACTED_<LABEL>]\").\ntype taggedRegion struct {\n\tregion\n\n\tlabel string\n}\n\ntype jsonReplacement struct {\n\tkey      string\n\toriginal string\n\tredacted string\n}\n\ntype connectionStringRule struct {\n\tpattern   *regexp.Regexp\n\thasSecret func(string) bool\n}\n\nvar connectionStringRules = []connectionStringRule{\n\t{pattern: jdbcPattern, hasSecret: hasJDBCPassword},\n\t{pattern: databaseURLPattern, hasSecret: hasDatabaseURLSecret},\n\t{pattern: keywordDSNPattern, hasSecret: hasKeywordDSNPassword},\n\t{pattern: semicolonConnPattern, hasSecret: hasSemicolonConnectionPassword},\n}\n\n// String replaces secrets and PII in s using layered detection:\n// 1. Entropy-based: high-entropy alphanumeric sequences (threshold 4.5)\n// 2. Pattern-based: betterleaks regex rules (260+ known secret formats)\n// 3. Credentialed URIs: URLs containing userinfo passwords\n// 4. Database connection strings: JDBC, keyword DSNs, and semicolon strings\n// 5. Bounded credential key/value pairs: DB_PASSWORD=...\n// 6. PII detection: email, phone, address patterns (only when configured via ConfigurePII)\n// A string is redacted if ANY method flags it.\nfunc String(s string) string {\n\tvar regions []taggedRegion\n\n\t// 1. Entropy-based detection (secrets — always on).\n\tfor _, loc := range secretPattern.FindAllStringIndex(s, -1) {\n\t\tstart, end := loc[0], loc[1]\n\n\t\t// Don't consume characters that are part of JSON/string escape sequences.\n\t\t// Example: in \"controller.go\\nmodel.go\", the regex could match \"nmodel\"\n\t\t// (consuming the 'n' from '\\n'), and after replacement the '\\' would be\n\t\t// followed by 'R' from \"REDACTED\", creating invalid escape '\\R'.\n\t\t// Only skip for known JSON escape letters to avoid trimming real secrets\n\t\t// that happen to follow a literal backslash in decoded content.\n\t\tif start > 0 && s[start-1] == '\\\\' {\n\t\t\tswitch s[start] {\n\t\t\tcase 'n', 't', 'r', 'b', 'f', 'u', '\"', '\\\\', '/':\n\t\t\t\tstart++\n\t\t\t\tif end-start < 10 {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tif shannonEntropy(s[start:end]) > entropyThreshold {\n\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n\t\t}\n\t}\n\n\t// 2. Pattern-based detection via betterleaks (secrets — always on).\n\tif d := getDetector(); d != nil {\n\t\tfor _, f := range d.DetectString(s) {\n\t\t\tif f.Secret == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tsearchFrom := 0\n\t\t\tfor {\n\t\t\t\tidx := strings.Index(s[searchFrom:], f.Secret)\n\t\t\t\tif idx < 0 {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tabsIdx := searchFrom + idx\n\t\t\t\tregions = append(regions, taggedRegion{region: region{absIdx, absIdx + len(f.Secret)}})\n\t\t\t\tsearchFrom = absIdx + len(f.Secret)\n\t\t\t}\n\t\t}\n\t}\n\n\t// 3. Credentialed URIs (secrets — always on).\n\tfor _, loc := range credentialedURIPattern.FindAllStringIndex(s, -1) {\n\t\tregions = append(regions, taggedRegion{region: region{loc[0], loc[1]}})\n\t}\n\n\t// 4. Database and connection-string detection (secrets — always on).\n\tregions = append(regions, detectConnectionStrings(s)...)\n\n\t// 5. Bounded credential key/value detection (secrets — always on).\n\tregions = append(regions, detectCredentialValues(s)...)\n\n\t// 6. PII detection (opt-in — only runs when configured).\n\tregions = append(regions, detectPII(getPIIConfig(), s)...)\n\n\tif len(regions) == 0 {\n\t\treturn s\n\t}\n\n\t// Merge overlapping regions and build result.\n\tsort.Slice(regions, func(i, j int) bool {\n\t\tif regions[i].start != regions[j].start {\n\t\t\treturn regions[i].start < regions[j].start\n\t\t}\n\t\tif regions[i].end != regions[j].end {\n\t\t\treturn regions[i].end > regions[j].end // larger region first\n\t\t}\n\t\treturn regions[i].label < regions[j].label // deterministic tie-break\n\t})\n\tmerged := []taggedRegion{regions[0]}\n\tfor _, r := range regions[1:] {\n\t\tlast := &merged[len(merged)-1]\n\t\tif r.start <= last.end {\n\t\t\tif r.end > last.end {\n\t\t\t\tlast.end = r.end\n\t\t\t}\n\t\t\t// Keep the existing label (first/larger region wins)\n\t\t} else {\n\t\t\tmerged = append(merged, r)\n\t\t}\n\t}\n\n\tvar b strings.Builder\n\tprev := 0\n\tfor _, r := range merged {\n\t\tb.WriteString(s[prev:r.start])\n\t\tb.WriteString(replacementToken(r.label))\n\t\tprev = r.end\n\t}\n\tb.WriteString(s[prev:])\n\treturn b.String()\n}\n\nfunc detectConnectionStrings(s string) []taggedRegion {\n\tif !strings.ContainsRune(s, '=') {\n\t\treturn nil\n\t}\n\tvar regions []taggedRegion\n\tfor _, rule := range connectionStringRules {\n\t\tregions = append(regions, detectConnectionStringRule(s, rule)...)\n\t}\n\treturn regions